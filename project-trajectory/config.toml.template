# docs/config.toml — the single configuration authority (blank form).
#
# Every dial this repo understands is listed below, COMMENTED OUT and
# showing its default. Uncomment only what you actually want to declare:
# an unset key resolves to the default shown, and a key you set while its
# retired one-word file is still present is REFUSED as a mixed source.
#
# Generated by scripts/config_migrate.py --template from the declared
# schema (scripts/config.py SCHEMA). Adopter-owned once written: a kit
# re-sync never overwrites it.

schema = 1

[attestation]
# Inclusive human checkpoints: 0=SN; 1=SN+SR; 2=SN+SR+LLR; 3=SN+SR+LLR+TC.
# At or below the boundary a ratification needs a human decision; above it
# an adjudicator may enact.
# human_ratification_through = 1
# Persistent policy for a whole-spine human review at stage 4. A one-off ask
# is a review-request event, not a config edit.
# final_full_spine_review = "never"

[automation]
# The dispatcher's worker-lane ceiling. 1 is serial.
# lanes = 1
# Wall-clock ceiling for one worker session.
# session_timeout_seconds = 7200
# UTC Mon-Fri window "HH:MM-HH:MM" the coordinator starts no new session
# inside; "" disables it.
# blackout = ""

[policy]
# Who may publish this repo: human (an agent never pushes), agent-iteration
# (the scrubbed iteration branch only), or agent.
# push = "human"
# Run the privacy gate: author identity and committed content are scanned
# for PII / identity leak classes.
# privacy_check = false
# The always-on secrets floor: private-key headers and key/token shapes
# block a commit and a push.
# secrets_scan = true
# Whether an unwired reviewer command blocks a push (require) or warns and
# proceeds (warn-unwired). Read today by pre-push only.
# privacy_review = "require"
# Independent fresh-context review verdicts a completed work item gets
# before the integrator accepts it.
# review_rounds = 1
# Which sessions get the vendored guardrails core prepended: off, all, `all
# except <sub>`, or a model-substring allowlist.
# guardrails = "off"
# What happens when a session tries to spawn a subagent.
# subagent_gate = "off"
# Redraw the session status line in place instead of appending to the scroll
# (honoured only on a TTY).
# live_status = false
# Line budget for docs/status.md; 0 disables the lint.
# status_lint = 120
# Run the status.md <-> work-item registry coherence check.
# trajectory_check = true
# Run the declared-interface coverage check.
# interfaces_check = true
# Run the component-registry coverage check.
# components_check = true
# Generate and freshness-check the docs/okf/ knowledge bundle.
# okf_export = true

[harness]
# Product source root. Mirrors docs/stack.ini [paths] src; stack.ini stays
# the live source until the cutover and the two are proved equal by the
# parity tests.
# src = "src"
# Test root. Mirrors docs/stack.ini [paths] tests (see harness.src).
# tests = "tests"

[outcomes]
# Fraction of Complete outcomes that draw a dedicated adjudicator even with
# no risk trigger.
# complete_sampling_rate = 0.0
# Safety classes whose Complete outcome always adjudicates.
# risk_safety_classes = ["spine", "gate", "attestation", "high-risk", "adjudication"]

[admission]
# Optional throttle on one admission batch; 0 disables it. Never the
# independence criterion.
# max_batch_size = 0

[routing]
# Managed model routing. The explicit successor of the consent property
# docs/agents-enabled carried by mere presence, so it is opt-in: routing is
# off until this says otherwise.
# enabled = false

# Model routes, one [[routes]] table each. Convert an existing
# docs/agents.csv with `python scripts/config_migrate.py --write` rather
# than writing these by hand.
#   id — Stable route id, e.g. ANTHROPIC-OPUS-STRONG.
#   family — Provider family; drives cross-family draws.
#   model — Model slug substituted into {model}.
#   strength — 1=quick 2=medium 3=strong.
#   argv — Invocation argv; {model} is substituted.
#   env — Environment merged over the inherited one.
#   capabilities — What this route may be drawn for.
#   notes — Failure-context hint echoed at preflight.

# Per-job weighted pools, one [jobs.<name>] table each. Declared jobs:
# planner, critic, arbiter, implementer, reviewer, adjudicator.
#   minimum_strength — Weakest drawable route.
#   fallback — What to draw when the pool is out.
#   prefer_cross_family — Prefer a different family.
#   pool — Weighted route entries: {route=..., weight=...}.

# Reviewed prompt templates, one [prompts.<name>] table each. Declared
# prompts: planner, critic, arbiter, implementer, reviewer, adjudicator,
# adjudicate-amendment, adjudicate-disposition, adjudicate-conflict,
# adjudicate-red-test.
#   template — Repo-relative Markdown template path.
#   required_slots — Slots the render must fill.
#   allowed_sources — Evidence sources the prompt may cite.
#   prohibited_sources — Sources it may never cite.
#   output_schema — Declared output contract name.
