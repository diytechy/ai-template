#!/bin/sh
# Pre-commit hook — the agent-neutral *process floor*.
#
# Runs only the fast, always-valid kit checks so a stale code map, a duplicated
# or malformed requirement id, or unformatted code never lands in a commit —
# regardless of which agent (or human) made it. Enforcement lives here (git) and
# in CI, not in any one agent's hook config, so it holds for Claude, Gemini,
# Codex, and bare git alike.
#
# This is the universal *floor*; the full gate bar (placeholder rejection, schema
# checks, tests, coverage) is gate-scoped and lives in check.py / CI. Those
# heavier checks are deliberately NOT here: they would block legitimate
# early-stage (stage 0/1) commits. See process.md §7 (process vs product checks).
#
# Enable:  git config core.hooksPath .githooks   (setup.sh / setup.ps1 do this)
# Disable: git config --unset core.hooksPath
#
# One POSIX hook covers every platform: Git for Windows runs hooks through its
# bundled sh, so this same file works on Windows, Linux, and macOS.
set -e

# Locate the repo root. `git rev-parse --show-toplevel` is authoritative and works
# regardless of where this hook file physically lives — so a repo whose harness is
# elsewhere can DELEGATE to this one shipped hook (see KIT_SCRIPTS_DIR below,
# IMPROVEMENT_PLAN.md WI-1.42). Fall back to the hook's own location (.githooks/../)
# if rev-parse is unavailable.
REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || REPO_ROOT=$(cd "$(dirname "$0")/.." && pwd)

# Identity is no longer pinned by a repo file — the author-identity check is now
# the privacy-layer step 3a below (Python, via check_privacy.py --author), run
# only when docs/privacy-check is `true`. See process-options.md "Commit
# identity & privacy". Recorded trade: unlike the old pure-shell pin, a
# Python-less machine no longer enforces it — deliberate, since that pin moved to
# the user's own git config and what remains is a privacy check like the rest.

# Fail-closed guard for the skips below (M-42): a declared privacy policy must
# never be skipped silently. The skip-when-tooling-is-missing posture is right
# for the PROCESS checks (a Python-less box still commits), but it would also
# skip the secrets/privacy scans — so when docs/privacy-check reads `true`,
# parse it in pure sh (the pre-push hook's pattern) and REFUSE the skip. The
# trade, recorded: a privacy-checked repo cannot commit without a working
# Python 3; that is the same stance pre-push already takes at the boundary
# that matters most, moved up to where the leak would first land in history.
#   SN-028 re-key: the policy's home is now docs/process.toml, and THIS parse
# is the reason every value there is written one `key = value` per line — a
# first-line parse cannot read a TOML file, but a KEYED match can.
#
# TWO GRAMMARS READ ONE FILE, so the read below is deliberately asymmetric.
# `tomllib` understands far more than a `grep -E` can follow, and every shape
# only one of them sees is a silent flip of a security gate. So:
#   * the DECLARED test is BROAD — any `privacy_check =` occurrence on a
#     non-comment line, whatever precedes it;
#   * the OFF test is NARROW — only a value that is provably `false`;
#   * anything in between reads ON. FAIL CLOSED: a key we cannot prove is off
#     is on, which is loud, and the alternative is the M-42 failure itself.
# `agent_common.process_shape_findings` refuses the shapes this cannot follow
# (dotted keys, inline tables, multi-line strings, the key under the wrong
# section), and tests/test_process_config.py drives this exact function
# against `tomllib` over a table of adversarial files. POSIX ERE only — no \s,
# no -P, no -o.
#
# A MIXED config (both homes live) refuses outright rather than picking one:
# the Python readers do the same, and "which file wins" is not a question a
# privacy gate should have an opinion about.
_ptoml_body() {
  # The greppable body of docs/process.toml: whole-line comments dropped, then
  # TRAILING comments stripped.
  #
  # The trailing strip is not tidiness — without it the two grammars that read
  # this file disagree in the FAIL-OPEN direction. `privacy_check = true #
  # privacy_check = false` is legal TOML whose value is `true`, but the narrow
  # "provably false" test below matched the decoy inside the comment and the
  # gate silently switched off, while Python read it as ON. That is the M-42
  # contract inverted: the hook is what blocks the commit, so the hook reading
  # `false` is the one that decides.
  #
  # Stripping at the first `#` can truncate a string value that legitimately
  # contains one. Every consequence of that runs the SAFE way: a truncated
  # value is LESS able to prove `false` (so privacy stays ON), and
  # `privacy_review` treats anything that is not exactly `warn-unwired` as
  # require. The declaration test cannot be affected at all — `key =` sits
  # before any `#` on its line.
  grep -v '^[[:space:]]*#' "$1" 2>/dev/null | sed 's/[[:space:]]*#.*$//' || true
}

process_declares() {
  [ -f "$1" ] || return 1
  _ptoml_body "$1" | grep -Eq '(^|[^A-Za-z0-9_])'"$2"'[[:space:]]*='
}

mixed_config_refusal() {
  ptoml="$REPO_ROOT/docs/process.toml"
  process_declares "$ptoml" privacy_check || return 1
  [ -f "$REPO_ROOT/docs/privacy-check" ] || return 1
  echo "$1: docs/process.toml AND the legacy docs/privacy-check both declare" >&2
  echo "  the privacy policy. REFUSING — a mixed config is where two readers" >&2
  echo "  disagree about the same gate. Run:" >&2
  echo "    python scripts/bootstrap.py --migrate-config --dest ." >&2
  return 0
}

privacy_declared_true() {
  ptoml="$REPO_ROOT/docs/process.toml"
  if process_declares "$ptoml" privacy_check; then
    _ptoml_body "$ptoml" | grep -Eq '(^|[^A-Za-z0-9_])privacy_check[[:space:]]*=[[:space:]]*false([[:space:]]|#|$)' && return 1
    return 0
  fi
  [ -f "$REPO_ROOT/docs/privacy-check" ] || return 1
  p=$(grep -v '^[[:space:]]*#' "$REPO_ROOT/docs/privacy-check" | grep -v '^[[:space:]]*$' | head -n 1 | tr -d '[:space:]' || true)
  [ "$p" = "true" ]
}

if mixed_config_refusal "pre-commit"; then exit 1; fi

# Find a Python 3 interpreter. Prefer the project venv (setup.sh creates ./.venv
# with the toolchain), so tool-backed steps like format actually RUN instead of
# SKIP-on-missing-tool; fall back to a PATH python. Probe by *running* the
# candidate, not just finding it: on Windows, `python3` often resolves to the
# Microsoft Store app-execution alias, which exists on PATH but exits nonzero when
# Python isn't installed through it — existence alone would wedge every commit.
PY=""
for venvpy in "$REPO_ROOT/.venv/bin/python" "$REPO_ROOT/.venv/Scripts/python.exe"; do
  if [ -x "$venvpy" ] && "$venvpy" -c "" >/dev/null 2>&1; then PY="$venvpy"; break; fi
done
if [ -z "$PY" ]; then
  for cand in python3 python; do
    if command -v "$cand" >/dev/null 2>&1 && "$cand" -c "" >/dev/null 2>&1; then
      PY="$cand"; break
    fi
  done
fi
if [ -z "$PY" ]; then
  if privacy_declared_true; then
    echo "pre-commit: docs/privacy-check is true but Python 3 is unavailable —" >&2
    echo "  the secrets/privacy scans cannot run, so refusing to skip them." >&2
    echo "  FAILING CLOSED: install Python 3 (or run setup.sh) to commit." >&2
    exit 1
  fi
  echo "pre-commit: Python 3 not found on PATH; skipping process checks." >&2
  exit 0
fi

# Locate the scripts directory. Default layout is scripts/ (what bootstrap
# scaffolds). A repo whose harness lives elsewhere sets KIT_SCRIPTS_DIR (relative
# to the repo root, or absolute) so this one shipped hook fits ANY layout — e.g.
# the kit's own meta-repo, where the harness is under project-trajectory/scripts/
# and .githooks/pre-commit is a two-line wrapper that sets the var and delegates
# here (WI-1.42). NTFS is case-preserving: a repo whose dir is "Scripts/" keeps
# that name and bare "scripts/" fails on case-sensitive Linux CI — accept either.
SCRIPTS_DIR=""
if [ -n "${KIT_SCRIPTS_DIR:-}" ]; then
  case "$KIT_SCRIPTS_DIR" in
    /*) SCRIPTS_DIR="$KIT_SCRIPTS_DIR" ;;
    *)  SCRIPTS_DIR="$REPO_ROOT/$KIT_SCRIPTS_DIR" ;;
  esac
fi
if [ -z "$SCRIPTS_DIR" ]; then
  for sd in scripts Scripts; do
    if [ -d "$REPO_ROOT/$sd" ]; then
      SCRIPTS_DIR="$REPO_ROOT/$sd"; break
    fi
  done
fi
if [ -z "$SCRIPTS_DIR" ] || [ ! -d "$SCRIPTS_DIR" ]; then
  if privacy_declared_true; then
    echo "pre-commit: docs/privacy-check is true but the kit scripts dir cannot" >&2
    echo "  be found (KIT_SCRIPTS_DIR or scripts/), so the secrets/privacy scans" >&2
    echo "  cannot run — refusing to skip them. FAILING CLOSED." >&2
    exit 1
  fi
  echo "pre-commit: cannot find the kit scripts dir (KIT_SCRIPTS_DIR or scripts/) under $REPO_ROOT; skipping process checks." >&2
  exit 0
fi

# 1. The batched freshness/integrity floor — ONE interpreter spawn running the
#    independent floor checks concurrently (`check.py --run-steps`), where this
#    hook once chained a separate `--run-step`/script call per check. Faster on every
#    commit, and it reports EVERY stale artifact in one pass (the old `set -e`
#    chain stopped at the first, hiding the rest until the next attempt). The
#    delegation keeps each step honoring the declared docs/stack.ini profile
#    (Finance-Auditor re-sync field report, WI-1.26). The steps (the arch-map
#    committed-map step retired at WI-455 — the module map derives live from
#    the source AST):
#      - okf             knowledge bundle fresh: a registry edit stales docs/okf/
#                        exactly like the dashboard; vacuous for a non-adopter,
#                        [checks] okf_export = false silences.
#      - trajectory-map  PROJECT_STATE.html fresh: reads all four spine
#                        registries + the README vision tag + the okf bundle
#                        (WI-070), so an ordinary requirement edit stales it,
#                        and CI-only checking makes that a push-long feedback
#                        loop (THREAD_52_REVIEW.md F2). The floor rule, stated
#                        once here: a generated artifact's freshness check joins
#                        this hook when regenerating is one stdlib command and
#                        the step is vacuous for a non-adopter; checks needing
#                        the product toolchain or gate context (tests, perf,
#                        flows) stay in check.py / CI.
#      - ratify-fresh    the re-attestation brief fresh against the registry it
#                        summarizes (WI-325). It self-stamps its baseline, so the
#                        compare uses the one the FILE declares, never a re-derived
#                        one. Doubly self-arming: silent with no brief, and silent
#                        once the window is closed. Here rather than only at the
#                        gate because a stale brief is read by a HUMAN about to
#                        attest, and the sitting can happen between gate runs.
#      - status-map      docs/status.md's GENERATED STATUS block fresh (WI-202):
#                        the derived snapshot (spine + derived gate + open-items
#                        one-liners) regenerates + byte-compares like trajectory-map,
#                        so a registry / open-items / gate edit that stales it blocks
#                        HERE, not first in CI. It is the freshness successor to the
#                        WI-200 forward-only token guard (which stands down once the
#                        marker is present). Vacuous when status.md has no marker
#                        pair, so a non-adopter pays nothing.
#      - trajectory      the status.md <-> work-items.csv SSOT floor, WARN-FIRST
#                        at gate=all: only R-A (Deliverable non-empty iff done)
#                        is a hard ERROR here — a commit is the agent handoff
#                        point, so an incoherent WI state launches the next
#                        session wrong; R-B…R-E warn at commit, gate at DevStg-Tests+.
#      - registry-integrity  trace.py --strict-integrity: no duplicate/malformed
#                        ids — wrong at any stage. Deliberately NOT the full
#                        --strict orphan check: orphans are a DevStg-Tests+ gate criterion
#                        (a mid-DevStg-Reqs registry legitimately has SRs with no LLR/TC
#                        yet); the floor must never block an early-stage commit.
#      - derived-stage   docs/stage is GENERATED from artifact states by
#                        derive_stage.py; --check fails if a ratify/reopen moved
#                        the derived rung, or any declared derivation input, but
#                        the recorded file did not. Its predecessor `derived-gate`
#                        retired with `docs/gate` and the three-value bar axis.
#                        Regenerate with `python scripts/derive_stage.py`.
#      - skills-sync     per-agent skill copies byte-match the ONE neutral
#                        source; one-command fix (bootstrap.py --sync); a no-op
#                        where the kit-only generator isn't beside check.py.
#      - skills-index    skills/INDEX.csv still matches the SKILL.md frontmatter
#                        (WI-427). A DIFFERENT property from skills-sync above:
#                        that one compares hand-authored copies to hand-authored
#                        source and never reads the index. The fix is one stdlib
#                        command (`gen_skills_index.py`) and the branch that
#                        edited the SKILL.md is the only one that can run it —
#                        which is exactly the floor rule stated at trajectory-map.
#      - prompt-catalog  prompts/CATALOG.md still matches the shipped templates
#                        (WI-427). It is the join key from a session log's
#                        `# prompt-sha:` back to the template that produced it,
#                        so a stale one misleads whoever is debugging a session —
#                        and a template edit is precisely a COMMIT. Fix:
#                        `gen_prompt_catalog.py`. Both steps are no-ops where the
#                        kit-only generator isn't beside check.py, so a
#                        non-adopter pays nothing.
#      - staged-divergence  the one step here that is NOT a freshness check, and
#                        it exists because every step above reads the WORKING
#                        TREE: it asks which declared generated artifact is
#                        modified on disk but absent from the INDEX, i.e. which
#                        one you regenerated and did not `git add`. Without it a
#                        regenerate-and-forget commit is honestly green and
#                        lands stale (measured: 3b8d306d). IT BLOCKS since the
#                        WI-498 close: OI-31 ruled option (b) warn-first and
#                        promoted "once it has run clean for a program", and
#                        that is the promotion — so a regenerated-but-unstaged
#                        artifact REFUSES the commit rather than warning past
#                        it. Fix by staging the regenerated files (or reverting
#                        them). It does NOT catch an artifact staged
#                        while stale, which needs the gates themselves to read
#                        the staged tree (OI-31 option (a), the destination).
#                        Skips cleanly with no git and outside a checkout.
#    When a step reports STALE, regenerate in dependency order — okf ->
#    trajectory (the dashboard consumes the bundle); the gate marker via
#    spine_rules.py and the stage marker via derive_stage.py, then the status
#    snapshot via `gen_trajectory.py --status`
#    (it reads the fresh gate), then the owner surface via `gen_open_items.py`
#    — then STAGE THE REGENERATED FILES (`git add`) and re-commit. Staging is
#    not a formality: these steps compare the tree ON DISK, so regenerating
#    without staging turns them green over a commit that still carries the
#    stale bytes — the staged-divergence step above reports exactly that.
#    The two kit-only index/catalogue steps stand alone: each regenerates with
#    its own single command and feeds nothing else.
"$PY" "$SCRIPTS_DIR/check.py" --run-steps okf,trajectory-map,status-map,open-items,trajectory,registry-integrity,derived-stage,skills-sync,skills-index,prompt-catalog,ratify-fresh,staged-divergence

# 2. No-validation-delta warn (warn-first, never blocks): when this commit
#    closes a WI that is a follow-up on an SR a previously-done WI already
#    delivered, yet touches neither the TC registry nor a test file, the fix
#    landed in the code but not the validation chain — so the same failure can
#    recur. Reads the staged diff (git is available in the hook context); a
#    silent no-op outside a git checkout and when the registry is untouched.
"$PY" "$SCRIPTS_DIR/check_trajectory.py" --root "$REPO_ROOT" --staged || true

# 3. Secrets + privacy lint. The always-on SECRETS FLOOR (private-key headers,
#    key/token shapes) runs in EVERY repo — the security net an ordinary
#    project gets too; opt out with the one word `off` in docs/secrets-scan. The
#    PRIVACY layer (author identity, home-dir paths carrying the OS username,
#    non-exempt emails, the machine's global git identity) runs only when
#    docs/privacy-check is `true`. The script decides which layers apply and
#    exits 0 fast when both are off: zero cost. Deterministic floor only —
#    judgment-layer review lives at the push boundary and in the sync scrub.
#    3a. Author identity as a PRIVACY check — the commit author email must be in
#        the exempt allowlist (a no-op when docs/privacy-check is off). Replaces
#        the old commit-identity pin (integrity) with the privacy property.
#    3b. Content scan of the staged diff.
#    The commit *message* is scanned by the separate .githooks/commit-msg hook —
#    pre-commit runs before the message exists, so it cannot see it here.
"$PY" "$SCRIPTS_DIR/check_privacy.py" --root "$REPO_ROOT" --author
"$PY" "$SCRIPTS_DIR/check_privacy.py" --root "$REPO_ROOT"

# 4. Format check — the product formatter, sourced from the declared toolchain
#    (docs/stack.ini) rather than restated here. When the profile exists,
#    delegate to `check.py --run-step format`: check.py runs the profile's
#    format command itself (no shell-quoting of the interpreter path), treats a
#    missing tool as SKIP (exit 0, so a not-yet-set-up repo still commits), and
#    fails only on a real format violation. When there's no profile, fall back
#    to the historical staged-.py ruff check, run only if ruff is importable.
if [ -f "$REPO_ROOT/docs/stack.ini" ]; then
  "$PY" "$SCRIPTS_DIR/check.py" --run-step format
else
  if "$PY" -c "import importlib.util as u, sys; sys.exit(0 if u.find_spec('ruff') else 1)" >/dev/null 2>&1; then
    staged=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null | grep '\.py$' || true)
    if [ -n "$staged" ]; then
      # shellcheck disable=SC2086  # word-splitting is intended: one arg per file.
      "$PY" -m ruff format --check $staged
    fi
  fi
fi
