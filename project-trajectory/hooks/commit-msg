#!/bin/sh
# commit-msg hook — secrets + privacy scan of the commit MESSAGE (title + body).
#
# pre-commit runs before the message exists, so it can only scan the staged
# diff; the message body is unseen until push (pre-push --range reads history).
# That gap is how leaks in commit messages — a credential pasted into a body, an
# email in a trailer — pile up unnoticed across many commits before a push
# finally surfaces them. This hook closes it: git passes the prepared message
# file as $1, and a nonzero exit ABORTS the commit, so a leak is caught at the
# first commit, not the push.
#
# The script self-gates: the always-on SECRETS FLOOR scans every repo's message,
# and the PRIVACY layer adds its classes only when docs/privacy-check is `true`.
# Both off => it exits 0 fast (zero cost). Enabled by
# `git config core.hooksPath .githooks` (setup.sh / setup.ps1 already set it).
#
# One POSIX hook covers every platform (Git for Windows runs hooks through sh).
set -e

# Authoritative repo root (works when delegated from a wrapper elsewhere), with
# the .githooks/../ fallback — same as pre-commit.
REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || REPO_ROOT=$(cd "$(dirname "$0")/.." && pwd)

# (The WI-282 train-build trailer floor — pure sh over llm/train/* branches —
# retired with the dispatcher's reviewed_train_head at concurrency-restructure
# Phase 5: no llm/train/* branch exists to guard, and the integrator's verdict
# gate binds a review to its exact commit by git-derived freshness instead.)

# Fail-closed guard for the skip below (M-42, same as pre-commit): a repo that
# declared docs/privacy-check `true` must never have its message scan skipped
# silently — parse the policy in pure sh (the pre-push pattern) and refuse.
# The one skip left is a missing kit scripts dir (a missing interpreter
# refuses outright, WI-880); a non-privacy repo keeps that skip.
# SN-028 re-key: docs/process.toml's keyed match first, legacy file second.
# BYTE-IDENTICAL to pre-commit's copy — an F5 duplication the two hooks keep
# on purpose (their interpreter probe, by contrast, is one shared file), and
# load-bearing: two hooks that disagreed about whether privacy is on would
# gate one boundary and not the other. The asymmetry (broad "declared", narrow "off", fail closed in
# between) and the mixed-config refusal are documented in full at
# hooks/pre-commit. POSIX ERE only.
_ptoml_body() {
  # The greppable body of docs/process.toml: whole-line comments dropped, then
  # TRAILING comments stripped.
  #
  # The trailing strip is not tidiness — without it the two grammars that read
  # this file disagree in the FAIL-OPEN direction. `privacy_check = true #
  # privacy_check = false` is legal TOML whose value is `true`, but the narrow
  # "provably false" test below matched the decoy inside the comment and the
  # gate silently switched off, while Python read it as ON. That is the M-42
  # contract inverted: the hook is what blocks the commit, so the hook reading
  # `false` is the one that decides.
  #
  # Stripping at the first `#` can truncate a string value that legitimately
  # contains one. Every consequence of that runs the SAFE way: a truncated
  # value is LESS able to prove `false` (so privacy stays ON), and
  # `privacy_review` treats anything that is not exactly `warn-unwired` as
  # require. The declaration test cannot be affected at all — `key =` sits
  # before any `#` on its line.
  grep -v '^[[:space:]]*#' "$1" 2>/dev/null | sed 's/[[:space:]]*#.*$//' || true
}

process_declares() {
  [ -f "$1" ] || return 1
  _ptoml_body "$1" | grep -Eq '(^|[^A-Za-z0-9_])'"$2"'[[:space:]]*='
}

mixed_config_refusal() {
  ptoml="$REPO_ROOT/docs/process.toml"
  process_declares "$ptoml" privacy_check || return 1
  [ -f "$REPO_ROOT/docs/privacy-check" ] || return 1
  echo "$1: docs/process.toml AND the legacy docs/privacy-check both declare" >&2
  echo "  the privacy policy. REFUSING — a mixed config is where two readers" >&2
  echo "  disagree about the same gate. From your kept kit checkout, run:" >&2
  echo "    python project-trajectory/scripts/bootstrap.py --migrate-config --dest ." >&2
  return 0
}

privacy_declared_true() {
  ptoml="$REPO_ROOT/docs/process.toml"
  if process_declares "$ptoml" privacy_check; then
    _ptoml_body "$ptoml" | grep -Eq '(^|[^A-Za-z0-9_])privacy_check[[:space:]]*=[[:space:]]*false([[:space:]]|#|$)' && return 1
    return 0
  fi
  [ -f "$REPO_ROOT/docs/privacy-check" ] || return 1
  p=$(grep -v '^[[:space:]]*#' "$REPO_ROOT/docs/privacy-check" | grep -v '^[[:space:]]*$' | head -n 1 | tr -d '[:space:]' || true)
  [ "$p" = "true" ]
}

if mixed_config_refusal "commit-msg"; then exit 1; fi

# THE LOOP PROVENANCE FLOOR (SR-209). A commit made from a process the
# unattended loop started carries the loop marker in its environment, and must
# end with a valid `Loop-Session:` trailer naming that session; a person's
# commit carries no marker and is never judged. The rule itself lives once, in
# Python (`check.py --loop-trailer`, over `kitlib.provenance`); what this shell
# knows is only whether the marker is set, so that a marked commit whose floor
# cannot run FAILS CLOSED below instead of passing unjudged — the same stance
# the privacy layer takes. Hooks are opt-in per checkout, so the merge slot
# re-checks every commit of a lane's range whether or not this ran.
loop_marked() {
  [ -n "${KIT_LOOP_SESSION:-}" ]
}

# The ONE interpreter every step below runs on, resolved once, here, by the
# probe all three kit hooks share (hooks/kit-python.sh, shipped beside this
# hook; WI-880). With no Python 3.11+ it refuses, naming dev-setup's install.
. "$(dirname "$0")/kit-python.sh"
kit_python commit-msg commit || exit 1

# Locate the kit scripts dir honoring KIT_SCRIPTS_DIR (env / delegating wrapper)
# before the default scripts/ | Scripts/ — the harness-elsewhere layout WI-1.42
# gave pre-commit; the message scan must honor it too, or a repo with that
# layout silently never scans commit messages (REVIEW_GRIND_FULL C4).
SCRIPTS_DIR=""
if [ -n "${KIT_SCRIPTS_DIR:-}" ]; then
  case "$KIT_SCRIPTS_DIR" in
    /*) SCRIPTS_DIR="$KIT_SCRIPTS_DIR" ;;
    *)  SCRIPTS_DIR="$REPO_ROOT/$KIT_SCRIPTS_DIR" ;;
  esac
fi
if [ -z "$SCRIPTS_DIR" ] || [ ! -d "$SCRIPTS_DIR" ]; then
  SCRIPTS_DIR=""
  for sd in scripts Scripts; do
    if [ -d "$REPO_ROOT/$sd" ]; then
      SCRIPTS_DIR="$REPO_ROOT/$sd"; break
    fi
  done
fi
if [ -z "$SCRIPTS_DIR" ] || [ ! -d "$SCRIPTS_DIR" ]; then
  if privacy_declared_true; then
    echo "commit-msg: docs/privacy-check is true but the kit scripts dir cannot" >&2
    echo "  be found (KIT_SCRIPTS_DIR or scripts/), so the message scan cannot" >&2
    echo "  run — refusing to skip it. FAILING CLOSED." >&2
    exit 1
  fi
  if loop_marked; then
    echo "commit-msg: a loop commit, but the kit scripts dir cannot be found" >&2
    echo "  (KIT_SCRIPTS_DIR or scripts/), so its provenance trailer cannot be" >&2
    echo "  checked. FAILING CLOSED." >&2
    exit 1
  fi
  echo "commit-msg: cannot find the kit scripts dir (KIT_SCRIPTS_DIR or scripts/) under $REPO_ROOT; skipping message scan." >&2
  exit 0
fi

# The loop provenance floor: a no-op (exit 0) for a person's commit.
"$PY" "$SCRIPTS_DIR/check.py" --loop-trailer "$1"

# Scan the message file git handed us ($1). Nonzero exit aborts the commit.
"$PY" "$SCRIPTS_DIR/check_privacy.py" --root "$REPO_ROOT" --message "$1"
