#!/bin/sh
# commit-msg hook — secrets + privacy scan of the commit MESSAGE (title + body).
#
# pre-commit runs before the message exists, so it can only scan the staged
# diff; the message body is unseen until push (pre-push --range reads history).
# That gap is how leaks in commit messages — a credential pasted into a body, an
# email in a trailer — pile up unnoticed across many commits before a push
# finally surfaces them. This hook closes it: git passes the prepared message
# file as $1, and a nonzero exit ABORTS the commit, so a leak is caught at the
# first commit, not the push.
#
# The script self-gates: the always-on SECRETS FLOOR scans every repo's message,
# and the PRIVACY layer adds its classes only when docs/privacy-check is `true`.
# Both off => it exits 0 fast (zero cost). Enabled by
# `git config core.hooksPath .githooks` (setup.sh / setup.ps1 already set it).
#
# One POSIX hook covers every platform (Git for Windows runs hooks through sh).
set -e

# Authoritative repo root (works when delegated from a wrapper elsewhere), with
# the .githooks/../ fallback — same as pre-commit.
REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || REPO_ROOT=$(cd "$(dirname "$0")/.." && pwd)

# WI-282: the train-build commit-message floor — pure sh, run FIRST so it holds
# even on a Python-less box (unlike the message scan below). On an llm/train/*
# branch a substantive build commit must carry a parseable `WI: WI-<n>` trailer:
# the exact property agent_dispatch.reviewed_train_head reads to resolve a train's
# reviewed head. A malformed block (e.g. a blank line interposed in the trailer
# paragraph) makes git DROP the trailer, so the integrator SKIPS the commit and
# can grade a stale verdict, parking an approved train as rework — a one-line slip
# that cost a full build+review cycle (live failure 2026-07-23, train
# p0-g3-WI-281-9ae9). `git interpret-trailers --parse` shares git's trailer parser
# with that %(trailers) read, so this refuses exactly what the integrator would
# later fail to resolve. Vacuous off a train branch; the sanctioned coordinator
# commits (integrate:/telemetry:/review:/blocked: subject prefix) and a blocked
# disposition (a parseable `Blocked-WI: WI-<n>` trailer) stay legal. The prefix set mirrors
# agent_common.SANCTIONED_TRAIN_SUBJECT_PREFIXES (kept in step by
# tests/test_commit_msg_wi_trailer.py).
wi_branch=$(git -C "$REPO_ROOT" symbolic-ref --quiet --short HEAD 2>/dev/null || true)
case "$wi_branch" in
  llm/train/*)
    wi_subject=$(sed -n '1p' "$1")
    case "$wi_subject" in
      integrate:*|telemetry:*|review:*|blocked:*) : ;;  # sanctioned coordinator commit
      *)
        wi_trailers=$(git -C "$REPO_ROOT" interpret-trailers --parse "$1" 2>/dev/null || true)
        # This WI token grammar is identical to agent_common.WI_TOKEN_RE
        # (`^WI-\d+$`): invalid block evidence remains substantive, so the
        # reviewed-head diagnostic exposes it instead of hiding a newer build.
        blocked_trailers=$(printf '%s\n' "$wi_trailers" | grep -iE '^Blocked-WI:' || true)
        if [ -n "$blocked_trailers" ] && printf '%s\n' "$blocked_trailers" | grep -qvE '^[Bb]locked-[Ww][Ii]:[[:space:]]*WI-[0-9]+[[:space:]]*$'; then
          echo "commit-msg: every blocked disposition trailer must be" >&2
          echo "  'Blocked-WI: WI-<n>'; malformed block evidence is a build commit" >&2
          echo "  and therefore needs a valid WI: WI-<n> trailer instead." >&2
          exit 1
        elif [ -n "$blocked_trailers" ]; then
          : # every blocked disposition carries a parseable Blocked-WI, not WI
        elif printf '%s\n' "$wi_trailers" | grep -qE '^[Ww][Ii]:[[:space:]]*WI-[0-9]+[[:space:]]*$'; then
          : # a well-formed build commit
        else
          echo "commit-msg: this build commit on train branch '$wi_branch' carries" >&2
          echo "  no parseable 'WI: WI-<n>' trailer. The integrator resolves a train's" >&2
          echo "  reviewed head as the newest commit whose git-parsed trailers include" >&2
          echo "  WI: (agent_dispatch.reviewed_train_head); a commit without it is" >&2
          echo "  SKIPPED, so a stale verdict can park an approved train as rework" >&2
          echo "  (WI-282; live failure 2026-07-23 on train p0-g3-WI-281-9ae9)." >&2
          echo "" >&2
          echo "  Fix: end the message with a trailer block whose LAST paragraph is" >&2
          echo "  trailers ONLY - no blank line inside it (a blank line there breaks" >&2
          echo "  git's trailer parsing; that is the exact slip this floor catches):" >&2
          echo "" >&2
          echo "      <subject line>" >&2
          echo "" >&2
          echo "      WI: WI-<n>" >&2
          echo "      Train: <train-id>" >&2
          echo "      Base: <base-sha>" >&2
          echo "" >&2
          echo "  A sanctioned dispatcher commit is exempt instead: use an" >&2
          echo "  integrate:/telemetry:/review:/blocked: subject prefix, or a" >&2
          echo "  Blocked-WI: WI-<n> trailer for a blocked disposition." >&2
          exit 1
        fi
        ;;
    esac
    ;;
esac

# Fail-closed guard for the skips below (M-42, same as pre-commit): a repo that
# declared docs/privacy-check `true` must never have its message scan skipped
# silently — parse the policy in pure sh (the pre-push pattern) and refuse.
# The trade, recorded: a privacy-checked repo cannot commit without a working
# Python 3 + findable scripts dir; a non-privacy repo keeps the free skip.
privacy_declared_true() {
  [ -f "$REPO_ROOT/docs/privacy-check" ] || return 1
  p=$(grep -v '^[[:space:]]*#' "$REPO_ROOT/docs/privacy-check" | grep -v '^[[:space:]]*$' | head -n 1 | tr -d '[:space:]' || true)
  [ "$p" = "true" ]
}

# Find a Python 3 interpreter (same probe as pre-commit: run it, don't just find
# it — Windows' Store alias resolves on PATH but exits nonzero). No Python =
# skip, consistent with pre-commit's process-check posture.
PY=""
for cand in python3 python; do
  if command -v "$cand" >/dev/null 2>&1 && "$cand" -c "" >/dev/null 2>&1; then
    PY="$cand"; break
  fi
done
if [ -z "$PY" ]; then
  if privacy_declared_true; then
    echo "commit-msg: docs/privacy-check is true but Python 3 is unavailable —" >&2
    echo "  the message scan cannot run, so refusing to skip it. FAILING CLOSED." >&2
    exit 1
  fi
  echo "commit-msg: Python 3 not found on PATH; skipping message scan." >&2
  exit 0
fi

# Locate the kit scripts dir honoring KIT_SCRIPTS_DIR (env / delegating wrapper)
# before the default scripts/ | Scripts/ — the harness-elsewhere layout WI-1.42
# gave pre-commit; the message scan must honor it too, or a repo with that
# layout silently never scans commit messages (REVIEW_GRIND_FULL C4).
SCRIPTS_DIR=""
if [ -n "${KIT_SCRIPTS_DIR:-}" ]; then
  case "$KIT_SCRIPTS_DIR" in
    /*) SCRIPTS_DIR="$KIT_SCRIPTS_DIR" ;;
    *)  SCRIPTS_DIR="$REPO_ROOT/$KIT_SCRIPTS_DIR" ;;
  esac
fi
if [ -z "$SCRIPTS_DIR" ] || [ ! -d "$SCRIPTS_DIR" ]; then
  SCRIPTS_DIR=""
  for sd in scripts Scripts; do
    if [ -d "$REPO_ROOT/$sd" ]; then
      SCRIPTS_DIR="$REPO_ROOT/$sd"; break
    fi
  done
fi
if [ -z "$SCRIPTS_DIR" ] || [ ! -d "$SCRIPTS_DIR" ]; then
  if privacy_declared_true; then
    echo "commit-msg: docs/privacy-check is true but the kit scripts dir cannot" >&2
    echo "  be found (KIT_SCRIPTS_DIR or scripts/), so the message scan cannot" >&2
    echo "  run — refusing to skip it. FAILING CLOSED." >&2
    exit 1
  fi
  echo "commit-msg: cannot find the kit scripts dir (KIT_SCRIPTS_DIR or scripts/) under $REPO_ROOT; skipping message scan." >&2
  exit 0
fi

# Scan the message file git handed us ($1). Nonzero exit aborts the commit.
"$PY" "$SCRIPTS_DIR/check_privacy.py" --root "$REPO_ROOT" --message "$1"
