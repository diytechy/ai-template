#!/bin/sh
# commit-msg hook — secrets + privacy scan of the commit MESSAGE (title + body).
#
# pre-commit runs before the message exists, so it can only scan the staged
# diff; the message body is unseen until push (pre-push --range reads history).
# That gap is how leaks in commit messages — a credential pasted into a body, an
# email in a trailer — pile up unnoticed across many commits before a push
# finally surfaces them. This hook closes it: git passes the prepared message
# file as $1, and a nonzero exit ABORTS the commit, so a leak is caught at the
# first commit, not the push.
#
# The script self-gates: the always-on SECRETS FLOOR scans every repo's message,
# and the PRIVACY layer adds its classes only when docs/privacy-check is `true`.
# Both off => it exits 0 fast (zero cost). Enabled by
# `git config core.hooksPath .githooks` (setup.sh / setup.ps1 already set it).
#
# One POSIX hook covers every platform (Git for Windows runs hooks through sh).
set -e

# Authoritative repo root (works when delegated from a wrapper elsewhere), with
# the .githooks/../ fallback — same as pre-commit.
REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || REPO_ROOT=$(cd "$(dirname "$0")/.." && pwd)

# (The WI-282 train-build trailer floor — pure sh over llm/train/* branches —
# retired with the dispatcher's reviewed_train_head at concurrency-restructure
# Phase 5: no llm/train/* branch exists to guard, and the integrator's verdict
# gate binds a review to its exact commit by git-derived freshness instead.)

# No step of this hook is ever skipped: a missing interpreter refuses
# (WI-880), and so does a missing kit scripts dir (WI-926), whatever the
# privacy policy or the loop marker says. A mixed or unreadable policy
# refuses too; the probe's kit_policy makes that one read, as it does for
# pre-commit and pre-push.

# THE LOOP PROVENANCE FLOOR (SR-209). A commit made from a process the
# unattended loop started carries the loop marker in its environment, and must
# end with a valid `Loop-Session:` trailer naming that session; a person's
# commit carries no marker and is never judged. The rule itself lives once, in
# Python (`check.py --loop-trailer`, over `kitlib.provenance`), run below; a
# commit whose floor cannot run is refused, marked or not. Hooks are opt-in
# per checkout, so the merge slot re-checks every commit of a lane's range
# whether or not this ran.

# The ONE interpreter every step below runs on, resolved once, here, by the
# probe all three kit hooks share (hooks/kit-python.sh, shipped beside this
# hook; WI-880). With no Python 3.11+ it refuses, naming dev-setup's install.
# Then kit_policy resolves the kit scripts dir (SCRIPTS_DIR) and makes the
# hooks' one policy read.
. "$(dirname "$0")/kit-python.sh"
kit_python commit-msg commit || exit 1
kit_policy commit-msg commit || exit 1

# The loop provenance floor: a no-op (exit 0) for a person's commit.
"$PY" "$SCRIPTS_DIR/check.py" --loop-trailer "$1"

# Scan the message file git handed us ($1). Nonzero exit aborts the commit.
"$PY" "$SCRIPTS_DIR/check_privacy.py" --root "$REPO_ROOT" --message "$1"
