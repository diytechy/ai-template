# docs/stack.ini — the product toolchain, declared ONCE.
#
# The single home for the format / lint / test commands, the source & test
# paths, the test tiers, and the coverage threshold. scripts/check.py reads
# this file; CI (.github/workflows/check.yml), the pre-commit hook, and
# scripts/setup.* delegate to it instead of restating a command — so a stack
# swap becomes editing THIS file, not hunting the same command across six
# copies (the single-source rule the kit preaches). Delete the file to fall
# back to check.py's built-in Python-reference defaults (identical to below).
#
# Placeholders expanded inside the commands:
#   {py}          the Python interpreter running check.py, so the venv python is
#                 enough — no activated venv / PATH entry needed. A non-Python
#                 stack names its own tool (npx, go, cargo, pwsh) instead.
#   {src} {tests} the [paths] values below.
#   {coverage}    the resolved coverage threshold (see [coverage]).
# A command that runs `{py} -m <module>` auto-declares <module> as a required
# import, so a missing tool is reported SKIP(missing) and fails the gate rather
# than silently passing. Any other executable's absence on PATH is the same
# designed failure (check.py resolves it the way the OS would).

[paths]
src = src
tests = tests

[product]
# Language-specific — swap for your stack (e.g. `npx prettier --check {src}`).
format = {py} -m ruff format --check {src} {tests}
lint = {py} -m ruff check {src} {tests}
# The BASE test command. check.py appends the [coverage] args at the covered
# tiers and the [tiers] selector below, so keep this just the runner invocation.
test = {py} -m pytest -q
# Parallel execution is an OPT-IN: appending `-n auto` runs the suite across all
# cores via pytest-xdist (a big win on a slow suite), but a suite with
# order-dependent or shared-state tests may not be xdist-safe — so opting in is a
# knowing act. When your suite is isolated (each test in tmp_path, no shared
# mutable files), uncomment the line below and add pytest-xdist to your dev-setup:
# test = {py} -m pytest -q -n auto

[tiers]
# The kit tiers are fixed (smoke | full | release | all); their *expressions*
# are yours. Each value is a stack-native selector appended to [product] test;
# empty = run everything. The reference uses pytest markers — a vitest repo
# might use a path (`tests/smoke`) or a project (`--project smoke`). An UNMARKED
# pytest test runs in full/release (the safe opt-out default — see pytest.ini).
smoke = -m smoke
full = -m "not release"
release =
all =

[coverage]
# Line-coverage threshold %, enforced at the full/release/all tiers only (the
# smoke subset isn't held to it). `--coverage N` on the check.py CLI overrides.
threshold = 80
# Appended to [product] test at the covered tiers; drop/replace for a
# non-pytest coverage tool.
args = --cov={src} --cov-report=term-missing --cov-fail-under={coverage}

[arch-map]
# The kit-owned code-map freshness step (gen_arch_map.py --check):
#   symbols  (default) the Python-AST symbol map + dependency diagram.
#   files    the stack-neutral one-row-per-file fallback — the honest choice
#            for a non-Python stack until it ports a symbol-level generator
#            (ADOPTING.md §3; the marker block is the contract). An explicitly
#            non-Python bootstrap (--stack node|go|rust|powershell) seeds it.
mode = symbols
# files mode only — whitespace-separated comment tokens whose first line is a
# file's summary, when yours isn't one of the defaults (# // --):
# comment-prefixes = # // --

# --- Generated-artifact set (the integrator's auto-resolution allowlist) ------
# The parallel-dispatch integrator (scripts/agent_dispatch.py) auto-resolves a
# composition conflict CONFINED to a generated artifact by REGENERATING it from
# the cleanly-merged sources instead of parking for a hand-merge — the kit's
# generated-not-hand-maintained principle applied to the merge. This section
# DECLARES that set (WI-235): it is the ONE home the integrator reads, so a
# downstream repo teaches the integrator its own generated artifacts here rather
# than forking vendored kit code. Each row:
#   <path> = <kind> [| <BEGIN marker> | <END marker>]
# `path` is an exact repo-relative path or a "/"-terminated directory prefix.
# `kind` selects the regenerator: trajectory | okf | status | archmap. OMIT the
# marker pair for a FULLY generated artifact (any conflict is regenerable); NAME
# the (BEGIN, END) pair for a PARTIALLY generated file where only the marked
# region regenerates and a conflict OUTSIDE it must still park (status.md's and
# architecture.md's hand-authored prose). An ABSENT section => these built-in
# defaults (byte-identical). A MALFORMED row => the integrator FAILS CLOSED and
# parks (an unparseable declaration must never widen auto-resolution). The skills
# index is deliberately absent: its neutral source lives only in the kit repo and
# its per-agent copies are hand-authored source that must PARK, not regenerate.
[generated]
PROJECT_STATE.html = trajectory
docs/okf/ = okf
docs/architecture.md = archmap | <!-- BEGIN GENERATED MODULE MAP --> | <!-- END GENERATED MODULE MAP -->
docs/status.md = status | <!-- BEGIN GENERATED STATUS --> | <!-- END GENERATED STATUS -->

# --- Run capabilities (the launcher menu) ------------------------------------
# The root run.cmd / run.sh / run.command launchers read this [run] section
# (via scripts/run_menu.py) and present the major capabilities an evaluator
# runs — so starting the product never means recalling a command (process.md §7,
# "the evaluator's rungs"). No args = a numbered menu; `run.sh <name>` = launch
# one directly; `run_menu.py --list` = the machine listing for an agent.
# Declare one `<name> = <command>` line per capability plus an optional
# `<name>.desc = <one line>`; each command is a full SHELL line, so a multi-step
# capability lives in a project script named here once. An absent/empty [run]
# section degrades to guidance + exit 1 (a pure library deletes the run.*
# launchers). Uncomment and edit:
# [run]
# serve = docker compose up -d && python -m webbrowser http://localhost:8080
# serve.desc = start the app and open its page
# iso = ./build_iso.sh
# iso.desc = build the bootable ISO and launch the burner

# --- Project-specific gate steps ---------------------------------------------
# Add gates your DOMAIN needs (duplicate-code, license-lint, capability or
# dataflow integrity, …) as `[step:<name>]` sections — check.py runs them
# alongside the built-in plan, so CI and the local harness pick them up with no
# code change. This is why check.py is take-wholesale on a re-sync: your custom
# gates live HERE, not hand-edited into the kit script. Each section:
#   command  (required) the command to run; {py}/{src}/{tests}/{coverage} expand
#            as above. A `{py} -m <mod>` command auto-fails on a missing module;
#            any other executable's absence on PATH is the same designed failure.
#   gates    (optional, default G3) space/comma list of G1|G2|G3 — which gates
#            require it (check.py --gate GN runs only that gate's steps).
#   layer    (optional, default product) process|product — the --list tag only.
# The name may not shadow a built-in step (format, lint, tests+coverage,
# traceability, …). Example (commented — delete the # to activate):
# [step:dup-code]
# command = {py} scripts/check_dupes.py {src}
# gates = G2 G3
#
# [step:license-lint]
# command = npx license-checker --production --failOn GPL
#
# TS/JS adopters: if you run SOURCES directly (Node native type-stripping, no
# `tsc` emit) with an esbuild/swc-transpiled test runner (vitest, jest+swc), add
# a typecheck gate — the test transpiler accepts non-erasable syntax (enums,
# parameter properties, namespaces) that the production loader REJECTS, so
# format+lint+tests can all pass while the built module fails to LOAD at runtime.
# (A project with a real `tsc` emit build already typechecks while building and
# has no gap — skip this.)
# [step:typecheck]
# command = npx --no-install tsc --noEmit
