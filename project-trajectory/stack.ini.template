# docs/stack.ini — the product toolchain, declared ONCE.
#
# The single home for the format / lint / test commands, the source & test
# paths, the test tiers, and the coverage threshold. scripts/check.py reads
# this file; CI (.github/workflows/check.yml), the pre-commit hook, and
# scripts/setup.* delegate to it instead of restating a command — so a stack
# swap becomes editing THIS file, not hunting the same command across six
# copies (the single-source rule the kit preaches). Delete the file to fall
# back to check.py's built-in Python-reference defaults (identical to below).
#
# Placeholders expanded inside the commands:
#   {py}          the Python interpreter running check.py, so the venv python is
#                 enough — no activated venv / PATH entry needed. A non-Python
#                 stack names its own tool (npx, go, cargo, pwsh) instead.
#   {src} {tests} the [paths] values below.
#   {coverage}    the resolved coverage threshold (see [coverage]).
#   {tier}        the test tier this run selected (smoke|full|release|all) — for
#                 a tier-sensitive [step:] such as the per-module coverage floor.
# A command that runs `{py} -m <module>` auto-declares <module> as a required
# import, so a missing tool is reported SKIP(missing) and fails the gate rather
# than silently passing. Any other executable's absence on PATH is the same
# designed failure (check.py resolves it the way the OS would).

[paths]
src = src
tests = tests

[product]
# Language-specific — swap for your stack (e.g. `npx prettier --check {src}`).
format = {py} -m ruff format --check {src} {tests}
lint = {py} -m ruff check {src} {tests}
# The BASE test command. check.py appends the [coverage] args at the covered
# tiers and the [tiers] selector below, so keep this just the runner invocation.
test = {py} -m pytest -q
# Parallel execution is an OPT-IN: appending `-n auto` runs the suite across all
# cores via pytest-xdist (a big win on a slow suite), but a suite with
# order-dependent or shared-state tests may not be xdist-safe — so opting in is a
# knowing act. When your suite is isolated (each test in tmp_path, no shared
# mutable files), uncomment the line below and add pytest-xdist to your dev-setup:
# test = {py} -m pytest -q -n auto

[tiers]
# The kit tiers are fixed (smoke | full | release | all); their *expressions*
# are yours. Each value is a stack-native selector appended to [product] test;
# empty = run everything. The reference uses pytest markers — a vitest repo
# might use a path (`tests/smoke`) or a project (`--project smoke`). An UNMARKED
# pytest test runs in full/release (the safe opt-out default — see pytest.ini).
smoke = -m smoke
full = -m "not release"
release =
all =

# --- CI moment -> tier: the ONE home for "which bar runs when" ---------------
# The human bar is tiered BY MOMENT, and the reference CI workflow
# (ci/check.yml -> .github/workflows/check.yml) mirrors it BY TRIGGER. That
# correspondence is what makes "CI runs the same harness you run" true PER
# MOMENT rather than as one command, so the table is declared HERE instead of
# living only in a YAML comment: raising or lowering CI scope becomes a
# reviewed edit to these rows, never a quiet workflow change. The rows below
# ARE the table — nothing else may restate it.
#   Each row: <ci-trigger> = <tier> | <the human moment it mirrors>
# `tier` is one of the [tiers] names above. The triggers are the three the
# reference workflow discriminates: `push` (a branch push that is not a tag),
# `pull_request`, and `tag` (a push of a version tag). Delete a row whose
# trigger your workflow does not fire; the moment half is required, because a
# row that names no human moment is a trigger->tier table, not this one.
#   WHAT IS PINNED, HONESTLY: the kit's own tests hold the SHIPPED reference
# workflow to this table (entry point, guard, tier and step label). Nothing the
# kit ships can reach YOUR copy of the workflow once you edit it — if that
# correspondence matters to you, add the equivalent pin to your own suite.
[ci-tiers]
push = smoke | the per-commit bar (CI sees the pushed tip)
pull_request = full | a work-item / slice close
tag = release | a release

[coverage]
# Line-coverage threshold %, enforced at the full/release/all tiers only (the
# smoke subset isn't held to it). `--coverage N` on the check.py CLI overrides.
threshold = 80
# Appended to [product] test at the covered tiers; drop/replace for a
# non-pytest coverage tool.
args = --cov={src} --cov-report=term-missing --cov-fail-under={coverage}

[arch-map]
# The kit-owned code-map freshness step (gen_arch_map.py --check):
#   symbols  (default) the Python-AST symbol map + dependency diagram.
#   files    the stack-neutral one-row-per-file fallback — the honest choice
#            for a non-Python stack until it ports a symbol-level generator
#            (ADOPTING.md §3; the marker block is the contract). An explicitly
#            non-Python bootstrap (--stack node|go|rust|powershell) seeds it.
mode = symbols
# files mode only — whitespace-separated comment tokens whose first line is a
# file's summary, when yours isn't one of the defaults (# // --):
# comment-prefixes = # // --

# --- Generated-artifact set (the trunk lane's declared ownership, §5.2) -------
# The COMPLETE set of generated/derived artifacts the TRUNK LANE owns
# (docs/concurrency-restructure.md §5.2): a work branch never commits these
# and is never freshness-gated on them (check.py skips those gates off-trunk);
# the serial integrator's RULING-6 audit permits them in non-merge trunk
# commits; `trunk_step.py --regen` re-derives the document families after each
# merge. This section is the ONE home for that declaration, so a downstream
# repo teaches the kit its own generated artifacts here rather than forking
# vendored code. Each row:
#   <path> = <kind> [| <BEGIN marker> | <END marker>]
# `path` is an exact repo-relative path or a "/"-terminated directory prefix.
# `kind` names the regenerator: trajectory | okf | status | archmap. OMIT the
# marker pair for a FULLY generated artifact; NAME the (BEGIN, END) pair for a
# PARTIALLY generated file where only the marked region regenerates
# (status.md's and architecture.md's hand-authored prose stays yours). An
# ABSENT section => these built-in defaults (byte-identical). The skills index
# is deliberately absent: its neutral source lives only in the kit repo and
# its per-agent copies are hand-authored source (WI-231).
#   A further DATA kind exists for files that are measured-and-classified
# rather than generated — re-stamped by hand with a reason (§5.3), never
# blindly regenerated:
#   linecounts `"<module>.py": <int>` line-count baselines whose rationale
#              comments are the ratchet's audit trail.
# Declare it if you keep such a file, e.g.:
#   tests/test_module_size_ratchet.py = linecounts
# It is not a built-in default: whether you keep a size ratchet at all is your
# choice, and the kit ships the MECHANISM, not your paths.
[generated]
PROJECT_STATE.html = trajectory
docs/okf/ = okf
docs/architecture.md = archmap | <!-- BEGIN GENERATED MODULE MAP --> | <!-- END GENERATED MODULE MAP -->
docs/status.md = status | <!-- BEGIN GENERATED STATUS --> | <!-- END GENERATED STATUS -->

# --- Session-engine dials (IF-068) — the single home -------------------------
# The session engine (scripts/agent_loop.py) reads its dials here so a
# one-dial change edits ONE file instead of the same value in each of the three
# agent-resume.{cmd,sh,command} launchers. agent_loop resolves each dial with
# the precedence: a CLI flag (--model/--model-map/--lanes) > the AGENT_* env
# slot the launcher exports > this section > the built-in default. A
# blank/absent key falls through — the model dials ship COMMENTED OUT (a fresh
# scaffold keeps them in the launchers, where a double-clicking user sees them
# next to the consent banner). (The dispatcher-era `jobs` worker-ceiling dial
# retired with the parallel dispatcher at concurrency-restructure Phase 5; a
# declared value is ignored.)
[agent-loop]
# The dispatcher's worker-lane ceiling (WI-381; docs/concurrency-v2.md §A4.3,
# ruled 2026-07-31). SEEDED AT 2 — the smallest count that proves the spine
# barrier, the merge slot and the refresh race are real on a fresh scaffold —
# and seeded VISIBLY, on this line you can read and change. An ABSENT key
# means 1 (serial): this file is yours after scaffolding and a kit re-sync
# never rewrites it, so an adopted repo that predates the dial stays exactly
# as serial as it was until it adds the line.
lanes = 2
# model = <strong-model>
# fallback {model} when managed routing is off (AGENT_MODEL).
# model-map = PLAN=<strong-model>,BUILD=<cheap-model>
# per-phase fallback (AGENT_MODEL_MAP).

# --- Run capabilities (the launcher menu) ------------------------------------
# The root run.cmd / run.sh / run.command launchers read this [run] section
# (via scripts/run_menu.py) and present the major capabilities an evaluator
# runs — so starting the product never means recalling a command (process.md §7,
# "the evaluator's rungs"). No args = a numbered menu; `run.sh <name>` = launch
# one directly; `run_menu.py --list` = the machine listing for an agent.
# Declare one `<name> = <command>` line per capability plus an optional
# `<name>.desc = <one line>`; each command is a full SHELL line, so a multi-step
# capability lives in a project script named here once. An absent/empty [run]
# section degrades to guidance + exit 1 (a pure library deletes the run.*
# launchers). Uncomment and edit:
# [run]
# serve = docker compose up -d && python -m webbrowser http://localhost:8080
# serve.desc = start the app and open its page
# iso = ./build_iso.sh
# iso.desc = build the bootable ISO and launch the burner

# --- Project-specific gate steps ---------------------------------------------
# Add gates your DOMAIN needs (duplicate-code, license-lint, capability or
# dataflow integrity, …) as `[step:<name>]` sections — check.py runs them
# alongside the built-in plan, so CI and the local harness pick them up with no
# code change. This is why check.py is take-wholesale on a re-sync: your custom
# gates live HERE, not hand-edited into the kit script. Each section:
#   command  (required) the command to run; {py}/{src}/{tests}/{coverage} expand
#            as above. A `{py} -m <mod>` command auto-fails on a missing module;
#            any other executable's absence on PATH is the same designed failure.
#   gates    (optional, default DevStg-Impl) space/comma list of DevStg-Reqs|DevStg-Tests|DevStg-Impl — which gates
#            require it (check.py --gate GN runs only that gate's steps).
#   layer    (optional, default product) process|product — the --list tag only.
# The name may not shadow a built-in step (format, lint, tests+coverage,
# traceability, …). Example (commented — delete the # to activate):
# [step:capability-integrity]
# command = {py} scripts/check_capabilities.py {src}
# gates = DevStg-Tests DevStg-Impl
#
# [step:license-lint]
# command = npx license-checker --production --failOn GPL
#

# Prose reference rot — a backticked repo path or a `sym:module.name` reference
# naming something that is no longer there (check_docs.py only proves markdown
# LINKS resolve). Warn-first by design, so TRIAGE BEFORE YOU WIRE IT: run it
# once, fix or classify what it finds, and only then add --strict here. A path
# that is missing for a mechanical reason is reported as UNTRACED, not dangling
# — it resolves under the kit root, the doc is a record surface (log/archive/
# reviews), or the path is declared with its reason in a declared-absences file
# (see --declared-absences; a repo lists there what it deliberately does not
# carry, e.g. an opt-in registry or a policy file whose absence IS the default).
# The untraced count always prints, so the classification's size stays visible.
# [step:doc-refs]
# command = {py} scripts/check_doc_refs.py --root . --strict
#
# Per-module coverage floors (the kit-owned comparator, stdlib-only): the global
# [coverage] threshold is one aggregate number, so a well-tested module can
# subsidize a thin high-risk one. Add `--cov-report=json` to [coverage] args so
# pytest-cov writes coverage.json, list `<module> <min percent>` lines in
# docs/coverage-floors (# comments allowed), and enable the step. The global
# --cov-fail-under stays the backstop. `--tier {tier} --skip-tiers smoke` makes
# the smoke tier (which measures no coverage) SKIP without reading the report,
# and check.py run-scopes coverage.json (clears a stale copy before the plan), so
# a prior full-tier report is never graded as a current pass at the smoke tier.
# The `lane` line serializes it AFTER tests+coverage (it reads that step's JSON)
# so it doesn't race under `check.py --jobs>1`; drop it if you run sequentially.
# [step:module-coverage]
# command = {py} scripts/check_coverage.py --tier {tier} --skip-tiers smoke
# lane = tests+coverage
#
# TS/JS adopters: if you run SOURCES directly (Node native type-stripping, no
# `tsc` emit) with an esbuild/swc-transpiled test runner (vitest, jest+swc), add
# a typecheck gate — the test transpiler accepts non-erasable syntax (enums,
# parameter properties, namespaces) that the production loader REJECTS, so
# format+lint+tests can all pass while the built module fails to LOAD at runtime.
# (A project with a real `tsc` emit build already typechecks while building and
# has no gap — skip this.)
# [step:typecheck]
# command = npx --no-install tsc --noEmit
