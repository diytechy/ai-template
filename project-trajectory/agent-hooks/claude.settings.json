{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/subagent_gate.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/gen_arch_map.py --check && python scripts/trace.py --strict-integrity"
          }
        ]
      }
    ]
  }
}
