+acceptance_criteria = """A comparative claim with no pinning predicate marker emits a stdout WARNING and a report line; the exit code is unchanged."""
+priority = "S"
+verification = "Test"
+status = "Verified"
+phase = 1
+area = "Traceability"
+
+[requirement.SR-005]
+title = "Off-spine registries stay traceable"
+sn_refs = ["SN-002", "SN-012"]
+requirement = """trace.py shall integrity-check the optional off-spine registries (PB/REPO/PART/ASSET, plus legacy MOD compatibility) and validate their back-links without blocking a project that does not use them."""
+rationale = """Realizes SN-002 (off-spine rows stay linked to the spine) and SN-012 (an unused optional registry costs nothing — its -000 row is ignored)."""
+acceptance_criteria = """A PB row whose Refs name no real SR/LLR/Module, or a REPO row (including a legacy MOD row) delegating an unknown SR, is a finding; a -000 example row in any of them is ignored."""
+priority = "S"
+verification = "Test"
+status = "Verified"
+phase = 1
+area = "Off-spine registries"
