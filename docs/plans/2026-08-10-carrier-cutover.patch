+[requirement.SR-017]
+title = "Always-on secrets floor"
+sn_refs = ["SN-009"]
+requirement = """check_privacy.py shall scan every commit's staged diff, message, and outgoing range for secret patterns regardless of the privacy toggle, unless docs/process.toml [policies] secrets_scan is explicitly false (the legacy docs/secrets-scan is still read through the migration window)."""
+rationale = """Realizes SN-009 — a credential that reaches a shared branch must be treated as disclosed and rotated, and expunging it from history is a rewrite every clone has to follow, so the cheap moment to catch it is before the commit and the expensive one is any moment after. Folding the scan into the privacy toggle was rejected: that makes the highest-severity check opt-in alongside a preference. The one opt-out is an explicit declaration, so turning it off is a visible act."""
+acceptance_criteria = """A staged PEM header, token, or key pattern is flagged and blocks; a clean diff passes; the floor runs with privacy-check off, and is disabled only by an explicit secrets_scan = false."""
+priority = "M"
+verification = "Test"
+status = "Modified"
+phase = 1
+area = "Secrets + privacy lint"
