{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0139EqmMUaBafnw7WX2PkAXU","type":"tool_result","content":"1\t#!/bin/sh\n2\t# commit-msg hook — secrets + privacy scan of the commit MESSAGE (title + body).\n3\t#\n4\t# pre-commit runs before the message exists, so it can only scan the staged\n5\t# diff; the message body is unseen until push (pre-push --range reads history).\n6\t# That gap is how leaks in commit messages — a credential pasted into a body, an\n7\t# email in a trailer — pile up unnoticed across many commits before a push\n8\t# finally surfaces them. This hook closes it: git passes the prepared message\n9\t# file as $1, and a nonzero exit ABORTS the commit, so a leak is caught at the\n10\t# first commit, not the push.\n11\t#\n12\t# The script self-gates: the always-on SECRETS FLOOR scans every repo's message,\n13\t# and the PRIVACY layer adds its classes only when docs/privacy-check is `true`.\n14\t# Both off => it exits 0 fast (zero cost). Enabled by\n15\t# `git config core.hooksPath .githooks` (setup.sh / setup.ps1 already set it).\n16\t#\n17\t# One POSIX hook covers every platform (Git for Windows runs hooks through sh).\n18\tset -e\n19\t\n20\t# Authoritative repo root (works when delegated from a wrapper elsewhere), with\n21\t# the .githooks/../ fallback — same as pre-commit.\n22\tREPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || REPO_ROOT=$(cd \"$(dirname \"$0\")/..\" && pwd)\n23\t\n24\t# WI-282: the train-build commit-message floor — pure sh, run FIRST so it holds\n25\t# even on a Python-less box (unlike the message scan below). On an llm/train/*\n26\t# branch a substantive build commit must carry a parseable `WI: WI-<n>` trailer:\n27\t# the exact property agent_dispatch.reviewed_train_head reads to resolve a train's\n28\t# reviewed head. A malformed block (e.g. a blank line interposed in the trailer\n29\t# paragraph) makes git DROP the trailer, so the integrator SKIPS the commit and\n30\t# can grade a stale verdict, parking an approved train as rework — a one-line slip\n31\t# that cost a full build+review cycle (live failure 2026-07-23, train\n32\t# p0-g3-WI-281-9ae9). `git interpret-trailers --parse` shares git's trailer parser\n33\t# with that %(trailers) read, so this refuses exactly what the integrator would\n34\t# later fail to resolve. Vacuous off a train branch; the sanctioned coordinator\n35\t# commits (integrate:/telemetry:/review:/blocked: subject prefix) and a blocked\n36\t# disposition (a Blocked-WI: trailer) stay legal. The prefix set mirrors\n37\t# agent_common.SANCTIONED_TRAIN_SUBJECT_PREFIXES (kept in step by\n38\t# tests/test_commit_msg_wi_trailer.py).\n39\twi_branch=$(git -C \"$REPO_ROOT\" symbolic-ref --quiet --short HEAD 2>/dev/null || true)\n40\tcase \"$wi_branch\" in\n41\t  llm/train/*)\n42\t    wi_subject=$(sed -n '1p' \"$1\")\n43\t    case \"$wi_subject\" in\n44\t      integrate:*|telemetry:*|review:*|blocked:*) : ;;  # sanctioned coordinator commit\n45\t      *)\n46\t        wi_trailers=$(git -C \"$REPO_ROOT\" interpret-trailers --parse \"$1\" 2>/dev/null || true)\n47\t        if printf '%s\\n' \"$wi_trailers\" | grep -qiE '^Blocked-WI:[[:space:]]'; then\n48\t          : # a blocked disposition carries Blocked-WI, not WI\n49\t        elif printf '%s\\n' \"$wi_trailers\" | grep -qE '^[Ww][Ii]:[[:space:]]*WI-[0-9]+[[:space:]]*$'; then\n50\t          : # a well-formed build commit\n51\t        else\n52\t          echo \"commit-msg: this build commit on train branch '$wi_branch' carries\" >&2\n53\t          echo \"  no parseable 'WI: WI-<n>' trailer. The integrator resolves a train's\" >&2\n54\t          echo \"  reviewed head as the newest commit whose git-parsed trailers include\" >&2\n55\t          echo \"  WI: (agent_dispatch.reviewed_train_head); a commit without it is\" >&2\n56\t          echo \"  SKIPPED, so a stale verdict can park an approved train as rework\" >&2\n57\t          echo \"  (WI-282; live failure 2026-07-23 on train p0-g3-WI-281-9ae9).\" >&2\n58\t          echo \"\" >&2\n59\t          echo \"  Fix: end the message with a trailer block whose LAST paragraph is\" >&2\n60\t          echo \"  trailers ONLY - no blank line inside it (a blank line there breaks\" >&2\n61\t          echo \"  git's trailer parsing; that is the exact slip this floor catches):\" >&2\n62\t          echo \"\" >&2\n63\t          echo \"      <subject line>\" >&2\n64\t          echo \"\" >&2\n65\t          echo \"      WI: WI-<n>\" >&2\n66\t          echo \"      Train: <train-id>\" >&2\n67\t          echo \"      Base: <base-sha>\" >&2\n68\t          echo \"\" >&2\n69\t          echo \"  A sanctioned dispatcher commit is exempt instead: use an\" >&2\n70\t          echo \"  integrate:/telemetry:/review:/blocked: subject prefix, or a\" >&2\n71\t          echo \"  Blocked-WI: trailer for a blocked disposition.\" >&2\n72\t          exit 1\n73\t        fi\n74\t        ;;\n75\t    esac\n76\t    ;;\n77\tesac\n78\t\n79\t# Fail-closed guard for the skips below (M-42, same as pre-commit): a repo that\n80\t# declared docs/privacy-check `true` must never have its message scan skipped\n81\t# silently — parse the policy in pure sh (the pre-push pattern) and refuse.\n82\t# The trade, recorded: a privacy-checked repo cannot commit without a working\n83\t# Python 3 + findable scripts dir; a non-privacy repo keeps the free skip.\n84\tprivacy_declared_true() {\n85\t  [ -f \"$REPO_ROOT/docs/privacy-check\" ] || return 1\n86\t  p=$(grep -v '^[[:space:]]*#' \"$REPO_ROOT/docs/privacy-check\" | grep -v '^[[:space:]]*$' | head -n 1 | tr -d '[:space:]' || true)\n87\t  [ \"$p\" = \"true\" ]\n88\t}\n89\t\n90\t# Find a Python 3 interpreter (same probe as pre-commit: run it, don't just find\n91\t# it — Windows' Store alias resolves on PATH but exits nonzero). No Python =\n92\t# skip, consistent with pre-commit's process-check posture.\n93\tPY=\"\"\n94\tfor cand in python3 python; do\n95\t  if command -v \"$cand\" >/dev/null 2>&1 && \"$cand\" -c \"\" >/dev/null 2>&1; then\n96\t    PY=\"$cand\"; break\n97\t  fi\n98\tdone\n99\tif [ -z \"$PY\" ]; then\n100\t  if privacy_declared_true; then\n101\t    echo \"commit-msg: docs/privacy-check is true but Python 3 is unavailable —\" >&2\n102\t    echo \"  the message scan cannot run, so refusing to skip it. FAILING CLOSED.\" >&2\n103\t    exit 1\n104\t  fi\n105\t  echo \"commit-msg: Python 3 not found on PATH; skipping message scan.\" >&2\n106\t  exit 0\n107\tfi\n108\t\n109\t# Locate the kit scripts dir honoring KIT_SCRIPTS_DIR (env / delegating wrapper)\n110\t# before the default scripts/ | Scripts/ — the harness-elsewhere layout WI-1.42\n111\t# gave pre-commit; the message scan must honor it too, or a repo with that\n112\t# layout silently never scans commit messages (REVIEW_GRIND_FULL C4).\n113\tSCRIPTS_DIR=\"\"\n114\tif [ -n \"${KIT_SCRIPTS_DIR:-}\" ]; then\n115\t  case \"$KIT_SCRIPTS_DIR\" in\n116\t    /*) SCRIPTS_DIR=\"$KIT_SCRIPTS_DIR\" ;;\n117\t    *)  SCRIPTS_DIR=\"$REPO_ROOT/$KIT_SCRIPTS_DIR\" ;;\n118\t  esac\n119\tfi\n120\tif [ -z \"$SCRIPTS_DIR\" ] || [ ! -d \"$SCRIPTS_DIR\" ]; then\n121\t  SCRIPTS_DIR=\"\"\n122\t  for sd in scripts Scripts; do\n123\t    if [ -d \"$REPO_ROOT/$sd\" ]; then\n124\t      SCRIPTS_DIR=\"$REPO_ROOT/$sd\"; break\n125\t    fi\n126\t  done\n127\tfi\n128\tif [ -z \"$SCRIPTS_DIR\" ] || [ ! -d \"$SCRIPTS_DIR\" ]; then\n129\t  if privacy_declared_true; then\n130\t    echo \"commit-msg: docs/privacy-check is true but the kit scripts dir cannot\" >&2\n131\t    echo \"  be found (KIT_SCRIPTS_DIR or scripts/), so the message scan cannot\" >&2\n132\t    echo \"  run — refusing to skip it. FAILING CLOSED.\" >&2\n133\t    exit 1\n134\t  fi\n135\t  echo \"commit-msg: cannot find the kit scripts dir (KIT_SCRIPTS_DIR or scripts/) under $REPO_ROOT; skipping message scan.\" >&2\n136\t  exit 0\n137\tfi\n138\t\n139\t# Scan the message file git handed us ($1). Nonzero exit aborts the commit.\n140\t\"$PY\" \"$SCRIPTS_DIR/check_privacy.py\" --root \"$REPO_ROOT\" --message \"$1\"\n141\t"}]},"parent_tool_use_id":null,"session_id":"4e57370e-8fa5-48cc-ac58-efd3fa70d438","uuid":"7d20160c-a74b-473d-a75a-2e2d4a338a9a","timestamp":"2026-07-24T09:22:20.699Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\Projects\\ai-template-trains\\p0-g3-WI-282-eb40\\project-trajectory\\hooks\\commit-msg","content":"#!/bin/sh\n# commit-msg hook — secrets + privacy scan of the commit MESSAGE (titl
[... byte cap hit — full stream in out/run-logs/ ...]
 \"add\", str(wt), \"llm/train/t1\")\n+    tip = _commit_no_trailer(wt, \"WI-201: build (trailer slipped, no WI: trailer)\")\n+    reviewed = agent_dispatch.reviewed_train_head(repo, \"t1\", head)\n+    assert reviewed is None, \"no commit carries a WI trailer, so none resolves\"\n+    assert agent_dispatch._substantive_tip(repo, \"t1\", head) == tip\n+    journal = agent_loop._Journal(repo)\n+    agent_dispatch.warn_reviewed_head_slip(repo, journal, \"t1\", head, reviewed)\n+    slips = [e for e in _events(repo) if e.get(\"event\") == \"reviewed-head-trailer-slip\"]\n+    assert slips, \"a train with NO WI-trailered head must still journal the slip\"\n+    assert slips[0][\"reviewed\"] == \"(none)\"\n+    assert slips[0][\"build_tip\"] == tip[:12]\n+\n+\n # --- publication + the intent protocol --------------------------------------------","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
