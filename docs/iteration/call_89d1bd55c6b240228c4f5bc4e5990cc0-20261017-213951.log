l/parse/requested_path/render_requested/read_requested/REQUESTED_SUFFIX/OUTCOMES/write_binding/accepted/accepted_part/accepted_at/judged_rows/_named_line/unaccepted_refusal/REVIEWS/branch_verdicts/uncovered_refusal;row_rulings/ROW_RULINGS/blessed_rows/BLESS_TAG;call_succeeded;requested_for/bind_pending/bound_kinds/bind_requested;record_outcome\"","-detail = \"A combined class accepts only amendment:<id>, first-approval:<id> and done-when:<id> Adjudicates tokens; it composes each named class through compose with that section's verdict path in fixed amendment, first-approval, done-when order, and refuses whole if any section cannot compose. One parser reads machine lines one physical line at a time: every line whose first token is a machine keyword counts, complete or not, so a bare, split, bad-label, field-missing or declared-field-repeated line invalidates. The same module's review_line is the one reader of a review VERDICT line: exactly one case-insensitive VERDICT keyword line is accepted only as `VERDICT: <APPROVE|CHANGES-REQUESTED> findings=<digits>` with findings named once; the filing boundary refuses every other form and the merge reader treats it as no verdict. A combined sitting names exactly the kinds bound at reservation in <verdict>.requested, has exactly one kind-form lower-case section per bound kind and none other, and has across the whole file exactly one complete line per bound kind and one SITTING line, and no line for another kind; a single-kind verdict has no kind-form section and exactly one complete line for its kind. One binding records pending before either route calls: the coordinator entry point binds the request exclusively at reservation, and the loop binds its composed request at composition; write_binding is its one writer and record_outcome its one route recorder and commit path, returning its `(outcome, why)` decision and recording accepted only when call_succeeded has derived exit 0, no timeout and no reported error result, and validation passes. call_succeeded is derived once and shared by both routes; a failed call is recorded failed without its verdict being read, and the loop consumes that same why as its completion obligation. The coordinator validates its pending binding before recording its outcome, while the loop records against the kinds read back from its bound request; later consumers use the accepted-verdict reader, which returns only an accepted, bound, valid verdict and each part's row rulings. Every row an adjudication merge act flips needs an APPROVE ruling in an accepted first-approval part, and every row it re-attests needs a MEANING or CLARITY ruling in an accepted amendment part among the branch's own bindings, whether or not the act names a verdict; an accepted verdict over other rows authorizes nothing, and a named verdict must judge each row its act re-attests. Failed, pending, unbound or other-class verdicts cover nothing. Ordinary and mixed lanes consume the same claimed-row reader at the merge: raw scope parsing, the complete acted set including ledger-only approvals, and the route’s normalized brief cannot give one consumer authority another does not see. Token and section parsing are shared by composition, validation, act scopes and merge-time minting; the class is routed and retainable through BRIEF_PROMPTS. An amendment verdict's `- [MEANING+BLESS]` row tag reads MEANING to every rulings reader, and a dedicated reader returns only rows so marked, treating a row without the mark or also tagged plain MEANING or CLARITY as not blessed.\"","-rationale = \"A shared checkpoint reduces adjudication launches only if no constituent judgement loses its scope or grammar. One parser prevents composition, validation and later acts from interpreting the same sitting differently.\"","+detail = \"A combined class accepts only amendment:<id>, first-approval:<id> and done-when:<id> Adjudicates tokens; it composes each named class through compose with that section's verdict path in fixed amendment, first-approval, done-when order, and refuses whole if any section cannot compose. One parser reads machine lines one physical line at a time: every line whose first token is a machine keyword counts, complete or not, so a bare, split, bad-label or field-missing line invalidates. The same module's review_line is the one reader of a review VERDICT line: exactly one case-insensitive VERDICT keyword line is accepted only as `VERDICT: <APPROVE|CHANGES-REQUESTED> findings=<digits>`; the filing boundary refuses every other form and the merge reader treats it as no verdict. A combined sitting names exactly the kinds bound at reservation in <verdict>.requested, has exactly one kind-form lower-case section per bound kind and none other, and has across the whole file exactly one complete line per bound kind and one SITTING line, and no line for another kind; a single-kind verdict has no kind-form section and exactly one complete line for its kind. One binding records pending before either route calls: the coordinator entry point binds the request exclusively at reservation, and the loop binds its composed request at composition; write_binding is its one writer and record_outcome its one route recorder and commit path, returning its `(outcome, why)` decision and recording accepted only when call_succeeded has derived exit 0, no timeout and no reported error result, and validation passes. call_succeeded is derived once and shared by both routes; a failed call is recorded failed without its verdict being read, and the loop consumes that same why as its completion obligation. The coordinator validates its pending binding before recording its outcome, while the loop records against the kinds read back from its bound request; later consumers use the accepted-verdict reader, which returns only an accepted, bound, valid verdict and each part's row rulings. Every row an adjudication merge act flips needs an APPROVE ruling in an accepted first-approval part, and every row it re-attests needs a MEANING or CLARITY ruling in an accepted amendment part among the branch's own bindings, whether or not the act names a verdict; an accepted verdict over other rows authorizes nothing, and a named verdict must judge each row its act re-attests. Failed, pending, unbound or other-class verdicts cover nothing. Ordinary and mixed lanes consume the same claimed-row reader at the merge: raw scope parsing, the complete acted set including ledger-only approvals, and the route’s normalized brief cannot give one consumer authority another does not see. Token and section parsing are shared by composition, validation, act scopes and merge-time minting; the class is routed and retainable through BRIEF_PROMPTS. An amendment verdict's `- [MEANING+BLESS]` row tag reads MEANING to every rulings reader, and a dedicated reader returns only rows so marked, treating a row without the mark or also tagged plain MEANING or CLARITY as not blessed.\"","+rationale = \"A shared checkpoint reduces adjudication launches only if no constituent judgement loses its scope or grammar. One parser prevents composition, validation and later acts from interpreting the same sitting differently. An adjudication machine line that repeats a declared field reads its last copy; only a model writing the same field twice on one line produces that form, which is outside the bound of lines the kit’s reviewer and adjudicator routes write.\""," test_refs = \"TC-327; TC-331; TC-368\""," status = \"Approved\""," component = \"CMP-008\""]}]},{"filePath":"C:\\Projects\\ai-template.wt\\wi-929\\docs\\archive\\last_approved\\docs\\test\\test-cases.toml","hunks":[{"oldStart":3334,"oldLines":9,"newStart":3334,"newLines":9,"lines":[" [test.TC-327]"," verifies = [\"SR-156\", \"SR-232\", \"LLR-308\", \"LLR-310\", \"IF-115\", \"IF-287\"]"," level = \"Integration\"","-method = \"Run test_the_done_when_brief_binds_the_digest_the_holds_compute, test_the_done_when_brief_refuses_an_unchanged_done_when, test_th