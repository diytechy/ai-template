{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018Vkwp5iFzxAANSpUnYYmjd","type":"tool_result","content":"1001-    # WI-203: OWNER_SCRATCHPAD.md is perpetually owner-edited, so the loop's\n1002-    # dirty-tree signal drops it — the raw primitive still counts it, but the\n1003-    # substantive view (used by the resume note + done detection) reads clean.\n1004-    loop = load_script(\"agent_loop\")\n1005-    repo = tmp_path / \"r\"\n1006-    repo.mkdir()\n1007-    _git(repo, \"init\")\n1008-    _git(repo, \"config\", \"user.email\", \"a@b.com\")\n1009-    _git(repo, \"config\", \"user.name\", \"A\")\n1010-    (repo / \"OWNER_SCRATCHPAD.md\").write_text(\"notes\\n\", encoding=\"utf-8\")\n1011-    (repo / \"a.txt\").write_text(\"hi\\n\", encoding=\"utf-8\")\n1012-    _git(repo, \"add\", \"-A\")\n1013-    _git(repo, \"commit\", \"-q\", \"-m\", \"seed\")\n1014-    # only the owner scratchpad is dirty -> raw sees it, substantive does not\n1015-    (repo / \"OWNER_SCRATCHPAD.md\").write_text(\"edited\\n\", encoding=\"utf-8\")\n1016-    assert len(loop.working_tree_dirty(repo)) == 1  # the primitive stays honest\n1017-    assert loop.substantive_working_tree_dirty(repo) == []  # the loop reads clean\n1018-    # a real deliverable still counts; the scratchpad is still dropped\n1019-    (repo / \"a.txt\").write_text(\"changed\\n\", encoding=\"utf-8\")\n1020-    sub = loop.substantive_working_tree_dirty(repo)\n1021-    assert len(sub) == 1 and \"a.txt\" in sub[0]\n1022-    assert len(loop.working_tree_dirty(repo)) == 2  # raw counts both\n1023-\n1024-\n1025-def test_owner_scratchpad_dirty_at_start_injects_nothing(loop_repo):\n1026-    # WI-203: an owner-only-dirty tree at loop start is NOT interrupted residue —\n1027-    # no WI-076 reconcile note, no dirty line logged (the prompt stays\n1028-    # byte-identical to the clean default), so the note fires only on real residue.\n1029-    repo, ctl, template = loop_repo\n1030-    (ctl / \"actions.txt\").w