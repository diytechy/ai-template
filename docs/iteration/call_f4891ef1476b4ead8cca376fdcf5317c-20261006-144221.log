dStart":3229,"oldLines":13,"newStart":3229,"newLines":13,"lines":[" phase = 6"," "," [design.LLR-306]","-sr_refs = [\"SR-231\"]","+sr_refs = [\"SR-227\", \"SR-231\"]"," title = \"Coordinator adjudication entry attributes a current verdict to its claimed lane call\""," module = \"project-trajectory/scripts/coordinator_adjudicate.py\""," code_symbol = \"DEFAULT_ROUTE/resolve_route/lane_refusal/reserve_verdict/adjudicate/signin/main\""," detail = \"\"\"ENTRY. coordinator_adjudicate runs only from a claimed lane worktree and otherwise refuses before launch through IF-284. It also refuses an unusable route or unreadable or undecodable brief through that interface. As its last pre-launch check it creates the verdict path's missing parent directories and then the path itself, empty and exclusively, so an existing or concurrently reserved path, or one whose parent cannot be created, also refuses; a refused call removes its empty reservation and leaves any directory it created. Otherwise it composes the shared request, plans the keep, launches and records an ADJUDICATE call with coordinator attribution, and prints the IF-285 reading. A non-zero exit or timeout returns the failed-call outcome through IF-284 without reading the verdict; after a successful in-deadline call, an empty reservation is a missing verdict with that outcome. A launched call leaves its verdict file, empty or written, for inspection. The default route and every command outcome are declared by IF-283 and IF-284, and the command also exposes a sign-in reading.\"\"\"","-rationale = \"The coordinator's adjudication evidence needs one attributable boundary: a call outside its claimed lane could commit telemetry on trunk, and a path not exclusively reserved for this call could carry an earlier call's verdict. The entry point therefore owns admission and evidence freshness, while IF-283, IF-284 and IF-285 each own the command contract they expose; copying those contracts here was rejected because two homes for the same route or exit condition would drift.\"","+rationale = \"This one entry point serves SR-227's coordinator-route and sign-in obligations as well as SR-231's lane-local admission and evidence-freshness boundary: a call outside its claimed lane could commit telemetry on trunk, and a path not exclusively reserved for this call could carry an earlier call's verdict. The entry point therefore owns admission and evidence freshness, while IF-283, IF-284 and IF-285 each own the command contract they expose; copying those contracts here was rejected because two homes for the same route or exit condition would drift.\""," test_refs = \"(see TC-321)\"","-status = \"Drafted\"","+status = \"Approved\""," component = \"CMP-008\""," phase = 6"]}]},{"filePath":"C:\\Projects\\ai-template.wt\\wi-835\\docs\\archive\\last_approved\\docs\\requirements\\system-requirements.toml","hunks":[{"oldStart":1723,"oldLines":10,"newStart":1723,"newLines":10,"lines":[" hat_refs = [\"UNATTENDED-OPS\", \"INTEGRITY-RECOVERABILITY\"]"," requirement = \"The delivered coordinator adjudication entry point shall, regardless of the declared adjudicator retention dial, run only from a claimed lane worktree and read success only from a verdict that its own call wrote within that call's deadline.\""," rationale = \"A DERIVED requirement, and labelled so. SN-025 asks that a configured agent progress without a human curating what comes next; it does not state the entry boundary for an adjudication the coordinator starts, so this obligation arrives through two lenses. The unattended-operations lens listens for a run whose telemetry lands on trunk instead of the claimed work it judges, leaving a later reader unable to recover its work item context. The integrity lens listens for stale evidence being accepted as this call's success: a verdict left by an earlier or overdue call can make an unsuccessful current call look valid. A lane-local call that owns a fresh verdict reservation was chosen over trusting a caller-supplied path or a shared trunk record, because both leave the evidence's author and time ambiguous. Fed back to the need: SN-025's acceptance could name attributable, current adjudication evidence as part of unattended progress; until it does, this row is derived and says so.\"","-acceptance_criteria = \"At every retention-dial value, a coordinator adjudication from the primary checkout, an unclaimed worktree or outside a repository refuses before launch; a valid claimed lane exclusively reserves a new verdict path, creating missing parent directories, and only one concurrent call can claim it; a refusal releases its empty reservation; a successful call returns success only for a valid verdict it wrote before its deadline; and a failed, timed-out, missing or invalid verdict never returns success.\"","+acceptance_criteria = \"At every retention-dial value, a coordinator adjudication from the primary checkout, an unclaimed worktree or outside a repository refuses before launch; a valid claimed lane exclusively reserves a new verdict path and only one concurrent call can claim it; a successful call returns success only for a valid verdict it wrote before its deadline; and a failed, timed-out, missing or invalid verdict never returns success.\""," priority = \"S\""," verification = \"Test\"","-status = \"Drafted\"","+status = \"Approved\""," phase = 6"," form = \"interface\""," "]}]},{"filePath":"C:\\Projects\\ai-template.wt\\wi-835\\docs\\archive\\last_approved\\docs\\test\\test-cases.toml","hunks":[{"oldStart":3243,"oldLines":14,"newStart":3243,"newLines":14,"lines":[" "," "," [test.TC-321]","-verifies = [\"SR-231\", \"LLR-306\", \"IF-283\", \"IF-284\", \"IF-285\"]","+verifies = [\"SR-227\", \"SR-231\", \"LLR-306\", \"IF-283\", \"IF-284\", \"IF-285\"]"," level = \"Unit\"","-method = \"Run test_the_coordinator_route_writes_one_session_log_per_call, test_an_unknown_route_or_one_off_the_enable_list_is_refused, test_a_missing_or_malformed_verdict_is_reported_and_f