guration directory; only token-account homes are created, empty, and provider authentication state is never read, moved, copied or deleted; Codex rollout telemetry is the LLR-267 exception. Entry identity governs cooldowns and planner routing; retained-record identity is defined by LLR-270, including account and lease-only records. The declared-token adjudicator and developer setup report its account; an unverified non-ambient Claude login is printed, not refused.\""," rationale = \"A family is not a credential boundary. Resolving the account once with the entry prevents launch paths from reconstructing authority from family or ambient state and keeps provider authentication outside the checkout.\""," test_refs = \"(see TC-361, TC-362, TC-363, TC-364, TC-365, TC-366)\"","-status = \"Drafted\"","+status = \"Approved\""," component = \"CMP-008\""," phase = 6"," "]}]},{"filePath":"C:\\Projects\\ai-template.wt\\wi-798\\docs\\archive\\last_approved\\docs\\test\\test-cases.toml","hunks":[{"oldStart":3553,"oldLines":7,"newStart":3553,"newLines":7,"lines":[" expected = \"Account declaration has no ambient fallback.\""," automated = \"Yes\""," evidence = \"tests/test_accounts.py::test_account_tables_load_and_a_qualified_entry_carries_its_account; tests/test_accounts.py::test_a_malformed_account_table_is_an_error_naming_it_and_is_dropped; tests/test_accounts.py::test_two_accounts_naming_one_token_variable_are_both_dropped; tests/test_accounts.py::test_a_malformed_qualifier_is_an_enable_list_error_never_the_unqualified_entry; tests/test_accounts.py::test_route_and_account_environments_that_collide_are_refused; tests/test_accounts.py::test_an_unreadable_enable_list_is_an_error_and_an_absent_one_is_routing_off; tests/test_accounts.py::test_the_loop_fails_preflight_on_an_account_or_qualifier_error; tests/test_accounts.py::test_a_preference_may_name_a_qualified_entry; tests/test_accounts.py::test_a_qualified_entry_launches_on_every_template_form_the_launcher_reads; tests/test_acco