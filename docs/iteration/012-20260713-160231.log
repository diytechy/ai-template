# Subprocess-aware coverage for the meta-repo self-tests (IMPROVEMENT_PLAN.md
# Thread 47 phase 6). The suite runs the kit scripts as SUBPROCESSES (bootstrap a
# temp scaffold, then run the real command in it), so most coverage is produced
# by child processes running the scaffold's *copied* scripts from a temp dir.
# tests/conftest.run_py wires each child (COVERAGE_PROCESS_START + the
# tests/_cov/sitecustomize.py that calls coverage.process_startup()) when
# pytest-cov is active, sharing pytest-cov's datafile so the parallel data lands
# in one place for the session-end combine.
[run]
parallel = true
# No `source` here on purpose: a child runs the scaffold's copied script from a
# temp dir, and `source` is applied at TRACE time against that real temp path, so
# it would exclude every child entirely. Children trace freely; the REPORT is
# scoped by the parent's --cov=project-trajectory/scripts (COV_CORE_SOURCE), and
# the [paths] map below folds each temp-scaffold */scripts/ copy back onto the
# source tree at combine time.

[paths]
scripts =
    project-trajectory/scripts/
    */scripts/

[report]
# Scope the report (and so --cov-fail-under) to the PRODUCT only. A child traces
# freely (no [run] source — see above), so it also records temp-scaffold fixtures
# it spawns (e.g. agent_loop's fake_agent.py). Those keep their temp path (they are
# not under a */scripts/ dir, so [paths] does not fold them onto the source tree),
# while the real script copies are remapped to project-trajectory/scripts/. This
# omit runs AFTER that remap, so it drops the fixtures without touching the scripts.
# A [run] omit could not: the script copies live under the same pytest tmp dir.
omit =
    */pytest-of-*/*
    */tmp*/*
# Subprocess-aware coverage for the meta-repo self-tests (IMPROVEMENT_PLAN.md
# Thread 47 phase 6). The suite runs the kit scripts as SUBPROCESSES (bootstrap a
# temp scaffold, then run the real command in it), so most coverage is produced
# by child processes running the scaffold's *copied* scripts from a temp dir.
# tests/conftest.run_py wires each child (COVERAGE_PROCESS_START + the
# tests/_cov/sitecustomize.py that calls coverage.process_startup()) when
# pytest-cov is active, sharing pytest-cov's datafile so the parallel data lands
# in one place for the session-end combine.
#
# Combine race + debris (WI-105 / the 2026-07-12b review's M9/L1): children write
# their `.coverage.*` parallel files next to pytest-cov's datafile at the repo
# root, the same glob the xdist master erases at start and combines at end. On the
# old-local pytest-cov 4.1.0 that shared glob raced (workers mis-erasing mid-write
# -> WinError 32; a mid-combine delete -> FileNotFoundError INTERNALERROR), losing
# children from the combine (~91% -> ~82%) and leaving debris behind. The WI-104
# pin closes it: on the pinned toolchain (pytest-cov ~=7 / ~=5) the master erases
# stale `.coverage.*` at session start (verified: a seeded stale file is consumed)
# so an aborted run self-heals, and a full-suite run measures a clean ~91% with
# zero debris left at root. The `[coverage] threshold = 85` in docs/stack.ini is
# the regression sensor if that ever silently breaks again. Pointing children at a
# dedicated data DIRECTORY (to unshare the glob structurally) was considered and
# declined: pytest-cov's session-end combine only merges parallel files beside its
# own datafile, so a separate dir needs an explicit combine step that risks
# dropping the subprocess coverage the ~91% depends on — a poor trade once the pin
# already makes the shared-glob path clean.
[run]
parallel = true
# No `source` here on purpose: a child runs the scaffold's copied script from a
# temp dir, and `source` is applied at TRACE time against that real temp path, so
# it would exclude every child entirely. Children trace freely; the REPORT is
# scoped by the parent's --cov=project-trajectory/scripts (COV_CORE_SOURCE), and
# the [paths] map below folds each temp-scaffold */scripts/ copy back onto the
# source tree at combine time.

[paths]
scripts =
    project-trajectory/scripts/
    */scripts/

[report]
# Scope the report (and so --cov-fail-under) to the PRODUCT only. A child traces
# freely (no [run] source — see above), so it also records temp-scaffold fixtures
# it spawns (e.g. agent_loop's fake_agent.py). Those keep their temp path (they are
# not under a */scripts/ dir, so [paths] does not fold them onto the source tree),
# while the real script copies are remapped to project-trajectory/scripts/. This
# omit runs AFTER that remap, so it drops the fixtures without touching the scripts.
# A [run] omit could not: the script copies live under the same pytest tmp dir.
omit =
    */pytest-of-*/*
    */tmp*/*
