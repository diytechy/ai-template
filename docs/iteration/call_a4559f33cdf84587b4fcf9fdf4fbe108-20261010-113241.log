{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011sVSTzojTpM8HLekHkfLbM","type":"tool_result","content":"diff --git a/docs/requirements/interfaces.toml b/docs/requirements/interfaces.toml\nindex c7a64183..c04c67d9 100644\n--- a/docs/requirements/interfaces.toml\n+++ b/docs/requirements/interfaces.toml\n@@ -802,17 +802,17 @@ status = \"Drafted\"\n \n [interface.IF-046]\n owner = \"scripts/score_reviews\"\n-requestors = [\"scripts/agent_loop\", \"scripts/integrate\", \"scripts/gen_verdict_rollup\", \"scripts/kitlib/verdict\", \"scripts/plan_coverage\"]\n+requestors = [\"scripts/agent_loop\", \"scripts/dispatch\", \"scripts/integrate\", \"scripts/gen_verdict_rollup\", \"scripts/kitlib/verdict\", \"scripts/plan_coverage\", \"scripts/review_brief\"]\n channel = \"call\"\n-data = \"parse_verdict: typed verdict findings, with a verdict word and declared count taken only from the shared strict review-line reader, neither returned when that reader refuses; substance, merge_verdict, fired_trip\n+data = \"parse_verdict: typed verdict findings, where a finding is a bullet whose bracket names one of the module's declared SEVERITIES (BLOCKER, MAJOR, MINOR), without regard to case; its verdict word and declared count\n version = \"v1\"\n status = \"Drafted\"\n \n [interface.IF-047]\n owner = \"docs/reviews/\"\n-consumers = [\"scripts/score_reviews\", \"scripts/check_trajectory\", \"scripts/integrate\", \"scripts/kitlib/verdict\", \"scripts/gen_verdict_rollup\"]\n+consumers = [\"scripts/score_reviews\", \"scripts/check_trajectory\", \"scripts/integrate\", \"scripts/kitlib/verdict\", \"scripts/gen_verdict_rollup\", \"scripts/plan_coverage\", \"scripts/review_brief\"]\n channel = \"file\"\n-data = \"VERDICT: APPROVE | CHANGES-REQUESTED findings=N\"\n+data = \"VERDICT: APPROVE | CHANGES-REQUESTED findings=N; finding is - [BLOCKER|MAJOR|MINOR] <text>, case-insensitive; another bracketed bullet is prose.\"\n version = \"v1\"\n status = \"Drafted\"\n notes = \"\"\"Low fan-out, and the set is still closed and nameable: check_trajectory (_latest_critique_verdict), score_reviews (this row, read_scoreboard/record_round), kitlib/verdict (the round-file NAME grammar and the \ndiff --git a/project-trajectory/RESYNC_PACK.md b/project-trajectory/RESYNC_PACK.md\nindex 245f4942..6e7a1b0b 100644\n--- a/project-trajectory/RESYNC_PACK.md\n+++ b/project-trajectory/RESYNC_PACK.md\n@@ -7941,6 +7941,31 @@ hooks --example .claude/settings.json.example --enable` run on a Python 3.11+\n interpreter (the hooks are bound to the interpreter that runs it). A machine\n that has not opted in runs no guard hooks. No registry or setting changes.\n \n+### A review's finding line names a declared severity [since 8d75bc6c]\n+\n+*(Anchored at the preceding commit: the change lands in the commit after it.)*\n+\n+**What changed.** `scripts/score_reviews.py` declares the finding severities\n+once, as `SEVERITIES` (`BLOCKER`, `MAJOR`, `MINOR`), and its `parse_verdict`\n+counts a line as a finding only when its bracket names one of them, in any\n+case. Before, any bracketed word at a bullet's start counted, so a reviewer's\n+coverage bullet such as `- [run] lines: ...` read as a finding of severity\n+`RUN`. That made `review_brief.py file` refuse a `findings=3` review as\n+carrying 4, and made `plan_coverage.py --findings` number every later finding\n+one off. Any other bracketed word is now prose, in every reader that goes\n+through `parse_verdict`: the filing check, the coverage gate's F1..Fn, the\n+loop's routing and scoring, the merge gate and the verdict rollup. A critique's\n+`- [TC-HARDEN] ...` proposal was never a finding and still is not.\n+\n+**Kit-owned files — overwrite:** `scripts/score_reviews.py`.\n+\n+**What to do.** Nothing needs migrating, and no setting or registry changes.\n+If your own reviewer or critique prompts (an operator `--prompt-map` override)\n+state a finding grammar, it should name the same three severities: a line\n+bracketed with any other word is no longer counted. A committed round whose\n+`findings=N` was written to match a bracketed non-severity line now reads one\n+finding short; do not rewrite the record.\n+\n ## 5. Promotion: when this pack stops being prose\n \n This pack is deliberately **not** mechanized. Re-syncs are rare, every adopter is\ndiff --git a/project-trajectory/scripts/score_reviews.py b/project-trajectory/scripts/score_reviews.py\nindex 759ab928..ee8be7ef 100644\n--- a/project-trajectory/scripts/score_reviews.py\n+++ b/project-trajectory/scripts/score_reviews.py\n@@ -70,11 +70,25 @@ from pathlib import Path\n # aliased to the module-local name so no call site changes.\n from kitlib.config import utf8_console as _utf8_console\n from kitlib.sitting import review_line\n-from kitlib.verdict import declared_phases, effective_verdict\n+from kitlib.verdict import MINOR, declared_phases, effective_verdict\n+\n+# The declared severities, in the order the briefs state them: the ONE home of\n+# the finding grammar's bracket. The reviewer and critique templates write\n+# `- [BLOCKER|MAJOR|MINOR] ...` (a template cannot import this, so\n+# tests/test_prompts.py composes that text from this tuple and pins it), and\n+# FINDING_RE below is built from it. WI-888: the bracket used to accept any\n+# word, so a reviewer's `- [run] lines: ...` coverage bullet parsed as a finding\n+# of severity RUN and every reader counted one too many. Any other bracketed\n+# word at a bullet's start (`[run]`, a critique's `[TC-HARDEN]` proposal) is\n+# prose.\n+SEVERITIES = (\"BLOCKER\", \"MAJOR\", MINOR)\n \n # The finding line: \"- [SEVERITY] <anchor> -> issue -> change [-> @owner]\".\n+# The severity is matched without regard to case, as it always was.\n # Arrows may be \"->\" or the unicode arrow; we split on either.\n-FINDING_RE = re.compile(r\"^\\s*-\\s*\\[(?P<sev>[A-Za-z]+)\\]\\s*(?P<body>.+)$\")\n+FINDING_RE = re.compile(\n+    r\"^\\s*-\\s*\\[(?P<sev>(?i:{}))\\]\\s*(?P<body>.+)$\".format(\"|\".join(SEVERITIES))\n+)\n ARROW_RE = re.compile(r\"\\s*(?:->|→)\\s*\")\n MODEL_RE = re.compile(r\"^\\s*Model:\\s*(?P<model>.+?)\\s*$\", re.I)\n # An anchor of the shape file:line or file:line:col, or a bare path, or sym:...\n@@ -161,7 +175,7 @@ def _parse_anchor(token):\n \n def _finding(ln):\n     \"\"\"The `Finding` one verdict-block line carries, or None when it is not a\n-    finding line.\n+    finding line: one whose bracket names a declared severity (`SEVERITIES`).\n \n     Implements: SR-154, LLR-046\n     \"\"\"\ndiff --git a/tests/fixtures/review_with_coverage_bullet.md b/tests/fixtures/review_with_coverage_bullet.md\nnew file mode 100644\nindex 00000000..dd001ac7\n--- /dev/null\n+++ b/tests/fixtures/review_with_coverage_bullet.md\n@@ -0,0 +1,12 @@\n+Reviewed: {sha}\n+\n+Verified: drove the shipped launch path on a real interpreter.\n+\n+Coverage:\n+- [run] lines: TC-047 and the new real-interpreter regression pass for an older interpreter on PATH, with independently confirmed red-before behavior. POSIX shim execution is UNCOVERED here because sh fails before execu\n+- [TC-HARDEN] add a TC that launches through cmd's current-directory lookup.\n+\n+- [MAJOR] project-trajectory/scripts/run_menu.py:223 -> bare python is not exact on Windows when cmd's current-directory lookup is enabled -> make the launch boundary exclude current-directory lookup -> @Software-Engine\n+- [MAJOR] .claude/settings.json:1 -> the coordinator workstation has no guard hooks after the committed-hook removal -> complete the workstation opt-in before landing -> @Driver\n+- [MINOR] docs/requirements/system-requirements.toml:133 -> for clarity: SR-020 names the obsolete module -> name the shared probe -> @System-Engineer\n+VERDICT: CHANGES-REQUESTED findings=3\ndiff --git a/tests/test_plan_coverage.py b/tests/test_plan_coverage.py\nindex 4edf60af..eb072f82 100644\n--- a/tests/test_plan_coverage.py\n+++ b/tests/test_plan_coverage.py\n@@ -510,6 +510,20 @@ def test_the_shared_step_turns_a_real_verdict_into_F_clauses():\n     }\n \n \n+def test_a_bracketed_word_that_is_not_a_severity_never_shifts_the_F_ids():\n+    \"\"\"WI-888: a reviewer's `- [run] lines:` coverage bullet is prose, so the\n+    three findings after it are F1..F3, not F2..F4.\"\"\"\n+    import plan_coverage\n+\n+    text = (\n+        Path(__file__).parent / \"fixtures\" / \"review_with_coverage_bullet.md\"\n+    ).read_text(encoding=\"utf-8\")\n+    clauses = plan_coverage.finding_clauses(text)\n+    assert list(clauses) == [\"F1\", \"F2\", \"F3\"]\n+    assert clauses[\"F1\"].startswith(\"[MAJOR] project-trajectory/scripts/run_menu.py\")\n+    assert clauses[\"F3\"].startswith(\"[MINOR] docs/requirements/system-requirements\")\n+\n+\n def test_a_findings_file_mixing_both_shapes_is_malformed(tmp_path):\n     proc = write_single(tmp_path, plan=REWORK_PLAN, findings=FINDINGS + REVIEW)\n     assert proc.returncode == 2, proc.stdout + proc.stderr\ndiff --git a/tests/test_prompts.py b/tests/test_prompts.py\nindex e7b1a82e..24d2b0b6 100644\n--- a/tests/test_prompts.py\n+++ b/tests/test_prompts.py\n@@ -111,6 +111,19 @@ def test_the_three_engine_briefs_load_and_carry_their_load_bearing_clauses():\n     assert \"{brief}\" in critique and \"{verdict}\" in critique\n \n \n+def test_the_briefs_finding_grammar_names_the_parsers_severities():\n+    # WI-888: the severities a brief tells its reviewer to write are the set\n+    # the one finding parser reads, so the two cannot drift: the grammar is\n+    # composed here from `score_reviews.SEVERITIES`, never retyped. The two\n+    # briefs whose verdicts that parser reads carry it, and so does the method's\n+    # own statement of the review block.\n+    severities = load_script(\"score_reviews\").SEVERITIES\n+    grammar = \"- [{}] \".format(\"|\".join(severities))\n+    for key in (pr.REVIEWER, pr.CRITIQUE):\n+        assert grammar in pr.load(key), key\n+    assert grammar in (KIT / \"PROCESS.md\").read_text(encoding=\"utf-8\")\n+\n+\n def test_the_reviewer_brief_carries_the_construction_first_clause():\n     # WI-567: the finding contract requires, for any remedy that ADDS a check,\n     # guard, warn, or invariant, one clause naming why the defect cannot be made\ndiff --git a/tests/test_review_brief.py b/tests/test_review_brief.py\nindex 331b934e..07426719 100644\n--- a/tests/test_review_brief.py\n+++ b/tests/test_review_brief.py\n@@ -18,6 +18,8 @@ The command line's git reads and its success exit codes are driven on a real\n git repository in test_review_brief_git.py, which is slow-tier (it spawns git).\n \"\"\"\n \n+from pathlib import Path\n+\n import pytest\n from conftest import ROOT, load_script\n \n@@ -282,6 +284,20 @@ def test_a_filed_coordinator_review_appears_in_the_rollup(tmp_path):\n     assert \"| 2 | REVIEW-A | `abcdef0` | APPROVE | 0 |\" in text\n \n \n+def test_a_bracketed_word_that_is_not_a_severity_never_refuses_a_filing(tmp_path):\n+    # WI-888 (the WI-880 round-004 refusal): a `- [run] lines:` coverage bullet\n+    # beside three findings is a findings=3 review, filed as written.\n+    text = (\n+        (Path(__file__).parent / \"fixtures\" / \"review_with_coverage_bullet.md\")\n+        .read_text(encoding=\"utf-8\")\n+        .format(sha=SHA)\n+    )\n+    path = rb.file_review(tmp_path, \"wi-900\", text, SHA, \"full\")\n+    assert path.read_text(encoding=\"utf-8\") == text\n+    [(_path, rolled)] = rollup.targets(tmp_path)\n+    assert \"| 1 | REVIEW-A | `abcdef0` | CHANGES-REQUESTED | 3 |\" in rolled\n+\n+\n @pytest.mark.parametrize(\n     \"text, why\",\n     [\ndiff --git a/tests/test_score_reviews.py b/tests/test_score_reviews.py\nindex 171a97dc..027dc3c3 100644\n--- a/tests/test_score_reviews.py\n+++ b/tests/test_score_reviews.py\n@@ -2,6 +2,8 @@\n (score_reviews.py, WI-059). Every scored component is in [0,1]; severity hygiene\n and the tripwires are GATES, never scores; length never scores positively.\"\"\"\n \n+from pathlib import Path\n+\n import pytest\n from conftest import SCRIPTS, load_script, run_py\n \n@@ -367,3 +369,33 @@ def test_merged_routing_verdict_promotes_a_minor_only_round_and_says_so():\n         \"CHANGES-REQUESTED\"\n     )\n     assert said == []\n+\n+\n+# --- WI-888: a finding line is one whose bracket names a declared severity -----\n+\n+# The WI-880 round-004 shape, as a reviewer wrote it: a `- [run] lines:` coverage\n+# bullet beside three findings and `findings=3`. The open grammar read the\n+# bullet as a finding of severity RUN, so every reader counted four.\n+COVERAGE_REVIEW = (\n+    Path(__file__).parent / \"fixtures\" / \"review_with_coverage_bullet.md\"\n+).read_text(encoding=\"utf-8\")\n+\n+\n+def test_a_bracketed_word_that_is_not_a_severity_is_prose():\n+    v = score.parse_verdict(COVERAGE_REVIEW)\n+    assert [f.severity for f in v.findings] == [\"MAJOR\", \"MAJOR\", \"MINOR\"]\n+    assert v.declared_n == 3\n+    # Scored as the three findings it declares: no count-gaming tripwire, and\n+    # every one carries its change clause.\n+    assert score.fired_tripwires([v]) == []\n+    assert score.actionability(v) == 1.0\n+    # A critique's `- [TC-HARDEN]` proposal stays what it always was: not a\n+    # finding (the critique grammar's `findings=N` does not count it).\n+    assert not any(\"TC-HARDEN\" in f.raw for f in v.findings)\n+\n+\n+def test_every_declared_severity_reads_as_a_finding():\n+    for sev in score.SEVERITIES:\n+        for word in (sev, sev.lower()):\n+            found = score.parse_verdict(\"- [{}] src/a.py:1 -> x -> y\".format(word))\n+            assert [f.severity for f in found.findings] == [sev]","is_error":false}]},"parent_tool_use_id":null,"session_id":"7a511e73-e906-4589-9f31-ae73f8534ed7","uuid":"7ba5a8bc-08d7-48b7-ac57-9a3a30365380","timestamp":"2026-10-10T16:30:04.762Z","tool_use_result":{"stdout":"diff --git a/docs/requirements/interfaces.toml b/docs/requirements/interfaces.toml\nindex c7a64183..c04c67d9 100644\n--- a/docs/requirements/interfaces.toml\n+++ b/docs/r