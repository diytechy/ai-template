{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"\"C:\\\\Program Files\\\\PowerShell\\\\7\\\\pwsh.exe\" -Command \"@'\nimport hashlib\nimport pathlib\nimport re\npath = pathlib.Path('docs/requirements/low-level-requirements.toml')\nwith path.open('r', encoding='utf-8', newline='') as f:\n    text = f.read()\nsection = re.search(r'(?ms)\"'^'\"\\\\[design\\\\.LLR-153\\\\]\\\\n(?P<body>.*?)(?=\"'^'\"\\\\[|\\\\Z)', text)\nassert section, 'LLR-153 section missing'\nfield = re.search(r'(?ms)\"'^detail = \"\"\"(?P<value>.*?)\"\"\"$'\"', section.group('body'))\nassert field, 'LLR-153 detail triple-quoted field missing'\nold_value = field.group('value')\nassert hashlib.sha256(old_value.encode('utf-8')).hexdigest() == 'a1ff10e143af29f093065403ae48ea5d71ab3592093cfda23a4a8eb1f81c3305', 'LLR-153 detail old value changed'\nold = \\\"\\\"\\\"The command re-attests every row it names and never names a verdict, the act being the owner's, and the item states that the act copies the whole registry, so any other row of it unanchored when the owner acts is named beside them. Those rows leave the amendment row. Every other state writes nothing, and a row left over, one whose text differs from what its verdict bound or whose verdict bound none included, stays on the amendment row as any other record does.\\\"\\\"\\\"\nnew = \\\"\\\"\\\"The command re-attests every row it names and never names a verdict, the act being the owner's, and the item's option (a) directs the owner to name beside them any other row of the registry unanchored when the owner acts. Every other non-refusing state writes nothing, and a row left over, one whose text differs from what its verdict bound or whose verdict bound none included, stays on the amendment row as any other record does. Where a landing owes an open item, through this trigger or a drafted [open_item] table, and the open-items registry is not the TOML carrier, the mint refuses by naming the carrier, writes nothing, including any amendment row the same landing owes, and the merge stands; recovery is converting the carrier and then sweeping the range.\\\"\\\"\\\"\nassert old_value.count(old) == 1, 'LLR-153 disposition target does not occur exactly once'\nupdated = old_value.replace(old, new)\nresult = text[:section.start('body') + field.start('value')] + updated + text[section.start('body') + field.end('value'):]\nwith path.open('w', encoding='utf-8', newline='') as f:\n    f.write(result)\n'@ | & 'C:/Projects/ai-template/.venv/Scripts/python.exe' -\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
