e = f'{cell} = {old_value\"'!r}'\"'\n    new_line = f'{cell} = {new_value\"'!r}'\"'\n    own_block = block(texts[path], table)\n    assert own_block.count(old_line) == 1, f'{path} {table} {cell}: old value not unique in own table block'\n    assert texts[path].count(old_line) == 1, f'{path} {table} {cell}: old value not unique in file'\n    texts[path] = texts[path].replace(old_line, new_line, 1)\n\nfor path, text in texts.items():\n    assert '\\\\r' not in text, f'{path}: edit introduced CR'\n    with open(path, 'w', encoding='utf-8', newline='') as f:\n        f.write(text)\n\nfor path, (section, ident, allowed) in files.items():\n    with open(path, 'r', encoding='utf-8', newline='') as f:\n        after_text = f.read()\n    assert '\\\\r' not in after_text, f'{path}: not LF-only after write'\n    after = tomllib.loads(after_text)\n    assert isinstance(after[section][ident]['verifies'], list) if path.endswith('test-cases.toml') else True\n    for key in after:\n        assert after[key] == before[path][key], f'{path}: top-level section moved: {key}'\n    row_before = before[path][section][ident]\n    row_after = after[section][ident]\n    assert set(row_before) == set(row_after), f'{path}: cell set changed'\n    for cell in row_before:\n        expected = new_values.get((path, section, ident, cell), row_before[cell])\n        assert row_after[cell] == expected, f'{path}: unexpected movement in {section}.{ident}.{cell}'\n    for other_id, row in after[section].items():\n        if other_id \"'!= ident:\n            assert row == before[path][section][other_id], f'\"'{path}: unrelated row moved: {other_id}'\n\nassert isinstance(tomllib.loads(read('docs/test/test-cases.toml'))['test']['TC-399']['verifies'], list)\nprint('guarded UTF-8/LF edit passed: five cells changed; TOML parsed; list cell preserved; no other cells moved')\n'@ | & 'C:/Projects/ai-template/.venv/Scripts/python.exe' -\ngit diff --check\ngit diff -- docs/requirements/interfaces.toml docs/test/test