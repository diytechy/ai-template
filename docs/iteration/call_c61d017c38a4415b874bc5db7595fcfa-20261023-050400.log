r\n\r\n[perspective.PRODUCT-FITNESS]\r\napplicable = true\r\napplies_when = \"always\"\r\nproduced = []\r\nno_finding = \"The description floor serves the parent playbook need by making skill use discoverable, so no additional stakeholder outcome is identified.\"\r\n+boundary_refs = [\"B-02\", \"B-09\"]\r\n+hat_refs = [\"CONSISTENCY\"]\r\n+requirement = \"The delivered governance capability shall report every standing case in which an SR, LLR, or TC with Approved or Founded status cites a declared spine parent that lacks one of those statuses, naming the child, parent, and both statuses; refuse a staged or lane commit that moves either status into such a case while allowing an act that approves parent and child together and a commit that moves neither relevant status; treat no other status as approved; and exclude IF, B, DA, unknown, and -000 references from this judgement.\"\r\n+rationale = \"A DERIVED requirement, and labelled so. SN-002 requires mechanically verified traceability and SN-029 requires each approval to remain a review against the row's evidence, but neither states that a child approval must agree with its parent's approval. The consistency lens listens for related contracts that disagree: an approved child beneath an unapproved parent asserts a completed chain while its parent asserts the opposite. Reporting the standing state and refusing the status transition that creates it were selected over relying on a reader to compare four registries, because the same approval vocabulary must have one meaning at the standing and commit boundaries. Fed back to the needs: their acceptance could state that an approved trace chain contains no child whose cited parent remains unapproved.\"\r\n+acceptance_criteria = \"An Approved or Founded SR, LLR, or TC that cites a Drafted, missing-status, or unknown-status declared SN, SR, or LLR parent produces one integrity finding that names the child, parent, and both statuses, and strict integrity fails; a Founded parent does not produce that finding. A staged or lane commit that changes a child or parent status into such a case is refused, while an act that approves parent and child together passes and a commit that moves neither status passes over a standing case. IF, B, DA, unknown, and -000 references do not produce a parent-first finding.\"\r\n+priority = \"S\"\r\n+verification = \"Test\"\r\n+status = \"Drafted\"\r\n+phase = 6\r\n+aspect = \"process\"\r\ncd5292585\r\n\r\ndiff --git a/docs/requirements/system-requirements.toml b/docs/requirements/system-requirements.toml\r\nindex f5ff1692f..a921381f6 100644\r\n--- a/docs/requirements/system-requirements.toml\r\n+++ b/docs/requirements/system-requirements.toml\r\n@@ -1658,7 +1658,7 @@ rationale = \"\"\"A DERIVED requirement, and labelled so. SN-005 asks that agents a\r\n acceptance_criteria = \"A skill whose description is shorter than the declared floor fails the check, which names that skill and not a skill at the floor; a description at the floor passes; the kit's shipped skills clear the floor.\"\r\n priority = \"C\"\r\n verification = \"Test\"\r\n-status = \"Drafted\"\r\n+status = \"Approved\"\r\n phase = 6\r\n \r\n [requirement.SR-225]\r\n97f2e64e5\r\n\r\ndiff --git a/docs/requirements/system-requirements.toml b/docs/requirements/system-requirements.toml\r\nindex cb7933f83..f5ff1692f 100644\r\n--- a/docs/requirements/system-requirements.toml\r\n+++ b/docs/requirements/system-requirements.toml\r\n@@ -1653,7 +1653,7 @@ title = \"A skill whose description cannot say when to use it fails the skills-in\r\n sn_refs = [\"SN-005\"]\r\n boundary_refs = [\"B-05\"]\r\n hat_refs = [\"FIRST-RUN-ADOPTER\"]\r\n-requirement = \"The skill descriptions the kit ships are at or above the declared description floor, and if a skill's description is shorter than that floor, then the kit's skills-index check shall fail, naming that skill.\"\r\n+requirement = \"The kit shall hold every skill description to the declared description floor: the descriptions it ships are at or above it, and its skills-index check fails, naming the skill, on any description shorter than it.\"\r\n rationale = \"\"\"A DERIVED requirement, and labelled so. SN-005 asks that agents and humans work from the same playbook; it does not name what a skill's description must carry, so this obligation arrives through the first-run-adopter lens rather than through the need's text. An agent reads only a skill's description to decide whether to load it, so a description too short to say when to use the skill is shipped guidance an adopter's agent never reads: the skill works only for someone who already knows it exists, the undocumented-knowledge failure that lens listens for. A length floor is a lexical proxy, not a proof that a description is good: it catches the one-line stub that cannot state a trigger and leaves the wording to review. A reviewer's judgement of every description was the alternative, and it lost as the only guard because nothing would re-ask it when a skill is added. Fed back to the need: SN-005's acceptance could name the skills' descriptions as part of the playbook; until it does, this row is derived and says so.\"\"\"\r\n acceptance_criteria = \"A skill whose description is shorter than the declared floor fails the check, which names that skill and not a skill at the floor; a description at the floor passes; the kit's shipped skills clear the floor.\"\r\n priority = \"C\"\r\nab4b6d8c2\r\n\r\ndiff --git a/docs/requirements/system-requirements.toml b/docs/requirements/system-requirements.toml\r\nindex b351bc907..cb7933f83 100644\r\n--- a/docs/requirements/system-requirements.toml\r\n+++ b/docs/requirements/system-requirements.toml\r\n@@ -1653,7 +1653,7 @@ title = \"A skill whose description cannot say when to use it fails the skills-in\r\n sn_refs = [\"SN-005\"]\r\n boundary_refs = [\"B-05\"]\r\n hat_refs = [\"FIRST-RUN-ADOPTER\"]\r\n-requirement = \"If a skill's description is shorter than the declared description floor, then the kit's skills-index check shall fail, naming that skill.\"\r\n+requirement = \"The skill descriptions the kit ships are at or above the declared description floor, and if a skill's description is shorter than that floor, then the kit's skills-index check shall fail, naming that skill.\"\r\n rationale = \"\"\"A DERIVED requirement, and labelled so. SN-005 asks that agents and humans work from the same playbook; it does not name what a skill's description must carry, so this obligation arrives through the first-run-adopter lens rather than through the need's text. An agent reads only a skill's description to decide whether to load it, so a description too short to say when to use the skill is shipped guidance an adopter's agent never reads: the skill works only for someone who already knows it exists, the undocumented-knowledge failure that lens listens for. A length floor is a lexical proxy, not a proof that a description is good: it catches the one-line stub that cannot state a trigger and leaves the wording to review. A reviewer's judgement of every description was the alternative, and it lost as the only guard because nothing would re-ask it when a skill is added. Fed back to the need: SN-005's acceptance could name the skills' descriptions as part of the playbook; until it does, this row is derived and says so.\"\"\"\r\n acceptance_criteria = \"A skill whose description is shorter than the declared floor fails the check, which names that skill and not a skill at the floor; a description at the floor passes; the kit's shipped skills clear the floor.\"\r\n priority = \"C\"\r\ndiff --git a/tests/test_module_size_ratchet.py b/tests/test_module_size_ratchet.py\r\nindex 5a08dee9e..5b6b60666 100644\r\n--- a/tests/test_module_size_ratchet.py\r\n+++ b/tests/test_module_size_ratchet.py\r\n@@ -772,7 +772,7 @@ BASELINE = {\r\n     # whichever id scan globbed the old suffix, and nothing generic catches it\r\n     # (a scan that finds no registry reads zero rather than r