lines":[" - 2026-10-09 — refresh under approval. Copied: low-level-requirements.toml (re-attested: LLR-320); test-cases.toml (re-attested: TC-342, TC-343). Registries not named by this act keep their prior snapshot bytes."," - 2026-10-09 — refresh under approval. Copied: low-level-requirements.toml (re-attested: LLR-300); test-cases.toml (re-attested: TC-316, TC-340). Registries not named by this act keep their prior snapshot bytes."," - 2026-10-09 — refresh under approval. Copied: low-level-requirements.toml (re-attested: LLR-167, LLR-270); test-cases.toml (re-attested: TC-161, TC-322). Registries not named by this act keep their prior snapshot bytes.","+- 2026-10-10 — refresh under approval. Copied: low-level-requirements.toml (re-attested: LLR-045); test-cases.toml (re-attested: TC-082). Registries not named by this act keep their prior snapshot bytes."]}]},{"filePath":"C:\\Projects\\ai-template.wt\\wi-847\\docs\\archive\\last_approved\\acts.toml","hunks":[{"oldStart":554,"oldLines":3,"newStart":554,"newLines":9,"lines":[" date = \"2026-10-09\""," approved = []"," reattested = [\"LLR-167\", \"LLR-270\", \"TC-161\", \"TC-322\"]","+","+[[act]]","+seq = 92","+date = \"2026-10-10\"","+approved = []","+reattested = [\"LLR-045\", \"TC-082\"]"]}]},{"filePath":"C:\\Projects\\ai-template.wt\\wi-847\\docs\\archive\\last_approved\\docs\\requirements\\low-level-requirements.toml","hunks":[{"oldStart":478,"oldLines":8,"newStart":478,"newLines":8,"lines":[" sr_refs = [\"SR-154\"]"," title = \"Managed review dispatch\""," module = \"project-trajectory/scripts/agent_loop.py;project-trajectory/scripts/agent_brief.py\"","-code_symbol = \"main/reviewer_prompt/phase_tier\"","-detail = \"Schedules review-policy sessions in managed mode, constructs redacted prompt-map briefs, parses verdicts, logs selections, and preserves unmanaged behavior. A declared review policy of N schedules N reviewer sessions (0/1/2 -> zero/one/two); a broken prompt map fails preflight before any session launches; an absent enable-list keeps the legacy unmanaged behavior. The queued phases are always NAMED by the caller and never defaulted: a fresh round names the declared span, and a resume names exactly the phases the branch's committed evidence still owes at the governing identity - so an empty list is an empty round rather than a full one, and the untracked owed-round marker contributes advisory fields only, never a round.\"","+code_symbol = \"main/reviewer_prompt/narrow_scope_line/narrow_reviewer_prompt/phase_tier\"","+detail = \"Schedules review-policy sessions in managed mode, constructs redacted prompt-map briefs, parses verdicts, logs selections, and preserves unmanaged behavior. A declared review policy of N schedules N reviewer sessions (0/1/2 -> zero/one/two); a broken prompt map fails preflight before any session launches; an absent enable-list keeps the legacy unmanaged behavior. The queued phases are always NAMED by the caller and never defaulted: a fresh round names the declared span, and a resume names exactly the phases the branch's committed evidence still owes at the governing identity - so an empty list is an empty round rather than a full one, and the untracked owed-round marker contributes advisory fields only, never a round. narrow_reviewer_prompt builds a narrow round that answers prior findings by strictly filling the phase override or shipped reviewer template through prompts.fill with the round delta as its reading scope and round facts that state the shared narrow range sentence and name the findings file as a claim under judgement. A template with missing or unknown slots refuses rather than yielding a full-lane or unfilled scope; the rendered reviewer commits its own verdict and carries no attended recording facts.\""," test_refs = \"(see TC-082)\""," status = \"Approved\""," component = \"CMP-008\""]}]},{"filePath":"C:\\Projects\\ai-template.wt\\wi-847\\docs\\archive\\last_approved\\docs\\test\\test-cases.toml","hunks":[{"oldStart":818,"oldLines":11,"newStart":818,"newLines":11,"lines":[" [test.TC-082]"," verifies = [\"SR-154\", \"LLR-045\"]"," level = \"Integration\"","-method = \"\"\"Run review-policy 0/1/2, prompt-map, redaction, selection logging, verdict, and unmanaged cases. The queue's phases are driven as a REQUIRED argument: a fresh round queues the declared span its caller names, a resume queues the named owed subset, an empty list queues an EMPTY round rather than falling back to the full one, and omitting the argument raises - so \"the evidence owes nothing\" and \"the caller named nothing\" cannot share one value.\"\"\"","+method = \"\"\"Run review-policy 0/1/2, prompt-map, redaction, selection logging, verdict, and unmanaged cases. The queue's phases are driven as a REQUIRED argument: a fresh round queues the declared span its caller names, a resume queues the named owed subset, an empty list queues an EMPTY round rather than falling back to the full one, and omitting the argument raises - so \"the evidence owes nothing\" and \"the caller named nothing\" cannot share one value. Render the narrow reviewer brief with prior findings and compare its delta scope and narrow range sentence with the attended narrow render; confirm it has no unfilled slot or attended recording facts, and that an override lacking the range slots refuses.\"\"\""," tier = \"Full\"","-expected = \"\"\"Managed scheduling matches policy with redacted logged routing; bad prompts fail preflight; unmanaged mode stays legacy.\"\"\"","+expected = \"\"\"Managed scheduling matches policy with redacted logged routing; bad prompts fail preflight; unmanaged mode stays legacy. The narrow reviewer renderer reads the round delta, states the same narrow range sentence as the attended renderer, leaves no slot or attended recording facts, and refuses an override that cannot carry its scope.\"\"\""," automated = \"Yes\"","-evidence = \"\"\"tests/test_agent_loop_review.py::test_review_policy_1_dispatches_one_heterogeneous_reviewer; tests/test_agent_loop_review.py::test_review_policy_2_schedules_two_providers; tests/test_agent_loop_review.py::test_review_policy_0_schedules_no_reviewer; tests/test_agent_loop_review.py::test_reviewer_prompt_is_redacted_by_construction; tests/test_agent_loop_review.py::test_prompt_map_missing_file_fails_preflight; tests/test_agent_loop_review.py::test_absent_enable_list_keeps_legacy_behavior; tests/test_agent_loop_routing.py::test_routingstate_schedule_review_round_by_policy\"\"\"","+evidence = \"\"\"tests/test_agent_loop_review.py::test_review_policy_1_dispatches_one_heterogeneous_reviewer; tests/test_agent_loop_review.py::test_review_policy_2_schedules_two_providers; tests/test_agent_loop_review.py::test_review_policy_0_schedules_no_reviewer; tests/test_agent_loop_review.py::test_reviewer_prompt_is_redacted_by_construction; tests/test_agent_loop_review.py::test_prompt_map_missing_file_fails_preflight; tests/test_agent_loop_review.py::test_absent_enable_list_keeps_legacy_behavior; tests/test_agent_loop_routing.py::test_routingstate_schedule_review_round_by_policy; tests/test_review_brief.py::test_the_loop_narrow_round_renders_its_delta_through_the_one_render; tests/test_review_brief.py::test_a_loop_narrow_round_refuses_an_override_that_cannot_carry_its_range\"\"\""," status = \"Approved\""," phase = 1"," "]}]}],"moreFiles":0,"changedFiles":["C:\\Projects\\ai-template.wt\\wi-847\\docs\\archive\\last_approved\\README.md","C:\\Projects\\ai-template.wt\\wi-847\\docs\\archive\\last_approved\\acts.toml","C:\\Projects\\ai-template.wt\\wi-847\\docs\\archive\\last_approved\\docs\\requirements\\low-level-requirements.toml","C:\\Projects\\ai-template.wt\\wi-847\\docs\\archive\\last_approved\\docs\\test\\test-cases.toml"]}}}
