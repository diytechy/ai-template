th, keep.KeepConfig()) is None\n    assert not keep.store_dir(tmp_path).exists()\n\n\n# --- keep-warm (TC-268) -------------------------------------------------------------\n\n\nclass _Row:\n    def __init__(self, family, cmd_template=None):\n        self.id = family + \"-ROUTE\"\n556:    lease_only = _state(tmp_path)\n557:    assert lease_only[\"lease\"][\"holder\"] == minting[0].holder\n558:    assert \"session_id\" not in lease_only and \"state\" not in lease_only\n605:def test_a_first_mint_that_raises_removes_its_lease_only_record(tmp_path):","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
