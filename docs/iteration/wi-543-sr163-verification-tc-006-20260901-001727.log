{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Wp2Bw4nY4qFYTS5YgimXx7","type":"tool_result","content":"1950\t    nothing.\"\"\"\n1951\t    ids = live_llr_ids(root, registry)\n1952\t    minimum = read_backlink_min(root)\n1953\t    roots = \", \".join(str(s) for s in src_roots)\n1954\t    if not ids:\n1955\t        return [\n1956\t            \"back-link coverage: no live LLR rows under {} — vacuous.\".format(\n1957\t                Path(root) / registry\n1958\t            )\n1959\t        ], True\n1960\t    covered, uncovered, pct = backlink_coverage(src_roots, ids, exts)\n1961\t    lines = [\n1962\t        \"back-link coverage: {}/{} live LLR rows ({:.1f}%) are named by a \"\n1963\t        \"literal `Implements:` declaration under {}; declared minimum {}% \"\n1964\t        \"(docs/{} [checks] {}).\".format(\n1965\t            len(covered), len(ids), pct, roots, minimum, PROCESS_TOML, BACKLINK_MIN_KEY\n1966\t        )\n1967\t    ]\n1968\t    if minimum == 0:\n1969\t        # The shipped position, and it is stated on every run rather than\n1970\t        # implied by silence: a reader must be able to tell \"this repo declined\n1971\t        # the bar\" from \"this repo has never heard of the layer\".\n1972\t        lines.append(\n1973\t            \"back-link coverage: REPORT-ONLY — the minimum is 0, so the number \"\n1974\t            \"is reported and nothing is gated. Raise it when your practice \"\n1975\t            \"earns the bar.\"\n1976\t        )\n1977\t    elif pct < minimum:\n1978\t        lines.append(\n1979\t            \"back-link coverage: WARNING - {:.1f}% is below the declared \"\n1980\t            \"minimum of {}%. {} LLR row(s) carry no back-link, starting with \"\n1981\t            \"{}. Raise coverage by writing the declarations, never by lowering \"\n1982\t            \"the dial.\".format(pct, minimum, len(uncovered), \", \".join(uncovered[:5]))\n1983\t        )\n1984\t    return lines, (pct >= minimum)\n1985\t\n1986\t\n1987\t# ── SR-163: the shipped-file purpose-coverage checker, the forward direction ──\n1988\t#\n1989\t# `backlink_report` above asks whether each live DESIGN ROW is NAMED by some\n1990\t# source declaration. SR-163 asks the INVERSE, over a different universe: does\n1991\t# each shipped-FILE inventory entry map, through a requirement reference, to a\n1992\t# stakeholder need — and does its destination exist. The inventory is\n1993\t# `bootstrap.mapping_entries()` (source, destination, optional requirement id);\n1994\t# a bare pair is by definition an unmapped-entry warning, so the reference\n1995\t# burn-down IS the migration and no flag day is forced (OI-72, 2026-08-31).\n1996\t#\n1997\t# THE DECLARED WARN-VS-GATE POLICY, one home. Unresolved references and unmapped\n1998\t# files START warn — filling references is a migration, and the SHIPPED default\n1999\t# for unmapped stays warn-only; the flip of either class to \"gate\" is a reviewed\n2000\t# commit taken once that class reaches zero. Missing files and stale exclusions\n2001\t# are already delivered and gated by the dogfood/bootstrap checks, so they gate\n2002\t# here too (they stand at zero, or those checks are already red).\n2003\tMAPPING_FINDING_POLICY = {\n2004\t    \"missing_file\": \"gate\",\n2005\t    \"stale_entry\": \"gate\",\n2006\t    \"unresolved_reference\": \"warn\",\n2007\t    \"unmapped_file\": \"warn\",\n2008\t}\n2009\t\n2010\t\n2011\tdef load_spine_index(root, sr_registry=SR_REGISTRY, sn_registry=SN_REGISTRY):\n2012\t    \"\"\"`(sr_by_id, sn_ids)` for the SR-163 join: a `{SR-ID: row}` map of live\n2013\t    system requirements and the set of live stakeholder-need ids, both `-000`\n2014\t    example rows dropped. Empty containers when a registry is absent — a repo\n2015\t    with no spine has nothing to resolve against, and the checker says so by\n2016\t    reporting every reference unresolved rather than by crashing.\"\"\"\n2017\t    srs = spine_carrier.load(Path(root) / sr_registry, \"SR-ID\", False)\n2018\t    sns = spine_carrier.load(Path(root) / sn_registry, \"SN-ID\", False)\n2019\t    sr_by_id = {\n2020\t        str(r.get(\"SR-ID\") or \"\").strip(): r\n2021\t        for r in srs\n2022\t        if str(r.get(\"SR-ID\") or \"\").strip()\n2023\t    }\n2024\t    sn_ids = {\n2025\t        str(r.get(\"SN-ID\") or \"\").strip()\n2026\t        for r in sns\n2027\t        if str(r.get(\"SN-ID\") or \"\").strip()\n2028\t    }\n2029\t    return sr_by_id, sn_ids\n2030\t\n2031\t\n2032\tdef resolve_requirement_reference(ref, sr_by_id, sn_ids):\n2033\t    \"\"\"`None` when `ref` names a live system requirement whose stakeholder-need\n2034\t    references resolve to at least one live need; otherwise a short reason the\n2035\t    reference does not resolve. The SR-163 file→requirement→need join, stated\n2036\t    once so the checker and its TC read it the same way.\"\"\"\n2037\t    ref = (ref or \"\").strip()\n2038\t    if not ref:\n2039\t        return \"carries no reference\"\n2040\t    sr = sr_by_id.get(ref)\n2041\t    if sr is None:\n2042\t        return \"names no live system requirement\"\n2043\t    needs = [n for n in _kitspine.refs(sr.get(\"SN-Refs\")) if n in sn_ids]\n2044\t    if not needs:\n2045\t        return \"system requirement resolves to no live stakeholder need\"\n2046\t    return None\n2047\t\n2048\t\n2049\tdef mapping_purpose_findings(\n2050\t    entries, *, present, sr_by_id, sn_ids, declared_absences=()\n2051\t):\n2052\t    \"\"\"The four SR-163 finding classes over a shipped-file inventory, as a list\n2053\t    of `(class, destination, detail)` tuples. PURE: every environment fact is an\n2054\t    injected value, so the same function grades the real `bootstrap.MAPPING` and\n2055\t    a planted scaffold identically.\n2056\t\n2057\t      `entries`            — iterable of `(src, dst, ref)` (bootstrap.mapping_entries\n2058\t                             shape; `ref` None for a bare pair).\n2059\t      `present(dst)`       — True when the destination materializes (physically\n2060\t                             present, or served in place from the kit tree).\n2061\t      `sr_by_id`/`sn_ids`  — the spine index from `load_spine_index`.\n2062\t      `declared_absences`  — `{path: reason}` for destinations recorded as\n2063\t                             deliberately not shipped. A reason opening\n2064\t                             `LIFECYCLE:` marks a path whose PRESENCE is a legal,\n2065\t                             documented state, so it is exempt from the stale\n2066\t                             arm — the same marker rule the dogfood walk applies,\n2067\t                             stated once (`check_doc_refs.load_declared_absences`\n2068\t                             is its shape).\n2069\t\n2070\t    Classes (each carried by `MAPPING_FINDING_POLICY`):\n2071\t      unmapped_file        — a bare pair: the file ships with no recorded purpose.\n2072\t      unresolved_reference — a reference that does not resolve SR → live need.\n2073\t      missing_file         — a declared destination that is absent and not excluded.\n2074\t      stale_entry          — a declared exclusion whose destination is now present.\n2075\t    \"\"\"\n2076\t    absences = dict(declared_absences)\n2077\t    findings = []\n2078\t    for _src, dst, ref in entries:\n2079\t        if ref is None:\n2080\t            findings.append(\n2081\t                (\"unmapped_file\", dst, \"ships with no requirement reference\")\n2082\t            )\n2083\t        else:\n2084\t            reason = resolve_requirement_reference(ref, sr_by_id, sn_ids)\n2085\t            if reason:\n2086\t                findings.append(\n2087\t                    (\n2088\t                        \"unresolved_reference\",\n2089\t                        dst,\n2090\t                        \"reference {!r} {}\".format(ref, reason),\n2091\t                    )\n2092\t                )\n2093\t        if not present(dst) and dst not in absences:\n2094\t            findings.append((\"missing_file\", dst, \"declared destination is absent\"))\n2095\t    for dst, reason in sorted(absences.items()):\n2096\t        if not str(reason).startswith(\"LIFECYCLE:\") and present(dst):\n2097\t            findings.append(\n2098\t                (\n2099\t                    \"stale_entry\",\n2100\t                    dst,\n2101\t                    \"declared exclusion but the destination is present\",\n2102\t                )\n2103\t            )\n2104\t    return findings\n2105\t\n2106\t\n2107\tdef mapping_purpose_report(findings, policy=MAPPING_FINDING_POLICY):\n2108\t    \"\"\"`(lines, ok)` 
