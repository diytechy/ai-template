{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CbjJyvru592io8NFchypQT","type":"tool_result","content":"    Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>\n\n docs/interface-reference.md                      |  2 +-\n project-trajectory/RESYNC_PACK.md                | 24 +++++++++\n project-trajectory/prompts/CATALOG.md            | 15 +++++-\n project-trajectory/prompts/README.md             | 10 ++--\n project-trajectory/scripts/adjudicate_brief.py   |  6 ++-\n project-trajectory/scripts/gen_prompt_catalog.py | 50 ++++++++++++++++---\n project-trajectory/scripts/prompts.py            | 48 +++++++++++++++---\n tests/test_generated_freshness_wiring.py         | 24 +++++++++\n tests/test_routing_and_prompts.py                | 62 ++++++++++++++++++++++++\n 9 files changed, 220 insertions(+), 21 deletions(-)\ncommit d9b5c38c6fa931d79a88181a9b70974cbd7bbfa2\nAuthor: Reviewer <reviewer@example.test>\nDate:   Sat Oct 10 11:21:48 2026 -0500\n\n    WI-882: The prompt catalogue lists the composed question home by digest, freshness-gated like the templates\n    \n    Build round 1 (kit-builder), option (a) of the spec. prompts.KIT_FRAGMENTS is\n    the one home of the composed fragment's filename (adjudicate_brief reads it);\n    fragment_rows() digests each fragment over the templates' normalized text, and\n    an absent, unreadable or empty fragment raises before any write, so\n    gen_prompt_catalog --check goes red and the previous catalogue stands. The\n    catalogue gains a Composed fragments table; the template table is unchanged.\n    Red-first tests: an edit stales the catalogue, a CRLF copy stays fresh, an\n    absent/undecodable/notes-only home fails generation and --check; the\n    check.py prompt-catalog step reds end to end (slow tier).\n    \n    Coordinator re-run: affected modules 177 passed; gen_prompt_catalog --check fresh.\n    check_trajectory --strict clean.\n    Smoke: 2401 passed, 2 skipped in 41.94s; budget 42.0s vs 60s -> within.\n    \n    Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>\n\ndiff --git a/project-trajectory/scripts/gen_prompt_catalog.py b/project-trajectory/scripts/gen_prompt_catalog.py\nindex 1ee4b687..8f3aba33 100644\n--- a/project-trajectory/scripts/gen_prompt_catalog.py\n+++ b/project-trajectory/scripts/gen_prompt_catalog.py\n@@ -42,7 +42,8 @@ import prompts  # noqa: E402  (path set above; the kit's script-sibling idiom)\n CATALOG = prompts.PROMPTS / \"CATALOG.md\"\n \n HEADER = \"\"\"<!-- GENERATED by scripts/gen_prompt_catalog.py — do not hand-edit.\n-     Re-generate after editing any template; `--check` gates it. -->\n+     Re-generate after editing any template or composed fragment; `--check`\n+     gates it. -->\n \n # Shipped prompt catalogue\n \n@@ -63,6 +64,19 @@ is a refusal rather than a silently empty instruction.\n |---|---|---|---|\n \"\"\"\n \n+FRAGMENTS = \"\"\"\n+## Composed fragments\n+\n+A shipped file a brief reads at render time and composes into one of its slots\n+is a source of that brief's instruction text just as a template is, so it is\n+listed here by the same digest and stales this catalogue the same way. It has\n+no key and no override. An absent or unreadable fragment fails generation and\n+`--check`; it is never listed as skipped.\n+\n+| File | Digest | Fills |\n+|---|---|---|\n+\"\"\"\n+\n FOOTER = \"\"\"\n An operator override replaces a template per phase (`--prompt-map`); an\n overridden session's `# prompt-template:` names the override path, so the\n@@ -72,8 +86,9 @@ substitution is visible in the telemetry rather than only in the launch flags.\n \n def render():\n     \"\"\"The catalogue's full text. Pure — takes no arguments and touches no\n-    state beyond reading the shipped templates, so `--check` and the write path\n-    cannot disagree about what \"current\" means.\n+    state beyond reading the shipped templates and composed fragments, so\n+    `--check` and the write path cannot disagree about what \"current\" means.\n+    Raises `prompts.PromptError` when a composed fragment cannot be read.\n \n     Implements: SR-146, LLR-164\n     \"\"\"\n@@ -87,7 +102,21 @@ def render():\n         )\n         for key, filename, slot_names, digest in prompts.catalog_rows()\n     ]\n-    return HEADER + \"\\n\".join(rows) + \"\\n\" + FOOTER\n+    fragments = [\n+        \"| [{file}]({file}) | `{digest}` | `{{{slot}}}` |\".format(\n+            file=filename, digest=digest, slot=slot\n+        )\n+        for filename, slot, digest in prompts.fragment_rows()\n+    ]\n+    return (\n+        HEADER\n+        + \"\\n\".join(rows)\n+        + \"\\n\"\n+        + FRAGMENTS\n+        + \"\\n\".join(fragments)\n+        + \"\\n\"\n+        + FOOTER\n+    )\n \n \n def main(argv=None):\n@@ -104,7 +133,13 @@ def main(argv=None):\n         \"--print\", dest=\"show\", action=\"store_true\", help=\"print, write nothing\"\n     )\n     args = ap.parse_args(argv)\n-    text = render()\n+    try:\n+        text = render()\n+    except prompts.PromptError as exc:\n+        # Before any write, so the previous catalogue stands; and for `--check`\n+        # too, so an unreadable source is a red gate rather than a green one.\n+        print(\"gen_prompt_catalog: {}\".format(exc), file=sys.stderr)\n+        return 1\n     if args.show:\n         print(text, end=\"\")\n         return 0\n@@ -120,8 +155,9 @@ def main(argv=None):\n             print(\"gen_prompt_catalog: fresh ({} prompts).\".format(text.count(\"\\n| `\")))\n             return 0\n         print(\n-            \"gen_prompt_catalog: {} is STALE — a template changed and the \"\n-            \"catalogue did not. Run `python scripts/gen_prompt_catalog.py` \"\n+            \"gen_prompt_catalog: {} is STALE — a template or composed fragment \"\n+            \"changed and the catalogue did not. Run \"\n+            \"`python scripts/gen_prompt_catalog.py` \"\n             \"and commit the result.\".format(\n                 CATALOG.relative_to(prompts.KIT.parent)\n                 if CATALOG.is_relative_to(prompts.KIT.parent)\ndiff --git a/project-trajectory/scripts/prompts.py b/project-trajectory/scripts/prompts.py\nindex 2e6153f7..7c3a80fa 100644\n--- a/project-trajectory/scripts/prompts.py\n+++ b/project-trajectory/scripts/prompts.py\n@@ -58,10 +58,14 @@ Contract IF-097: the prompt LOADER. `KIT_PROMPTS` is the declared key-to-file ma\n     shipped template.\n Contract IF-098: the generated prompt catalogue's row source. `catalog_rows()`\n     returns `(key, file, slots, digest)` for every shipped prompt whose file is\n-    present, sorted by key, and the catalogue reads nothing else — so the\n-    document cannot disagree with the loader about what ships or with what\n+    present, sorted by key, and the catalogue reads nothing but it and\n+    `fragment_rows()` — so the document cannot disagree with the loader about what ships or with what\n     slots. A key whose file is absent is omitted from the rows and reported by\n-    `preflight`, not rendered as a blank entry.\n+    `preflight`, not rendered as a blank entry. `fragment_rows()` returns\n+    `(file, slot, digest)` for every composed fragment in `KIT_FRAGMENTS` (a\n+    file a brief composes into a slot at render time), digested over the same\n+    normalized text; a fragment that is absent, unreadable or empty after its\n+    notes raises `PromptError` rather than being omitted or digested as empty.\n Contract IF-099: the session engine's side of the loader. `WORKER`, `REVIEWER` and\n     `CRITIQUE` are resolved by CALL, never at import, so a missing shipped\n     template is a named `PromptError` the coordinator's preflight reports rather\n@@ -145,6 +149,14 @@ KIT_PROMPTS = {\n     ADJUDICATE_DISPUTE: \"adjudicate-dispute.template.md\",\n }\n \n+# COMPOSED FRAGMENTS (WI-882): shipped files a brief reads at render time and\n+# composes into one of its slots, so each is a source of a launched brief's\n+# static instruction text exactly as a template is. A fragment has no key and\n+# no `--prompt-map` override; the catalogue lists it by digest, freshness-gated\n+# like the templates. Filename -> the slot it fills.\n+SPINE_QUESTIONS = \"spine-questions.md\"\n+KIT_FRAGMENTS = {SPINE_QUESTIONS: \"questions\"}\n+\n # A single-brace `{name}` slot. Lower-case + underscore only, so a `{}` that is\n # part of prose (or a doubled `{{`) is not mistaken for a slot.\n SLOT_RE = re.compile(r\"(?<!\\{)\\{([a-z][a-z0-9_]*)\\}(?!\\})\")\n@@ -191,16 +203,26 @@ def load(key, override=None):\n     Raises `PromptError` naming the path on any read failure — a template the\n     kit ships is not optional, and the alternative (an empty brief) is the\n     silent-wrong-content failure this whole layer exists to prevent.\"\"\"\n-    path = template_path(key, override)\n+    return _read_body(key, template_path(key, override))\n+\n+\n+def _read_body(label, path):\n+    \"\"\"`path`'s text with its notes block stripped and trailing newline dropped,\n+    or `PromptError` naming the path when it cannot be read or is empty after\n+    the notes: the one read a template and a composed fragment both take.\n+\n+    Implements: SR-146, LLR-162\"\"\"\n     try:\n         text = path.read_text(encoding=\"utf-8\")\n     except (OSError, UnicodeDecodeError) as exc:\n         raise PromptError(\n-            \"prompt [{}]: cannot read {}: {}\".format(key, path, exc)\n+            \"prompt [{}]: cannot read {}: {}\".format(label, path, exc)\n         ) from exc\n     body = strip_dispatcher_block(text)\n     if not body.strip():\n-        raise PromptError(\"prompt [{}]: {} is empty after the notes\".format(key, path))\n+        raise PromptError(\n+            \"prompt [{}]: {} is empty after the notes\".format(label, path)\n+        )\n     return body.rstrip(\"\\n\")\n \n \n@@ -297,6 +319,20 @@ def catalog_rows():\n     return rows\n \n \n+def fragment_rows():\n+    \"\"\"`[(file, slot, digest)]` over every composed fragment, sorted by file —\n+    the catalogue's second table. NO SKIP: unlike a template, whose absence\n+    `preflight` reports, a fragment that is absent, unreadable or empty after\n+    its notes raises `PromptError`, so the catalogue never lists it as skipped\n+    or digests it as empty.\n+\n+    Implements: SR-146, LLR-162\"\"\"\n+    return [\n+        (name, slot, digest(_read_body(name, PROMPTS / name)))\n+        for name, slot in sorted(KIT_FRAGMENTS.items())","is_error":false}]},"parent_tool_use_id":null,"session_id":"7a511e73-e906-4589-9f31-ae73f8534ed7","uuid":"175d8933-1430-42f5-bd91-311e558e0b4e","timestamp":"2026-10-10T17:59:59.930Z","tool_use_result":{"stdout":"    Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>\n\n docs/interface-reference.md                      |  2 +-\n project-trajectory/RESYNC_PACK.md                | 24 +++++++++\n project-trajectory/prompts/CATALOG.md            | 15 +++++-\n project-trajectory/prompts/README.md             | 10 ++--\n project-trajectory/scripts/adjudicate_brief.py   |  6 ++-\n project-trajectory/scripts/gen_prompt_catalog.py | 50 ++++++++++++++++---\n project-trajectory/scripts/prompts.py            | 48 +++++++++++++++---\n tests/test_generated_freshness_wiring.py         | 24 +++++++++\n tests/test_routing_and_prompts.py                | 62 ++++++++++++++++++++++++\n 9 files changed, 220 insertions(+), 21 deletions(-)\ncommit d9b5c38c6fa931d79a88181a9b70974cbd7bbfa2\nAuthor: Reviewer <reviewer@example.test>\nDate:   Sat Oct 10 11:21:48 2026 -0500\n\n    WI-882: The prompt catalogue lists the composed question home by digest, freshness-gated like the templates\n    \n    Build round 1 (kit-builder), option (a) of the spec. prompts.KIT_FRAGMENTS is\n    the one home of the composed fragment's filename (adjudicate_brief reads it);\n    fragment_rows() digests each fragment over the templates' normalized text, and\n    an absent, unreadable or empty fragment raises before any write, so\n    gen_prompt_catalog --check goe