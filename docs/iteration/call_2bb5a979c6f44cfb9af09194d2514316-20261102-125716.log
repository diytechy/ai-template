sts/test_id_carrier.py:386:def test_each_reserve_refusal_writes_nothing(\ndocs/test/test-cases.toml:1590:[test.TC-401]\ndocs/test/test-cases.toml-1591-verifies = [\"SR-174\", \"LLR-362\", \"IF-101\"]\ndocs/test/test-cases.toml-1592-level = \"Integration\"\ndocs/test/test-cases.toml-1593-method = \"\"\"Run carrier unit and repository cases. Drive every reserve argument refusal and assert that it writes neither carrier nor working watermark; drive sequential and stale-base reservations and assert disjoint ranges; drive a lost compare-and-swap and assert no write; and fold clean and conflicted watermarks, asserting maximum marks and the sorted, deduplicated record union.\"\"\"\ndocs/test/test-cases.toml-1594-tier = \"Full\"\ndocs/test/test-cases.toml-1595-expected = \"\"\"Each admitted reservation receives a range above its applicable high-water mark; each refused reservation leaves both durable states unchanged; concurrent and sequential reservations are disjoint; a lost swap leaves no reservation; and each fold preserves the highest marks and every valid record exactly once.\"\"\"\ndocs/test/test-cases.toml-1596-automated = \"Yes\"\ndocs/test/test-cases.toml-1597-evidence = \"\"\"tests/test_id_carrier.py; tests/test_id_carrier_git.py::test_first_reservation_seeds_the_carrier_from_trunk; tests/test_id_carrier_git.py::test_a_lost_race_refuses_with_nothing_written; tests/test_id_carrier_git.py::test_sequential_reservations_are_disjoint; tests/test_id_carrier_git.py::test_stale_base_reservations_are_disjoint; tests/test_id_carrier_git.py::test_a_reservation_after_a_ruled_correction_starts_above_it; tests/test_id_carrier_git.py::test_a_reservation_in_a_lane_behind_trunk_commits_through_the_integrity_floor; tests/test_id_carrier_git.py::test_the_claim_folder_reader_reads_each_lanes_work_items_at_a_revision; tests/test_id_carrier_git.py::test_fold_ids_on_a_conflicted_watermark\"\"\"\ndocs/test/test-cases.toml-1598-status = \"Drafted\"\ndocs/test/test-cases.toml-1599-phase = 6\ndocs/test/test-cases.toml-1600-\ndocs/test/test-cases.toml-1601-[test.TC-402]\ndocs/test/test-cases.toml-1602-verifies = [\"SR-174\", \"LLR-363\", \"IF-101\"]\n--\ndocs/requirements/low-level-requirements.toml:3745:[design.LLR-362]\ndocs/requirements/low-level-requirements.toml-3746-sr_refs = [\"SR-174\"]\ndocs/requirements/low-level-requirements.toml-3747-title = \"The shared carrier and reservation record for lane-minted identities\"\ndocs/requirements/low-level-requirements.toml-3748-module = \"project-trajectory/scripts/id_carrier.py;project-trajectory/scripts/trace.py\"\ndocs/requirements/low-level-requirements.toml-3749-code_symbol = \"WATERMARK/CARRIER_REF/TRUNK_SPACES/MAX_COUNT/LOST_RACE/RESERVE_VERB/CORRECTION_LINE/MARK_LINE/Refused/carrier_spaces/parse_marks/parse_corrections/parse_reservations/record_line/parse_counts/plan_reservation/fold/carried/fold_lag/carrier_tip/carrier_text/write_carrier/reserve/receiving_sides/record_history_findings/reserve_ids/check_work_item/committed_reservations/_baseline_texts/_reserved_highs/_basis/_trunk_name/_committed_marks/_cmd_reserve_ids/_cmd_fold_ids/render_watermark/bump_watermark/correct_watermark/_mark_history_findings\"\ndocs/requirements/low-level-requirements.toml-3750-detail = \"\"\"The carrier holds the id watermark for every lane-minted space. A reservation moves the carrier by compare-and-swap and appends one record per requested space, stating its inclusive range and work item. Only a reservation writes a record, and only a fold copies one into a watermark. A committed record remains unchanged across every parent. Every watermark writer preserves the records it receives.\"\"\"\ndocs/requirements/low-level-requirements.toml-3751-rationale = \"\"\"Parallel lanes need one allocation authority: ranges chosen from separate bases otherwise collide, and a record that a later writer drops cannot justify either a raised mark or a landing. Compare-and-swap makes a lost race leave no reservation, while preserving records through each writer keeps the authority readable.\"\"\"\ndocs/requirements/low-level-requirements.toml-3752-test_refs = \"TC-401;TC-158\"\ndocs/requirements/low-level-requirements.toml-3753-status = \"Drafted\"\ndocs/requirements/low-level-requirements.toml-3754-component = \"CMP-006\"\ndocs/requirements/low-level-requirements.toml-3755-phase = 6\ndocs/requirements/low-level-requirements.toml-3756-\ndocs/requirements/low-level-requirements.toml-3757-[design.LLR-363]\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"\"C:\\\\Program Files\\\\PowerShell\\\\7\\\\pwsh.exe\" -Command '$_edit = @'\"'\n\"'$ErrorActionPreference='\"'Stop'\n\"'$utf8=[Text.UTF8Encoding]::new($false)\nfunction Edit($path,$section,$key,$value){$t=[IO.File]::ReadAllText($path,[Text.Encoding]::UTF8);if($t.Contains(\"`r\")){throw \"non-LF $path\"};$m=[regex]::Match($t,'\"'(?ms)(\"'^'\"\\\\['+[regex]::Escape(\"'$section)+'\"'\\\\]\\\\n)(.*?)(?=\"'^'\"\\\\[|\\\\z)');if(\"'!$m.Success){throw \"missing $section\"};$b=$m.Groups[2].Value;$p='\"'(?m)\"'^'\"'+[regex]::Escape(\"'$key)+'\"'\\\\s*=.*\"'$'\"';if([regex]::Matches(\"'$b,$p).Count-ne 1){throw \"not one $section $key\"};$nb=[regex]::Replace($b,$p,$value,1);$out=$t.Substring(0,$m.Groups[2].Index)+$nb+$t.Substring($m.Groups[2].Index+$m.Groups[2].Length);if($out.Contains(\"`r\")){throw '\"'CR result'};[IO.File]::WriteAllText(\"'$path,$out,$utf8)}\nEdit '\"'docs/requirements/low-level-requirements.toml' 'design.LLR-362' 'detail' 'detail = \\\"\\\"\\\"The carrier is a shared ref holding the id watermark for every lane-minted space apart from any lane''s branch. A reservation moves the carrier by compare-and-swap and appends one record per requested space, stating its inclusive range and work item. Each range starts one above the larger of the carrier''s mark and the integration branch''s committed mark, so reservations in sequence or at once from any bases are disjoint. A refused reserve argument or lost compare-and-swap writes neither the carrier nor the receiving watermark. The first reservation creates the carrier from the integration branch''s committed watermark. Only a reservation writes a record, and only a fold copies one into a watermark. A fold yields each space''s maximum mark, the union of reservation and correction records, and a basis computed from the receiving tree''s live ids. A committed record remains unchanged across every parent. Every watermark writer preserves the records it receives. A mark rises only by allocation, a ruled correction, or a covering reservation record.\\\"\\\"\\\"'\nEdit 'docs/test/test-cases.toml' 'test.TC-401' 'expected' 'expected = \\\"\\\"\\\"Each admitted reservation receives a range one above its applicable carrier or integration-branch high-water mark; each refused reservation leaves both durable states unchanged; concurrent and sequential reservations are disjoint; a lost swap leaves no reservation; the first reservation creates a carrier seeded from the integration branch''s committed watermark; and each fold preserves the highest marks and every valid record exactly once.\\\"\\\"\\\"'\n'@\n& ([scriptblock]::Create(\"'$_edit)); git diff --check; rg -n -A 8 '\"'\"'^'\"\\\\[design\\\\.LLR-362\\\\]|\"'^'\"\\\\[test\\\\.TC-401\\\\]' docs/requirements/low-level-requirements.toml docs/test/test-cases.toml\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
