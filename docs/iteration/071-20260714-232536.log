+    gt = load_script("gen_trajectory")
+    for status, fill in gt.STATUS_FILL.items():
+        ink = "#0f172a" if status == "queued" else "#ffffff"
+        assert _wcag(ink, fill) >= 4.5, (status, ink, fill)
