lumn cannot\r\n# ride in on the residual unnoticed).\r\n#\r\n# `Boundary-Refs` (SR) joins the TRACED half at WI-442, on `SN-Refs`' own argument\r\n# rather than a new one: it is the same SHAPE of pointer — which declared\r\n# boundary crossing does this requirement state an observable at — it carries no\r\n# prose either side, and whether a re-point moved SCOPE is exactly the judgement\r\n# the adjudication kind exists to make. So a changed `Boundary-Refs` ROUTES to\r\n# adjudication (intake.ROUTED_TRACED_CELLS) beside `SN-Refs`; it never arms a\r\n# re-attest window directly. Classifying it approved instead would arm a window\r\n# on every row of the re-tier campaign, which is the noise that gets a window\r\n# ignored — and the campaign's re-statements touch `Requirement` anyway, which\r\n# IS approved, so nothing escapes attestation by this choice.\r\n#\r\n# `Hat-Refs` (SR and LLR) joins the TRACED half at WI-484, and the classification\r\n# is the load-bearing half of shipping the cell rather than a footnote. Three\r\n# reasons, in the order that decides it: (1) it is the same SHAPE of pointer as\r\n                \"check: --strict applies only to --staged-divergence today (the \"\r\n                \"plan's severity comes from --stage)\"\r\n            )\r\n        return\r\n    sys.exit(staged_divergence(\".\", strict=args.strict))\r\n\r\n\r\ndef _claimed_work_branch(root):\r\n    \"\"\"The uncached answer behind `_work_branch` — see it for the contract.\r\n\r\n    Implements: SR-006, SR-170, LLR-141\r\n    \"\"\"\r\n    out = _git_out(root, [\"symbolic-ref\", \"--short\", \"HEAD\"])\r\n    branch = (out or \"\").strip()\r\n    if not branch:\r\n        return None  # no git, not a repo, or a detached HEAD => full checks\r\n    # A branch name is used here as a relative PATH. git's own ref rules already\r\n    # forbid `..` and `\\`, but this decides whether a gate runs, so it refuses\r\n    # rather than trusts — loudly, because a name that reaches here is either a\r\n    # git that stopped enforcing its rules or something feeding us a fake ref.\r\n    if \"..\" in branch or \"\\\\\" in branch or branch.startswith(\"/\"):\r\n        print(\r\n            \"check: ignoring implausible branch name '{}' — running the full \"\r\n            \"checks (concurrency-restructure §5.2)\".format(branch),\r\n            file=sys.stderr,\r\n        )\r\n        return None\r\n    active = Path(root) / \"docs\" / \"work\" / \"active\"\r\n    spec_dir = active / branch\r\n    try:\r\n        # Belt-and-braces containment: whatever the name, the claim directory\r\n        # must sit UNDER docs/work/active/ for this to be a claimed branch.\r\n        spec_dir.resolve().relative_to(active.resolve())\r\n    except (OSError, ValueError):\r\n        return None\r\n    if spec_dir.is_dir():\r\n        return branch\r\n    # WI-357: the working tree alone cannot answer this. §2.3 step 3 closes a WI by\r\n    # MOVING the claim out of active/, so from the close commit on the tree holds no\r\n    # claim and the freshness gates re-arm inside the very commit that closes it,\r\n    # demanding artifacts §5.2 forbids the branch to commit. History outlives the\r\n    # move: the base commit that cut the branch added the directory, and that add\r\n    # stays reachable. One path-limited git call, stopped at the first hit.\r\n    # FAIL-DIRECTION: no git, a failing git or an empty answer all read as the TRUNK\r\n    # lane and its STRICT bar, because a false positive would switch the freshness\r\n    # gates off on the trunk — the one branch that owns regenerating them, where\r\n    # nothing else would catch the drift. Residual (review-confirmed breadth): ANY\r\n    # branch whose name ever appeared under docs/work/active/ in reachable history\r\n    # reads as claimed forever — a retired WI branch re-cut, or a throwaway reusing\r\n    # its name; that relaxes a BRANCH, never the trunk, and bounding the walk would\r\n    # need a configured trunk name this rule deliberately has not. Cost note: on\r\n    # the trunk the pathspec never matches, so the -1 walk pays full history —\r\n    # measured ~0.05 ms/commit (61 ms at 1.2k commits), once per process via the\r\n    # cache below; a very large adopter repo that feels it should bound with\r\n    # --since rather than name its trunk.\r\n    log = _git_out(\r\n        root, [\"log\", \"-1\", \"--format=%H\", \"--\", \"docs/work/active/\" + branch]\r\n    )\r\n    return branch if (log or \"\").strip() else None\r\n\r\n\r\ndef _work_branch(root=\".\"):\r\n    \"\"\"The current branch name IF it is a CLAIMED work branch, else None.\r\n\r\n    The claim is the Phase 2c registry model (concurrency-restructure §2.1/§2.3):\r\n    a claimed branch's work-item specs live in `docs/work/active/<branch>/`, moved\r\n    there by the serial trunk commit that cut the branch. So the branch itself\r\n    carries the evidence — no ref namespace, no reservation file — in its working\r\n    tree, or once the close moves the specs to their terminal directory, in\r\n    its own history.\r\n            copy = \"{}/{}\".format(baseline_snapshot.SNAPSHOT_DIR, rel)\r\n            self.cache[key] = (\r\n                acceptance_record.rows_at(self.root, self.rev, rel, id_col),\r\n                acceptance_record.rows_at(self.root, self.rev, copy, id_col),\r\n            )\r\n        return self.cache[key]\r\n\r\n\r\n# Whether a row's `Status` claims approval (`Approved` or `Founded`): the pair's\r\n# one home is `kitlib.spine.claims_approval`, which the acceptance record's\r\n# approval-act readers and the parent-first rule read too.\r\n_claims_approval = kspine.claims_approval\r\n\r\n\r\ndef _retirement(act, rid, held, recorded):\r\n    \"\"\"The state of a judged row absent from the committed registries: a\r\n    re-attest is a retirement, owed while the copy still holds the row\r\n    (`recorded`) and taken once it does not, and owes no act on a held rung;\r\n    a first approval of an absent row is inconsistent.\r\n\r\n    Implements: SR-231, SR-232, LLR-338\"\"\"\r\n    if act != \"reattest\":\r\n        return None, _odd(rid, \"absent\", False)\r\n    if held:\r\n        return NO_ACT, None\r\n    return (RETIRE if recorded else \"taken\"), None\r\n\r\n\r\ndef _state(rows, act, rid, held):\r\n    \"\"\"`(\"owed\" | RETIRE | \"taken\" | NO_ACT, None)` for one authorized row,\r\n    or `(None, why)` when its committed state is inconsistent with the act.\r\n\r\n    Implements: SR-231, SR-232, LLR-338\"\"\"\r\n    tier = _tier(rid)\r\n    if tier is None:\r\n        return None, \"{} is held by no compared tier\".format(rid)\r\n    live, copy = rows.pair(*tier)\r\n    row = live.get(rid)\r\n    if row is None:\r\n        return _retirement(act, rid, held, rid in copy)\r\n    approved, equal = _claims_approval(row), copy.get(rid) == row\r\n    if act == \"approve\" and not approved:\r\n        return \"owed\", None\r\n    if approved and equal:\r\n        return \"taken\", None\r\n    if approved and act == \"reattest\":\r\n        return \"owed\", None\r\n    return None, _odd(rid, row.get(\"Status\") or \"(empty)\", equal)\r\n\r\n\r\ndef _odd(rid, status, equal):\r\n    \"\"\"The inconsistent-row line, naming its status and its copy.\"\"\"\r\n    return \"{} is inconsistent: its committed status is {} and its recorded copy {}\".format(\r\n        rid, status, \"equals it\" if equal else \"does not equal it\"\r\n    )\r\n\r\n\r\ndef _derive(root, verdict, rev):\r\n    \"\"\"`(rel, authorized, owed, None)` for the verdict at `verdict` judged at\r\n    the commit `rev`, or `(rel, None, None, reason)` when it is refused: not\r\n    accepted there, of a class that owes no act, or a judged row in a state\r\n    no act explains.\r\n\r\n    Implements: SR-231, SR-232, LLR-338\"\"\"\r\n    rel = _verdict_rel(root, verdict)\r\n    if not rel:\r\n        return None, None, None, \"the verdict {} lies outside {}\".format(verdict, root)\r\n    found, why = _accepted(root, rev, rel)\r\n    if found is None:\r\n        return rel, None, None, why\r\n    rows, authorized, owed = _Rows(root, rev), [], []\r\n    for act, rid, held in _authorized(found[1], kauthority.dial_at(root, rev)):\r\n        state, why = _state(rows, act, rid, held)\r\n        if state is None:\r\n            return rel, None, None, \"the verdict {} judged a row {}\".format(rel, why)\r\n        if state == NO_ACT:\r\n            continue\r\n        authorized.append((act, rid, held))\r\n        if state in (\"owed\", RETIRE):\r\n            owed.append((RETIRE if state == RETIRE else act, rid, held))\r\n    return rel, authorized, owed, None\r\n\r\n\r\ndef owed_acts(root, verdict, rev=\"HEAD\"):\r\n    \"\"\"`(acts, None)`: every act the verdict at `verdict` authorizes that the\r\n    commit `rev` does not yet carry in full, or `(None, reason)` (the module\r\n    docstring's partition and refusals).\r\n\r\n    Implements: SR-231, SR-232, LLR-338\"\"\"\r\n    rel, authorized, owed, why = _derive(root, verdict, rev)\r\n    if why:\r\n        return None, why\r\n    if any(act == \"approve\" for act, _rid, _held in owed) and not _recorded(root, rev):\r\n        return None, (\r\n            \"the verdict {} approves rows, but no approval record exists at {}: \"\r\n","exit_code":0,"status":"completed"}}
