\r\n> delivered_with = [\"SR-157\"]\r\n  \r\n  [requirement.SR-017]\r\n  title = \"Always-on secrets floor\"\r\n  sn_refs = [\"SN-009\"]\r\n  boundary_refs = [\"B-01\", \"B-04\"]\r\n  hat_refs = [\"SECURITY\"]\r\n  requirement = \"When a session attempts to commit or push content matching a secret pattern, the system shall refuse \r\nat the hook floor — scanning every commit's staged diff, message and outgoing range regardless of the privacy toggle, \r\nand naming the finding — unless the declared secrets_scan dial is explicitly false.\"\r\n  rationale = \"\"\"Realizes SN-009 — a credential that reaches a shared branch must be treated as disclosed and rotated, \r\nand expunging it from history is a rewrite every clone has to follow, so the cheap moment to catch it is before the \r\ncommit and the expensive one is any moment after. Folding the scan into the privacy toggle was rejected: that makes \r\nthe highest-severity check opt-in alongside a preference. The one opt-out is an explicit declaration, so turning it \r\noff is a visible act.\"\"\"\r\n  acceptance_criteria = \"\"\"A staged PEM header, token, or key pattern is flagged and blocks; a clean diff passes; the \r\nfloor runs with privacy-check off, and is disabled only by an explicit secrets_scan = false.\"\"\"\r\n  priority = \"M\"\r\n  verification = \"Test\"\r\n  status = \"Approved\"\r\n  status = \"Approved\"\r\n  phase = 4\r\n  da_refs = [\"DA-006\", \"DA-013\"]\r\n  \r\n> [requirement.SR-157]\r\n  title = \"Spine and work-registry rules red the harness verdict\"\r\n  sn_refs = [\"SN-002\", \"SN-012\", \"SN-025\"]\r\n  boundary_refs = [\"B-09\"]\r\n  hat_refs = [\"FIRST-RUN-ADOPTER\", \"TEST-ENGINEER\"]\r\n  requirement = \"\"\"The delivered harness shall report every declared spine and work-registry rule violation — broken \r\njoins, integrity and schema faults, leftover placeholders, requirement-form findings and work-item coherence \r\ncontradictions — naming the at-fault row and cell, gating the declared failure set at the declared gate while advisory \r\nclasses never change the exit code.\"\"\"\r\n  rationale = \"\"\"Realizes SN-002 (the chain is mechanically verified, not asserted — this row is the boundary-level \r\nhome of the verdict SN-002's acceptance asks for), SN-012 (optional registries and opt-outs cost a non-user nothing) \r\nand SN-025 (the tracked work-item graph the loop derives its next work from is kept coherent). One row because the \r\nadopter-observable contract is one: registry rules produce named findings at a declared severity; which rules, at \r\nwhich severities, is the component detail the rows below it decompose. Deliberate pair (census F6): the PB-format \r\ninvariant itself is SR-015's; this row's decomposition carries the checker. Fan-out re-stamp: the delivered contract \r\nis one — a named, row-and-cell-attributed finding at a declared severity, gating or advisory — while the rule \r\ninventory it ranges over is open by this row's own acceptance (\"a rule added at one of those sites is in this row's \r\nscope by default\"), so the child count tracks the number of declared rules rather than the number of decisions this \r\nrow makes, and would climb back through any bound a split bought.\"\"\"\r\n  acceptance_criteria = \"Each declared registry rule violation is reported with row-level attribution; the declared \r\nstrict set exits nonzero at its gate and advisory classes never join the exit code; absent or placeholder-only \r\noptional registries and declared opt-outs are vacuous; the declared verification vocabulary (including Critique) is \r\naccepted and an unknown value fails. The declaration this is read against is the rule inventory the delivered checkers \r\nthemselves publish — the id shapes, the required cells and the closed vocabularies (with the interface and component \r\nentries advisory by their own recorded ruling), the strict flag families and their stated exit contracts, the gating \r\nform and provenance findings beside the never-gating paraphrase and acceptance advisories, and the work-item coherence \r\nrules with their declared opt-out — each recorded at its declaration site, not restated here. A rule added at one of \r\nthose sites is in this row's scope by default: an unreported one is a finding against this row, not an amendment to \r\nit.\"\r\n  priority = \"M\"\r\n  verification = \"Test\"\r\n  status = \"Approved\"\r\n  phase = 1\r\n  coincident = \"\"\"The needs ask for a chain that is mechanically verified rather than asserted, work-registry \r\ncontradictions that surface rather than hide, and small changes kept cheap; each declared rule violation reported \r\nnaming its row and cell, with the declared failure set gating and advisories not, is that verification's verdict as \r\nthe reader receives it. Whether a row that passes every rule says something worth relying on is not this row's \r\nclaim.\"\"\"\r\n  boundary_refs = [\"B-09\"]\r\n  hat_refs = [\"FIRST-RUN-ADOPTER\", \"TEST-ENGINEER\"]\r\n  requirement = \"\"\"The delivered harness shall report declared-architecture connectivity gaps — an unresolvable \r\ninterface row, an undeclared endpoint or direction, a cross-component import no declared interface covers, an invalid \r\nspec interface citation, and a top view past its declared bound — warn-first with --strict gating, vacuous where the \r\noptional inventories are absent.\"\"\"\r\n  rationale = \"\"\"Realizes SN-023 (the parts' connections are as much of the truth as the requirement tree, checked \r\nmechanically warn-first — the need's own words), SN-002 (interface rows stay resolvable) and SN-012 (opt-out and \r\nvacuity keep the layer free for non-users). One row: the delivered contract is one connectivity verdict; the checkers \r\nbelow it are its decomposition.\"\"\"\r\n> acceptance_criteria = \"\"\"Malformed or unresolvable IF rows are findings; undeclared endpoints, uncovered \r\ncross-component edges, invalid spec citations and an oversized top view warn plain and fail --strict; declared \r\nopt-outs and small or absent inventories are vacuous; declared seams render without changing the verdict. The rules \r\nand their opt-outs are read off their declaration sites, not restated here: the interface and component id shapes and \r\nthe off-spine back-link to the spine sit on the always-on integrity floor and join --strict, their required-field \r\nentries and enums staying advisory by the recorded warn-first sequencing; the connectivity rules join every module of \r\nthe generated architecture inventory against the declared interface endpoints (a module resolving to no endpoint is \r\nthe \"connectivity undeclared\" warn), report a cross-component import no declared interface covers and a spec interface \r\ncitation resolving to neither a declared seam nor the intra-module escape, and hold the top view to its declared bound \r\n(warn plain, error under --strict); two declared opt-outs and a per-module source/sink honesty valve carve the layer \r\nout. A connectivity rule added at one of those sites is in this row's scope by default. Carved out of that default \r\n(owner ruling 2026-08-15, second-read M1): the interface endpoint-pair cells and the closed discrete/variable Signal \r\nvocabulary are SR-162's observables — their resolution against the declared external frame is SN-037's need, stated \r\nthere in the need's own words — while the generic required-field and closed-vocabulary checker those cells ride stays \r\nSR-157's; a rule landing at those two cells belongs to those rows, not this one.\"\"\"\r\n  priority = \"S\"\r\n  verification = \"Test\"\r\n  status = \"Approved\"\r\n  phase = 1\r\n  coincident = \"\"\"The needs ask for a reviewer seeing how the parts connect from a chain that is checked; each \r\ndeclared-architecture gap reported is that outcome, since the gaps are what would make the drawn connections \r\nunreliable.\"\"\"\r\n  aspect = \"connectivity\"\r\n  \r\n  [requirement.SR-160]\r\n  title = \"Front-door launchers for the two universal contributor actions\"\r\n  sn_refs = [\"SN-034\"]\r\n  boundary_refs = [\"B-05\"]\r\n  hat_refs = [\"CROSS-PLATFORM\", \"FIRST-RUN-ADOPTER\"]\r\n  sn_refs = [\"SN-008\", \"SN-012\"]\r\n  boundary_refs = [\"B-09\"]\r\n  hat_refs = [\"PERFORMANCE\"]\r\n  requirement = \"\"\"The delivered harness shall fail the bar it runs exactly when an in-tier hard-gated \r\nperformance-budget row breaches — its measured metric worse than its absolute Budget, or regressed beyond its declared \r\nTolerance band around the committed baseline — while warn-gated rows and out-of-tier rows only warn, and a metric with \r\nno measurement this run is a reported skip, never a silent pass.\"\"\"\r\n> rationale = \"\"\"Realizes SN-008 (a reader can believe a green — a breach on a row the project chose to hard-gate must \r\nred the run, not ride as a tracked number) and SN-012 (the perf layer is opt-in; a repo declaring no PB rows pays \r\nnothing, while one that does gets the same honest-gate discipline as every other check). This row is the requirement \r\nhome for the perf verdict itself: SR-006 states the step plan and the missing-tool refusal, SR-015 the PB back-link \r\ninvariant, and SR-033 only the warn-tier, never-fails side, so the exit contract the perf step already implements, \r\ndecomposes and proves had no requirement stating it. One row for BOTH breach arms deliberately — absolute and \r\nregression are one delivered exit contract, the SR-157 one-verdict shape, and a regression-only framing is the \r\nsymptom, not the boundary. THE REQUIREMENT NAMES NO ARTIFACT: the comparator is not on the declared delivered-artifact \r\nlist — it is the harness's internal perf step — so the SR states the harness-verdict observable and the comparator is \r\nnamed only in acceptance as the current carrier, the SR-157/SR-158 pattern. Vacuous in THIS repository — no \r\nperformance-budgets registry exists here and the perf layer is declared absent — but the template ships the layer, and \r\na shipped layer owes a stated, tested obligation even where locally unused. One act is deliberately still owed: \r\nLLR-014.sr_refs and TC-014.verifies are NOT re-pointed here — both rows are Approved, so amending their cells \r\noverrides attestation, which is the sitting's act; when taken, LLR-014 adds this row beside SR-006 and TC-014 verifies \r\nit beside LLR-014. The charter's third clause — what happens when the budget is exceeded — is this row's entire \r\nsubject, and no other lens in the roster asks it; the charter is ruled `always`, so that lens applies unconditionally \r\nrather than waiting on a tag, and naming it is what turns a row that exists because a layer ships into a reviewable \r\nderived requirement.\"\"\"\r\n  acceptance_criteria = \"\"\"An in-tier hard-gated performance-budget row whose measured metric breaches its absolute \r\nBudget, or falls outside its declared Tolerance band around the committed baseline, makes the perf step exit nonzero \r\nnaming the row and the bar red with it; the same breach on a warn-gated row, or on a row outside the run tier, exits \r\nzero and warns; a hard-gated row with no measurement this run is a per-row reported skip, never silent; a row with no \r\nbaseline or no tolerance cannot fail on the regression arm while its absolute arm still applies; a reviewed baseline \r\nupdate is the acceptance path for an intended regression, proven end to end against a bootstrapped scaffold.\"\"\"\r\n  priority = \"S\"\r\n  verification = \"Test\"\r\n  status = \"Approved\"\r\n  phase = 1\r\n  coincident = \"\"\"The needs ask for a pass verdict that hides no breached budget and budgets that cost only where \r\nadopted; failing the bar on an in-tier hard-gated breach, and reporting an unmeasured metric as a skip, is that \r\nverdict.\"\"\"\r\n  aspect = \"perf\"\r\n  \r\n  [requirement.SR-168]\r\n  title = \"The state view shows current progress and next work\"\r\n  sn_refs = [\"SN-023\", \"SN-010\"]\r\n  boundary_refs = [\"B-09\"]\r\n  sn_refs = [\"SN-025\"]\r\n  boundary_refs = [\"B-01\", \"B-09\", \"B-10\"]\r\n  hat_refs = [\"UNATTENDED-OPS\", \"PERFORMANCE\"]\r\n  requirement = \"While the queued work items include a set that overlaps, the delivered loop content shall hand that \r\nset to a single judgement, at most once for any one state of the queued work items and never while another judgement \r\nis in progress, queued over an item of the set, or queued to run before it, whose outcome takes effect only as a \r\nrecorded restructuring in which each absorbed item is closed in a terminal state naming its one successor, its scope \r\ntext unchanged.\"\r\n> rationale = \"\"\"A DERIVED requirement, and labelled so. SN-025 asks that no human curate what comes next; its \r\nacceptance states only that the next work derives from the tracked work-item graph, which a stranger reading it would \r\nderive as work selection alone. This row states what that promise needs once the loop also mints work: rows minted one \r\nfinding at a time overlap, and without this row either a human merges them, which is the curation the need rules out, \r\nor the loop builds the same job more than once. Two lenses shape it. UNATTENDED-OPS: an overlap is a standing state, \r\nso a judgement fired on it re-asks the same question on every idle tick unless the judged state is remembered past the \r\njudging row's close, an unbounded retry that pages nobody. PERFORMANCE: each judgement is a strong-tier session, so \r\nasking once per queue state is the operating-cost bound rather than an optimisation. The restructuring is recorded \r\nrather than done by deletion so that an absorbed item's scope and its successor stay readable after the act. Fed back \r\nto the need: SN-025's acceptance could name the loop keeping its own queue free of duplicated work; until it does, \r\nthis row is derived and says so. Choosing the next work stays SR-148's, and reporting an overlap as a warning stays \r\nSR-157's.\"\"\"\r\n  acceptance_criteria = \"A queue holding an overlapping set yields exactly one judgement row, and the same state of \r\nthe queued work items yields none again, including after that judgement has closed; no judgement is started while \r\nanother is in progress, while another consolidation is pending, while a queued judgement names an item of the set, or \r\nwhile a queued judgement would run before it, each refusal naming that judgement, and a queued judgement that does \r\nneither holds nothing back; a judgement is never itself a member of a set; a set is never seeded by, and never \r\nre-absorbs, an item created by an earlier judgement that enacted a consolidation, while an item made by a judgement \r\nthat consolidated nothing, or by a consolidation without a recorded judgement, is not treated as judged; an outcome \r\nthat moves an item no longer queued is refused, naming the item; an absorbing outcome leaves each absorbed item in a \r\nterminal state naming its one successor with its scope text unchanged, and the successor records every item it \r\nsupersedes.\"\r\n  priority = \"S\"\r\n  verification = \"Test\"\r\n  status = \"Approved\"\r\n  phase = 5\r\n  da_refs = [\"DA-015\"]\r\n  \r\n  [requirement.SR-221]\r\n  title = \"A builder changing a module can list the tests the spine links to it\"\r\n  sn_refs = [\"SN-012\"]\r\n  boundary_refs = [\"B-09\"]\r\n  hat_refs = [\"PERFORMANCE\", \"TEST-ENGINEER\"]\r\n  \r\n> [interface.IF-131]\r\n  rationale = \"\"\"The rules read the live source AST instead of parsing the retired docs/architecture.md MODULE MAP \r\nblock back. One walk, one grammar: the module keys and import names are exactly what the map rendered, so every \r\ndownstream join (stem resolution, CMP membership) is unchanged.\"\"\"\r\n  owner = \"scripts/gen_arch_map\"\r\n  requestors = [\"scripts/check_trajectory\"]\r\n  channel = \"call\"\r\n  data = \"scan_inventory, contracts_grammar_findings, file_contracts, file_grammar_findings, owner_files, \r\nContractsGrammarError, read_test_tags\"\r\n  version = \"v1\"\r\n  status = \"Drafted\"\r\n  component = \"CMP-006\"\r\n  notes = \"\"\"intra-CMP-006 import, declared anyway because gen_arch_map is multi-tagged (CMP-006/CMP-009 via LLR-080) \r\nand the multi-tag advisory names an undeclared edge into such a module; the seam of record is honest coverage, not \r\nsilence. The IF-117 why-an-import-and-not-a-copy reasoning applies verbatim: a second AST walk in the consumer is the \r\nsilent-divergence hazard a duplicated parser always is.\"\"\"\r\n  \r\n  [interface.IF-132]\r\n  rationale = \"\"\"The read replaces the retired parse of docs/architecture.md's committed MODULE MAP block - \r\nregistries/source -> dashboard, no markdown way-station.\"\"\"\r\n  \r\n> [interface.IF-263]\r\n  owner = \"scripts/trajectory_arch\"\r\n  requestors = [\"scripts/check_trajectory\"]\r\n  channel = \"call\"\r\n  data = \"architecture inventories and findings for seams, contracts, components, code symbols, spec boundaries, and \r\ntest-file tags\"\r\n  version = \"v1\"\r\n  status = \"Drafted\"\r\n  component = \"CMP-006\"\r\n  \r\n  [interface.IF-264]\r\n  owner = \"scripts/schedule\"\r\n  consumers = [\"scripts/traj_status\", \"scripts/agent_brief\", \"scripts/dispatch\", \"scripts/integrate\"]\r\n  channel = \"call\"\r\n\r\n","exit_code":0,"status":"completed"}}
