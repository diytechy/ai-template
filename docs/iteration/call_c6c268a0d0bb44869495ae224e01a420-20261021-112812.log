ding = \"The review gate serves the stated need for an honest pass verdict while preserving record-only review bookkeeping; no different stakeholder outcome is identified.\"\n411:def test_a_search_past_the_walk_bound_refuses(git_lane, capsys):\n412-    # TC-371. The walk below the reviewed commit is bounded: one bound short\n413-    # of it the attested commit still stands, one past it the render refuses\n414-    # naming the bound. Adequacy witness: an unbounded walk renders past the\n415-    # bound, and one that refuses below the bound refuses the first render.\n416-    root, base, tip, _side, out = git_lane\n417-    bound = kverdict._MAX_GOVERNING_WALK\n418-    head = _empty_commits(root, bound - 1)\n419-    assert rb.main(_review_argv(root, base, head, out)) == 0\n420-    assert _attested_line(capsys.readouterr().out, tip), \"no attested-commit line\"\n421-    (out / \"brief.md\").unlink()\n422-    head = _empty_commits(root, 2)\n423-    assert rb.main(_review_argv(root, base, head, out)) == 2\n424-    err = _refused(root, out, capsys, head)\n425-    assert \"no verified attestation within 64 record-only commits\" in err, err\n426-\n427-\n428-@pytest.mark.parametrize(\"rel\", [\"src/app.py\", \"docs/decisions/wi-900.toml\"])\n429-def test_a_work_commit_above_the_attested_one_refuses(git_lane, capsys, rel):\n430-    # TC-371. The decisions record is not a record path, so it needs the bar\n431-    # too. Adequacy witness: a walk that steps over any commit renders here.\n432-    root, base, _tip, _side, out = git_lane\n433-    _work(root, rel)\n434-    _git(root, \"commit\", \"-q\", \"-m\", \"work above the attested commit\")\n435-    sha = _git(root, \"rev-parse\", \"HEAD\")\n436-    assert rb.main(_review_argv(root, base, sha, out)) == 2\n437-    err = _refused(root, out, capsys, sha)\n438-    assert \"changes non-record paths over its parent\" in err, err\nTC-372.md\n tests/test_prompts.py                         |   7 +-\n tests/test_review_brief_git.py                |  40 ++++++++++\n 8 files changed, 169 insertions(+), 20 deletions(-)","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01Mn5T6jRJdYz6hT3xUZZ4Q2","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
