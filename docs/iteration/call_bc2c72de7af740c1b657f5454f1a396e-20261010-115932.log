 SR-238 and LLR-026 to processes still in the session's process group (POSIX) or job (Windows), recording the POSIX gap; or strengthen the POSIX mechanism.\n2. Add tests to TC-026 for the interruption path and for refusing a child that can't be contained. Pick one timing bound: either make the coordinator wait for descendants to end, or state the bound in SR-238 and have the test assert it.\n\nThen resubmit SR-238, LLR-026 and TC-026 together.","ttft_ms":2596,"type":"result","duration_ms":143615,"uuid":"0c2891dc-9aab-4d30-80a4-36cccfc3f079","ttft_stream_ms":1164,"time_to_request_ms":220,"time_to_request_phases_ms":{"other":17,"system_prompt":35,"resume_other":0,"process_user_input":3,"input_attachments":104,"input_hooks":1,"transcript_persist":1,"tool_pool_refresh":2,"init_message":10,"engine_pickup":0,"message_prep":1,"model_config_wait":1,"autocompact":1,"query_setup":0,"model_gates":1,"tool_schema_build":13,"message_normalization":14,"client_creation":4,"request_build":12},"turn_start_resume_kind":"none","process_turn_index":0,"time_to_request_loop_lag_ms":50,"time_to_request_cpu_ms":250,"time_to_request_major_faults":7143,"input_attachments_detail":{"slowest_producer":"changed_files","slowest_producer_ms":85,"cpu_ms":125,"major_faults":3854,"changed_files_reread":7},"first_content_frame_ms":1165,"queued_turn_count":0,"result_index":0}
