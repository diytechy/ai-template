test_the_rules_are_actually_WIRED_INTO_the_integrity_floor; tests/test_id_watermark.py::test_the_mint_does_not_reissue_a_deleted_id; tests/test_id_watermark.py::test_bump_ids_keeps_every_reservation_record; tests/test_id_watermark.py::test_correct_mark_keeps_every_reservation_record; tests/test_id_watermark.py::test_a_rise_covered_by_a_reservation_record_passes; tests/test_id_watermark.py::test_a_rise_above_every_record_is_refused; tests/test_id_watermark.py::test_an_altered_committed_record_is_refused; tests/test_id_watermark.py::test_a_deleted_committed_record_is_refused; tests/test_id_watermark.py::test_a_merge_dropping_one_parents_record_is_refused; tests/test_id_watermark.py::test_a_reservation_line_never_reads_as_a_correction; tests/test_id_watermark.py::test_a_malformed_reservation_line_justifies_nothing\\\"\\\"\\\"'\n\"'$x=A $x '\"'test.TC-401' @'\n[test.TC-401]\nverifies = [\\\"SR-174\\\", \\\"LLR-362\\\", \\\"IF-101\\\"]\nlevel = \\\"Integration\\\"\nmethod = \\\"\\\"\\\"Run carrier unit and repository cases. Drive every reserve argument refusal and assert that it writes neither carrier nor working watermark; drive sequential and stale-base reservations and assert disjoint ranges; drive a lost compare-and-swap and assert no write; and fold clean and conflicted watermarks, asserting maximum marks and the sorted, deduplicated record union.\\\"\\\"\\\"\ntier = \\\"Full\\\"\nexpected = \\\"\\\"\\\"Each admitted reservation receives a range above its applicable high-water mark; each refused reservation leaves both durable states unchanged; concurrent and sequential reservations are disjoint; a lost swap leaves no reservation; and each fold preserves the highest marks and every valid record exactly once.\\\"\\\"\\\"\nautomated = \\\"Yes\\\"\nevidence = \\\"\\\"\\\"tests/test_id_carrier.py; tests/test_id_carrier_git.py::test_first_reservation_seeds_the_carrier_from_trunk; tests/test_id_carrier_git.py::test_a_lost_race_refuses_with_nothing_written; tests/test_id_carrier_git.py::test_sequential_reservations_are_disjoint; tests/test_id_carrier_git.py::test_stale_base_reservations_are_disjoint; tests/test_id_carrier_git.py::test_a_reservation_after_a_ruled_correction_starts_above_it; tests/test_id_carrier_git.py::test_fold_ids_on_a_conflicted_watermark\\\"\\\"\\\"\nstatus = \\\"Drafted\\\"\nphase = 6\n'@\n\"'$x=A $x '\"'test.TC-402' @'\n[test.TC-402]\nverifies = [\\\"SR-174\\\", \\\"LLR-363\\\", \\\"IF-101\\\"]\nlevel = \\\"Integration\\\"\nmethod = \\\"\\\"\\\"Run real merge-slot and hand-squash landing cases. Drive every landing-table outcome, including a stale-base lane that minted another lane''s reserved number; move the carrier after a lane''s own fold and assert that each landing route carries the moved state; and drive a refresh conflict limited to the watermark.\\\"\\\"\\\"\ntier = \\\"Full\\\"\nexpected = \\\"\\\"\\\"A code-only landing passes; only added identities reserved for its claimed work item pass; each unreserved, other-work-item, reused, carrierless, unreadable-claim, or landing-only-record case refuses before landing; both routes land the carrier fold they read; and a watermark-only refresh conflict resolves to that fold.\\\"\\\"\\\"\nautomated = \\\"Yes\\\"\nevidence = \\\"\\\"\\\"tests/test_id_landing.py::test_the_extracted_sweep_equals_the_working_sweep_for_every_carrier_space; tests/test_id_landing.py::test_a_minus_000_placeholder_is_never_added; tests/test_id_landing.py::test_landing_fold_lag_reads_a_commit_and_an_index_tree; tests/test_id_landing.py::test_the_slot_folds_a_carrier_moved_after_the_lanes_refresh; tests/test_id_landing.py::test_a_code_only_lane_lands_with_the_carriers_fold; tests/test_id_landing.py::test_a_refresh_conflicting_only_on_the_watermark_is_resolved_by_the_fold; tests/test_id_landing.py::test_a_hand_squash_folds_a_carrier_moved_after_the_lanes_fold; tests/test_id_landing.py::test_a_code_only_squash_passes_with_no_reservation\\\"\\\"\\\"\nstatus = \\\"Drafted\\\"\nphase = 6\n'@;W \"'$p $x\n$p='\"'docs/requirements/interfaces.toml';\"'$x=R $p\n$x=C $x '\"'interface.IF-101' 'requestors' 'requestors = [\\\"scripts/intake\\\", \\\"scripts/plan_artifacts\\\", \\\"scripts/integrate\\\", \\\"scripts/check\\\"]'\n\"'$x=C $x '\"'interface.IF-101' 'data' 'data = \\\"read_watermark, bump_watermark, reserve_ids and fold_ids over docs/id-watermark; reservation records name a carrier space, inclusive range and work item; the carrier ref allocates every watermark space except WI, OI and DP, which remain trunk-minted; landing_id_refusal judges added identities against the carrier records and claimed work item; landing_fold_lag reports a watermark behind the carrier fold\\\"';W \"'$p $x\n'\"'@\n& ([scriptblock]::Create(\"'$guard))'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"\"C:\\\\Program Files\\\\PowerShell\\\\7\\\\pwsh.exe\" -Command '$_restore = @'\"'\n\"'$ErrorActionPreference = '\"'Stop'\n\"'$utf8 = [Text.UTF8Encoding]::new($false)\n$paths = @('\"'docs/requirements/system-requirements.toml','docs/requirements/low-level-requirements.toml','docs/requirements/interfaces.toml','docs/test/test-cases.toml')\nforeach (\"'$path in $paths) {\n  $psi = [Diagnostics.ProcessStartInfo]::new('\"'git', \\\"show HEAD:\"'$path\")\n  $psi.RedirectStandardOutput = $true; $psi.RedirectStandardError = $true; $psi.UseShellExecute = $false; $psi.StandardOutputEncoding = [Text.Encoding]::UTF8\n  $p = [Diagnostics.Process]::Start($psi); $text = $p.StandardOutput.ReadToEnd(); $err = $p.StandardError.ReadToEnd(); $p.WaitForExit()\n  if ($p.ExitCode -ne 0) { throw \"git show failed for $path: $err\" }\n  $text = $text -replace \"`r`n\", \"`n\" -replace \"`r\", \"`n\"\n  [IO.File]::WriteAllText($path, $text, $utf8)\n}\n'\"'@\n& ([scriptblock]::Create(\"'$_restore))\n$guard = @'\"'\n\"'$ErrorActionPreference='\"'Stop';\"'$u=[Text.UTF8Encoding]::new($false)\nfunction R($p){$x=[IO.File]::ReadAllText($p,[Text.Encoding]::UTF8);if($x.Contains(\"`r\")){throw '\"'CR'};\"'$x}\nfunction W($p,$x){if($x.Contains(\"`r\")){throw '\"'CR'};[IO.File]::WriteAllText(\"'$p,$x,$u)}\nfunction C($x,$s,$k,$v){$m=[regex]::Match($x,'\"'(?ms)(\"'^'\"\\\\['+[regex]::Escape(\"'$s)+'\"'\\\\]\\\\n)(.*?)(?=\"'^'\"\\\\[|\\\\z)');if(\"'!$m.Success){throw \"section $s\"};$b=$m.Groups[2].Value;$pat='\"'(?m)\"'^'\"'+[regex]::Escape(\"'$k)+'\"'\\\\s*=.*\"'$'\"';if([regex]::Matches(\"'$b,$pat).Count-ne 1){throw \"key $s $k\"};$nb=[regex]::Replace($b,$pat,$v,1);$x.Substring(0,$m.Groups[2].Index)+$nb+$x.Substring($m.Groups[2].Index+$m.Groups[2].Length)}\nfunction A($x,$s,$r){if([regex]::Matches($x,'\"'(?m)\"'^'\"\\\\['+[regex]::Escape(\"'$s)+'\"'\\\\]\"'$'\"').Count){throw \\\"exists \"'$s\"};$x.TrimEnd(\"`n\")+\"`n`n\"+$r.Trim()+\"`n\"}\n$p='\"'docs/requirements/system-requirements.toml';\"'$x=R $p\n$x=C $x '\"'requirement.SR-174' 'sn_refs' 'sn_refs = [\\\"SN-025\\\", \\\"SN-027\\\"]'\n\"'$x=C $x '\"'requirement.SR-174' 'requirement' 'requirement = \\\"\\\"\\\"The delivered loop content shall allocate each identity it mints at most once. Work items are minted on the integration branch alone. The registry identities that parallel lanes author are drawn from one shared reservation record. No two concurrent actors receive the same identity, and an identity freed by a deletion is never re-issued.\\\"\\\"\\\"'\n\"'$x=C $x '\"'requirement.SR-174' 'rationale' 'rationale = \\\"\\\"\\\"Identity allocation is its own decision, not a consequence of serialization: serializing the writer makes a COLLISION unlikely and does nothing about RE-USE, which is the half that silently re-points every commit message and archived document citing the freed id. The non-reuse clause has a \"'`shall` of its own here rather than living in SR-170'\"''s acceptance, which is a cell that cannot mint a requirement. Contributes to SN-025 (the ready frontier ordered deterministically, so two readers of the same registry dispatch the same work) by supplying a work-item identity that names one record for every reader, before and after a deletion. The keep-or-mint review checks LLR-153, LLR-154, TC-147, TC-148, TC-158, and the SR-170 and SR-173 rationales: each concerns the unchanged work-item allocation half.\\\"\\\"\\\"'\n\"'$x=C $x '\"'requirement.SR-174' 'acceptance_criteria' 'acceptance_criteria = \\\"\\\"\\\"Two actors finishing against the same tree cannot obtain the same work-item identity; an identity freed by deleting its record is not re-issued to new work; allocation counts from the recorded high-water mark rather than from the live maximum; reservations in sequence or at once, from any bases, receive disjoint ranges; a landing that adds a registry identity outside its own work item''s reservation is refused before it lands; a mark rises only by allocation, by a ruled correction, or by a recorded reservation.\\\"\\\"\\\"';W \"'$p $x\n$p='\"'docs/requirements/low-level-requirements.toml';\"'$x=R $p\n$x=A $x '\"'design.LLR-362' @'\n[design.LLR-362]\nsr_refs = [\\\"SR-174\\\"]\ntitle = \\\"The shared carrier and reservation record for lane-minted identities\\\"\nmodule = \\\"project-trajectory/scripts/id_carrier.py;project-trajectory/scripts/trace.py\\\"\ncode_symbol = \\\"CARRIER_REF/TRUNK_SPACES/carrier_spaces/parse_reservations/parse_counts/check_work_item/fold/fold_lag/plan_reservation/carrier_tip/carrier_text/write_carrier/landing_lines/render_watermark/bump_watermark/correct_watermark/_mark_history_findings\\\"\ndetail = \\\"\\\"\\\"The carrier holds the id watermark for every lane-minted space. A reservation moves the carrier by compare-and-swap and appends one record per requested space, stating its inclusive range and work item. Only a reservation writes a record, and only a fold copies one into a watermark. A committed record remains unchanged across every parent. Every watermark writer preserves the records it receives.\\\"\\\"\\\"\nrationale = \\\"\\\"\\\"Parallel lanes need one allocation authority: ranges chosen from separate bases otherwise collide, and a record that a later writer drops cannot justify either a raised mark or a landing. Compare-and-swap makes a lost race leave no reservation, while preserving records through each writer keeps the authority readable.\\\"\\\"\\\"\ntest_refs = \\\"TC-401;TC-158\\\"\nstatus = \\\"Drafted\\\"\ncomponent = \\\"CMP-006\\\"\nphase = 6\n'@\n\"'$x=A $x '\"'design.LLR-363' @'\n[design.LLR-363]\nsr_refs = [\\\"SR-174\\\"]\ntitle = \\\"A landing admits only its reserved identities and carries the current fold\\\"\nmodule = \\\"project-trajectory/scripts/trace.py;project-trajectory/scripts/integrate.py;project-trajectory/scripts/check.py\\\"\ncode_symbol = \\\"landing_id_refusal/landing_fold_lag/fold_watermark/_reserved_id_refusal/_landing_ready/_merge_trunk_in/_reserved_ids_mode\\\"\ndetail = \\\"\\\"\\\"A landing with no added carrier-space identity passes without a reservation. A landing whose added carrier-space identities all lie in records naming its claimed work item passes; an added identity outside such a record, an unreadable claim when identities were added, a missing carrier, or a landing-only record refuses before landing. Each landing carries the fold of the carrier tip it read: the automated landing refreshes a lagging tip, and the hand landing folds its staged watermark and refuses while it still lags. A refresh conflict limited to the watermark resolves to that fold; any other conflict remains refused.\\\"\\\"\\\"\nrationale = \\\"\\\"\\\"A reservation is authority only when the landing reads it. Folding the carrier's state into both landing routes prevents a valid reservation made after a lane's earlier fold from disappearing at integration, while retaining refusal for claims, records, and conflicts whose authority cannot be established.\\\"\\\"\\\"\ntest_refs = \\\"TC-402\\\"\nstatus = \\\"Drafted\\\"\ncomponent = \\\"CMP-008\\\"\nphase = 6\n'@;W \"'$p $x\n$p='\"'docs/test/test-cases.toml';\"'$x=R $p\n$x=C $x '\"'test.TC-158' 'method' 'method = \\\"\\\"\\\"Run the id-watermark suite. It drives trace.py''s CLI so the rules are asserted on the EXIT CODE, not just as a function call - the wiring into --strict-integrity is the guarantee, and a suite that only calls watermark_findings() survived deleting it. Covers the mint seam IF-101 declares: next_wi_id counts from the mark, so a deleted id is not re-issued, and the reader''s refusal on an absent mark is NOT caught. It also drives a rise justified by a reservation record, a rise above every record, an altered or deleted committed record, and writers that retain records.\\\"\\\"\\\"'\n\"'$x=C $x '\"'test.TC-158' 'expected' 'expected = \\\"\\\"\\\"A live id above its mark, a missing space, a malformed line, an absent file, a lowered mark and a hand-raised mark each fail loud; headroom left by a deleted row stays legal; the mint returns the next unused id after a deletion and refuses without a mark; a rise covered by a record passes, a rise above every record fails, an altered or deleted committed record fails, and a bump or correction retains every record.\\\"\\\"\\\"'\n\"'$x=C $x '\"'test.TC-158' 'evidence' 'evidence = \\\"\\\"\\\"tests/test_id_watermark.py::test_the_rules_are_actually_WIRED_INTO_the_integrity_floor; tests/test_id_watermark.py::test_the_mint_does_not_reissue_a_deleted_id; tests/test_id_watermark.py::test_bump_ids_keeps_every_reservation_record; tests/test_id_watermark.py::test_correct_mark_keeps_every_reservation_record; tests/test_id_watermark.py::test_a_rise_covered_by_a_reservation_record_passes; tests/test_id_watermark.py::test_a_rise_above_every_record_is_refused; tests/test_id_watermark.py::test_an_altered_committed_record_is_refused; tests/test_id_watermark.py::test_a_deleted_committed_record_is_refused; tests/test_id_watermark.py::test_a_merge_dropping_one_parents_record_is_refused; tests/test_id_watermark.py::test_a_reservation_line_never_reads_as_a_correction; tests/test_id_watermark.py::test_a_malformed_reservation_line_justifies_nothing\\\"\\\"\\\"'\n\"'$x=A $x '\"'test.TC-401' @'\n[test.TC-401]\nverifies = [\\\"SR-174\\\", \\\"LLR-362\\\", \\\"IF-101\\\"]\nlevel = \\\"Integration\\\"\nmethod = \\\"\\\"\\\"Run carrier unit and repository cases. Drive every reserve argument refusal and assert that it writes neither carrier nor working watermark; drive sequential and stale-base reservations and assert disjoint ranges; drive a lost compare-and-swap and assert no write; and fold clean and conflicted watermarks, asserting maximum marks and the sorted, deduplicated record union.\\\"\\\"\\\"\ntier = \\\"Full\\\"\nexpected = \\\"\\\"\\\"Each admitted reservation receives a range above its applicable high-water mark; each refused reservation leaves both durable states unchanged; concurrent and sequential reservations are disjoint; a lost swap leaves no reservation; and each fold preserves the highest marks and every valid record exactly once.\\\"\\\"\\\"\nautomated = \\\"Yes\\\"\nevidence = \\\"\\\"\\\"tests/test_id_carrier.py; tests/test_id_carrier_git.py::test_first_reservation_seeds_the_carrier_from_trunk; tests/test_id_carrier_git.py::test_a_lost_race_refuses_with_nothing_written; tests/test_id_carrier_git.py::test_sequential_reservations_are_disjoint; tests/test_id_carrier_git.py::test_stale_base_reservations_are_disjoint; tests/test_id_carrier_git.py::test_a_reservation_after_a_ruled_correction_starts_above_it; tests/test_id_carrier_git.py::test_fold_ids_on_a_conflicted_watermark\\\"\\\"\\\"\nstatus = \\\"Drafted\\\"\nphase = 6\n'@\n\"'$x=A $x '\"'test.TC-402' @'\n[test.TC-402]\nverifies = [\\\"SR-174\\\", \\\"LLR-363\\\", \\\"IF-101\\\"]\nlevel = \\\"Integration\\\"\nmethod = \\\"\\\"\\\"Run real merge-slot and hand-squash landing cases. Drive every landing-table outcome, including a stale-base lane that minted another lane''s reserved number; move the carrier after a lane''s own fold and assert that each landing route carries the moved state; and drive a refresh conflict limited to the watermark.\\\"\\\"\\\"\ntier = \\\"Full\\\"\nexpected = \\\"\\\"\\\"A code-only landing passes; only added identities reserved for its claimed work item pass; each unreserved, other-work-item, reused, carrierless, unreadable-claim, or landing-only-record case refuses before landing; both routes land the carrier fold they read; and a watermark-only refresh conflict resolves to that fold.\\\"\\\"\\\"\nautomated = \\\"Yes\\\"\nevidence = \\\"\\\"\\\"tests/test_id_landing.py::test_the_extracted_sweep_equals_the_working_sweep_for_every_carrier_space; tests/test_id_landing.py::test_a_minus_000_placeholder_is_never_added; tests/test_id_landing.py::test_landing_fold_lag_reads_a_commit_and_an_index_tree; tests/test_id_landing.py::test_the_slot_folds_a_carrier_moved_after_the_lanes_refresh; tests/test_id_landing.py::test_a_code_only_lane_lands_with_the_carriers_fold; tests/test_id_landing.py::test_a_refresh_conflicting_only_on_the_watermark_is_resolved_by_the_fold; tests/test_id_landing.py::test_a_hand_squash_folds_a_carrier_moved_after_the_lanes_fold; tests/test_id_landing.py::test_a_code_only_squash_passes_with_no_reservation\\\"\\\"\\\"\nstatus = \\\"Drafted\\\"\nphase = 6\n'@;W \"'$p $x\n$p='\"'docs/requirements/interfaces.toml';\"'$x=R $p\n$x=C $x '\"'interface.IF-101' 'requestors' 'requestors = [\\\"scripts/intake\\\", \\\"scripts/plan_artifacts\\\", \\\"scripts/integrate\\\", \\\"scripts/check\\\"]'\n\"'$x=C $x '\"'interface.IF-101' 'data' 'data = \\\"read_watermark, bump_watermark, reserve_ids and fold_ids over docs/id-watermark; reservation records name a carrier space, inclusive range and work item; the carrier ref allocates every watermark space except WI, OI and DP, which remain trunk-minted; landing_id_refusal judges added identities against the carrier records and claimed work item; landing_fold_lag reports a watermark behind the carrier fold\\\"';W \"'$p $x\n'\"'@\n& ([scriptblock]::Create(\"'$guard))'","aggregated_output":"","exit_code":1,"status":"failed"}}
