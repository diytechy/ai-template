d()\nassert '\\\\r' not in after_text, 'post-write text is not LF-only'\nafter = tomllib.loads(after_text)\nassert set(after) == set(before), 'top-level section set changed'\nfor top in after:\n    if top \"'!= section:\n        assert after[top] == before[top], f'\"'unrelated section moved: {top}'\nassert set(after[section]) == set(before[section]), 'row set changed'\nfor row_id, row in after[section].items():\n    if row_id \"'!= ident:\n        assert row == before[section][row_id], f'\"'unrelated row moved: {row_id}'\nassert set(after[section][ident]) == set(before[section][ident]), 'cell set changed'\nfor key, value in before[section][ident].items():\n    assert after[section][ident][key] == (new_value if key == cell else value), f'unexpected movement in {ident}.{key}'\nprint('guarded UTF-8/LF edit passed: LLR-360 detail changed; TOML parsed; no other cell moved')\n'@ | & 'C:/Projects/ai-template/.venv/Scripts/python.exe' -\ngit diff --check\ngit diff -- docs/requirements/low-level-requirements.toml\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
