+            + str((scaffold / "docs" / "architecture.md").resolve()).replace("\\", "/"),
+        ),
+        krow("CMP-003", "docs/knowledge/nested/../nested/found"),
+    )
+    proc = run_py(["scripts/trace.py", "--strict"], cwd=scaffold)
