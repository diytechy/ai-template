\r\n+method = \"Run dual and single plan coverage, reference, graph, exclusion, review-verdict finding, dispute-ruling, SR/TC-diff, absent-registry, and malformed-input cases. Exercise an exclusion citing an accepted SUCCESSOR of the same finding, and refuse SUCCESSOR rulings of another finding or another round. Exercise two dispute rounds in one lane reusing ids, each resolving its own finding; cite round 1's verdict for round 2's same-id finding; exercise a binding without the record with a matching findings file beside it; exercise recorded files that are missing, directories, not TOML, or record no such id with a matching file beside them; exercise the pass-record route at HEAD with a dismissal bound without its record; and exercise a dispute bound through the entry point against its own round's finding.\"\r\n+tier = \"Full\"\r\n+expected = \"A review verdict yields ordered F# clauses for its declared-severity findings only; a bracketed non-severity bullet yields no clause and does not shift later F# ids. A covered or reasoned-excluded finding passes; an uncovered finding, bad reference or plan graph, unexplained clause gap in either run (SINGLE Done-when or finding, DUAL goal clause), undeclared or reasonless exclusion, an F# exclusion citing a FIX, ESCALATE, non-accepted, mismatched, missing, unrelated, another-round same-numbered, or unshown dispute finding, an item SR no row cites (even if excluded), or a TC verifying an item SR that no row names nor excludes exits 1 by name. A mixed declared/verdict findings file, malformed input, or a missing Done-when exits 2; DUAL report bytes remain unchanged; absent registries note without failure. An accepted SUCCESSOR of the same finding resolves its exclusion; a SUCCESSOR of another finding or another round, or an unaccepted SUCCESSOR, leaves the finding unresolved; refusals of FIX or ESCALATE name DISMISS and SUCCESSOR as the resolving rulings. Two dispute rounds in one lane reusing ids each resolve their own finding, while round 1's verdict cited for round 2's same-id finding refuses. A binding without the record refuses by name with a matching findings file beside it; recorded files that are missing, directories, not TOML, or record no such id also refuse by name with a matching file beside them. The pass-record route at HEAD refuses a dismissal bound without its record. A dispute bound through the entry point resolves only its own round's finding.\"\r\n automated = \"Yes\"\r\n-evidence = \"tests/test_plan_coverage.py::test_the_shared_step_turns_a_real_verdict_into_F_clauses; tests/test_plan_coverage.py::test_a_bracketed_word_that_is_not_a_severity_never_shifts_the_F_ids; tests/test_plan_coverage.py::test_a_findings_file_mixing_both_shapes_is_malformed; tests/test_plan_coverage.py::test_an_uncovered_review_finding_refuses_the_dispatch; tests/test_plan_coverage.py::test_covered_or_excluded_review_findings_pass; tests/test_plan_coverage.py::test_a_dismissed_dispute_citing_its_ruling_passes; tests/test_plan_coverage.py::test_a_dispute_ruling_cited_by_its_own_id_passes; tests/test_plan_coverage.py::test_a_dismissal_of_an_unrelated_finding_refuses; tests/test_plan_coverage.py::test_a_dismissal_from_another_round_under_the_same_id_refuses; tests/test_plan_coverage.py::test_a_dismissal_whose_finding_cannot_be_shown_refuses; tests/test_plan_coverage.py::test_a_ruling_of_the_same_finding_passes_through_typographic_drift; tests/test_plan_coverage.py::test_a_cited_ruling_that_does_not_dismiss_refuses; tests/test_plan_coverage.py::test_a_real_dispute_verdict_ruling_FIX_refuses_its_exclusion; tests/test_plan_coverage_step.py::test_an_unexcluded_gap_in_plan_a_alone_bounces_only_a;tests/test_plan_coverage.py::test_a_successor_ruling_citing_its_verdict_passes;tests/test_plan_coverage.py::test_a_successor_ruling_of_another_finding_refuses\"\r\n+evidence = \"tests/test_plan_coverage.py::test_the_shared_step_turns_a_real_verdict_into_F_clauses; tests/test_plan_coverage.py::test_a_bracketed_word_that_is_not_a_severity_never_shifts_the_F_ids; tests/test_plan_coverage.py::test_a_findings_file_mixing_both_shapes_is_malformed; tests/test_plan_coverage.py::test_an_uncovered_review_finding_refuses_the_dispatch; tests/test_plan_coverage.py::test_covered_or_excluded_review_findings_pass; tests/test_plan_coverage.py::test_a_dismissed_dispute_citing_its_ruling_passes; tests/test_plan_coverage.py::test_a_dispute_ruling_cited_by_its_own_id_passes; tests/test_plan_coverage.py::test_a_dismissal_of_an_unrelated_finding_refuses; tests/test_plan_coverage.py::test_a_dismissal_from_another_round_under_the_same_id_refuses; tests/test_plan_coverage.py::test_a_dismissal_whose_finding_cannot_be_shown_refuses; tests/test_plan_coverage.py::test_a_ruling_of_the_same_finding_passes_through_typographic_drift; tests/test_plan_coverage.py::test_a_cited_ruling_that_does_not_dismiss_refuses; tests/test_plan_coverage.py::test_a_real_dispute_verdict_ruling_FIX_refuses_its_exclusion; tests/test_plan_coverage_step.py::test_an_unexcluded_gap_in_plan_a_alone_bounces_only_a;tests/test_plan_coverage.py::test_a_successor_ruling_citing_its_verdict_passes;tests/test_plan_coverage.py::test_a_successor_ruling_of_another_finding_refuses; tests/test_plan_coverage.py::test_two_dispute_rounds_reusing_ids_each_resolve_their_own_finding; tests/test_plan_coverage.py::test_round_ones_verdict_cited_for_round_twos_same_id_finding_refuses; tests/test_plan_coverage.py::test_a_binding_without_the_findings_record_refuses_and_reads_no_sibling; tests/test_plan_coverage.py::test_a_recorded_findings_file_that_cannot_show_the_finding_refuses; tests/test_plan_filing.py::test_at_the_cap_a_dismissal_bound_without_its_findings_file_is_refused; tests/test_coordinator_adjudicate.py::test_the_entry_points_dispute_binding_resolves_only_its_own_rounds_finding\"\r\n status = \"Approved\"\r\n phase = 1\r\n \r\n@@ -3349,11 +3349,11 @@ phase = 6\r\n [test.TC-327]\r\n verifies = [\"SR-156\", \"SR-232\", \"LLR-308\", \"LLR-310\", \"IF-115\", \"IF-287\"]\r\n level = \"Integration\"\r\n-method = \"Run test_the_done_when_brief_binds_the_digest_the_holds_compute, test_the_done_when_brief_refuses_an_unchanged_done_when, test_the_done_when_verdict_grammar, test_a_combined_sitting_composes_each_kind_from_its_own_brief, test_a_combined_sitting_refuses_whole_when_a_section_cannot_compose, test_a_combined_verdict_is_parsed_section_by_section, test_a_combined_verdicts_done_when_section_is_acted_on, test_both_new_classes_are_accepted_by_the_coordinator_entry_point, and test_this_repo_retains_both_new_classes, test_the_done_when_brief_carries_the_specs_context, test_a_combined_verdict_must_judge_exactly_the_kinds_its_sitting_requested, test_the_coordinator_reads_the_requested_kinds_from_the_composed_brief, test_a_combined_rows_tokens_scope_each_kinds_act, test_the_done_when_brief_refuses_an_unreadable_claim, test_the_done_when_brief_refuses_a_spec_with_no_context, test_the_done_when_brief_reads_a_closed_rows_claim_from_its_claim_commit, test_the_done_when_brief_clips_a_long_context_at_its_stated_limit, test_an_unrequested_section_refuses_the_combined_verdict, test_the_entry_point_binds_the_requested_kinds_beside_the_verdict, test_the_loop_route_accepts_a_combined_sitting_on_its_bound_kinds, and test_an_unusable_verdict_is_refused_and_says_which_way. Assert the done-when brief refuses unreadable, contextless and unchanged subjects, reads a closed subject at its claim commit, and states any 120-line Context clip; the entry point and loop bind a sitting's requested kinds beside its verdict; and a combined sitting presents exactly its bound requested scoped kinds and refuses an invalid or unrequested section.\"\r\n86d0d097f71599506c071cfa0a37552f70a3c976\n","exit_code":0,"status":"completed"}}
