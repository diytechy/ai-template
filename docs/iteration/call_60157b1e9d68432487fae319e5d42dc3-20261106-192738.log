mated = \"Yes\"\n4141-evidence = \"tests/test_review_set.py::test_a_bootstrapped_scaffold_derives_the_set; tests/test_review_set.py::test_a_lane_closed_in_its_own_tree_reads_its_closed_copy; tests/test_review_set.py::test_each_unreadable_input_refuses_by_name; tests/test_review_set.py::test_the_tag_readers_refusal_passes_through\"\n4142-status = \"Drafted\"\n--\n4145:[test.TC-417]\n4146-verifies = [\"SR-156\", \"SR-241\", \"LLR-207\", \"LLR-367\", \"IF-154\"]\n4147-level = \"Integration\"\n4148-method = \"Drive the attest command line and call over seeded lanes and read what ran, what was recorded and what was printed.\"\n4149-tier = \"Full\"\n4150-expected = \"Attestation accepts no hand test list, derives before any bar, preserves branch and index and runs no bar on refusal, runs the review bar then derived files, records their digest, and prints the result.\"\n4151-automated = \"Yes\"\n4152-evidence = \"tests/test_integrate_attest.py::test_a_derivation_refusal_runs_no_bar_and_leaves_branch_and_index; tests/test_integrate_attest.py::test_a_row_touching_no_code_runs_the_bar_alone; tests/test_integrate_attest.py::test_attest_prints_the_gaps_a_row_touching_no_code_reports; tests/test_integrate_attest.py::test_attest_prints_the_set_and_the_listed_evidence; tests/test_integrate_attest.py::test_attest_runs_the_review_bar_then_the_derived_files; tests/test_integrate_attest.py::test_attest_takes_no_tests_argument\"\n4153-status = \"Drafted\"\n--\n4156:[test.TC-418]\n4157-verifies = [\"SR-154\", \"SR-241\", \"LLR-344\", \"LLR-367\", \"IF-173\"]\n4158-level = \"Integration\"\n4159-method = \"Run the loop over seeded lanes and read the rounds drawn, the red records and the attestations.\"\n4160-tier = \"Full\"\n4161-expected = \"An unattended draw compares its record with the derived set; a derivation refusal records the existing red route without a round; and a closed lane derives through its closed copy.\"\n4162-automated = \"Yes\"\n4163-evidence = \"tests/test_agent_loop_review_gate.py::test_a_closed_lane_draws_over_its_closed_copy; tests/test_agent_loop_review_gate.py::test_a_code_lane_with_an_untagged_tc_draws_no_round; tests/test_agent_loop_review_gate.py::test_a_derivation_refusal_counts_toward_the_red_cap; tests/test_agent_loop_review_gate.py::test_the_draw_runs_the_derived_files_and_compares_their_digest\"\n4164-status = \"Drafted\"\n--\n4167:[test.TC-419]\n4168-verifies = [\"SR-241\", \"SR-154\", \"LLR-341\", \"LLR-313\", \"LLR-367\", \"IF-288\"]\n4169-level = \"Integration\"\n4170-method = \"Drive the review render over seeded lanes with records for the derived set, another set and none.\"\n4171-tier = \"Full\"\n4172-expected = \"Review rendering accepts no hand test list, renders the derived set, refuses a mismatch naming both digests or a derivation refusal with its text, the reviewed commit and the attest step, and renders an allowed empty set without a test command while stating why.\"\n4173-automated = \"Yes\"\n4174-evidence = \"tests/test_review_brief_git.py::test_a_derivation_refusal_refuses_the_render_with_its_text; tests/test_review_brief_git.py::test_a_working_tree_tag_edit_refuses_naming_both_digests; tests/test_review_brief_git.py::test_an_empty_set_renders_no_pytest_line_and_says_why; tests/test_review_brief_git.py::test_the_refusal_hint_names_attest_without_tests; tests/test_review_brief_git.py::test_the_render_lists_the_derived_files; tests/test_review_brief_git.py::test_the_render_takes_no_tests_argument\"\n4175-status = \"Drafted\"\n--\n4178:[test.TC-420]\n4179-verifies = [\"SR-241\", \"LLR-367\"]\n4180-level = \"Integration\"\n4181-method = \"Bootstrap a scaffold, claim a lane in it and derive the set from its shipped scripts.\"\n4182-tier = \"Full\"\n4183-expected = \"A bootstrapped scaffold derives the review test set from its work-item requirement trace and test declarations.\"\n4184-automated = \"Yes\"\n4185-evidence = \"tests/test_review_set.py::test_a_bootstrapped_scaffold_derives_the_set\"\n4186-status = \"Drafted\"\ndocs/requirements/system-requirements.toml:1906:[requirement.SR-241]\ndocs/requirements/system-requirements.toml-1907-title = \"Review briefs render only over a matching verified review record\"\ndocs/requirements/system-requirements.toml-1908-sn_refs = [\"SN-004\", \"SN-008\"]\ndocs/requirements/system-requirements.toml-1909-boundary_refs = [\"B-05\"]\ndocs/requirements/system-requirements.toml-1910-hat_refs = [\"PERFORMANCE\"]\ndocs/requirements/system-requirements.toml-1911-requirement = \"When an attended launcher requests a review brief for a lane commit, the delivered review content shall render it only when that commit, or a commit beneath it from which only record changes or no changes separate it, carries a verified record that the declared review bar and the test set derived from the work item's requirements passed on its tree; otherwise it refuses without a brief and names the cause and the step that makes the record.\"\ndocs/requirements/system-requirements.toml-1912-rationale = \"A DERIVED requirement, and labelled so. SN-004 and SN-008 require trustworthy gate outcomes, but do not say that a metered independent-review session must be withheld when its requested tree is already known not to meet its declared review bar. The performance lens listens for operating cost left unassessed: a review over such a tree spends the scarce review session on a failure the process can name before dispatch, while a record-only change must not require the same bar again. Trusting the verified record was chosen over running the bar during rendering because rendering then stays a bounded reader of a prior result rather than a second executor with a potentially different result. The coordinator and unattended review routes decompose this shared boundary separately. Fed back to the needs: their acceptance could state that a review begins only from a verified review-bar result.\"\ndocs/requirements/system-requirements.toml-1913-acceptance_criteria = \"A requested review renders when its commit carries a verified review record for the test set derived from the work item's requirements, and when only record changes or no changes separate it from such a commit; it refuses without a brief when that record is absent, malformed, names another tree or parent, names another bar or test set, when a commit above it changes a non-record path, or when derivation reports no requirements, an empty set, or a partial set for code-touching work. A non-code change may render with an empty set and reported gaps. Every refusal names the reviewed commit, the cause and the step that records a passing review bar; a test-set mismatch names both digests and a tree or parent mismatch names both values.\"\n--\ndocs/requirements/low-level-requirements.toml:3407:[design.LLR-313]\ndocs/requirements/low-level-requirements.toml-3408-sr_refs = [\"SR-146\", \"SR-154\", \"SR-235\"]\ndocs/requirements/low-level-requirements.toml-3409-title = \"Attended review, critique and single-plan briefs and records\"\ndocs/requirements/low-level-requirements.toml-3410-module = \"project-trajectory/scripts/review_brief.py\"\ndocs/requirements/low-level-requirements.toml-3411-code_symbol = \"Round/spec_path/round_facts/render_review/render_critique/review_refusal/round_path/file_review/lane_commits/_registry_lines/latest_critique/critique_findings/render_plan/coverage_run/render_plan_critique/file_plan_critique/pass_fields/_ruled_findings/write_pass/_critique_coverage/dispute_findings/write_dispute_findings/_test_lines\"\ndocs/requirements/low-level-requirements.toml-3412-detail = \"Round accepts only a full-lane review with no prior findings or a narrow review that names the prior findings file. render_review strictly fills the shipped reviewer template with the work-item specification, lane range, scratch location, optional review rubric and verdict destination; an empty derived set is a valid round, renders no test command, and states that the row touches no code; listed evidence and reported gaps render beside the test command; render_critique strictly fills the shipped critique template with the work-item specification and named rubric. Both refuse a missing specification, unreadable or empty named input, or unfilled template slot before a brief is written. review_refusal accepts only a verdict bound to the reviewed full commit after the shared review-line reader accepts exactly one line whose keyword, in any case, is VERDICT, in exactly the canonical form `VERDICT: <APPROVE|CHANGES-REQUESTED> findings=<digits>`, whose count matches the finding lines the review scorer reads from declared-severity brackets and whose changes request names a finding. round_path chooses the next ordinal lane round filename, file_review writes only an accepted verdict as that round record when the round reader reads its lane path back as that lane's scope, and lane_commits resolves commits on a branch and requires the base to be an ancestor of the reviewed commit. A first plan critique is bound to its named lane commit, includes coverage over the Done-when alone, opens with that commit, and refuses a missing rubric, plan or specification, a missing or beyond delta, a coverage failure, or a third round. A second plan critique is bound to its named lane commit, includes coverage over the Done-when and the first critique's finding identifiers, never their text, uses convergence stance, and refuses a revision that leaves a first-critique finding neither covered nor excluded. A single-plan brief strictly fills the shipped single-plan template with the specification, ordered Done-when clauses, required registry references, and one planner output path; a revision additionally labels the committed plan and latest filed critique findings as claims under judgement. It refuses a missing specification, Done-when, plan or critique, or an unfilled slot. A critique record is filed only when it is bound to an ancestor that holds the plan and has the verdict form; a pass record is written only from committed cited records, passing plan coverage, and a passing delta, after an approval or an accepted dismissal of every blocking and major second-round finding. At the cap, a dispute findings file is written only from the committed second critique, giving each blocking and major finding the identifier of its position among all critique findings, its text verbatim, and a declared position; it refuses another identifier set or an existing file. The second plan critique's brief never carries the first critique's verdict or any finding's text. A review round is ordinary by default or convergence: ordinary emits no stance line, while convergence emits one fixed stance line after the range and refuses a narrow scope or unknown stance before writing a brief. An ordinary review reading scope reads the delegated-decisions record and filed plan critiques, while a convergence scope excludes both; a convergence render refuses a reviewer template whose reading-scope command does not carry the review-record exclusion exactly once. The scope critique names the component and interface registries, derived architecture, runtime flows, and dependency ledger, marking an absent registry; the single-plan brief and scope critique render their registry lines from one declared set. A plan critique ties every severity class to a normal-use-reachable defect: a fail-open, data-loss, or security path counts only when a supported workflow or the kit's own routes reach it, and a rare or contrived path is MINOR at most or dismissed. Its confirming round treats a new finding as BLOCKER or MAJOR only when it is a reachable fail-open, data-loss, or Done-when gap; anything else is MINOR. A finding line bearing the convergence-class tag defined by LLR-311 is filed and counted as one finding under the unchanged verdict grammar.\"\ndocs/requirements/low-level-requirements.toml-3413-rationale = \"An attended reviewer needs the same reviewed instructions and durable verdict carrier as an unattended review without inheriting its scheduler. Strict rendering and boundary validation prevent a reviewer from receiving incomplete instructions or an unrelated verdict from becoming review history.\"\ndocs/requirements/low-level-requirements.toml-3414-test_refs = \"TC-333; TC-419\"\n--\ndocs/requirements/low-level-requirements.toml:3575:[design.LLR-341]\ndocs/requirements/low-level-requirements.toml-3576-sr_refs = [\"SR-241\"]\ndocs/requirements/low-level-requirements.toml-3577-title = \"Verified review-record search before review rendering\"\ndocs/requirements/low-level-requirements.toml-3578-module = \"project-trajectory/scripts/kitlib/verdict.py;project-trajectory/scripts/review_brief.py\"\ndocs/requirements/low-level-requirements.toml-3579-code_symbol = \"read_bar_attestation/review_attestation/_identity_step;_review_bar_refusal\"\ndocs/requirements/low-level-requirements.toml-3580-detail = \"The review render resolves the reviewed commit and searches that commit, then its first-parent ancestors only while their non-record identities remain equal, for one verified review-bar record whose test digest equals the digest of the derived test set. Equivalent spellings and orderings of a derived test set yield the same digest. It does not peel a disposable commit. An absent, malformed or unverified record, another bar, another test set, a changed non-record path, or no verified record among the first 64 commits the search examines, the reviewed commit included, produces a refusal; a landing or no-bar record is another-bar refusal. The refusal reports the reviewed commit, cause, both bar values for another-bar refusal, both digests for a test-set mismatch or both values for a tree or parent mismatch, and the attest step without a test list; a derivation refusal keeps the derivation's text whole and reports the reviewed commit and the attest step; it writes no brief and returns the refusal result. A successful render reports the attested commit and digest. The search reads the record and never runs the bar.\"\ndocs/requirements/low-level-requirements.toml-3581-rationale = \"One shared record reader keeps each review route from assigning its own meaning to a verified review result. Searching only through record-only ancestors preserves a valid result across review bookkeeping while stopping at work that can invalidate it; refusing rather than re-running preserves the separation between recording a result and deciding whether it is usable.\"\ndocs/requirements/low-level-requirements.toml-3582-test_refs = \"TC-371; TC-419\"\n--\ndocs/requirements/low-level-requirements.toml:3805:[design.LLR-367]\ndocs/requirements/low-level-requirements.toml-3806-sr_refs = [\"SR-241\"]\ndocs/requirements/low-level-requirements.toml-3807-title = \"Derive a lane review test set from its requirement trace\"\ndocs/requirements/low-level-requirements.toml-3808-module = \"project-trajectory/scripts/review_set.py;project-trajectory/scripts/kitlib/spine.py\"\ndocs/requirements/low-level-requirements.toml-3809-code_symbol = \"derive/ReviewSet/ReviewSet.notes/ReviewSet.lines/_Refused/_base/_claimed_id/_row_srs/_changed/_roots/_registry/_tags/_touches_code/_walk/_answer/root_prefix/llrs_under/review_scope/_case_answer/_unverified\"\ndocs/requirements/low-level-requirements.toml-3810-detail = \"The derivation reads the merge base, then one claimed work item found at the lane tip or that base, using its closed copy when available, then its requirement references, its changed paths and declared paths, before registries and test declarations. Its scope is the row's referenced system requirements, every low-level requirement referring to any of them, and every test case of any status verifying either; directly verified system requirements have no gap. Each scoped test case is exactly one of tagged, declared non-executable, untagged executable, or no evidence. It returns the sorted union of tagged test files, lists a tagged test case's non-test evidence and declared non-executable evidence without running it, and returns every gap: an unverified system requirement or low-level requirement, an untagged executable test case, or a test case with no evidence; sibling low-level requirements are included. Code-touching is a changed path from merge base to staged tree under the declared source or tests roots, with both ends of a rename counted; all other paths are not code-touching. A code-touching row with no requirement reference refuses by name; one with any gap refuses partial naming every gap; one with no tagged file and no gap refuses empty; a row not touching code reports gaps without refusal, permits an empty set, and runs a non-empty set. Missing or multiple claims, malformed frontmatter or requirement references, a missing referenced system requirement, unreadable or malformed registries, paths declaration, trunk declaration, or a test-declaration refusal refuse by name; an unreadable input outranks partial and empty. The derivation reads the lane's own tree and never widens to the whole bar. Its covered behavior is the claim copy, scope walk, classes, changed-path decision, input refusals, set printing, attestation, draw, rendering, and closed-lane routes; hand-edited claim copies or records, path aliases, and sub-second timing windows are outside this bound.\"\ndocs/requirements/low-level-requirements.toml-3811-rationale = \"One closed derivation prevents recording, drawing, and rendering from disagreeing about required verification while preserving named, repairable refusals.\"\ndocs/requirements/low-level-requirements.toml-3812-test_refs = \"TC-413; TC-414; TC-415; TC-416; TC-417; TC-418; TC-419; TC-420\"\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_9","type":"agent_message","text":"Reconciled the checkpoint rows. I did not run lints or pytest, as directed.\n\n| Row / cell | Before → after | Why |\n|---|---|---|\n| TC-417 `verifies` | `[\"SR-156\", \"LLR-207\", \"IF-154\"]` → `[\"SR-156\", \"SR-241\", \"LLR-207\", \"LLR-367\", \"IF-154\"]` | Closes the derived-set trace. |\n| TC-418 `verifies` | `[\"SR-154\", \"LLR-344\", \"IF-173\"]` → `[\"SR-154\", \"SR-241\", \"LLR-344\", \"LLR-367\", \"IF-173\"]` | Closes the derived-set trace. |\n| TC-419 `verifies` | `[\"SR-241\", \"SR-154\", \"LLR-341\", \"LLR-313\", \"IF-288\"]` → `[\"SR-241\", \"SR-154\", \"LLR-341\", \"LLR-313\", \"LLR-367\", \"IF-288\"]` | Adds the set derivation it exercises. |\n| TC-413–TC-420 `method` | “Run the planned derivation tests for this case.” → each change-list-specific final method | Identifies the actual test activity. |\n| TC-416 `expected` | Includes bootstrap scaffold → only malformed-input/tag-refusal and closed-copy outcomes | Leaves scaffold delivery solely to TC-420. |\n| TC-414 `expected` | Gap/partial/empty clauses → adds “a system requirement verified only through its low-level requirement has no gap” | Covers the through-LLR case. |\n| TC-419 `expected` | Derivation refusal “with its text” → adds reviewed commit and attest step | Matches the repaired render refusal. |\n| LLR-367 `detail` | Claim copy before base → merge base first, then lane-tip/base claim | Matches settled read order. |\n| LLR-313 `detail` | Empty-set rendering clause → adds listed evidence and reported gaps beside the test command | States the rendered notes. |\n| LLR-341 `detail` | Derivation refusal returns same text → keeps the text whole and reports reviewed commit plus attest step | Matches render behavior. |\n| SR-241 `acceptance_criteria` | Empty/partial refusal unqualified; only no-requirement non-code exemption → all no-SR/empty/partial refusals scoped to code-touching work; any non-code change may render with an empty set and reported gaps | Aligns SR acceptance with LLR-367. |\n\nAll TC expected clauses now have a governing sentence in the cited set; no unmatched clause found.\n\nArms map:\n\n| LLR | Outcomes, refusals, exemptions | TC coverage |\n|---|---|---|\n| LLR-367 | Sorted tagged files; listed evidence; all gaps; named no-SR, partial, empty, malformed/unreadable refusals; non-code rows report gaps and allow empty sets; no whole-bar fallback; closed-copy read; specified coverage exclusions | TC-413–TC-420 |\n| LLR-207 | Derives before the bar; refusal runs no bar and preserves branch/index; bar then derived files; digest; prints set/listed evidence/gaps | TC-417, TC-132 |\n| LLR-341 | Derived-set digest comparison; mismatch reports both digests; derivation refusal keeps its text and reports reviewed commit/attest step; no brief | TC-419, TC-371 |\n| LLR-344 | Derived-set attestation permits draw; derivation refusal becomes red/no round/named rework/red-cap; closed-copy draw | TC-418 |\n| LLR-313 | Empty set is a valid round; no test command; non-code explanation; listed evidence/gaps beside a non-empty command | TC-333, TC-419 |"}}
