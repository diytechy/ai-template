 = \"Approved\""," component = \"CMP-008\""," phase = 6","+","+[design.LLR-311]","+sr_refs = [\"SR-233\"]","+title = \"Review threat-model definition and reviewer reference\"","+module = \"project-trajectory/PROCESS.md;project-trajectory/prompts/reviewer.template.md\"","+code_symbol = \"Review threat model;REVIEWER\"","+detail = \"The §6 bold-lead paragraph `Review threat model` defines the review scope: normal-environment defects include repository content agents write, supported configurations, and regressions of supported behavior; compromised or contrived host reproductions are ruled out, with the ruling party recording the dismissal in one recorded line in the response to the review verdict and, when the run keeps a delegated-decisions record, in that record too, without a code response. The enumerated set of delivered briefs that judge a review finding, whose only member today is the reviewer brief, each cite that bold lead and do not copy its boundary examples.\"","+rationale = \"The process document is the stable home for the scope, while the brief must direct each reviewer to that home. Repeating the examples in the brief would create a second definition that can drift from the process rule.\"","+test_refs = \"TC-332\"","+status = \"Approved\"","+component = \"CMP-008\"","+phase = 6"]}]},{"filePath":"C:\\Projects\\ai-template.wt\\wi-860\\docs\\archive\\last_approved\\docs\\requirements\\system-requirements.toml","hunks":[{"oldStart":1786,"oldLines":3,"newStart":1786,"newLines":18,"lines":[" status = \"Approved\""," phase = 6"," form = \"interface\"","+","+[requirement.SR-233]","+title = \"Review threat model\"","+sn_refs = [\"SN-006\"]","+boundary_refs = [\"B-09\", \"B-10\"]","+hat_refs = [\"UNATTENDED-OPS\"]","+requirement = \"The delivered review process shall limit findings to defects reachable in a normal working environment.\"","+rationale = \"A DERIVED requirement, and labelled so. SN-006 requires an unattended run to report failures clearly and to continue until it must surface to a human; it does not say which hostile host conditions a review must treat as an actionable defect. The unattended-operations lens listens for an unbounded retry: treating a reproduction that depends on a compromised or contrived host as actionable can extend review indefinitely and can demand code that compensates for a host whose integrity the process cannot establish. A stated boundary was chosen over relying on each reviewer to infer it, because an inferred boundary varies by session and cannot stop repeated rework. Fed back to the need: SN-006's acceptance could identify the normal working environment in which a review finding is actionable; until it does, this row is derived and says so.\"","+acceptance_criteria = \"The review scope includes repository content agents write, supported configurations, and regressions of supported behavior; one authoritative definition excludes a finding whose reproduction requires a compromised or contrived host; the party that rules an out-of-scope finding records its dismissal in one recorded line in the response to the review verdict and, when the run keeps a delegated-decisions record, in that record too, without a code response; and the enumerated set of delivered briefs that judge a review finding, whose only member today is the reviewer brief, each cite that definition without restating its boundary examples.\"","+priority = \"S\"","+verification = \"Test\"","+status = \"Approved\"","+phase = 6","+aspect = \"process\"","+form = \"cross-cutting\""]}]},{"filePath":"C:\\Projects\\ai-template.wt\\wi-860\\docs\\archive\\last_approved\\docs\\test\\test-cases.toml","hunks":[{"oldStart":3363,"oldLines":3,"newStart":3363,"newLines":14,"lines":[" evidence = \"tests/test_integrate_admission.py::test_an_in_lane_act_backed_by_an_accepted_verdict_merges_at_the_slot; tests/test_integrate_admission.py::test_an_in_lane_act_with_no_verdict_is_refused; tests/test_integrate_admission.py::test_an_in_lane_act_wh