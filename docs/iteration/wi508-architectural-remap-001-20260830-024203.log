{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015ZshEJvbocKuwXw6HQXuwy","type":"tool_result","content":"364\tdef main(argv=None):\n365\t    ap = argparse.ArgumentParser(\n366\t        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter\n367\t    )\n368\t    ap.add_argument(\"--root\", default=\".\", help=\"repo root (default: cwd)\")\n369\t    ap.add_argument(\"src\", help=\"repo-relative path of the file to move\")\n370\t    ap.add_argument(\"dest\", nargs=\"?\", help=\"repo-relative destination path\")\n371\t    ap.add_argument(\n372\t        \"--archive\",\n373\t        action=\"store_true\",\n374\t        help=\"derive the destination: docs/archive/specs/<stem>.<date>.md\",\n375\t    )\n376\t    ap.add_argument(\n377\t        \"--date\",\n378\t        default=None,\n379\t        help=\"the archival date stamp (YYYY-MM-DD; default: today)\",\n380\t    )\n381\t    args = ap.parse_args(argv)\n382\t    if bool(args.dest) == bool(args.archive):\n383\t        ap.error(\"give exactly one of DEST or --archive\")\n384\t    root = Path(args.root).resolve()\n385\t    dest = args.dest\n386\t    if args.archive:\n387\t        dest = archive_dest(args.src, args.date or datetime.date.today().isoformat())\n388\t    touched, refusal = move_spec(root, args.src, dest)\n389\t    if refusal:\n390\t        print(\"spec_move: REFUSED - {}\".format(refusal), file=sys.stderr)\n391\t        return 1\n392\t    print(\"spec_move: {} -> {}\".format(args.src, dest))\n393\t    for rel in touched:\n394\t        print(\"spec_move: relinked {}\".format(rel))\n395\t    return 0\n396\t\n397\t\n398\tif __name__ == \"__main__\":"}]},"parent_tool_use_id":null,"session_id":"956b541d-3742-4ad3-bcfb-33caa85fe04d","uuid":"40a0af00-5c05-4fbf-8dfa-af26a7e2f6e9","timestamp":"2026-08-30T07:55:21.304Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\Projects\\ai-template-drive\\wi508-architectural-remap\\project-trajectory\\scripts\\spec_move.py","content":"def main(argv=None):\n    ap = argparse.ArgumentParser(\n        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter\n    )\n    ap.add_argument(\"--root\", default=\".\", help=\"repo root (default: cwd)\")\n    ap.add_argument(\"src\", help=\"repo-relative path of the file to move\")\n    ap.add_argument(\"dest\", nargs=\"?\", help=\"repo-relative destination path\")\n    ap.add_argument(\n        \"--archive\",\n        action=\"store_true\",\n        help=\"derive the destination: docs/archive/specs/<stem>.<date>.md\",\n    )\n    ap.add_argument(\n        \"--date\",\n        default=None,\n        help=\"the archival date stamp (YYYY-MM-DD; default: today)\",\n    )\n    args = ap.parse_args(argv)\n    if bool(args.dest) == bool(args.archive):\n        ap.error(\"give exactly one of DEST or --archive\")\n    root = Path(args.root).resolve()\n    dest = args.dest\n    if args.archive:\n        dest = archive_dest(args.src, args.date or datetime.date.today().isoformat())\n    touched, refusal = move_spec(root, args.src, dest)\n    if refusal:\n        print(\"spec_move: REFUSED - {}\".format(refusal), file=sys.stderr)\n        return 1\n    print(\"spec_move: {} -> {}\".format(args.src, dest))\n    for rel in touched:\n        print(\"spec_move: relinked {}\".format(rel))\n    return 0\n\n\nif __name__ == \"__main__\":","numLines":35,"startLine":364,"totalLines":400}}}
