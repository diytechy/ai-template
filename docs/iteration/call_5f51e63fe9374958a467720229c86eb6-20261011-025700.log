erdict notes, outside both findings:\n- `trace.py --strict` also fails on LLR-292's word \"minimal\". That predates this lane and is unchanged in it.\n- There's a process gap: the closure check before a sitting should run this form check on `Drafted` rows, so a failure like DB's shows up before approval rather than after.\n\nThe `.requested` binding file is still untracked, left for the coordinator.","ttft_ms":1690,"type":"result","duration_ms":155898,"uuid":"08bb956e-8a06-470b-8ce6-b621fe5e5dd2","ttft_stream_ms":1145,"time_to_request_ms":304,"time_to_request_phases_ms":{"other":24,"system_prompt":28,"resume_other":0,"process_user_input":2,"input_attachments":215,"input_hooks":1,"transcript_persist":1,"tool_pool_refresh":2,"init_message":4,"engine_pickup":1,"message_prep":0,"model_config_wait":2,"autocompact":2,"query_setup":0,"model_gates":0,"tool_schema_build":8,"message_normalization":6,"client_creation":2,"request_build":6},"turn_start_resume_kind":"none","process_turn_index":0,"time_to_request_loop_lag_ms":23,"time_to_request_cpu_ms":516,"time_to_request_major_faults":39911,"input_attachments_detail":{"slowest_producer":"at_mentioned_files","slowest_producer_ms":129,"cpu_ms":407,"major_faults":37283,"changed_files_reread":2},"first_content_frame_ms":1145,"queued_turn_count":0,"result_index":0}]
