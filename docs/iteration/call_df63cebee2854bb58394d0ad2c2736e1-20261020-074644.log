st.skip(\"the PowerShell dev-setup on Windows\")\n    env = _devsetup_env(**_signed_in_login_home(tmp_path))\n    _retention(scaffold_root, 55)\n    try:\n        with _adjudicator(scaffold_root, kind=\"login\", verified=verified):\n            proc = subprocess.run(\n                argv,\n                cwd=str(scaffold_root),\n                capture_output=True,\n                text=True,\n                input=\"\",\n                env=env,\n                timeout=180,\n            )\n    finally:\n        _retention(scaffold_root, 0)\n    assert proc.returncode == 0, proc.stdout + proc.stderr\n    line = _signin_line(proc.stdout)\n    assert line.startswith(\"  [ok]\"), proc.stdout\n    assert \"(account ADJUDICATOR, its own home)\" in line, line\n    assert \"setup-token\" not in line and \"[y/N]\" not in proc.stdout\n    if verified:\n        assert \"UNVERIFIED\" not in line, line\n    else:\n        assert \"UNVERIFIED: its login-isolation check has not passed\" in line, line\n\n\nCANARY = \"[REDACTED]\"  # a fake token shaped like a real one; privacy-ok\n\n\n@pytest.mark.parametrize(\"family\", [\"sh\", \"ps1\"])\ndef test_the_sign_in_report_never_prints_or_stores_the_token(\n    scaffold_root, tmp_path, family\n):\n    \"\"\"Signed in, the report names the token's variable and never its value:\n    the canary is in neither stream nor in any file under the repository.\"\"\"\n    if family == \"sh\":\n        argv = [_sh(), \"scripts/dev-setup.sh\", \"--check\"]\n    elif WINDOWS:","is_error":false}]},"parent_tool_use_id":null,"session_id":"726af005-72ee-4ae5-b3a9-c78cd6ec31fc","uuid":"62fe99ec-7e66-4765-b842-e6954ffdbe0c","timestamp":"2026-10-20T12:45:33.925Z","tool_use_result":{"stdout":"49d91cd38 WI-798: Terra answers sitting 013's TC-344 return: its Method drives the signed-in login account, verified and unverified, and its evidence cites the test\n88324f6b4 WI-798: dev-setup's report of a signed-in login account is driven on both launcher families