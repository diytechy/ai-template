":[{"oldStart":3333,"oldLines":6,"newStart":3333,"newLines":6,"lines":[" detail = \"dispute_values accepts exactly one findings-file reference from an adjudication row, reads it through kitlib.dispute, and refuses an unreadable or malformed file. It accepts only a hexadecimal base..head range that git resolves, derives that range's commit and name-status facts, and fills the dispute template's range, commits, request, findings, and process-document values. _render_finding preserves each finding and held position between labelled delimiters. BRIEF_PROMPTS routes the dispute class to its shipped template, so the existing strict fill refuses a partial brief.\""," rationale = \"The adjudicator needs the reviewer wording and the contested position as subjects to judge, while the range facts and review-scope link must be independently derived. Refusing an incomplete assembly avoids sending a judge a brief that appears complete but has lost a finding or its scope.\""," test_refs = \"TC-334\"","-status = \"Drafted\"","+status = \"Approved\""," component = \"CMP-008\""," phase = 6"]}]},{"filePath":"C:\\Projects\\ai-template.wt\\wi-865\\docs\\archive\\last_approved\\docs\\requirements\\system-requirements.toml","hunks":[{"oldStart":1812,"oldLines":7,"newStart":1812,"newLines":7,"lines":[" acceptance_criteria = \"A composed adjudication carries exactly the requested findings, each finding and held position verbatim, change-range facts, and a link to the review scope; malformed findings input refuses composition without a partial sitting. A verdict refuses when a requested finding is unruled or ruled twice, an unrequested finding is ruled, a ruling is outside the declared set, a dismissal lacks its declared reason class, or a ruling lacks its reason. An accepted dispute verdict authorizes no approval act.\""," priority = \"S\""," verification = \"Test\"","-status = \"Drafted\"","+status = \"Approved\""," phase = 6"," aspect = \"process\""," form = \"interface\""]}]},{"filePath":"C:\\Projects\\ai-template.wt\\wi-865\\docs\\requirements\\low-level-requirements.toml","hunks":[{"oldStart":3333,"oldLines":6,"newStart":3333,"newLines":6,"lines":[" detail = \"dispute_values accepts exactly one findings-file reference from an adjudication row, reads it through kitlib.dispute, and refuses an unreadable or malformed file. It accepts only a hexadecimal base..head range that git resolves, derives that range's commit and name-status facts, and fills the dispute template's range, commits, request, findings, and process-document values. _render_finding preserves each finding and held position between labelled delimiters. BRIEF_PROMPTS routes the dispute class to its shipped template, so the existing strict fill refuses a partial brief.\""," rationale = \"The adjudicator needs the reviewer wording and the contested position as subjects to judge, while the range facts and review-scope link must be independently derived. Refusing an incomplete assembly avoids sending a judge a brief that appears complete but has lost a finding or its scope.\""," test_refs = \"TC-334\"","-status = \"Drafted\"","+status = \"Approved\""," component = \"CMP-008\""," phase = 6"]}]}],"moreFiles":1,"changedFiles":["C:\\Projects\\ai-template.wt\\wi-865\\docs\\archive\\last_approved\\README.md","C:\\Projects\\ai-template.wt\\wi-865\\docs\\archive\\last_approved\\acts.toml","C:\\Projects\\ai-template.wt\\wi-865\\docs\\archive\\last_approved\\docs\\requirements\\low-level-requirements.toml","C:\\Projects\\ai-template.wt\\wi-865\\docs\\archive\\last_approved\\docs\\requirements\\system-requirements.toml","C:\\Projects\\ai-template.wt\\wi-865\\docs\\requirements\\low-level-requirements.toml","C:\\Projects\\ai-template.wt\\wi-865\\docs\\requirements\\system-requirements.toml"]}}}
