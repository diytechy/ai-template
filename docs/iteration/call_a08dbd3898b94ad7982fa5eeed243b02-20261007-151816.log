ild, close and merge transition\""," module = \"project-trajectory/scripts/agent_loop.py;project-trajectory/scripts/integrate.py\"","-code_symbol = \"build_hold;_done_when_refusal/staged_done_when_refusal\"","-detail = \"Before a build or rework session, build_hold asks LLR-307's lane_hold and returns the worker's HELD human outcome when a blessing is owed; review sessions and adjudication rows are not held. The merge refusal ladder asks the same predicate after its close records and refuses an unblessed changed closed checklist. The pre-commit done-when-blessed step invokes the staged-close arm, which refuses an index move out of active when the index contains no binding blessing. Each arm names the digest and changes; the commit that changes Done-when text itself and test execution are not held.\"","+code_symbol = \"routed_session/build_hold;_done_when_refusal/staged_done_when_refusal\"","+detail = \"After routed_session selects a build or rework session, build_hold asks LLR-307's lane_hold and returns the worker's HELD human outcome when a blessing is owed; review sessions, critiques and adjudication rows are not held, and worker_endstate asks no hold. The merge refusal ladder asks the same predicate after its close records and refuses an unblessed changed closed checklist. The pre-commit done-when-blessed step invokes the staged-close arm, which refuses an index move out of active when the index contains no binding blessing. Each arm names the digest and changes; the commit that changes Done-when text itself and test execution are not held.\""," rationale = \"A release condition is ineffective if a lane can continue at any lifecycle boundary consuming its changed goalpost. A shared predicate at each transition makes the verdict or owner ruling the sole release without preventing the edit that creates the obligation.\""," test_refs = \"TC-325, TC-326\""," status = \"Approved\""]}]},{"filePath":"C:\\Projects\\ai-template.wt\\wi-841\\docs\\archive\\last_approved\\docs\\test\\test-cases.toml","hunks":[{"oldStart":3301,"oldLines":11,"newStart":3301,"newLines":11,"lines":[" [test.TC-325]"," verifies = [\"SR-156\", \"LLR-307\", \"LLR-309\", \"IF-286\"]"," level = \"Integration\"","-method = \"Run test_an_edit_with_no_verdict_holds_the_dispatch_and_the_close, test_an_unchanged_or_only_ticked_done_when_holds_nothing, test_the_edit_commit_itself_is_not_held_by_the_hook, test_an_adjudication_row_is_never_held_at_dispatch, test_the_hold_points_share_one_predicate, test_a_hand_close_into_any_terminal_home_is_held, test_an_absent_claim_is_released_at_every_hold_point, test_an_unreadable_claim_is_held_naming_why, test_an_unreadable_current_spec_is_held_naming_why, test_a_claimed_row_whose_spec_is_gone_from_the_lane_is_held, test_a_lane_that_deletes_its_done_when_section_owes_a_blessing, test_a_review_session_is_never_held, test_a_test_run_is_never_held, and test_the_merge_refusal_names_the_digest_and_the_changes. Assert an unblessed edit holds build or rework dispatch, staged close, and the merge ladder; an absent claim releases, unreadable claims or current copies and a claimed row without a current specification hold naming why, and a deleted Done-when section owes a blessing. Unchanged or evidence-only text does not hold. The explicit exemptions are the editing commit, adjudication rows, review sessions and test runs; all hold points consult one predicate.\"","+method = \"Run test_an_edit_with_no_verdict_holds_the_dispatch_and_the_close, test_an_unchanged_or_only_ticked_done_when_holds_nothing, test_the_edit_commit_itself_is_not_held_by_the_hook, test_an_adjudication_row_is_never_held_at_dispatch, test_the_hold_points_share_one_predicate, test_a_hand_close_into_any_terminal_home_is_held, test_an_absent_claim_is_released_at_every_hold_point, test_an_unreadable_claim_is_held_naming_why, test_an_unreadable_current_spec_is_held_naming_why, test_a_claimed_row_whose_spec_is_gone_from_the_lane_is_held, test_a_lane_that_deletes_its_done_when_section_owes_a_blessing, test_a_review_session_is_never_held, test_a_build_after_a_dirty_completed_lane_is_held_at_dispatch, test_a_resumed_blocked_lanes_first_build_is_held_at_dispatch, test_a_test_run_is_never_held, and test_the_merge_refusal_names_the_digest_and_the_changes. Assert an unblessed edit holds build or rework dispatch, staged close, and the merge ladder; an absent claim releases, unreadable claims or current copies and a claimed row without a current specification hold naming why, and a deleted Done-when section owes a blessing. Unchanged or evidence-only text does not hold. The explicit exemptions are the editing commit, adjudication rows, review or critique sessions and test runs; dispatch drives its hold through routed_session, and all hold points consult one predicate.\""," tier = \"Smoke\"","-expected = \"An in-lane changed Done-when holds subsequent build or rework dispatch, staged close and serial landing until blessed; an absent claim releases, while an unreadable claim or current copy and a claimed row without a current specification hold naming why; deleting Done-when owes a blessing; and the editing commit, adjudication rows, review sessions and test runs are exempt.\"","+expected = \"An in-lane changed Done-when holds subsequent build or rework dispatch, staged close and serial landing until blessed; an absent claim releases, while an unreadable claim or current copy and a claimed row without a current specification hold naming why; deleting Done-when owes a blessing; and the editing commit, adjudication rows, review or critique sessions and test runs are exempt; dispatch applies its hold after routing selects a build or rework session.\""," automated = \"Yes\"","-evidence = \"tests/test_done_when_blessing.py::test_an_edit_with_no_verdict_holds_the_dispatch_and_the_close; tests/test_done_when_blessing.py::test_an_unchanged_or_only_ticked_done_when_holds_nothing; tests/test_done_when_blessing.py::test_the_edit_commit_itself_is_not_held_by_t