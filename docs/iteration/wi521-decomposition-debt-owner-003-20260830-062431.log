import ast, pathlib, subprocess, textwrap

def funcs(src):
    tree = ast.parse(src)
    out = {}
    for n in tree.body:
        if isinstance(n, ast.FunctionDef):
            out[n.name] = ast.get_source_segment(src, n)
        elif isinstance(n, ast.AsyncFunctionDef):
            out[n.name] = ast.get_source_segment(src, n)
    return out

old = subprocess.check_output(['git','show','56e7e52b:tests/test_trace.py'], text=True, encoding='utf-8')
core = pathlib.Path('tests/test_trace.py').read_text(encoding='utf-8')
newif = pathlib.Path('tests/test_trace_interfaces.py').read_text(encoding='utf-8')
fo, fc, fi = funcs(old), funcs(core), funcs(newif)

# helpers and tests in IF module vs old
changed = []
missing = []
for name, src in fi.items():
    if name not in fo:
        missing.append(name)
        continue
    if fo[name] != src:
        changed.append(name)
print('IF funcs vs old: changed', changed, 'missing-in-old', missing)

# remaining core tests vs old
core_changed = []
for name, src in fc.items():
    if name.startswith('test_') or True:
        if name in fo and fo[name] != src:
            core_changed.append(name)
print('core funcs vs old: changed', core_changed)

# constants that moved: compare by assignment names at module level
def assigns(src):
    tree = ast.parse(src)
    out = {}
    for n in tree.body:
        if isinstance(n, ast.Assign) and len(n.targets)==1 and isinstance(n.targets[0], ast.Name):
            out[n.targets[0].id] = ast.get_source_segment(src, n)
    return out
ao, ac, ai = assigns(old), assigns(core), assigns(newif)
const_changed = []
for k,v in ai.items():
    if k in ao and ao[k] != v:
        const_changed.append(k)
    elif k not in ao:
        const_changed.append('NEW '+k)
print('IF consts vs old changed/new', const_changed)
"

