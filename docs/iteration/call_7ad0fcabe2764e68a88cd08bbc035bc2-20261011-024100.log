equirements.toml","hunks":[{"oldStart":1877,"oldLines":12,"newStart":1877,"newLines":13,"lines":[" sn_refs = [\"SN-025\"]"," boundary_refs = [\"B-10\"]"," hat_refs = [\"PERFORMANCE\", \"UNATTENDED-OPS\", \"INTEGRITY-RECOVERABILITY\"]","-requirement = \"Where the declared reviewer retention dial is above zero, the delivered loop review content shall resume a reviewer only across iteration rounds for one lane, claim and review phase, keyed by those values and the iteration stage; read an absent, unreadable, malformed, misfiled or differently keyed retained record as no session and start fresh; never keep a reviewer session warm; retire that iteration session when the lane's full-lane round is drawn; run that round fresh, or, where the declared final-reviewer setting selects persistence, on one retained final reviewer per lane and phase that never resumes an iteration session; read a malformed reviewer setting, or a persisted final reviewer while reviewer retention is off, as retention off and a fresh final reviewer; and treat a change to the template a retained reviewer's brief is built from as a change of its governing inputs.\"","-rationale = \"A DERIVED requirement. The Performance, Unattended Operations and Integrity Recoverability lenses identify the operating cost, unattended judgement degradation, and shared-state corruption risk of repeatedly minting reviewer sessions. Repeated fresh reviewer rounds can exhaust the available plan, while scoped identity prevents one lane or review stage from inheriting another transcript. Lane decision D-001 (pending owner) records that the coordinator-written review-scope and session-generation records, not reviewer-authored text, establish final-review provenance; session-mode and keep-scope remain audit-only.\"","-acceptance_criteria = \"With the reviewer dial at zero, every review round launches fresh and merge-gate admission is unchanged. With it on, two iteration rounds of one lane and phase resume one session while another lane starts its own; a record under another keying, an undeclared record shape, or a record filed under another key reads as no session; drawing the lane's full-lane round retires its iteration session; with a fresh final reviewer the full-lane round is fresh, and with a persisted one it resumes only the final reviewer's own session. The coordinator's committed review-scope record is the gating record the gate reads: only a full-lane round it records as final, with persisted mode enabled, admits that resumed final reviewer; a retained full round and every iteration round hold. Each review session log records session-mode and keep-scope as audit-only columns.\"","+requirement = \"Where the declared reviewer retention dial is above zero, the delivered loop review content shall resume a reviewer only across iteration rounds for one lane, claim and review phase, keyed by those values and the iteration stage; read an absent, unreadable, malformed, misfiled or differently keyed retained record as no session and start fresh; never keep a reviewer session warm; retire that iteration session when the lane's full-lane round is drawn; run that round fresh, or, where the declared final-reviewer setting selects persistence, on one retained final reviewer per lane and phase that never resumes an iteration session; treat a change to the template a retained reviewer's brief is built from as a change of its governing inputs; and record session-mode and keep-scope as audit-only columns. If the reviewer setting is malformed, or names a persisted final reviewer while retention is off, then the delivered loop review content shall read it as retention off and a fresh final reviewer.\"","+rationale = \"A DERIVED requirement. The Performance, Unattended Operations and Integrity Recoverability lenses identify the operating cost, unattended judgement degradation, and shared-state corruption risk of repeatedly minting reviewer sessions. Repeated fresh reviewer rounds can exhaust the available plan, while scoped identity prevents one lane or review stage from inheriting another transcript. Coordinator-written review-scope and session-generation records, not reviewer-authored text, establish final-review provenance; session-mode and keep-scope remain audit-only. Fed back to the need: SN-025's acceptance could name bounded operating cost per reviewer judgement as part of what lets a run proceed with no human curating it; until it does, this row is derived and says so.\"","+acceptance_criteria = \"With the reviewer dial at zero, every review round launches fresh. With it on, two iteration rounds of one lane and phase resume one session while another lane starts its own; a record under another keying, an undeclared record shape, or a record filed under another key reads as no session; drawing the lane's full-lane round retires its iteration session; with a fresh final reviewer the full-lane round is fresh, and with a persisted one it resumes only the final reviewer's own session. A malformed reviewer setting, or a persisted final reviewer while retention is off, reads as retention off and fresh. Gate admission is specified by SR-156. Each review session log records session-mode and keep-scope as audit-only columns.\""," priority = \"S\""," verification = \"Test\"","-status = \"Drafted\"","+status = \"Approved\""," phase = 6"," da_refs = [\"DA-017\"]"," aspect = \"unattended-loop\"","+form = \"cross-cutting\""]}]},{"filePath":"C:\\Projects\\ai-template.wt\\wi-887\\docs\\archive\\last_approved\\docs\\test\\test-cases.toml","hunks":[{"oldStart":3537,"oldLines":5,"newStart":3537,"newLines":5,"lines":[" expected = \"Satisfies SR-239 through LLR-269 and LLR-270: only its lane, claim, phase and stage resume; invalid or other-keyed state mints fresh; iteration and final reviewers remain separate; reviewer records are never warmed; and session-mode and keep-scope are recorded.\""," automated = \"Yes\""," evidence = \"tests/test_session_keep.py::test_two_iteration_