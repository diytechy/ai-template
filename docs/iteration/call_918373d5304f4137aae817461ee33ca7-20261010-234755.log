e are trace cells only, and no other row's normative text moved; I said so in the commit message.\n\nBoth commits passed their checks (`RESULT: PASS`). The checks also reported two readability worsenings from the lane's code, neither in a gating measure. I edited no registry cell. The untracked `.requested` marker is still there.","ttft_ms":2678,"type":"result","duration_ms":135109,"uuid":"9198462a-8bc9-4d84-b097-03e4dc672b26","ttft_stream_ms":1106,"time_to_request_ms":197,"time_to_request_phases_ms":{"other":14,"system_prompt":103,"resume_other":0,"process_user_input":3,"input_attachments":24,"input_hooks":3,"transcript_persist":1,"tool_pool_refresh":1,"init_message":6,"engine_pickup":2,"message_prep":0,"model_config_wait":2,"autocompact":1,"query_setup":0,"model_gates":1,"tool_schema_build":14,"message_normalization":10,"client_creation":4,"request_build":8},"turn_start_resume_kind":"none","process_turn_index":0,"time_to_request_loop_lag_ms":147,"time_to_request_cpu_ms":204,"time_to_request_major_faults":3355,"input_attachments_detail":{"slowest_producer":"skill_listing","slowest_producer_ms":14,"cpu_ms":48,"major_faults":356},"first_content_frame_ms":1106,"queued_turn_count":0,"result_index":0}]
