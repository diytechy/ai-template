\"\r\n2008:data = \"interface_bridge_findings -> (failures, advisories); obstacle_hat_findings -> failures\"\r\n2012:notes = \"\"\"source - assumption_rules consumes nothing but the row vocabulary it reads from kitlib.spine: rows in, \r\nfindings out, with no I/O, no git and no filesystem.\"\"\"\r\n2041:data = \"observation_evidence_findings -> (integrity, advisories); record_policy_problem, falsification_worklist, \r\naccepted_risk_state\"\r\n2136:rationale = \"\"\"The assumption gate is four questions asked at four rungs, and the harness reads every step the \r\nsame way: by exit code, with the findings on stdout for the reviewer. One command taking the step's name keeps the \r\nregistry reads and the choice between failing and advising in one place, so the four steps cannot disagree about what \r\nthe setting means, and the checker's own module stays free of the gate's reads.\"\"\"\r\n2151:data = \"boundary_gate_findings(srs, das, surs, reach, have_frame) · reach_gaps(...) -> {DA id: [reasons]} · \r\ncrossing_gate_findings(srs, das, bifs) · interface_form_gate_findings(srs, ifs, llrs) · if_reached_srs(ifs, llrs) · \r\nmodule_srs(llrs) · release_gate_findings(das, srs, risks) -> [finding]\"\r\n2259:data = \"record_path (raises ValueError for a run name no record can carry: # or a character git refuses); \r\nrecord_findings; owner_state; review_queue(text) -> (unseen, overruled, confirmed_count); citation; citations; \r\nnewly_overruled (raises ValueError for an unparseable after side); overrule_sync_lines(changed, before, after) -> \r\nrefusal lines (before/after read a path's text in the parent and resulting tree, None when absent; what they raise \r\npropagates); migrate_text -> (text, left_ids) (raises ValueError for unparseable input or failed re-parse \r\nequivalence); MODES, REQUIRED_KEYS, OWNER_KEY, CONFIRMED, OVERRULED, OWNER_VALUES, RETIRED_KEY; owed; \r\nmissing_record_refusal(mode, run) -> the merge slot refusal of an owed close with no record, or with a run name no \r\nrecord can carry; session_note\"\r\n2388:data = \"process-config readers and findings, approval authority decisions, and normalized coordinator dials\"\r\n2406:data = \"architecture inventories and findings for seams, contracts, components, code symbols, and spec boundaries\"\r\n2455:data = \"Cadence(root, revision, snapshot, checkpoint, git).eligible(row, since, checkpoint) -> bool; \r\nobservation_rubric_findings(rows) -> warnings. Reads committed process policy and closed-WI git history.\"\r\n2643:data = \"binding/path grammar; requested, identity and findings-file cells; outcome; combined-scope and \r\nreview-verdict readers\"\r\n2647:notes = \"source - consumes no declared seam; pure functions. An identity cell is preserved when a pending binding \r\nis rewritten as accepted or failed; absent, malformed or repeated identities read as no identity with a reason. A \r\nfindings-file record is carried the same way when a pending binding is rewritten as accepted or failed; an absent \r\nrecord reads as none.\"\r\n2650:owner = \"scripts/kitlib/dispute\"\r\n2653:data = \"read_findings(text, where); request_line(ids); file_line(path); requested_ids(brief_text); \r\nrequested_file(brief_text); parse(text, requested, where)\"\r\n2657:rationale = \"Brief composition needs one owner for the findings and verdict grammars, so it cannot render a \r\nrequest that validation reads differently.\"\r\n2665:data = \"review / critique [--plan --sha] / file / plan [--revise] / plan-file (--critique --sha | --pass \r\n[--dispute] | --dispute-findings PATH --positions FILE).\"\r\n2676:data = \"0 brief written, or review, critique, dispute findings or pass record filed | 2 refused; a refusal writes \r\nno requested brief or record.\"\r\n2716:rationale = \"The commit checker needs one fail-closed plan-gate result so it can reject unbound single-plan build \r\noutput without interpreting the gate's findings.\"\r\n2781:rationale = \"The commit checker needs one fail-closed adoption-record result so it can reject an unauthorized \r\nrecord change without interpreting the rule's internal findings.\"\r\n3404c5d0e\n\ndiff --git a/project-trajectory/scripts/kitlib/sitting.py b/project-trajectory/scripts/kitlib/sitting.py\nindex 828074036..2fb146ca8 100644\n--- a/project-trajectory/scripts/kitlib/sitting.py\n+++ b/project-trajectory/scripts/kitlib/sitting.py\n@@ -306,15 +306,21 @@ def render_requested(\n     return text\n \n \n+def _cells(text):\n+    \"\"\"A binding's `key = value` cells, keyed by the text before each line's\n+    first ` = `; a line without one is not a cell.\"\"\"\n+    return dict(\n+        line.split(\" = \", 1) for line in (text or \"\").splitlines() if \" = \" in line\n+    )\n+\n+\n def read_requested(text):\n     \"\"\"`(brief, kinds, outcome)` from a binding's text, or None when it is not\n     one; a binding recording no outcome reads `pending`.\n \n     Implements: SR-232, LLR-310\n     \"\"\"\n-    cells = dict(\n-        line.split(\" = \", 1) for line in (text or \"\").splitlines() if \" = \" in line\n-    )\n+    cells = _cells(text)\n     brief, kinds = cells.get(\"brief\", \"\").strip(), cells.get(\"kinds\", \"\").strip()\n     if not brief or not kinds:\n         return None\n@@ -333,14 +339,12 @@ FINDINGS_FILE_CELL = \"findings_file\"\n def read_findings_file(text):\n     \"\"\"The repo-relative path a dispute binding records as the findings file\n     its brief was composed over, or None when it carries no record or an\n-    empty one. Cells read as `read_requested` reads them.\n+    empty one. Cells come from `_cells`, the one cell reader it shares with\n+    `read_requested`.\n \n     Implements: SR-232, LLR-310\n     \"\"\"\n-    cells = dict(\n-        line.split(\" = \", 1) for line in (text or \"\").splitlines() if \" = \" in line\n-    )\n-    return cells.get(FINDINGS_FILE_CELL, \"\").strip() or None\n+    return _cells(text).get(FINDINGS_FILE_CELL, \"\").strip() or None\n \n \n def read_identities(text):\nfea628b8f\n\ndiff --git a/project-trajectory/scripts/adjudicate_brief.py b/project-trajectory/scripts/adjudicate_brief.py\nindex 544a7d58a..dbb7b8a7c 100644\n--- a/project-trajectory/scripts/adjudicate_brief.py\n+++ b/project-trajectory/scripts/adjudicate_brief.py\n@@ -106,6 +106,9 @@ Contract IF-115: `compose(root, row, verdict_path, prompt_templates)` returns\n     `JUDGED-TEXT: <row id> <digest>` line per row; `bind_pending` records\n     those lines in the binding (IF-287) and `record_outcome` keeps them when\n     it rewrites the outcome, so a held CLARITY act is bound to the text judged.\n+    The dispute brief names the findings file it was composed over on its\n+    `FINDINGS-FILE:` line (IF-290); `bind_pending` records that path in the\n+    binding and `record_outcome` keeps it the same way.\n \"\"\"\n \n from __future__ import annotations\n@@ -323,9 +326,12 @@ def requested_for(brief, prompt):\n def bind_pending(verdict_path, brief, prompt, exclusive=False):\n     \"\"\"Bind what this call was asked - its brief and requested kinds, outcome\n     `pending`, and the identity of each row's approved text the prompt showed\n-    (`requested_identities`) - beside its verdict, through the one writer; the\n-    kinds, or () when a combined brief names none (no binding is then\n-    written). A prompt that shows no amended text binds no identity. Both\n+    (`requested_identities`), and for a dispute the findings file its\n+    `FINDINGS-FILE:` line names (`kitlib.dispute.requested_file`) - beside\n+    its verdict, through the one writer; the kinds, or () when a combined\n+    brief names none (no binding is then written). A prompt that shows no\n+    amended text binds no identity, and one naming no findings file binds no\n+    record. Both\n     routes call it before the call: the coordinator's entry point exclusively\n     at reservation, the loop at composition.\n \n@@ -340,6 +346,7 @@ def bind_pending(verdict_path, brief, prompt, exclusive=False):\n             \"pending\",\n             exclusive,\n             identities=requested_identities(prompt) or None,\n+            findings_file=kdispute.requested_file(prompt) if brief == DISPUTE else None,\n         )\n     return kinds\n \n@@ -382,7 +389,8 @@ def record_outcome(root, verdict_path, brief, kinds, call_ok, session):\n     being read. The loop's completion consumes this same decision, so a\n     failed call keeps its obligation (WI-841 rounds 11-15). `kinds` None reads\n     back the request bound beside the verdict (`bound_kinds`, round 17). The\n-    rewrite carries the identity cell bound at reservation through unchanged.\n+    rewrite carries the identity cell and the findings-file record bound at\n+    reservation through unchanged.\n \n     Implements: SR-232, SR-178, LLR-310, LLR-359\n     \"\"\"\n@@ -392,13 +400,20 @@ def record_outcome(root, verdict_path, brief, kinds, call_ok, session):\n     else:\n         why = \"the call failed (a non-zero exit, a timeout or a reported error)\"\n     outcome = \"failed\" if why else \"accepted\"\n-    # The rewrite keeps the identities bound at reservation: dropping them\n-    # would leave every held CLARITY act bound to no text.\n-    identities, _none = ksitting.read_identities(\n-        _read(ksitting.requested_path(verdict_path))\n-    )\n-    ksitting.write_binding(verdict_path, brief, kinds, outcome, identities=identities)\n+    # The rewrite keeps the identities and the findings-file record bound at\n+    # reservation: dropping them would leave every held CLARITY act bound to\n+    # no text, and every dispute verdict bound to no findings file.\n     binding = ksitting.requested_path(verdict_path)\n+    bound = _read(binding)\n+    identities, _none = ksitting.read_identities(bound)\n+    ksitting.write_binding(\n+        verdict_path,\n+        brief,\n+        kinds,\n+        outcome,\n+        identities=identities,\n+        findings_file=ksitting.read_findings_file(bound),\n+    )\n     ac.commit_telemetry(root, session, \"verdict \" + outcome, [binding])\n     return outcome, why\n \n@@ -1824,7 +1839,9 @@ def dispute_values(root, row):\n     but the commit facts is a CLAIM the template labels as under judgement:\n     the finding as the reviewer wrote it, and the position on it. The range\n     it declares is re-derived from git (`_commit_facts`), so a range git\n-    cannot resolve refuses rather than briefing a judge on nothing.\n+    cannot resolve refuses rather than briefing a judge on nothing. The\n+    request names the ids to rule, then the file they were read from, as the\n+    row writes it, for the binding to record.\n \n     Implements: SR-234, LLR-315\n     \"\"\"\n@@ -1852,7 +1869,7 @@ def dispute_values(root, row):\n     return {\n         \"range\": span,\n         \"commits\": commits,\n-        \"request\": kdispute.request_line(ids),\n+        \"request\": kdispute.request_line(ids) + \"\\n\" + kdispute.file_line(scope[0]),\n         \"findings\": \"\\n\".join(_render_finding(f) for f in found[\"findings\"]),\n         \"process_doc\": agent_brief.process_doc_path(root),\n     }, None\ndiff --git a/project-trajectory/scripts/kitlib/dispute.py b/project-trajectory/scripts/kitlib/dispute.py\nindex 14869bd45..a5ed13f73 100644\n--- a/project-trajectory/scripts/kitlib/dispute.py\n+++ b/project-trajectory/scripts/kitlib/dispute.py\n@@ -20,7 +20,11 @@ Contract IF-290: the dispute grammar `adjudicate_brief` calls. Text in,\n     why)` naming `where` and the cause. `request_line(ids)` returns the brief's\n     `DISPUTE: findings=<ids>` line, and `requested_ids(brief_text)` reads the\n     ids back off the first such line, `()` when there is none, so the request a\n-    brief renders is the request its verdict is judged against. `parse(text,\n+    brief renders is the request its verdict is judged against. `file_line(\n+    path)` returns the brief's `FINDINGS-FILE: <path>` line, naming the\n+    findings file the brief was composed over, and `requested_file(\n+    brief_text)` reads the path back off the first such line, None when there\n+    is none or it is empty. `parse(text,\n     requested, where)` returns `({id: (ruling, reason class or None, reason)},\n     None)` for a verdict ruling every requested finding exactly once and\n     nothing else, else `(None, why)`.\n@@ -71,7 +75,9 @@ __all__ = [\n     \"HELD_BY\",\n     \"read_findings\",\n     \"request_line\",\n+    \"file_line\",\n     \"requested_ids\",\n+    \"requested_file\",\n     \"parse\",\n ]\n \n@@ -79,9 +85,11 @@ BRIEF = \"dispute\"\n RULINGS = (\"FIX\", \"SUCCESSOR\", \"DISMISS\", \"ESCALATE\")\n DISMISS_REASONS = (\"out-of-scope\", \"refuted\", \"not-worth-cost\")\n HELD_BY = (\"builder\", \"coordinator\")\n-# The verdict's per-finding keyword, and the composed brief's request line.\n+# The verdict's per-finding keyword, the composed brief's request line, and\n+# its line naming the findings file it was composed over.\n _RULING = \"RULING\"\n _REQUEST = \"DISPUTE\"\n+_FILE = \"FINDINGS-FILE\"\n _ID_RE = re.compile(r\"[A-Za-z][A-Za-z0-9._-]*\")\n _FILE_KEYS = (\"range\", \"finding\")\n _FINDING_KEYS = (\"id\", \"held_by\", \"finding\", \"position\")\n@@ -163,6 +171,15 @@ def request_line(ids):\n     return \"{}: findings={}\".format(_REQUEST, \";\".join(ids))\n \n \n+def file_line(path):\n+    \"\"\"The composed brief's line naming the findings file it was composed\n+    over, which the binding records beside the verdict.\n+\n+    Implements: SR-234, LLR-314\n+    \"\"\"\n+    return \"{}: {}\".format(_FILE, path)\n+\n+\n def _keyword_rests(text, keyword):\n     \"\"\"The text after `keyword:` on every physical line of `text` whose first\n     token, leading whitespace aside, is `keyword:`. One line at a time, as\n@@ -189,6 +206,17 @@ def requested_ids(brief_text):\n     return ()\n \n \n+def requested_file(brief_text):\n+    \"\"\"The findings file a composed dispute brief names, read off its FIRST\n+    `FINDINGS-FILE: <path>` line (the template puts it before any finding's\n+    text); None when it carries none or names nothing.\n+\n+    Implements: SR-234, LLR-314\n+    \"\"\"\n+    rests = _keyword_rests(brief_text, _FILE)\n+    return (rests[0] or None) if rests else None\n+\n+\n def _one_ruling(rest, where):\n     \"\"\"`((id, ruling, reason class or None, reason), None)` for one\n     `RULING:` line's text after the keyword, else `(None, why)`.\"\"\"\ndiff --git a/project-trajectory/scripts/kitlib/sitting.py b/project-trajectory/scripts/kitlib/sitting.py\nindex fa62730fb..828074036 100644\n--- a/project-trajectory/scripts/kitlib/sitting.py\n+++ b/project-trajectory/scripts/kitlib/sitting.py\n@@ -43,11 +43,16 @@ Contract IF-287: a combined sitting's grammar. `SITTING` is the brief class and\n     `({id: digest}, None)`, or `(None, reason)` for no cell, a malformed\n     token or a repeated id, and `accepted_identities(root, rev, verdict)` is\n     the one reader of an ACCEPTED verdict's bound identities, `(None,\n-    reason)` for a verdict `accepted_at` does not read as accepted;\n-    `judged_rows(parsed)` is the ONE reader of the rows an accepted verdict\n-    authorizes an act on - an APPROVE row, a CLARITY row, and a MEANING row\n-    only with its bless mark - which the merge's backing checks and the act\n-    assembler both read. `review_line(text)`\n+    reason)` for a verdict `accepted_at` does not read as accepted. A dispute\n+    binding may also carry the findings-file record cell, `findings_file =\n+    <repo-relative path>`, naming the findings file its brief was composed\n+    over: `render_requested(..., findings_file)` and `write_binding(...,\n+    findings_file)` write it only when a path is given, `read_requested`\n+    ignores it, and `read_findings_file(text)` returns the path, or None for\n+    no cell or an empty one; `judged_rows(parsed)` is the ONE reader of the\n+    rows an accepted verdict authorizes an act on - an APPROVE row, a CLARITY\n+    row, and a MEANING row only with its bless mark - which the merge's\n+    backing checks and the act assembler both read. `review_line(text)`\n     is the ONE reader of a review round's `VERDICT:` line, which the attended\n     filing boundary and the merge gate's round reader both consume. Pure\n     functions over text, except `write_binding` (one file) and `accepted_at`\n@@ -84,6 +89,7 @@ __all__ = [\n     \"render_requested\",\n     \"read_requested\",\n     \"read_identities\",\n+    \"read_findings_file\",\n     \"REQUESTED_SUFFIX\",\n     \"OUTCOMES\",\n     \"write_binding\",\n@@ -274,16 +280,22 @@ def requested_path(verdict_path):\n OUTCOMES = (\"pending\", \"accepted\", \"failed\")\n \n \n-def render_requested(brief, kinds, outcome=\"pending\", identities=None):\n+def render_requested(\n+    brief, kinds, outcome=\"pending\", identities=None, findings_file=None\n+):\n     \"\"\"The binding's text: the brief class, the kinds it requested and the\n-    call's recorded outcome, and, when `identities` (`{row id: digest}`) is\n-    given, the identity cell naming each judged row's approved-text digest.\n+    call's recorded outcome; when `findings_file` is given, the record of the\n+    findings file a dispute brief was composed over; and, when `identities`\n+    (`{row id: digest}`) is given, the identity cell naming each judged row's\n+    approved-text digest.\n \n     Implements: SR-232, SR-178, LLR-310, LLR-359\n     \"\"\"\n     text = \"brief = {}\\nkinds = {}\\noutcome = {}\\n\".format(\n         brief, \";\".join(kinds), outcome\n     )\n+    if findings_file:\n+        text += \"{} = {}\\n\".format(FINDINGS_FILE_CELL, findings_file)\n     if identities:\n         text += \"{} = {}\\n\".format(\n             IDENTITY_CELL,\n@@ -314,6 +326,21 @@ def read_requested(text):\n # per row the brief showed, `;`-joined.\n IDENTITY_CELL = \"rows\"\n _IDENTITY_TOKEN = re.compile(r\"([A-Z]+-[0-9]+)=(sha256:[0-9a-f]{16})\")\n+# A dispute binding's record of the findings file its brief was composed over.\n+FINDINGS_FILE_CELL = \"findings_file\"\n+\n+\n+def read_findings_file(text):\n+    \"\"\"The repo-relative path a dispute binding records as the findings file\n+    its brief was composed over, or None when it carries no record or an\n+    empty one. Cells read as `read_requested` reads them.\n+\n+    Implements: SR-232, LLR-310\n+    \"\"\"\n+    cells = dict(\n+        line.split(\" = \", 1) for line in (text or \"\").splitlines() if \" = \" in line\n+    )\n+    return cells.get(FINDINGS_FILE_CELL, \"\").strip() or None\n \n \n def read_identities(text):\n@@ -590,11 +617,18 @@ def sitting_refusal(text, where, kinds):\n \n \n def write_binding(\n-    verdict_path, brief, kinds, outcome, exclusive=False, identities=None\n+    verdict_path,\n+    brief,\n+    kinds,\n+    outcome,\n+    exclusive=False,\n+    identities=None,\n+    findings_file=None,\n ):\n     \"\"\"THE one writer of a verdict's binding: its brief class, requested kinds\n-    and recorded outcome, beside the verdict, and its identity cell when\n-    `identities` is given. `exclusive` creates it (the entry point's\n+    and recorded outcome, beside the verdict, its identity cell when\n+    `identities` is given, and its findings-file record when `findings_file`\n+    is given. `exclusive` creates it (the entry point's\n     reservation, which refuses an existing one); otherwise it overwrites,\n     which is how the route that ran the call records `accepted` or `failed`.\n     Raises OSError as `open` does; the caller says what it means.\n@@ -603,7 +637,7 @@ def write_binding(\n     \"\"\"\n     mode = \"x\" if exclusive else \"w\"\n     with open(requested_path(verdict_path), mode, encoding=\"utf-8\", newline=\"\\n\") as fh:\n-        fh.write(render_requested(brief, kinds, outcome, identities))\n+        fh.write(render_requested(brief, kinds, outcome, identities, findings_file))\n \n \n def accepted(text, binding_text):\n\r\n","exit_code":0,"status":"completed"}}
