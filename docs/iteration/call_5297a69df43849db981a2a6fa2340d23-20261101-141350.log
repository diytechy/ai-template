    esc(rel), esc(date), esc(rev)\r\n970:                     )\r\n971:                     for rel, rev, date in stamps\r\n972:                 ),\r\n973:             )\r\n974:             if stamps\r\n975:             else \"<code>{}</code> � no snapshot exists yet, so every row below \"\r\n976:             \"awaits a FIRST approval and shows its current text in \"\r\n977:             \"full\".format(esc(baseline_snapshot.SNAPSHOT_DIR))\r\n978:         ),\r\n979:     }\r\n980:     return (\r\n981:         \"<!doctype html>\\n\"\r\n982:         '<html lang=\"en\"><head><meta charset=\"utf-8\">\\n'\r\n983:         '<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\\n'\r\n984:         \"<title>Open items � owner decision surface</title>\\n\"\r\n985:         \"<style>{css}</style>\\n\"\r\n986:         # Without scripting the checkbox governs nothing, so the honest default\r\n987:         # is the FULLER page: context visible rather than a control that lies.\r\n988:         \"<noscript><style>.ctx{{display:flex;}}</style></noscript>\\n\"\r\n989:         \"</head><body>\\n\"\r\n990:         '<div class=\"wrap\">\\n'\r\n991:         \"<header>\\n\"\r\n992:         '<p class=\"eyebrow\">generated � do not hand-edit � '\r\n993:         \"<code>python project-trajectory/scripts/gen_open_items.py</code></p>\\n\"\r\n994:         \"<h1>Open items � owner decision surface</h1>\\n\"\r\n995:         '<p class=\"sub\">{pending} pending decision(s) � {attest} spine row(s) owing a '\r\n996:         \"approval or a re-attest, across {rows} chain row change(s); \"\r\n997:         \"{drifted} row(s) drifted from the approved snapshot. Briefs are rows \"\r\n998:         \"in <code>{registry}</code>; the attestation depth is \"\r\n999:         \"computed by <code>trace.reattest_model</code>, the same code behind \"\r\n1000:         \"<code>trace.py --approve</code>. If the two ever disagree, the brief is \"\r\n1001:         \"authoritative and this view is the bug.</p>\\n\"\r\n1002:         '<div class=\"baseline\">Baseline: {baseline}</div>\\n'\r\n1003:         \"{offspine}\"\r\n1004:         \"</header>\\n\"\r\n1005:         '<section class=\"band\"><p class=\"eyebrow\">1 � Pending decisions</p>{briefs}</section>\\n'\r\n1006:         '<div class=\"toolbar\"><label><input type=\"checkbox\" id=\"focus\" checked> '\r\n1007:         \"Collapse unchanged text and the cells that did not change</label>\"\r\n1008:         '<span class=\"hint\">clear it to read every row in full � each amended '\r\n1009:         \"row's remaining cells, and the SR text a chain-only amendment hangs \"\r\n1010:         \"from</span></div>\\n\"\r\n1011:         '<section class=\"band\"><p class=\"eyebrow\">2 � Approval &amp; '\r\n1012:         \"re-attestation</p>{attestations}{audit}</section>\\n\"\r\n1013:         '<section class=\"band\"><p class=\"eyebrow\">3 � Pending owner actions '\r\n1014:         \"(derived)</p>{pointers}</section>\\n\"\r\n1015:         '<section class=\"band\" id=\"decisions-to-review\"><p class=\"eyebrow\">'\r\n1016:         \"4 � Decisions to review</p>{decisions}</section>\\n\"\r\n1017:         \"<footer>Source: <code>{registry}</code> + the spine \"\r\n1018:         \"registries. Rule a decision by appending to <code>docs/log.md</code>'s \"\r\n1019:         \"Decisions log and setting the row's <code>Status</code>; bless an amendment \"\r\n1020:         \"by re-reading the drifted cells and running <code>intake.py snapshot \"\r\n1021:         \"--reattests &lt;ROW-ID&gt;</code>, naming each row read, in a reviewed \"\r\n1022:         \"commit � the copy IS the blessing now that no <code>Status</code> cell \"\r\n1023:         \"records one, so without it the record of what was blessed does not move. \"\r\n1024:         \"The gate re-derives on its own.</footer>\\n\"\r\n1025:         \"</div>\\n<script>{js}</script>\\n</body></html>\\n\"\r\n1026:     ).format(\r\n1027:         css=CSS,\r\n1028:         js=JS,\r\n1029:         briefs=_brief_cards(queue, live_registry_rel(root).split(\"docs/\", 1)[-1]),\r\n1030:         decisions=decisions_block(*pending.decisions_to_review(root)),\r\n1031:         attestations=_attestation_cards(\r\n1032:             model, {r.get(\"SR-ID\"): r for r in reg.srs if r.get(\"SR-ID\")}\r\n1033:         ),\r\n1034:         audit=verdict_reattest_block(_ledger_entries(root)),\r\n1035:         pointers=_pointer_list(pure),\r\n1036:         offspine=_offspine_census_block(offspine_rows),\r\n1037:         # The LIVE carrier, never a hardcoded suffix: this view is the surface\r\n1038:         # an owner rules from, and a pointer at the file the repo no longer has\r\n1039:         # (or has not migrated to yet) sends them to edit nothing.\r\n1040:         registry=live_registry_rel(root),\r\n","exit_code":0,"status":"completed"}}
