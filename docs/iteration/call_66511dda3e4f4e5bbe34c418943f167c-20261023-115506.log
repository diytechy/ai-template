{"type":"item.completed","item":{"id":"item_38","type":"command_execution","command":"\"C:\\\\Program Files\\\\PowerShell\\\\7\\\\pwsh.exe\" -Command 'Get-Content docs/test/test-cases.toml | Select-Object -Skip 2528 -First 18\n'","aggregated_output":"status = \"Approved\"\r\nphase = 6\r\n\r\n[test.TC-243]\r\nverifies = [\"SR-210\", \"LLR-249\", \"IF-195\", \"IF-196\"]\r\nlevel = \"Integration\"\r\nmethod = \"Driven on a real git repository, in a module registered as slow, with a history of three trunk commits — a loop-trailer commit changing a status on a rung its own tree's dial holds, one changing a status on a released rung, and one changing a held status without the trailer — plus a merged lane whose inner trailer-carrying commit changes a held status. The first trunk commit and the lane commit are reported, each once, naming the commit, the row and the rung; the merge commit itself is not reported. A root commit is compared with the empty tree. Raising the dial in a later commit does not change the verdict on earlier commits. A commit whose policy file has no dial is judged as most-held and prints no legacy warning. The pure dial comparison is unit-tested on each rung.\"\r\ntier = \"Full\"\r\nexpected = \"Satisfies SR-210's acceptance: each trailer-carrying commit changing a held status reported naming commit, row and rung; released rungs and commits without the trailer produce nothing; the rung judged against that commit's own dial.\"\r\nautomated = \"Yes\"\r\nevidence = \"tests/test_loop_provenance.py\"\r\nstatus = \"Approved\"\r\nphase = 6\r\n\r\n[test.TC-244]\r\nverifies = [\"SR-211\", \"LLR-250\", \"IF-208\"]\r\nlevel = \"Integration\"\r\nmethod = \"interface_bridge_findings driven through the traceability check. A boundary interface naming declared assumptions is bridged; one with a waiver is coincident; one with neither is one advisory naming it; one naming an undeclared assumption fails the strict run naming the interface. Beside an assumptions registry