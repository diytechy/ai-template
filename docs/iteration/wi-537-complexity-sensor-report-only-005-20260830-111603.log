{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HAw7QQPDt7q1TVzPvGvFwN","type":"tool_result","content":"1\t#!/usr/bin/env python3\n2\t\"\"\"check_complexity.py — the stdlib cognitive-complexity + SLOC census.\n3\t\n4\tMeasures SonarSource Cognitive Complexity (CognitiveComplexity.pdf v1.7) and\n5\tSLOC per function, plus a per-module public-symbol count (reported, never\n6\tgated — the Ousterhout depth proxy). Stdlib only: a shipped check must not make\n7\tevery adopter install a linter, which is why this exists beside — and not on\n8\ttop of — the ruff C901 ratchet. Because the counting rules live in this\n9\tdocstring rather than in a third-party tool, the baseline is a property of the\n10\tcode, not of a tool version: a linter upgrade cannot silently invalidate it.\n11\t\n12\tREPORT-ONLY as shipped: no `[step:]` is wired into `docs/stack.ini`, so nothing\n13\truns this as a gate. The enforce capability exists (`--mode enforce`, exercised\n14\tby the tests) but arming it is an opt-in act — a `[step:complexity]` step, of\n15\tthe shape below:\n16\t\n17\t    [step:complexity]\n18\t    command = {py} project-trajectory/scripts/check_complexity.py --root .\n19\t\n20\tCENSUS UNIT. One row per module-level function and per method. A nested `def`\n21\tor `lambda` is scored INTO its enclosing function (Sonar charges the nesting\n22\tincrement for it, never a base increment) and never gets its own row: the\n23\treward for decomposition is a SIBLING function or a new module, not an inner\n24\tone, and a second row for the inner def would double-count it in the census.\n25\t\n26\tBASELINE. `docs/complexity-baseline`, TSV, LF-only, sorted by path then\n27\tfunction, one row per over-threshold function: path, function, cognitive, sloc,\n28\treason. Its own header states that it is a DEBT STATEMENT, not an approval. TSV\n29\tfor one reason — the minimum merge-conflict surface when two concurrent\n30\tsessions re-stamp; it matches the extension-less house data files under `docs/`\n31\t(`docs/coverage-floors`). There is NO inline suppression pragma and there must\n32\tnever be one; the escape hatch is this one reviewed central file, because a\n33\tscattered opt-out self-replicates as new code copies it.\n34\t\n35\tImplements: SR-183, LLR-206\n36\t\"\"\"\n37\t\n38\timport argparse\n39\timport ast\n40\timport sys\n41\tfrom pathlib import Path\n42\t\n43\tfrom kitlib.config import utf8_console\n44\t\n45\tDEFAULT_THRESHOLD = 15\n46\tBASELINE = \"docs/complexity-baseline\"\n47\tDEFAULT_INCLUDE = (\"project-trajectory/scripts/**/*.py\",)\n48\tCOLUMNS = (\"path\", \"function\", \"cognitive\", \"sloc\", \"reason\")\n49\tHEADER = \"# \" + \"\\t\".join(COLUMNS)\n50\tDEBT_NOTE = (\n51\t    \"# docs/complexity-baseline — one row per function over the cognitive-\"\n52\t    \"complexity threshold when stamped.\\n\"\n53\t    \"# A row is a DEBT STATEMENT, NOT AN APPROVAL: the reason column records \"\n54\t    \"why it is carried, and the\\n\"\n55\t    \"# baseline only ever tightens — re-stamp DOWNWARD or delete a row, never \"\n56\t    \"up to clear a finding.\\n\"\n57\t)\n58\tPYCACHE = \"__pycache__\"\n59\tFIXES = (\n60\t    \"  named escapes: decompose OUTWARD (a sibling function or a new module, \"\n61\t    \"never a nested def); express the branches as a data table \"\n62\t    \"(check.py::steps is 670 lines at cognitive 14); define the error out of \"\n63\t    \"existence so the branch disappears.\"\n64\t)\n65\t\n66\t_LOOPS = (ast.For, ast.AsyncFor, ast.While)\n67\t_COMPS = (ast.ListComp, ast.SetComp, ast.DictComp, ast.GeneratorExp)\n68\t_DEFS = (ast.FunctionDef, ast.AsyncFunctionDef)\n69\t# Statement containers to descend into when collecting module/class-scope\n70\t# symbols — every stmt (control flow), plus the two block-bearing non-stmt\n71\t# nodes: an except clause and a match case. A `def` under `for`/`while`/`match`\n72\t# is a real module symbol, so the descent must not stop at `if`/`try`/`with`.\n73\t_BLOCKS = (ast.stmt, ast.excepthandler) + (\n74\t    (ast.match_case,) if hasattr(ast, \"match_case\") else ()\n75\t)\n76\t\n77\t\n78\tdef _kids(node, nesting, ctx):\n79\t    return sum(_visit(c, nesting, ctx) for c in ast.iter_child_nodes(node))\n80\t\n81\t\n82\tdef _seq(stmts, nesting, ctx):\n83\t    return sum(_visit(s, nesting, ctx) for s in stmts)\n84\t\n85\t\n86\tdef _h_if(node, nesting, ctx):\n87\t    return (\n88\t        1\n89\t        + nesting\n90\t        + _visit(node.test, nesting, ctx)\n91\t        + _seq(node.body, nesting + 1, ctx)\n92\t        + _h_orelse(node, nesting, ctx)\n93\t    )\n94\t\n95\t\n96\tdef _h_orelse(node, nesting, ctx):\n97\t    \"\"\"TRAP 1. Python parses `elif` as an `If` nested in `orelse`, so a naive\n98\t    recursion both double-counts and over-nests every ladder in the tree. An\n99\t    `elif` is HYBRID: +1 flat, NO nesting increment, body one level deeper. A\n100\t    written-out `else:` is +1 flat with its body one deeper. The discriminator\n101\t    is the column — a real `elif` starts at the parent `if`'s column.\"\"\"\n102\t    tail = node.orelse\n103\t    if not tail:\n104\t        return 0\n105\t    head = tail[0]\n106\t    chained = len(tail) == 1 and isinstance(head, ast.If)\n107\t    if chained and head.col_offset == node.col_offset:\n108\t        return (\n109\t            1\n110\t            + _visit(head.test, nesting, ctx)\n111\t            + _seq(head.body, nesting + 1, ctx)\n112\t            + _h_orelse(head, nesting, ctx)\n113\t        )\n114\t    return _h_else(tail, nesting, ctx)\n115\t\n116\t\n117\tdef _h_else(stmts, nesting, ctx):\n118\t    \"\"\"`else` — on an `if`, and equally on Python's loop-`else`, which is a\n119\t    break in linear flow and a famously misread one: +1 flat, body one deeper.\n120\t    The spec has no loop-`else` (no Java analogue); the reference Python\n121\t    implementation charges it, and so does this.\"\"\"\n122\t    return (1 + _seq(stmts, nesting + 1, ctx)) if stmts else 0\n123\t\n124\t\n125\tdef _h_loop(node, nesting, ctx):\n126\t    head = node.test if isinstance(node, ast.While) else node.iter\n127\t    return (\n128\t        1\n129\t        + nesting\n130\t        + _visit(head, nesting, ctx)\n131\t        + _seq(node.body, nesting + 1, ctx)\n132\t        + _h_else(node.orelse, nesting, ctx)\n133\t    )\n134\t\n135\t\n136\tdef _h_ifexp(node, nesting, ctx):\n137\t    return (\n138\t        1\n139\t        + nesting\n140\t        + _visit(node.test, nesting, ctx)\n141\t        + _visit(node.body, nesting + 1, ctx)\n142\t        + _visit(node.orelse, nesting + 1, ctx)\n143\t    )\n144\t\n145\t\n146\tdef _h_except(node, nesting, ctx):\n147\t    \"\"\"A catch is +1 however many types it names; `try`, `else` and `finally`\n148\t    are ignored altogether (spec, \"Catches\") — they fall through to `_kids`.\"\"\"\n149\t    return 1 + nesting + _seq(node.body, nesting + 1, ctx)\n150\t\n151\t\n152\tdef _h_match(node, nesting, ctx):\n153\t    \"\"\"A `switch` and ALL its cases combined is ONE structural increment (spec,\n154\t    \"Switches\"): it is read at a glance, unlike an if/elif ladder that may\n155\t    compare any number of variables against anything. A `case ... if guard`\n156\t    adds +1 flat — the guard is the extra comparison a switch cannot express.\"\"\"\n157\t    total = 1 + nesting + _visit(node.subject, nesting, ctx)\n158\t    for case in node.cases:\n159\t        if case.guard is not None:\n160\t            total += 1 + _visit(case.guard, nesting, ctx)\n161\t        total += _seq(case.body, nesting + 1, ctx)\n162\t    return total\n163\t\n164\t\n165\tdef _h_boolop(node, nesting, ctx):\n166\t    \"\"\"TRAP 2. +1 per RUN of like operators, not per operator: `a and b and c`\n167\t    is +1, `a and b or c` is +2. Python's parser already groups a run into one\n168\t    BoolOp with n values, so counting BoolOp NODES is counting runs.\"\"\"\n169\t    return 1 + _kids(node, nesting, ctx)\n170\t\n171\t\n172\tdef _h_lambda(node, nesting, ctx):\n173\t    return _kids(node, nesting + 1, ctx)\n174\t\n175\t\n176\tdef _h_comp(node, nesting, ctx):\n177\t    \"\"\"A comprehension is its own scope: nesting increment, no base increment\n178\t    (like a lambda). Each `if` clause is a real condition: +1 + inner nesting.\"\"\"\n179\t    inner = nesting + 1\n180\t    clauses = sum(1 for gen in node.generators for _ in gen.ifs)\n181\t    return _kids(node, inner, ctx) + clauses * (1 + inner)\n182\t\n183\t\n184\tdef _h_def(node, nesting, ctx):\n185\t    \"\"\"A nested def takes the nesting increment and no base increment — unless\n186\t    Appendix A's Python-decorator exception exempts it.\"\"\"\n187\t    return _kids(node, nesting + (0 if id(node) in ctx[1] else 1), ctx)\n188\t\n189\t\n190\tdef _h_call(node, nesting, ctx):\n191\t    \"\"\"Direct recursion is +1 per recursive call site: a bare `name(...)` or a\n192\t    `self`/`cls`-qualified `self.name(...)`. Anything else qualified is a\n193\t    DELEGATION, not recursion — `RoutingState.cool` calling `agent_route.cool`\n194\t    is the case that a bare attribute-name match gets wrong. Indirect recursion\n195\t    (the spec's \"recursion cycle\") needs a whole-program call graph and is out\n196\t    of scope.\"\"\"\n197\t    func = node.func\n198\t    owner = getattr(func, \"value\", None)\n199\t    same = getattr(owner, \"id\", None) in (\"self\", \"cls\")\n200\t    hit = (\n201\t        func.id\n202\t        if isinstance(func, ast.Name)\n203\t        else (getattr(func, \"attr\", None) if same else None)\n204\t    )\n205\t    return (1 if hit == ctx[0] else 0) + _kids(node, nesting, ctx)\n206\t\n207\t\n208\t_HANDLERS = {\n209\t    ast.If: _h_if,\n210\t    ast.IfExp: _h_ifexp,\n211\t    ast.ExceptHandler: _h_except,\n212\t    ast.BoolOp: _h_boolop,\n213\t    ast.Lambda: _h_lambda,\n214\t    ast.Call: _h_call,\n215\t}\n216\t_HANDLERS.update({t: _h_loop for t in _LOOPS})\n217\t_HANDLERS.update({t: _h_comp for t in _COMPS})\n218\t_HANDLERS.update({t: _h_def for t in _DEFS})\n219\tif hasattr(ast, \"Match\"):\n220\t    _HANDLERS[ast.Match] = _h_match\n221\t\n222\t\n223\tdef _visit(node, nesting, ctx):\n224\t    if node is None:\n225\t        return 0\n226\t    handler = _HANDLERS.get(type(node))\n227\t    return handler(node, nesting, ctx) if handler else _kids(node, nesting, ctx)\n228\t\n229\t\n230\tdef _is_docstring(stmt):\n231\t    return (\n232\t        isinstance(stmt, ast.Expr)\n233\t        and isinstance(stmt.value, ast.Constant)\n234\t        and isinstance(stmt.value.value, str)\n235\t    )\n236\t\n237\t\n238\tdef _wrapped_def(node):\n239\t    \"\"\"The inner `def` of Appendix A's Python-decorator shape — a body of\n240\t    nothing but an optional docstring, one nested def, and a `return` OF THAT\n241\t    DEF. Else None. The paper says \"only a nested function and a return\n242\t    statement\"; requiring the return to name the def is the narrow reading it\n243\t    asks for, and it is what stops a plain `def helper(): ...; return\n244\t    (helper(a), helper(b))` from claiming a decorator's exemption.\"\"\"\n245\t    body = [s for s in node.body if not _is_docstring(s)]\n246\t    if (\n247\t        len(body) != 2\n248\t        or not isinstance(body[0], _DEFS)\n249\t        or not isinstance(body[1], ast.Return)\n250\t    ):\n251\t        return None\n252\t    return body[0] if getattr(body[1].value, \"id\", None) == body[0].name else None\n253\t\n254\t\n255\tdef _exempt(fn):\n256\t    out, node = set(), _wrapped_def(fn)\n257\t    while node is not None:\n258\t        out.add(id(node))\n259\t        node = _wrapped_def(node)\n260\t    return out\n261\t\n262\t\n263\tdef cognitive(fn):\n264\t    \"\"\"The Sonar cognitive complexity of `fn`, nested defs and lambdas\n265\t    included.\"\"\"\n266\t    return _seq(fn.body, 0, (fn.name, _exempt(fn)))\n267\t\n268\t\n269\tdef _doc_lines(tree):\n270\t    out = set()\n271\t    for node in ast.walk(tree):\n272\t        if isinstance(node, (ast.Module, ast.ClassDef) + _DEFS) and node.body:\n273\t            head = node.body[0]\n274\t            if _is_docstring(head):\n275\t                out.update(range(head.lineno, head.end_lineno + 1))\n276\t    return out\n277\t\n278\t\n279\tdef sloc(node, lines, doc_lines):\n280\t    \"\"\"Non-blank, non-comment, non-docstring physical lines of `node`. Half the\n281\t    kit-scripts tree is prose by house style, so a raw line count would be\n282\t    measuring documentation.\"\"\"\n283\t    live = [i for i in range(node.lineno, node.end_lineno + 1) if i not in doc_lines]\n284\t    body = [lines[i - 1].strip() for i in live]\n285\t    return sum(1 for text in body if text and not text.startswith(\"#\"))\n286\t\n287\t\n288\tdef _collect(node, prefix, out):\n289\t    \"\"\"Every module-level function and method, qualified `Class.method`.\n290\t\n291\t    Descends through every statement container at module/class scope — control\n292\t    flow (`for`/`while`/`if`/`with`/`try`/`match`) can legally wrap a `def`, and\n293\t    a whitelist of only `if`/`try`/`with` silently drops the rest — but never\n294\t    into a function body: a nested def is scored INTO its enclosing function\n295\t    (`cognitive`), not given its own census row.\"\"\"\n296\t    for child in ast.iter_child_nodes(node):\n297\t        if isinstance(child, ast.ClassDef):\n298\t            _collect(child, prefix + child.name + \".\", out)\n299\t        elif isinstance(child, _DEFS):\n300\t            out.append((prefix + child.name, child))\n301\t        elif isinstance(child, _BLOCKS):\n302\t            _collect(child, prefix, out)\n303\t\n304\t\n305\tdef _bound(node, names):\n306\t    \"\"\"Names bound in module (or block) scope, descending through control flow\n307\t    the same way `_collect` does but never into a def/class body — whose names\n308\t    are not the module's surface.\"\"\"\n309\t    for child in ast.iter_child_nodes(node):\n310\t        if isinstance(child, (ast.ClassDef,) + _DEFS):\n311\t            names.append(child.name)\n312\t        elif isinstance(child, ast.Assign):\n313\t            names += [t.id for t in child.targets if isinstance(t, ast.Name)]\n314\t        elif isinstance(child, _BLOCKS):\n315\t            _bound(child, names)\n316\t\n317\t\n318\tdef _public(tree):\n319\t    \"\"\"Public module symbols, deduplicated — a `try/except` fallback that binds\n320\t    one name in both arms is one symbol, not two.\"\"\"\n321\t    names, seen, out = [], set(), []\n322\t    _bound(tree, names)\n323\t    for name in names:\n324\t        if not name.startswith(\"_\") and name not in seen:\n325\t            seen.add(name)\n326\t            out.append(name)\n327\t    return out\n328\t\n329\t\n330\tdef _paths(root, includes):\n331\t    seen = set()\n332\t    for pattern in includes:\n333\t        for path in sorted(root.glob(pattern)):\n334\t            rel = path.relative_to(root).as_posix()\n335\t            if PYCACHE not in path.parts and path.is_file() and rel not in seen:\n336\t                seen.add(rel)\n337\t                yield rel, path\n338\t\n339\t\n340\tdef census(root, includes):\n341\t    \"\"\"`(rows, modules)` — every function as `(path, name, cognitive, sloc)`\n342\t    and every module as `(path, public_symbols, lines)`. Paths are POSIX and\n343\t    relative to `root`, so a baseline is byte-identical on Windows and POSIX.\"\"\"\n344\t    rows, modules = [], []\n345\t    for rel, path in _paths(root, includes):\n346\t        text = path.read_text(encoding=\"utf-8\")\n347\t        tree = ast.parse(text)\n348\t        lines, docs = text.splitlines(), _doc_lines(tree)\n349\t        found = []\n350\t        _collect(tree, \"\", found)\n351\t        rows += [(rel, n, cognitive(f), sloc(f, lines, docs)) for n, f in found]\n352\t        modules.append((rel, len(_public(tree)), len(lines)))\n353\t    return sorted(rows), sorted(modules)\n354\t\n355\t\n356\tdef read_baseline(path):\n357\t    \"\"\"`{(path, function): (cognitive, sloc, reason)}`; empty when unstamped.\"\"\"\n358\t    out = {}\n359\t    if not path.exists():\n360\t        return out\n361\t    for line in path.read_text(encoding=\"utf-8\").splitlines():\n362\t        if line.startswith(\"#\"):\n363\t            continue\n364\t        cells = line.split(\"\\t\")\n365\t        if len(cells) < 4:\n366\t            continue\n367\t        reason = cells[4] if len(cells) > 4 else \"\"\n368\t        out[(cells[0], cells[1])] = (int(cells[2]), int(cells[3]), reason)\n369\t    return out\n370\t\n371\t\n372\tdef write_baseline(path, rows, old):\n373\t    text = [DEBT_NOTE + HEADER]\n374\t    for rel, name, cog, lines in rows:\n375\t        reason = old.get((rel, name), (\"\", \"\", \"\"))[2]\n376\t        text.append(\"\\t\".join((rel, name, str(cog), str(lines), reason)))\n377\t    path.parent.mkdir(parents=True, exist_ok=True)\n378\t    with open(path, \"w\", encoding=\"utf-8\", newline=\"\\n\") as handle:\n379\t        handle.write(\"\\n\".join(text) + \"\\n\")\n380\t\n381\t\n382\tdef compare(over, old):\n383\t    \"\"\"`(grew, improved)` as `[(path, function, was, now)]` — rows that rose\n384\t    above the baseline (or are new to it), and rows that fell below it (or\n385\t    vanished, reported as `now=None`).\"\"\"\n386\t    now = {(rel, name): cog for rel, name, cog, _ in over}\n387\t    grew, improved = [], []\n388\t    for key, score in sorted(now.items()):\n389\t        was = old[key][0] if key in old else None\n390\t        if was is None or score > was:\n391\t            grew.append(key + (was, score))\n392\t    for key, entry in sorted(old.items()):\n393\t        if now.get(key, -1) < entry[0]:\n394\t            improved.append(key + (entry[0], now.get(key)))\n395\t    return grew, improved\n396\t\n397\t\n398\tdef _fail(grew, improved):\n399\t    for rel, name, was, score in grew:\n400\t        print(\n401\t            \"check_complexity: FAIL - {}::{} cognitive {} -> {}. SIMPLIFY; a \"\n402\t            \"bump is a reviewed baseline edit whose reason lands in the log, \"\n403\t            \"never a drive-by.\\n{}\".format(rel, name, was, score, FIXES),\n404\t            file=sys.stderr,\n405\t        )\n406\t    for rel, name, was, score in improved:\n407\t        print(\n408\t            \"check_complexity: FAIL - {}::{} cognitive {} -> {}. RE-STAMP \"\n409\t            \"DOWNWARD (or delete the row) in this same commit, so the ratchet \"\n410\t            \"only ever tightens; `--restamp` writes it.\".format(rel, name, was, score),\n411\t            file=sys.stderr,\n412\t        )\n413\t\n414\t\n415\tdef _report(rows, modules, threshold):\n416\t    print(\"# \" + \"\\t\".join(COLUMNS[:4]))\n417\t    for row in rows:\n418\t        print(\"\\t\".join(str(cell) for cell in row))\n419\t    for cut in sorted({threshold, 25, 50}):\n420\t        print(\"# over {}: {}\".format(cut, sum(1 for r in rows if r[2] > cut)))\n421\t    for rel, public, lines in modules:\n422\t        print(\"# module\\t{}\\t{}\\t{}\".format(rel, public, lines))\n423\t\n424\t\n425\tdef main(argv=None):\n426\t    utf8_console()\n427\t    ap = argparse.ArgumentParser(\n428\t        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter\n429\t    )\n430\t    ap.add_argument(\"--root\", default=\".\", help=\"repo root (default: cwd)\")\n431\t    ap.add_argument(\"--mode\", choices=(\"report\", \"warn\", \"enforce\"), default=\"warn\")\n432\t    ap.add_argument(\"--report\", action=\"store_true\", help=\"alias for --mode report\")\n433\t    ap.add_argument(\"--restamp\", action=\"store_true\", help=\"rewrite the baseline\")\n434\t    ap.add_argument(\"--threshold\", type=int, default=DEFAULT_THRESHOLD)\n435\t    ap.add_argument(\"--include\", action=\"append\", default=None, metavar=\"GLOB\")\n436\t    ap.add_argument(\"--baseline\", default=BASELINE)\n437\t    args = ap.parse_args(argv)\n438\t\n439\t    root = Path(args.root).resolve()\n440\t    rows, modules = census(root, tuple(args.include or DEFAULT_INCLUDE))\n441\t    if args.report or args.mode == \"report\":\n442\t        _report(rows, modules, args.threshold)\n443\t        return 0\n444\t\n445\t    over = [r for r in rows if r[2] > args.threshold]\n446\t    path = root / args.baseline\n447\t    old = read_baseline(path)\n448\t    if args.restamp:\n449\t        write_baseline(path, over, old)\n450\t        print(\n451\t            \"check_complexity: re-stamped {} row(s) -> {}\".format(\n452\t                len(over), args.baseline\n453\t            )\n454\t        )\n455\t        return 0\n456\t\n457\t    grew, improved = compare(over, old)\n458\t    if not grew and not improved:\n459\t        print(\n460\t            \"check_complexity: OK - {} row(s) over {}, unchanged from baseline.\".format(\n461\t                len(over), args.threshold\n462\t            )\n463\t        )\n464\t        return 0\n465\t    _fail(grew, improved)\n466\t    return 1 if args.mode == \"enforce\" else 0\n467\t\n468\t\n469\tif __name__ == \"__main__\":\n470\t    sys.exit(main())\n471\t"}]},"parent_tool_use_id":null,"session_id":"24630cda-4612-43f6-af18-5afd3265c7d9","uuid":"7bb8476b-2d33-4379-a493-2e1c4538358d","timestamp":"2026-08-30T16:16:12.675Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\Projects\\ai-template-drive\\wi-537-complexity-sensor-report-only\\project-trajectory\\scripts\\check_complexity.py","content":"#!/usr/bin/env python3\n\"\"\"check_complexity.py — the stdlib cognitive-complexity + SLOC census.\n\nMeasures SonarSource Cognitive Complexity (CognitiveComplexity.pdf v1.7) and\nSLOC per function, plus a per-module public-symbol count (reported, never\ngated — the Ousterhout depth proxy). Stdlib only: a shipped check must not make\nevery adopter install a linter, which is why this exists beside — and not on\ntop of — the ruff C901 ratchet. Because the counting rules live in this\ndocstring rather than in a third-party tool, the baseline is a property of the\ncode, not of a tool version: a linter upgrade cannot silently invalidate it.\n\nREPORT-ONLY as shipped: no `[step:]` is wired into `docs/stack.ini`, so nothing\nruns this as a gate. The enforce capability exists (`--mode enforce`, exercised\nby the tests) but arming it is an opt-in act — a `[step:complexity]` step, of\nthe shape below:\n\n    [step:complexity]\n    command = {py} project-trajectory/scripts/check_complexity.py --root .\n\nCENSUS UNIT. One row per module-level function and per method. A nested `def`\nor `lambda` is scored INTO its enclosing function (Sonar charges the nesting\nincrement for it, never a base increment) and never gets its own row: the\nreward for decomposition is a SIBLING function or a new module, not an inner\none, and a second row for the inner def would double-count it in the census.\n\nBASELINE. `docs/complexity-baseline`, TSV, LF-only, sorted by path then\nfunction, one row per over-threshold function: path, function, cognitive, sloc,\nreason. Its own header states that it is a DEBT STATEMENT, not an approval. TSV\nfor one reason — the minimum merge-conflict surface when two concurrent\nsessions re-stamp; it matches the extension-less house data files under `docs/`\n(`docs/coverage-floors`). There is NO inline suppression pragma and there must\nnever be one; the escape hatch is this one reviewed central file, because a\nscattered opt-out self-replicates as new code copies it.\n\nImplements: SR-183, LLR-206\n\"\"\"\n\nimport argparse\nimport ast\nimport sys\nfrom pathlib import Path\n\nfrom kitlib.config import utf8_console\n\nDEFAULT_THRESHOLD = 15\nBASELINE = \"docs/complexity-baseline\"\nDEFAULT_INCLUDE = (\"project-trajectory/scripts/**/*.py\",)\nCOLUMNS = (\"path\", \"function\", \"cognitive\", \"sloc\", \"reason\")\nHEADER = \"# \" + \"\\t\".join(COLUMNS)\nDEBT_NOTE = (\n    \"# docs/complexity-baseline — one row per function over the cognitive-\"\n    \"complexity threshold when stamped.\\n\"\n    \"# A row is a DEBT STATEMENT, NOT AN APPROVAL: the reason column records \"\n    \"why it is carried, and the\\n\"\n    \"# baseline only ever tightens — re-stamp DOWNWARD or delete a row, never \"\n    \"up to clear a finding.\\n\"\n)\nPYCACHE = \"__pycache__\"\nFIXES = (\n    \"  named escapes: decompose OUTWARD (a sibling function or a new module, \"\n    \"never a nested def); express the branches as a data table \"\n    \"(check.py::steps is 670 lines at cognitive 14); define the error out of \"\n    \"existence so the branch disappears.\"\n)\n\n_LOOPS = (ast.For, ast.AsyncFor, ast.While)\n_COMPS = (ast.ListComp, ast.SetComp, ast.DictComp, ast.GeneratorExp)\n_DEFS = (ast.FunctionDef, ast.AsyncFunctionDef)\n# Statement containers to descend into when collecting module/class-scope\n# symbols — every stmt (control flow), plus the two block-bearing non-stmt\n# nodes: an except clause and a match case. A `def` under `for`/`while`/`match`\n# is a real module symbol, so the descent must not stop at `if`/`try`/`with`.\n_BLOCKS = (ast.stmt, ast.excepthandler) + (\n    (ast.match_case,) if hasattr(ast, \"match_case\") else ()\n)\n\n\ndef _kids(node, nesting, ctx):\n    return sum(_visit(c, nesting, ctx) for c in ast.iter_child_nodes(node))\n\n\ndef _seq(stmts, nesting, ctx):\n    return sum(_visit(s, nesting, ctx) for s in stmts)\n\n\ndef _h_if(node, nesting, ctx):\n    return (\n        1\n        + nesting\n        + _visit(node.test, nesting, ctx)\n        + _seq(node.body, nesting + 1, ctx)\n        + _h_orelse(node, nesting, ctx)\n    )\n\n\ndef _h_orelse(node, nesting, ctx):\n    \"\"\"TRAP 1. Python parses `elif` as an `If` nested in `orelse`, so a naive\n    recursion both double-counts and over-nes
