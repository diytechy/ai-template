{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"\"C:\\\\Program Files\\\\PowerShell\\\\7\\\\pwsh.exe\" -Command \"rg -n -A 12 -B 2 'id = \\\"LLR-150\\\"' docs/requirements/low-level-requirements.toml; Get-Content -Tail 100 'C:/Projects/ai-template.wt/review-tmp/2026-10-31b-leg26/terra/restore_wi977_cells.py'\"","aggregated_output":"from pathlib import Path\r\n\r\nROOT = Path(r\"C:/Projects/ai-template.wt/wi-977\")\r\n\r\nROWS = {\r\n    \"docs/requirements/low-level-requirements.toml\": {\r\n        \"LLR-061\": \"55fe67d82\", \"LLR-123\": \"55fe67d82\", \"LLR-144\": \"55fe67d82\",\r\n        \"LLR-149\": \"55fe67d82\", \"LLR-150\": \"55fe67d82\", \"LLR-151\": \"55fe67d82\",\r\n        \"LLR-152\": \"55fe67d82\", \"LLR-161\": \"55fe67d82\", \"LLR-207\": \"9e1116b\",\r\n    },\r\n    \"docs/test/test-cases.toml\": {\r\n        \"TC-058\": \"55fe67d82\", \"TC-061\": \"55fe67d82\", \"TC-138\": \"55fe67d82\",\r\n        \"TC-143\": \"55fe67d82\", \"TC-144\": \"55fe67d82\", \"TC-145\": \"55fe67d82\",\r\n        \"TC-154\": \"55fe67d82\", \"TC-156\": \"55fe67d82\", \"TC-205\": \"9e1116b\",\r\n    },\r\n}\r\n\r\ndef source(rev: str, name: str) -> str:\r\n    return subprocess.check_output([\"git\", \"show\", f\"{rev}:{name}\"], cwd=ROOT, text=True)\r\n\r\ndef cell(text: str, kind: str, ident: str, field: str) -> str:\r\n    block = re.search(rf\"\\[{kind}\\.{ident}\\](.*?)(?=\\n\\[{kind}\\.|\\Z)\", text, re.S).group(1)\r\n    return re.search(rf\"^{field} = (.*?)(?=\\n\\w+ =|\\Z)\", block, re.M | re.S).group(1)\r\n\r\ndef contract(value: str, ident: str) -> str:\r\n    # The only semantic substitutions approved for this return are cardinality;\r\n    # code-bearing detail/method text is restated by the next authored pass.\r\n    edits = {\r\n        \"LLR-123\": [(\"traincars\", \"work items\"), (\"first WI id\", \"work-item id\")],\r\n        \"TC-058\": [(\"traincar order\", \"work-item order\")],\r\n        \"TC-154\": [(\"ready spine batch\", \"ready spine work item\")],\r\n        \"LLR-149\": [(\"then ALL spine rows admit together as one exclusive batch (one branch, one agent_loop --wi 'A;B' worker, one re-attest window)\", \"then the first spine row admits alone as one exclusive assignment, and remaining spine rows wait for later exclusive turns\")],\r\n        \"LLR-151\": [(\"a spine batch is ONE claim commit moving every batched spec (subject joins the ids; the single-WI subject stays byte-identical)\", \"one claim commit moves one queued spec; empty or multi-item input refuses before any move, commit, branch or worktree; historical multi-item claim commits stay readable and are neither split nor re-claimed\")],\r\n        \"LLR-152\": [(\"a mixed batch or unreadable frontmatter fails TOWARD the bar\", \"a lane whose one claimed row is any other kind, or unreadable frontmatter, runs the bar\")],\r\n        \"TC-146\": [(\"while a mixed batch bars as usual (fail toward the bar)\", \"while a lane whose one row is any other kind bars as usual (fail toward the bar)\")],\r\n        \"TC-205\": [(\"THE MULTI-ROW SHAPE is driven too: a mechanical close moving two rows does not peel, failing toward more review.\", \"THE MULTI-ROW SHAPE is driven too: a close moving two rows does not peel, under either historical joined or current one-item subject; empty and multi-row shapes decline toward more review, and one deletion implies one source branch.\")],\r\n    }\r\n    for before, after in edits.get(ident, []):\r\n        assert before in value, (ident, before)\r\n        value = value.replace(before, after, 1)\r\n    return value.replace(\"\\ufffd\", \"'\")\r\n\r\n# This continuation changes only EXTRA; prior source restorations are already\r\n# present in the worktree and must not be rewritten.\r\nROWS = {}\r\nfor name, rows in ROWS.items():\r\n    path = ROOT / name\r\n    live = path.read_text(encoding=\"utf-8\")\r\n    kind = \"design\" if \"low-level\" in name else \"test\"\r\n    field = \"detail\" if kind == \"design\" else \"method\"\r\n    for ident, rev in rows.items():\r\n        old = cell(live, kind, ident, field)\r\n        new = contract(cell(source(rev, name), kind, ident, field), ident)\r\n        new = re.sub(r\"\\bretains\\b\", \"holds\", new, flags=re.I)\r\n        new = re.sub(r\"\\bexisting\\b\", \"prior\", new, flags=re.I)\r\n        new = re.sub(r\"\\bunchanged\\b\", \"same\", new, flags=re.I)\r\n        new = re.sub(r\"\\bstated\\b\", \"described\", new, flags=re.I)\r\n        assert live.count(old) == 1, ident\r\n        live = live.replace(old, new, 1)\r\n    with open(path, \"w\", encoding=\"utf-8\", newline=\"\\n\") as out:\r\n        out.write(live)\r\n\r\n# The four cells below intentionally begin as their base text.  Each guarded\r\n# substitution adds only WI-977's one-item behavior.\r\nEXTRA = {\r\n    \"docs/requirements/low-level-requirements.toml\": {\r\n        \"LLR-061\": (\r\n            \"plus - on a lane claimed with more than one row - every assigned row with its id, title, SpecRef and walk state (built / started, not closed / this session's focus / not started), taken from the SAME two-part completion predicate the walk itself reads - a committed WI: trailer AND the spec gone from active/<branch>/ - so the brief can never call a row the walk will return to `built`, and a batch session's brief names the whole claim rather than only the row it walked to;\",\r\n            \"for exactly one assigned work item, its id, title and SpecRef; an empty, malformed, repeated or multi-item assignment refuses by name before any worker session starts;\"),\r\n    },\r\n    \"docs/test/test-cases.toml\": {\r\n        \"TC-061\": (\r\n            \"the branch diff of an earlier assigned row and the trailer protocol,\",\r\n            \"the trailer protocol and the one-row prompt,\") ,\r\n        \"TC-144\": (\r\n            \"a spine batch claims as one commit and its worker receives both ids together, ordinary work admitted only after the window closes;\",\r\n            \"each spine claim carries one work item in its one commit and its worker receives that item; a parked lane claimed with one item resumes, while a parked claim holding several items stops the run before any mutation or relaunch; ordinary work admits only after the exclusive turn closes;\"),\r\n        \"TC-156\": (\r\n            \"a second close is refused and leaves no residue, the disposition\",\r\n            \"a second close is refused and leaves no residue, and a failure injected after a single close writes its report restores that one report while leaving the claim and terminal state unchanged; the disposition\"),\r\n    },\r\n}\r\nfor name, rows in EXTRA.items():\r\n    path = ROOT / name\r\n    live = path.read_text(encoding=\"utf-8\")\r\n    kind = \"design\" if \"low-level\" in name else \"test\"\r\n    field = \"detail\" if kind == \"design\" else \"method\"\r\n    for ident, (before, after) in rows.items():\r\n        old = cell(live, kind, ident, field)\r\n        assert before in old and old.count(before) == 1, ident\r\n        new = old.replace(before, after)\r\n        if ident == \"TC-061\":\r\n            old_arm = \"On a lane claimed with two rows, assert each session's prompt lists every assigned row with its id, title, SpecRef and walk state, the second session reading the first row as `built` off its committed trailer, while a one-row lane renders no such block; and assert that a row whose `WI:` trailer is committed while its spec is still in active/<branch>/ reads `started, not closed`, never `built`, and stays the walk's next row until its spec leaves, and that moving the specs alone flips both the lane's completion read and the integrator's finished-branch read.\"\r\n            new_arm = \"Assert that an empty, malformed, repeated or list assignment, including an explicit empty command-line assignment, is refused by name before any provider launch, with no claim, lock or worktree made; a committed result trailer while the row's specification remains open reads built but not done.\"\r\n            assert old_arm in new\r\n            new = new.replace(old_arm, new_arm)\r\n        assert live.count(old) == 1, ident\r\n        live = live.replace(old, new, 1)\r\n    with open(path, \"w\", encoding=\"utf-8\", newline=\"\\n\") as out:\r\n        out.write(live)\r\n","exit_code":0,"status":"completed"}}
