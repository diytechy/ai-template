l raises after the bound. A descendant that denies the kill access to wait on it also makes the kill raise, rather than letting the coordinator continue without knowing whether it ended.\"","+acceptance_criteria = \"At a wall deadline, an idle deadline, or coordinator interruption, the direct session child and every process still in the session process group on POSIX or session job on Windows have ended before the coordinator continues; if any has not ended within 10 s of the kill, the coordinator stops with an error naming what survived instead of continuing.\"","+priority = \"S\"","+verification = \"Test\"","+status = \"Approved\"","+phase = 6","+form = \"cross-cutting\""]}]},{"filePath":"C:\\Projects\\ai-template.wt\\wi-881\\docs\\requirements\\system-requirements.toml","hunks":[{"oldStart":1868,"oldLines":6,"newStart":1868,"newLines":6,"lines":[" acceptance_criteria = \"At a wall deadline, an idle deadline, or coordinator interruption, the direct session child and every process still in the session process group on POSIX or session job on Windows have ended before the coordinator continues; if any has not ended within 10 s of the kill, the coordinator stops with an error naming what survived instead of continuing.\""," priority = \"S\""," verification = \"Test\"","-status = \"Drafted\"","+status = \"Approved\""," phase = 6"," form = \"cross-cutting\""]}]}],"moreFiles":0,"changedFiles":["C:\\Projects\\ai-template.wt\\wi-881\\docs\\archive\\last_approved\\README.md","C:\\Projects\\ai-template.wt\\wi-881\\docs\\archive\\last_approved\\acts.toml","C:\\Projects\\ai-template.wt\\wi-881\\docs\\archive\\last_approved\\docs\\requirements\\system-requirements.toml","C:\\Projects\\ai-template.wt\\wi-881\\docs\\requirements\\system-requirements.toml"]}}}
