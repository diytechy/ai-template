d":"84f485ca-7d86-46c9-85e6-54376a8c7e94","total_cost_usd":14.9290005,"usage":{"input_tokens":274,"cache_creation_input_tokens":226875,"cache_read_input_tokens":20859989,"output_tokens":89072,"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":226875,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":1380,"cache_read_input_tokens":225361,"cache_creation_input_tokens":1514,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1514},"type":"message"}],"speed":"standard"},"modelUsage":{"claude-haiku-4-5-20251001":{"inputTokens":1986,"outputTokens":20,"cacheReadInputTokens":0,"cacheCreationInputTokens":0,"webSearchRequests":0,"costUSD":0.0020859999999999997,"contextWindow":200000,"maxOutputTokens":32000},"claude-opus-5":{"inputTokens":274,"outputTokens":89072,"cacheReadInputTokens":20859989,"cacheCreationInputTokens":226875,"webSearchRequests":0,"costUSD":14.926914499999999,"contextWindow":200000,"maxOutputTokens":32000}},"permission_denials":[],"terminal_reason":"completed","fast_mode_state":"off","uuid":"aa8f0f33-bfb5-4e44-bdc9-eccb971a205d"}
