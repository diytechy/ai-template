d3bd.md.requested","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false,"bashEditDiff":{"files":[{"filePath":"C:\\Projects\\ai-template.wt\\wi-931\\docs\\archive\\last_approved\\README.md","hunks":[{"oldStart":146,"oldLines":3,"newStart":146,"newLines":4,"lines":[" - 2026-10-16 — refresh under approval. Copied: system-requirements.toml (re-attested: SR-154). Registries not named by this act keep their prior snapshot bytes."," - 2026-10-16 — refresh under approval. Copied: low-level-requirements.toml (re-attested: LLR-313); test-cases.toml (re-attested: TC-333). Registries not named by this act keep their prior snapshot bytes."," - 2026-10-17 — refresh under approval. Copied: low-level-requirements.toml (re-attested: LLR-300); test-cases.toml (re-attested: TC-339). Registries not named by this act keep their prior snapshot bytes.","+- 2026-10-17 — refresh under approval. Copied: system-requirements.toml (re-attested: SR-238); low-level-requirements.toml (re-attested: LLR-026); test-cases.toml (re-attested: TC-026). Registries not named by this act keep their prior snapshot bytes."]}]},{"filePath":"C:\\Projects\\ai-template.wt\\wi-931\\docs\\archive\\last_approved\\acts.toml","hunks":[{"oldStart":756,"oldLines":3,"newStart":756,"newLines":9,"lines":[" date = \"2026-10-17\""," approved = []"," reattested = [\"LLR-300\", \"TC-339\"]","+","+[[act]]","+seq = 125","+date = \"2026-10-17\"","+approved = []","+reattested = [\"LLR-026\", \"SR-238\", \"TC-026\"]"]}]},{"filePath":"C:\\Projects\\ai-template.wt\\wi-931\\docs\\archive\\last_approved\\docs\\requirements\\low-level-requirements.toml","hunks":[{"oldStart":279,"oldLines":9,"newStart":279,"newLines":9,"lines":[" sr_refs = [\"SR-026\", \"SR-238\"]"," title = \"Headless session launch\""," module = \"project-trajectory/scripts/agent_session.py;project-trajectory/scripts/session_adapters.py\"","-code_symbol = \"build_argv/run_session/_codex_lastmsg_setup/_win32/_contain_in_job/_spawn_session/_end_launch/_end_suspended/_start_session_io/_feed_stdin/TreeNotEnded/_kill_tree/_end_job_tree/_end_group_tree/_terminate_job/_close_job/_open_job_members/_in_job/_close_handles/_job_active_processes/_job_survivors/_group_survivors/_await_tree_end\"","-detail = \"\"\"Runs the agent CLI headless: build_argv substitutes {model} into argv and, when a CmdTemplate carries no {prompt} placeholder (the default for both provider CLIs), routes the prompt to the child's STDIN (run_session writes it from a daemon thread then closes), while the no-wedge invariant holds — a fixed prompt plus EOF, never an interactive read. A codex session additionally captures that CLI's own --output-last-message file as the result (_codex_lastmsg_setup/_codex_lastmsg_read). stdin is otherwise closed so no prompt wedges the loop; the scope is the dispatcher and worker sessions, and the former status.md-resume read is retired rather than coexisting with them. The launch owns the child from when Popen returns; an interruption inside Popen is outside the kill and can lose a running POSIX child. A wall or idle deadline, or an interruption after Popen returns the child, ends every process in the session process group on POSIX or session job on Windows: the direct child is reaped, then the group or job is polled until empty. On Windows the kill first closes the job to new members, then takes a handle on each member, then terminates the job, and returns only when the job count is zero and every held member is signalled; an unopenable live member raises after the terminate. Past 10 s the kill raises naming the survivor. A failure to end the tree, or to show that it ended, raises TreeNotEnded, which no ordinary handler converts into a session result; an ordinary launch error still returns the session error. A child that cannot be contained ends as a session error before it runs.\"\"\"","-rationale = \"\"\"A large prompt passed as argv dies at the OS command-line cap (8191 characters through a Windows .CMD shim, 32767 via CreateProcess) and a round's briefs run to roughly 70k, so stdin is the only delivery that survives — both limits verified live rather than assumed. The last-message capture exists because that CLI echoes its banner and the whole prompt into stdout, so stdout is not the result. A surviving descendant can keep editing a worktree after its parent session ends; process-group and job containment make the tree an atomic session lifetime, while an uncontained Windows child is rejected before it can create that survivor. Closing the Windows job before its member snapshot makes that snapshot complete, and holding each member before termination covers the measured interval where the job count reaches zero before a terminated process is signalled.\"\"\"","+code_symbol = \"build_argv/run_session/_codex_lastmsg_setup/_win32/_contain_in_job/_spawn_session/_start_session_io/_feed_stdin/TreeNotEnded/_kill_tree/_end_job_tree/_end_group_tree/_terminate_job/_open_job_members/_close_handles/_job_active_processes/_job_survivors/_group_survivors/_await_tree_end\"","+detail = \"\"\"Runs the agent CLI headless: build_argv substitutes {model} into argv and, when a CmdTemplate carries no {prompt} placeholder (the default for both provider CLIs), routes the prompt to the child's STDIN (run_session writes it from a daemon thread then closes), while the no-wedge invariant holds — a fixed prompt plus EOF, never an interactive read. A codex session additionally captures that CLI's own --output-last-message file as the result (_codex_lastmsg_setup/_codex_lastmsg_read). stdin is otherwise closed so no prompt wedges the loop; the scope is the dispatcher and worker sessions, and the former status.md-resume read is retired rather than coexisting with them. An interruption ends the tree only once the coordinator supervises the session; one that lands while the session is still being launched is outside the kill. A wall or idle deadline, or an interruption while the coordinator supervises the session, ends every process in the session process group on POSIX or session job on Windows: the direct child is reaped, then the group or job is polled until empty. On Windows the kill takes a handle on each member, then terminates the job, and returns only when the job count is zero and every held member is signalled; an unopenable live member raises after the terminate. Past 10 s the kill raises naming the survivor. A failure to end the tree, or to show that it ended, raises the named tree-end error; an ordinary launch error still returns the session error. A child that cannot be contained ends as a session error before it runs.\"\"\"","+rationale = \"\"\"A large prompt passed as argv dies at the OS command-line cap (8191 characters through a Windows .CMD shim, 32767 via CreateProcess) and a round's briefs run to roughly 70k, so stdin is the only delivery that survives — both limits verified live rather than assumed. The last-message capture exists because that CLI echoes its banner and the whole prompt into stdout, so stdout is not the result. A surviving descendant can keep editing a worktree after its parent session ends; process-group and job containment make the tree an atomic session lifetime, while an uncontained Windows child is rejected before it can create that survivor. Holding each member before termination covers the measured interval where the job count reaches zero before a terminated process is signalled.\"\"\""," test_refs = \"(see TC-026)\""," status = \"Approved\""," component = \"CMP-008\""]}]},{"filePath":"C:\\Projects\\ai-template.wt\\wi-931\\docs\\archive\\last_approved\\docs\\requirements\\system-requirements.toml","hunks":[{"oldStart":1864,"oldLines":8,"newStart":1864,"newLines":8,"lines":[" boundary_refs = [\"B-10\"]"," hat_refs = [\"UNATTENDED-OPS\"]"," requirement = \"When a declared deadline or coordinator interruption ends a session, the delivered coordinator shall end every process in the session process group on POSIX or session job on Windows.\"","-rationale = \"A descendant can outlive the direct session child and keep editing the worktree handed to the next session. Ending only the direct child was rejected because it leaves that concurrent writer outside the coordinator's supervision. The bounded guarantee excludes a descendant that leaves the session process group and a process another service starts outside the session job: neither is ended, and the kill does not report it. A POSIX zombie under a PID 1 that never reaps keeps the group nonempty, so the kill raises after the bound. A descendant that denies the kill access to wait on it also makes the kill raise, rather than letting the coordinator continue without knowing whether it ended. Stopping is the need's cannot-proceed case, not a supervision fault: continuing would hand the worktree to the next session beside a writer that may still be live, and nothing can proceed safely past that. An interruption inside platform process creation, before the child reaches the coordinator, is not covered.\"","-acceptance_criteria = \"At a wall deadline, an idle deadline, or a coordinator interruption once the platform's process creation has returned the child, the direct session child and every process still in the session process group on POSIX or session job on Windows have ended before the coordinator continues; if any has not ended within 10 s of the kill, the coordinator stops with an error naming what survived instead of continuing.\"","+rationale = \"A descendant can outlive the direct session child and keep editing the worktree handed to the next session. Ending only the direct child was rejected because it leaves that concurrent writer outside the coordinator's supervision. The bounded guarantee excludes a descendant that leaves the session process group and a process another service starts outside the session job: neither is ended, and the kill does not report it. A POSIX zombie under a PID 1 that never reaps keeps the group nonempty, so the kill raises after the bound. A descendant that denies the kill access to wait on it also makes the kill raise, rather than letting the coordinator continue without knowing whether it ended. Stopping is the need's cannot-proceed case, not a supervision fault: continuing would hand the worktree to the next session beside a writer that may still be live, and nothing can proceed safely past that. Two windows lie outside the guarantee, each sub-second and on no supported workflow's ordinary path: an interruption while the session is still being launched, before the coordinator supervises it, which can leave a running child; and a process that joins the session job while the kill takes its member list, which is terminated with the job but can still be ending, for milliseconds, when the coordinator continues.\"","+acceptance_criteria = \"At a wall deadline, an idle deadline, or a coordinator interruption while the coordinator supervises a launched session, the direct session child and every process in the session process group on POSIX, or in the session job when the kill takes its member list on Windows, have ended before the coordinator continues; a process that joins the session job later in the kill is terminated with the job; if any has not ended within 10 s of the kill, the coordinator stops with an error naming what survived instead of continuing.\""," priority = \"S\""," verification = \"Test\""," status = \"Approved\""]}]},{"filePath":"C:\\Projects\\ai-template.wt\\wi-931\\docs\\archive\\last_approved\\docs\\test\\test-cases.toml","hunks":[{"oldStart":276,"oldLines":11,"newStart":276,"newLines":11,"lines":[" [test.TC-026]"," verifies = [\"SR-026\", \"SR-238\", \"LLR-026\"]"," level = \"Integration\"","-method = \"\"\"Run the agent-loop suite; the dispatcher and its workers resume headless (registry + reservations + explicit assignments) without blocking on any prompt; a no-{prompt} CmdTemplate delivers its prompt on stdin (build_argv/run_session), a large prompt surviving untruncated. test_a_deadline_kill_ends_the_grandchild shows that a deadline ends a real grandchild before the call returns on POSIX and, through a .cmd shim, on Windows. test_an_interruption_ends_the_grandchild shows that the interruption path ends that grandchild before it propagates. test_an_uncontainable_child_errors_before_it_runs shows that a Windows containment failure returns a session error before the child runs. test_a_tree_not_ended_within_the_bound_raises shows that an overrun raises within the stated bound and names the survivor. test_a_member_spawned_during_the_kill_has_ended_when_it_returns shows that no Windows member admitted during the kill remains when it returns. test_a_member_the_kill_cannot_open_makes_it_raise shows that an unopenable Windows member raises after the job is terminated. test_an_interruption_after_the_resume_ends_the_launching_child shows that a Windows interruption after resume ends the launching child. test_an_interruption_before_the_job_ends_the_suspended_child shows that a Windows interruption before containment ends the suspended child. test_an_interruption_in_supervision_ends_the_child shows on both platforms that interruptions during I/O setup or deadline handoff end the child. test_an_interrupted_launch_whose_tree_cannot_be_verified_raises shows that a Windows interrupted launch whose job members cannot be verified raises TreeNotEnded with the interruption preserved in its chain. test_a_launch_cleanup_that_cannot_terminate_raises shows that a Windows launch cleanup that cannot terminate the job raises TreeNotEnded. test_an_ordinary_launch_error_still_returns_the_session_error shows that a missing executable still returns the ordinary session error. test_run_session_idle_deadline_kills_a_silent_child shows that the idle deadline returns within 40 s.\"\"\"","+method = \"\"\"Run the agent-loop suite; the dispatcher and its workers resume headless (registry + reservations + explicit assignments) without blocking on any prompt; a no-{prompt} CmdTemplate delivers its prompt on stdin (build_argv/run_session), a large prompt surviving untruncated. test_a_deadline_kill_ends_the_grandchild shows that a deadline ends a real grandchild before the call returns on POSIX and, through a .cmd shim, on Windows. test_an_interruption_ends_the_grandchild shows that the interruption path ends that grandchild before it propagates. test_an_uncontainable_child_errors_before_it_runs shows that a Windows containment failure returns a session error before the child runs. test_a_tree_not_ended_within_the_bound_raises shows that an overrun raises within the stated bound and names the survivor. test_a_member_the_kill_cannot_open_makes_it_raise shows that an unopenable Windows member raises after the job is terminated. test_an_ordinary_launch_error_still_returns_the_session_error shows that a missing executable still returns the ordinary session error. test_run_session_idle_deadline_kills_a_silent_child shows that the idle deadline returns within 40 s.\"\"\""," tier = \"Full\"","-expected = \"Satisfies SR-026 AcceptanceCriteria; the bounded descendants have ended when the coordinator continues, with no grace period; an interruption before containment, after the resume, or during I/O setup or the deadline handoff ends the child as one during the wait does; an uncontainable child errors before it runs; no process enters the job once the kill begins; an unopenable member or an overrun past 10 s raises; and a failure to end or verify the tree raises TreeNotEnded instead of returning a session result, while an ordinary launch error still returns the session error.\"","+expected = \"Satisfies SR-026 AcceptanceCriteria; the bounded descendants have ended when the coordinator continues, with no grace period; an interruption during supervision ends them as a deadline does; an uncontainable child errors before it runs; an unopenable member or an overrun past 10 s raises; and an ordinary launch error still returns the session error.\""," automated = \"Yes\"","-evidence = \"tests/test_agent_loop.py; tests/test_session_stdin.py::test_a_deadline_kill_ends_the_grandchild; tests/test_session_stdin.py::test_an_interruption_ends_the_grandchild; tests/test_session_stdin.py::test_an_uncontainable_child_errors_before_it_runs; tests/test_session_stdin.py::test_a_tree_not_ended_within_the_bound_raises; tests/test_session_stdin.py::test_a_member_spawned_during_the_kill_has_ended_when_it_returns; tests/test_session_stdin.py::test_a_member_the_kill_cannot_open_makes_it_raise; tests/test_session_stdin.py::test_an_interruption_after_the_resume_ends_the_launching_child; tests/test_session_stdin.py::test_an_interruption_before_the_job_ends_the_suspended_child; tests/test_session_stdin.py::test_an_interruption_in_supervision_ends_the_child; tests/test_session_stdin.py::test_an_interrupted_launch_whose_tree_cannot_be_verified_raises; tests/test_session_stdin.py::test_a_launch_cleanup_that_cannot_terminate_raises; tests/test_session_stdin.py::test_an_ordinary_launch_error_still_returns_the_session_error; tests/test_session_stdin.py::test_run_session_idle_deadline_kills_a_silent_child\"","+evidence = \"tests/test_agent_loop.py; tests/test_session_stdin.py::test_a_deadline_kill_ends_the_grandchild; tests/test_session_stdin.py::test_an_interruption_ends_the_grandchild; tests/test_session_stdin.py::test_an_uncontainable_child_errors_before_it_runs; tests/test_session_stdin.py::test_a_tree_not_ended_within_the_bound_raises; tests/test_session_stdin.py::test_a_member_the_kill_cannot_open_makes_it_raise; tests/test_session_stdin.py::test_an_ordinary_launch_error_still_returns_the_session_error; tests/test_session_stdin.py::test_run_session_idle_deadline_kills_a_silent_child\""," status = \"Approved\""," phase = 1"," "]}]}],"moreFiles":0,"changedFiles":["C:\\Projects\\ai-template.wt\\wi-931\\docs\\archive\\last_approved\\README.md","C:\\Projects\\ai-template.wt\\wi-931\\docs\\archive\\last_approved\\acts