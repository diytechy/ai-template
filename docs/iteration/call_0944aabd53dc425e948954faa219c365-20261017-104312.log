wrap file reads.\n\n**Advisory:** LLR-026 no longer says the tree-end error must never be turned into a session result. Today that holds only because of how the code is structured. SR-238 still forbids continuing, but a future broad `except OSError` around a launch would breach it without the LLR saying why. A later edit could restate that without naming a carrier.\n\nThe untracked `003-ADJUDICATE-4dbd3bd.md.requested` belongs to the coordinator, and I didn't touch it.","ttft_ms":29804,"type":"result","duration_ms":336141,"uuid":"3e20a224-8ae5-4610-bebb-6daf5e0ca7c7","ttft_stream_ms":23616,"time_to_request_ms":641,"time_to_request_phases_ms":{"other":45,"system_prompt":99,"resume_other":0,"process_user_input":8,"input_attachments":339,"input_hooks":11,"transcript_persist":4,"tool_pool_refresh":4,"init_message":18,"engine_pickup":3,"message_prep":2,"model_config_wait":2,"autocompact":3,"query_setup":2,"model_gates":1,"tool_schema_build":18,"message_normalization":39,"client_creation":9,"request_build":34},"turn_start_resume_kind":"none","process_turn_index":0,"time_to_request_loop_lag_ms":185,"time_to_request_cpu_ms":781,"time_to_request_major_faults":34700,"input_attachments_detail":{"slowest_producer":"changed_files","slowest_producer_ms":310,"cpu_ms":484,"major_faults":23868,"changed_files_reread":11},"first_content_frame_ms":23617,"queued_turn_count":0,"result_index":0}]
