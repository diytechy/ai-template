{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"\"C:\\\\Program Files\\\\PowerShell\\\\7\\\\pwsh.exe\" -Command '$p='\"'docs/requirements/system-requirements.toml'; \"'$a=Get-Content $p; foreach($id in '\"'SR-224','SR-244'){ \"'$s=($a|Select-String \"''^'\"\\\\[requirement\\\\.\"'$id'\"\\\\]\\\").LineNumber; \\\"---\"'$id---\"; $a[($s-1)..($s+12)] }'","aggregated_output":"---SR-224---\r\n[requirement.SR-224]\r\ntitle = \"A skill whose description cannot say when to use it fails the skills-index check\"\r\nsn_refs = [\"SN-005\"]\r\nboundary_refs = [\"B-05\"]\r\nhat_refs = [\"FIRST-RUN-ADOPTER\"]\r\nrequirement = \"The skill descriptions the kit ships are at or above the declared description floor, and if a skill's description is shorter than that floor, then the kit's skills-index check shall fail, naming that skill.\"\r\nrationale = \"\"\"A DERIVED requirement, and labelled so. SN-005 asks that agents and humans work from the same playbook; it does not name what a skill's description must carry, so this obligation arrives through the first-run-adopter lens rather than through the need's text. An agent reads only a skill's description to decide whether to load it, so a description too short to say when to use the skill is shipped guidance an adopter's agent never reads: the skill works only for someone who already knows it exists, the undocumented-knowledge failure that lens listens for. A length floor is a lexical proxy, not a proof that a description is good: it catches the one-line stub that cannot state a trigger and leaves the wording to review. A reviewer's judgement of every description was the alternative, and it lost as the only guard because nothing would re-ask it when a skill is added. Fed back to the need: SN-005's acceptance could name the skills' descriptions as part of the playbook; until it does, this row is derived and says so.\"\"\"\r\nacceptance_criteria = \"A skill whose description is shorter than the declared floor fails the check, which names that skill and not a skill at the floor; a description at the floor passes; the kit's shipped skills clear the floor.\"\r\npriority = \"C\"\r\nverification = \"Test\"\r\nstatus = \"Drafted\"\r\nphase = 6\r\n\r\n[requirement.SR-225]\r\n---SR-244---\r\n[requirement.SR-244]\r\ntitle = \"Transcript-derived usage records include coordinated nested agents\"\r\nsn_refs = [\"SN-026\"]\r\nhat_refs = [\"PERFORMANCE\"]\r\nrequirement = \"The delivered coordination capability shall record once each transcript-bearing model session that coordination completion ingests for coordinated work, including every session an agent spawns at any nesting depth, with its identity and transcript-derived usage; record no already-recorded message, duplicate no service record, grant its record no gate authority, include no transcript text, refuse an unknown source shape, and direct completion to ingest the current session and a named prior-session tail.\"\r\nrationale = \"A DERIVED requirement through the PERFORMANCE lens: SN-026 makes model-family routing a configurable operating choice, but does not require the cost of coordinated sessions outside the launcher result to be visible. The lens identifies an incomplete cost reading when nested work is omitted or a repeated or resumed read inflates it. Recorded probes establish that a resume appends to its existing transcript, that a Claude result excludes sub-agent usage, and that arbitrary nesting occurs; a sub-agent's final hand-back often has no stop record and is complete once the session's transcripts show the agent finished. The direct-child fan-out re-stamp is intentional: the independently observable reader, identity, contribution, recovery, duplication, shape, source-selection, record, CLI, and completion decisions must not be merged. Fed back to the need: its acceptance could require the owner to see complete, non-duplicated usage for coordinated work across the configured families.\"\r\nacceptance_criteria = \"Every ingested transcript-bearing coordination session and nested agent is recorded with its identity; usage counts each completed message once, marks source-stated partial counts, retries add no already-recorded messages, and resumed recording adds only newly finalized messages; a session already recorded by the service is not counted twice; an ingested record has no gate authority and contains no transcript text; an unknown source shape is refused naming the defect; and published coordination guidance runs the recording at close-out and at a headless leg's end, including pickup of the previous session's tail.\"\r\npriority = \"S\"\r\nverification = \"Test\"\r\nstatus = \"Approved\"\r\nphase = 6\r\naspect = \"performance\"\r\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"\"C:\\\\Program Files\\\\PowerShell\\\\7\\\\pwsh.exe\" -Command '$p='\"'docs/requirements/low-level-requirements.toml'; \"'$a=Get-Content $p; $s=($a|Select-String '\"'\"'^'\"\\\\[design\\\\.LLR-281\\\\]').LineNumber; \"'$a[($s-1)..($s+15)]; $p='\"'docs/test/test-cases.toml'; \"'$a=Get-Content $p; $s=($a|Select-String '\"'\"'^'\"\\\\[test\\\\.TC-291\\\\]').LineNumber; \"'$a[($s-1)..($s+15)]; Get-Content -Raw docs/plans/WI-850/sr-224.perspectives.toml'","aggregated_output":"[design.LLR-281]\r\nsr_refs = [\"SR-224\"]\r\ntitle = \"The skills-index check refuses a description under the floor, by name\"\r\nmodule = \"project-trajectory/scripts/gen_skills_index.py\"\r\ncode_symbol = \"refuse_short_descriptions/short_descriptions/DESCRIPTION_FLOOR\"\r\ndetail = \"\"\"DESCRIPTION_FLOOR is the shortest description --check accepts, in characters, set at 100: room for a trigger and an effect (\"Use when <trigger> - <what>\"). short_descriptions(rows) returns the name and length of the rows under it, and refuse_short_descriptions(rows), called first by --check, prints one SHORT line per such skill naming it, its length and the floor, then exits 1. The regenerating path does not apply the floor, so a short description is refused where the index is checked rather than silently written.\"\"\"\r\nrationale = \"\"\"The floor is one declared number read by one function, so the check and its tests agree on it; a length written into the message and the comparison separately would drift. Refusing at --check rather than at regeneration keeps the generator total: the index still renders, and the gate that reads the generator's exit code is the one that says the description needs rewriting.\"\"\"\r\ntest_refs = \"(see TC-291)\"\r\nstatus = \"Approved\"\r\ncomponent = \"CMP-009\"\r\nphase = 6\r\n\r\n[design.LLR-285]\r\nsr_refs = [\"SR-054\"]\r\nhat_refs = [\"ACCESSIBILITY\"]\r\ntitle = \"A de-emphasised node drains its hue, not its contrast (T5 core)\"\r\nmodule = \"project-trajectory/scripts/gen_trajectory.py;project-trajectory/scripts/rendering/traj_render.py;project-trajectory/scripts/rendering/traj_panels.py\"\r\n[test.TC-291]\r\nverifies = [\"SR-224\", \"LLR-281\", \"IF-254\"]\r\nlevel = \"Unit\"\r\nmethod = \"\"\"(a) THE REFUSAL: a planted skills directory under a temporary directory holds one skill whose description is under the floor and one exactly at it; after the index is written, --check exits 1, its error output names the short skill and the floor and does not name the skill at the floor. (b) THE SHIPPED SET: short_descriptions over the kit's own skills returns nothing.\"\"\"\r\ntier = \"Smoke\"\r\nexpected = \"Satisfies SR-224 AcceptanceCriteria: a description under the floor fails the check by name, one at the floor passes, and every shipped skill clears it\"\r\nautomated = \"Yes\"\r\nevidence = \"tests/test_skills_index.py::test_check_refuses_a_description_under_the_floor; tests/test_skills_index.py::test_every_shipped_description_clears_the_floor\"\r\nstatus = \"Approved\"\r\nphase = 6\r\n\r\n[test.TC-296]\r\nverifies = [\"SR-054\", \"LLR-285\"]\r\nlevel = \"Unit\"\r\nmethod = \"\"\"Sweep every fresh emitter document, one fixture per emitter (the committed dashboard is left out: the case asserts the current emitter, which only a document rendered now evidences, and the committed artifact's freshness is SR-070's contract), and derive from each document's stylesheet every rule whose selector puts a de-emphasis state class (the dim and trace-muted states the page scripts toggle) on a node shape that document draws with a label. Model the rule's paint as the browser applies it: its shorthand filter functions as colour matrices over sRGB channels, then its opacity composited over the page surface, refusing a rule that sets any other property or names an unmodelled filter function. For every node the rule reaches, resolve its fill, its label ink (inline, else the most specific stylesheet rule for its classes) and, where it carries a descend arrow, its per-node ring ink or the accent fallback, in both themes and over both page surfaces, and assert each ink clears 4.5:1 against the de-emphasised fill. Assert the sweep reached the drill block, the icicle cell, the flat-roadmap work item and the knowledge concept, with the descend arrow among them.\"\"\"\r\ntier = \"Full\"\r\nparameters = \"tests/traj_fixtures.py (_every_emitter_document: the seven fresh emitter fixtures)\"\r\n# PERSPECTIVE RECORD (SR-161) for one decomposition, written by\n# `hats.py record`. A rewrite regenerates every field EXCEPT the ones a\n# person authors: subject, rows, tags, recorded_by, recorded_on, and each\n# perspective's no_finding. Comments are not kept.\n#   applicable = false                -> the roster predicate did not reach it\n#   applicable = true, produced = [..] -> it produced these rows (own Hat-Refs)\n#   applicable = true, produced = []   -> considered: no_finding says why\n# Check: `hats.py record <this file> --check`.\n\n[decomposition]\nrows = [\"SR-224\"]\ntags = [\"process\"]\nparents = [\"SN-005\"]\nrecorded_by = \"GPT Terra (gpt-5.6-terra), WI-850 spine author\"\nrecorded_on = \"2026-10-22\"\n\n[perspective.SECURITY]\napplicable = true\napplies_when = \"always\"\nproduced = []\nno_finding = \"The description floor and its check introduce no credential, secret, or authority boundary requiring a separate obligation.\"\n\n[perspective.FIRST-RUN-ADOPTER]\napplicable = true\napplies_when = \"tags contains \\\"scripts\\\" or tags contains \\\"templates\\\" or tags contains \\\"process\\\"\"\nproduced = [\"SR-224\"]\n\n[perspective.UNATTENDED-OPS]\napplicable = false\napplies_when = \"tags contains \\\"unattended\\\" or tags contains \\\"loop\\\"\"\nproduced = []\n\n[perspective.CROSS-PLATFORM]\napplicable = true\napplies_when = \"tags contains \\\"scripts\\\" or tags contains \\\"launcher\\\" or tags contains \\\"shell\\\"\"\nproduced = []\nno_finding = \"The floor applies to shipped descriptions without platform-specific behavior requiring a separate obligation.\"\n\n[perspective.MAINTAINER]\napplicable = true\napplies_when = \"always\"\nproduced = []\nno_finding = \"The rationale states the purpose of the description floor and the check preserves it, so no further maintenance obligation is identified.\"\n\n[perspective.TEST-ENGINEER]\napplicable = true\napplies_when = \"always\"\nproduced = []\nno_finding = \"TC-291 verifies the failure and shipped-description outcomes, so no distinct verification obligation is needed.\"\n\n[perspective.UX-DESIGNER]\napplicable = true\napplies_when = \"always\"\nproduced = []\nno_finding = \"The row concerns description content and adds no interaction or layout decision requiring a separate obligation.\"\n\n[perspective.UX-ENGINEER]\napplicable = true\napplies_when = \"always\"\nproduced = []\nno_finding = \"The row introduces no rendered surface whose width, theme, volume, or malformed-data behavior needs another obligation.\"\n\n[perspective.SAFETY]\napplicable = false\napplies_when = \"tags contains \\\"safety\\\"\"\nproduced = []\n\n[perspective.LEGAL]\napplicable = false\napplies_when = \"tags contains \\\"legal\\\"\"\nproduced = []\n\n[perspective.DATA-PROTECTION]\napplicable = false\napplies_when = \"tags contains \\\"personal-data\\\"\"\nproduced = []\n\n[perspective.ACCESSIBILITY]\napplicable = true\napplies_when = \"always\"\nproduced = []\nno_finding = \"The description floor adds no color- or pointer-dependent interaction requiring an accessibility obligation.\"\n\n[perspective.PERFORMANCE]\napplicable = true\napplies_when = \"always\"\nproduced = []\nno_finding = \"The description-length floor introduces no material latency, capacity, or operating-cost risk requiring a measured bound.\"\n\n[perspective.CONSISTENCY]\napplicable = true\napplies_when = \"always\"\nproduced = []\nno_finding = \"The one declared floor and its one check give the descriptions a single meaning, so no separate consistency obligation is identified.\"\n\n[perspective.INTEGRITY-RECOVERABILITY]\napplicable = true\napplies_when = \"always\"\nproduced = []\nno_finding = \"The row neither writes durable state nor creates a recovery path requiring a separate obligation.\"\n\n[perspective.PRODUCT-FITNESS]\napplicable = true\napplies_when = \"always\"\nproduced = []\nno_finding = \"The description floor serves the parent playbook need by making skill use discoverable, so no additional stakeholder outcome is identified.\"\n\r\n","exit_code":0,"status":"completed"}}
