orted((s, n) for s, n in added if n > 0 and (s, n) not in reissued)\r\n--\r\n516-    \"\"\"The watermark text the tree-ish `rev` holds, or \"\" when it holds none.\r\n517-\r\n518:    Implements: SR-174, LLR-363\r\n519-    \"\"\"\r\n520-    return _kitgit.git_out(root, [\"show\", \"{}:{}\".format(rev, WATERMARK)]) or \"\"\r\n521-\r\n522-\r\n--\r\n528-    `kitlib.git.ArchiveError` when git cannot write them.\r\n529-\r\n530:    Implements: SR-174, LLR-363\r\n531-    \"\"\"\r\n532-    with tempfile.TemporaryDirectory() as scratch:\r\n533-        _kitgit.write_blobs(root, rev, LANDING_DIRS, scratch)\r\n534-        return sweep(scratch)\r\n--\r\n539-    `parent_rev`; none when git reports no change under `LANDING_DIRS`.\r\n540-\r\n541:    Implements: SR-174, LLR-363\r\n542-    \"\"\"\r\n543-    changed = _kitgit.git_out(\r\n544-        root, [\"diff\", \"--name-only\", parent_rev, landing_rev, \"--\", *LANDING_DIRS]\r\n545-    )\r\n--\r\n557-    only when the landing brings a record.\r\n558-\r\n559:    Implements: SR-174, LLR-363\r\n560-    \"\"\"\r\n561-    landing_rev, parent_rev = pair\r\n562-    brought = {\r\n563-        k: v\r\n--\r\n579-    Raises `kitlib.git.ArchiveError` when the merge base cannot be read.\r\n580-\r\n581:    Implements: SR-174, LLR-363\r\n582-    \"\"\"\r\n583-    pairs = [revs]\r\n584-    if lane_tip:\r\n585-        base = (_kitgit.git_out(root, [\"merge-base\", revs[1], lane_tip]) or \"\").strip()\r\n--\r\n616-    naming why.\r\n617-\r\n618:    Implements: SR-174, LLR-363\r\n619-    \"\"\"\r\n620-    landing_rev, parent_rev = revs\r\n621-    try:\r\n622-        added, spent, reissued = _read_landing(\r\n--\r\n650-    index's tree) behind the carrier tip; [] with no carrier.\r\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"\"C:\\\\Program Files\\\\PowerShell\\\\7\\\\pwsh.exe\" -Command '$_edit=@'\"'\n\"'$ErrorActionPreference='\"'Stop';\"'$u=[Text.UTF8Encoding]::new($false)\nfunction E($p,$s,$k,$v){$t=[IO.File]::ReadAllText($p,[Text.Encoding]::UTF8);if($t.Contains(\"`r\")){throw '\"'non-LF'};\"'$m=[regex]::Match($t,'\"'(?ms)(\"'^'\"\\\\['+[regex]::Escape(\"'$s)+'\"'\\\\]\\\\n)(.*?)(?=\"'^'\"\\\\[|\\\\z)');if(\"'!$m.Success){throw $s};$b=$m.Groups[2].Value;$q='\"'(?m)\"'^'\"'+[regex]::Escape(\"'$k)+'\"'\\\\s*=.*\"'$'\"';if([regex]::Matches(\"'$b,$q).Count-ne 1){throw \"$s $k\"};$b=[regex]::Replace($b,$q,$v,1);$t=$t.Substring(0,$m.Groups[2].Index)+$b+$t.Substring($m.Groups[2].Index+$m.Groups[2].Length);if($t.Contains(\"`r\")){throw '\"'CR'};[IO.File]::WriteAllText(\"'$p,$t,$u)}\nE '\"'docs/requirements/low-level-requirements.toml' 'design.LLR-363' 'detail' 'detail = \\\"\\\"\\\"A landing with no added carrier-space identity passes without a reservation. A landing whose added carrier-space identities all lie in records naming its claimed work item passes; an added identity outside such a record, an unreadable claim when identities were added, a missing carrier, or a landing-only record refuses before landing. An added identity that a retirement record in the landing tree or its parent names is refused, naming the identity and the record, whether or not a reservation of the landing''s work item covers it. Independently of added identities, before a landing that adds none passes, an identity live in the landing tree that a retirement record the landing tree holds and its parent does not names is refused, naming the identity and the record; a retirement record and live identity both already held by the parent do not refuse the landing. An identity is added when the lane''s tip holds it and its merge base with the integration branch does not, and a hand landing also judges an identity its staged tree adds over the integration branch''s tip. Each landing carries the fold of the carrier tip it read: the automated landing refreshes a lagging tip, and the hand landing folds its staged watermark and refuses while it still lags. A refresh conflict limited to the watermark resolves to that fold; any other conflict remains refused.\\\"\\\"\\\"'\nE 'docs/requirements/low-level-requirements.toml' 'design.LLR-363' 'code_symbol' 'code_symbol = \\\"LANDING_DIRS/ids_at/_added_ids/_reissued_ids/_read_landing/_outside_lines/_retired_lines/_id_name/landing_lines/landing_refusal/rev_fold_lag/_watermark_at/live_ids/live_ids_at/landing_id_refusal/landing_fold_lag/fold_watermark/_reserved_id_refusal/_landing_ready/_merge_trunk_in/_lane_base/_fold_watermark_conflict/_fold_carrier_in/_reserved_ids_refusal/_squash_work_items/_reserved_ids_mode/FOLD_REMEDY\\\"'\nE 'docs/requirements/low-level-requirements.toml' 'design.LLR-362' 'code_symbol' 'code_symbol = \\\"WATERMARK/CARRIER_REF/TRUNK_SPACES/MAX_COUNT/LOST_RACE/RESERVE_VERB/CORRECTION_LINE/MARK_LINE/Refused/carrier_spaces/parse_marks/parse_corrections/parse_reservations/record_line/parse_counts/_count/plan_reservation/fold/carried/fold_lag/_ref_value/carrier_tip/carrier_text/_plumb/write_carrier/reserve/receiving_sides/record_history_findings/reserve_ids/check_work_item/committed_reservations/_baseline_texts/_reserved_highs/_basis/_trunk_name/_committed_marks/_cmd_reserve_ids/_cmd_fold_ids/render_watermark/bump_watermark/correct_watermark/_mark_history_findings\\\"'\nE 'docs/requirements/low-level-requirements.toml' 'design.LLR-286' 'code_symbol' 'code_symbol = \\\"RETIRED_DIR/CENSUS/fragment_text/parse_fragment/recorded_at/drop_row/retire/parse_exclusions/seed_census/missing_findings/shallow_boundary/edited_findings/retirement_findings/records/main\\\"'\nE 'docs/test/test-cases.toml' 'test.TC-402' 'method' 'method = \\\"\\\"\\\"Run real merge-slot and hand-squash landing cases. Drive every landing-table outcome, including a stale-base lane that minted another lane''s reserved number and a code-only lane after trunk retires an id from its base; drive a reserved identity authored, retired and authored again; drive an identity live at the lane''s base retired and authored again in the lane, and a lane landing beside a retirement record and live identity trunk already held; move the carrier after a lane''s own fold and assert that each landing route carries the moved state; and drive a refresh conflict limited to the watermark.\\\"\\\"\\\"'\nE 'docs/test/test-cases.toml' 'test.TC-402' 'expected' 'expected = \\\"\\\"\\\"A code-only landing passes; only added identities reserved for its claimed work item pass; each unreserved, other-work-item, reused, carrierless, unreadable-claim, or landing-only-record case refuses before landing; an identity authored, retired and authored again inside its reservation refuses at both landings naming its retirement record; an identity live at the lane''s base, retired and authored again in the lane, refuses at both landings naming its retirement record, while a lane beside a retired identity and live row trunk already held lands; both routes land the carrier fold they read; and a watermark-only refresh conflict resolves to that fold.\\\"\\\"\\\"'\nE 'docs/test/test-cases.toml' 'test.TC-402' 'evidence' 'evidence = \\\"\\\"\\\"tests/test_id_landing.py::test_the_extracted_sweep_equals_the_working_sweep_for_every_carrier_space; tests/test_id_landing.py::test_a_minus_000_placeholder_is_never_added; tests/test_id_landing.py::test_landing_fold_lag_reads_a_commit_and_an_index_tree; tests/test_id_landing.py::test_a_registry_an_export_ignore_rule_hides_is_still_judged; tests/test_id_landing.py::test_the_slot_refuses_each_unreserved_landing; tests/test_id_landing.py::test_the_slot_refuses_an_unreserved_id_an_export_ignore_rule_hides; tests/test_id_landing.py::test_the_slot_rung_refuses_ids_added_under_an_unreadable_claim; tests/test_id_landing.py::test_the_slot_lands_a_lane_whose_ids_sit_in_its_own_record; tests/test_id_landing.py::test_a_code_only_lane_with_no_carrier_lands; tests/test_id_landing.py::test_the_slot_lands_a_code_only_lane_after_trunk_deletes_an_id_it_based_on; tests/test_id_landing.py::test_the_slot_refuses_a_retired_id_re_authored_inside_its_own_reservation; tests/test_id_landing.py::test_the_slot_refuses_an_id_its_base_held_retired_and_re_authored; tests/test_id_landing.py::test_the_slot_lands_a_lane_beside_a_retired_id_trunk_already_holds_live; tests/test_id_landing.py::test_the_slot_folds_a_carrier_moved_after_the_lanes_refresh; tests/test_id_landing.py::test_a_code_only_lane_lands_with_the_carriers_fold; tests/test_id_landing.py::test_a_refresh_conflicting_only_on_the_watermark_is_resolved_by_the_fold; tests/test_id_landing.py::test_a_watermark_conflict_beside_another_conflict_still_refuses; tests/test_id_landing.py::test_a_registry_conflict_beside_the_watermark_refuses_with_the_merge_undone; tests/test_id_landing.py::test_the_hand_squash_refuses_each_unreserved_landing; tests/test_id_landing.py::test_the_hand_squash_passes_ids_in_its_own_record; tests/test_id_landing.py::test_the_hand_squash_refuses_ids_added_under_an_unreadable_claim; tests/test_id_landing.py::test_the_hand_squash_refuses_a_retired_id_re_authored_inside_its_own_reservation; tests/test_id_landing.py::test_the_hand_squash_refuses_an_id_its_base_held_retired_and_re_authored; tests/test_id_landing.py::test_the_hand_squash_refuses_another_lanes_number_after_that_lane_landed; tests/test_id_landing.py::test_a_hand_squash_folds_a_carrier_moved_after_the_lanes_fold; tests/test_id_landing.py::test_a_code_only_squash_passes_with_no_reservation; tests/test_id_landing.py::test_the_pre_commit_hook_runs_the_reserved_ids_step; tests/test_id_landing.py::test_the_dispatchers_drain_refreshes_a_lane_whose_watermark_lags_the_carrier\\\"\\\"\\\"'\nE 'docs/requirements/system-requirements.toml' 'requirement.SR-174' 'rationale' 'rationale = \\\"\\\"\\\"Identity allocation is its own decision, not a consequence of serialization: serializing the writer makes a COLLISION unlikely and does nothing about RE-USE, which is the half that silently re-points every commit message and archived document citing the freed id. The non-reuse clause has a \"'`shall` of its own here rather than living in SR-170'\"''s acceptance, which is a cell that cannot mint a requirement. Contributes to SN-025 (the ready frontier ordered deterministically, so two readers of the same registry dispatch the same work) by supplying a work-item identity that names one record for every reader, before and after a deletion. It contributes to SN-027 by assigning the registry identities independently authored by parallel lanes from one reservation record, so concurrent lanes cannot receive the same identity.\\\"\\\"\\\"'\nE 'docs/requirements/interfaces.toml' 'interface.IF-224' 'notes' 'notes = \\\"\\\"\\\"Cross-component crossing: trace is CMP-006 and agent_common is CMP-008. The imports are deferred: approval-brief rendering reads human_approves_spine, while a reservation reads trunk_name and parse_wi_id; trace paths outside those uses load nothing from the coordinator''s primitives. The shipped dial holds every rung, so a repo that has released none sees the brief it saw before.\\\"\\\"\\\"'\n'@\n& ([scriptblock]::Create(\"'$_edit)); git diff --check; git diff --stat'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
