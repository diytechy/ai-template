244\"]\n+title = \"Ingest reads the ambient transcript home for one selected session\"\n+module = \"project-trajectory/scripts/usage_ingest.py\"\n+code_symbol = \"main\"\n+detail = \"The command selects the ambient provider home from its environment or default location and never selects an account home. It selects an explicit session or the ambient session identity, refuses with the usage outcome when neither exists, refuses two matching project locations naming both, and names an absent main transcript while allowing present sub-agent transcripts to be read.\"\n+test_refs = \"TC-391, TC-394\"\n+status = \"Drafted\"\n+component = \"CMP-008\"\n+phase = 6\n+\n+[design.LLR-354]\n+sr_refs = [\"SR-244\"]\n+title = \"Ingested logs carry contribution usage without transcript text\"\n+module = \"project-trajectory/scripts/usage_ingest.py;project-trajectory/scripts/agent_common.py\"\n+code_symbol = \"main/write_session_log\"\n+detail = \"Each contribution records its identity, range, usage vocabulary, response and request models, role, phase, INGESTED outcome, transcript source, contribution scope, and known or partial usage status. Its body is a fixed summary of counts, message identities and timestamps, never transcript text or a raw usage object. Empty fields remain empty where the contribution does not provide them.\"\n+test_refs = \"TC-387, TC-393\"\n+status = \"Drafted\"\n+component = \"CMP-008\"\n+phase = 6\n+\n+[design.LLR-355]\n+sr_refs = [\"SR-244\"]\n+title = \"Usage ingest reports one defined command outcome per invocation\"\n+module = \"project-trajectory/scripts/usage_ingest.py\"\n+code_symbol = \"main\"\n+detail = \"The usage-ingest command accepts an optional session identity and root. It emits per-invocation recorded, unchanged, open, skipped, refused, absent or unresolved-parent outcomes with the defined identifying details. It exits zero when no refusal, absence or record-commit refusal occurred, one when any occurred, and two when no session was selected.\"\n+test_refs = \"TC-391, TC-394\"\n+status = \"Drafted\"\n+component = \"CMP-008\"\n+phase = 6\n+\n+[design.LLR-356]\n+sr_refs = [\"SR-244\"]\n+title = \"Close-out and headless completion ingest current and prior session tails\"\n+module = \"project-trajectory/skills/coordinator-cycle/SKILL.md;project-trajectory/skills/session-protocol/SKILL.md\"\n+code_symbol = \"close_out/headless_leg\"\n+detail = \"Coordination completion ingests its current session before writing its handoff and, when the replaced handoff names a session, ingests that prior session again. The later read records only the prior transcript's final range, including a message that was previously open once it becomes final.\"\n+test_refs = \"TC-395\"\n+status = \"Drafted\"\n+component = \"CMP-008\"\n+phase = 6\ndiff --git a/docs/requirements/system-requirements.toml b/docs/requirements/system-requirements.toml\nindex 8bcbed9d2..ef00f6898 100644\n--- a/docs/requirements/system-requirements.toml\n+++ b/docs/requirements/system-requirements.toml\n@@ -1944,3 +1944,16 @@ verification = \"Test\"\n status = \"Approved\"\n phase = 6\n aspect = \"process\"\n+\n+[requirement.SR-244]\n+title = \"Transcript-derived usage records include coordinated nested agents\"\n+sn_refs = [\"SN-026\"]\n+hat_refs = [\"PERFORMANCE\"]\n+requirement = \"The delivered coordination capability shall record once each model session spent on coordinated work, including every session an agent spawns at any nesting depth, from its transcript-derived usage.\"\n+rationale = \"A DERIVED requirement through the PERFORMANCE lens: SN-026 makes model-family routing a configurable operating choice, but does not require the cost of coordinated sessions outside the launcher result to be visible. The lens identifies an incomplete cost reading when nested work is omitted or a repeated or resumed read inflates it. Recorded probes establish that a resume appends to its existing transcript, that a Claude result excludes sub-agent usage, and that arbitrary nesting occurs; a final sub-agent hand-back can remain open with no later stop record, so it is not a completed contribution. Fed back to the need: its acceptance could require the owner to see complete, non-duplicated usage for coordinated work across the configured families.\"\n+acceptance_criteria = \"Every coordinated session and nested agent is recorded with its identity; usage counts each completed message once, marks source-stated partial counts, and adds nothing on repeated, resumed, or interrupted recording; a session already recorded by the service is not counted twice; an ingested record has no gate authority and contains no transcript text; an unknown source shape is refused naming the defect; and published coordination guidance runs the recording at close-out and at a headless leg's end, including pickup of the previous session's tail.\"\n+priority = \"S\"\n+verification = \"Test\"\n+status = \"Drafted\"\n+phase = 6\n+aspect = \"performance\"\ndiff --git a/docs/test/test-cases.toml b/docs/test/test-cases.toml\nindex aae2b85ee..34179c9c2 100644\n--- a/docs/test/test-cases.toml\n+++ b/docs/test/test-cases.toml\n@@ -3811,3 +3811,113 @@ automated = \"Yes\"\n evidence = \"tests/test_prompts.py::test_the_cycle_says_sol_and_terra_calls_are_refused_in_the_blackout_window; tests/test_prompts.py::test_no_recipe_launches_sol_or_terra_outside_the_entry_point\"\n status = \"Approved\"\n phase = 6\n+\n+[test.TC-386]\n+verifies = [\"SR-244\", \"LLR-347\", \"LLR-348\", \"IF-245\"]\n+level = \"Integration\"\n+method = \"Read a nested session fixture and assert its main and nested-agent identities, depth, parent, model and timestamp fields, together with deterministic distinct invocation identities.\"\n+tier = \"Smoke\"\n+expected = \"Every transcript invocation has its recorded identity, including nested agents.\"\n+automated = \"Yes\"\n+evidence = \"tests/test_claude_transcripts.py::test_a_session_with_nested_agents_yields_four_invocations_with_their_identities; tests/test_usage_ingest.py::test_the_invocation_id_is_derived_from_the_transcript_identity\"\n+status = \"Drafted\"\n+phase = 6\n+\n+[test.TC-387]\n+verifies = [\"SR-244\", \"LLR-347\", \"LLR-354\", \"IF-245\", \"IF-246\"]\n+level = \"Integration\"\n+method = \"Read transcript fixtures with repeated records, partial records and unrelated summary usage, then inspect the written usage records.\"\n+tier = \"Smoke\"\n+expected = \"Usage is the once-per-message assistant sum, and written records carry the required vocabulary and partial state.\"\n+automated = \"Yes\"\n+evidence = \"tests/test_claude_transcripts.py::test_each_invocation_usage_is_its_unique_message_sum; tests/test_claude_transcripts.py::test_a_repeated_record_adds_nothing; tests/test_claude_transcripts.py::test_the_parents_tool_result_summary_is_never_read; tests/test_usage_ingest.py::test_one_ingest_records_four_logs_with_the_usage_vocabulary\"\n+status = \"Drafted\"\n+phase = 6\n+\n+[test.TC-388]\n+verifies = [\"SR-244\", \"LLR-347\"]\n+level = \"Unit\"\n+method = \"Cut and restore a final transcript message, and read a message without a stop record followed by another message.\"\n+tier = \"Smoke\"\n+expected = \"An open last message is named and uncounted until final, while an earlier message without a stop record is counted once and marked partial.\"\n+automated = \"Yes\"\n+evidence = \"tests/test_claude_transcripts.py::test_an_open_last_message_is_named_and_not_counted; tests/test_claude_transcripts.py::test_a_message_without_a_stop_record_is_final_once_a_later_message_follows\"\n+status = \"Drafted\"\n+phase = 6\n+\n+[test.TC-389]\n+verifies = [\"SR-244\", \"LLR-349\", \"LLR-350\", \"IF-065\", \"IF-246\"]\n+level = \"Integration\"\n+method = \"Ingest, resume, repeat and interrupt fixture sessions, including same-second ending ranges and prior logs held in another worktree.\"\n+tier = \"Full\"\n+expected = \"Each completed range is recorded once under an ordered contribution key, and every retry records only the still-unrecorded range.\"\n+automated = \"Yes\"\n+evidence = \"tests/test_usage_ingest.py::test_ingesting_one_session_twice_records_nothing_the_second_time; tests/test_usage_ingest.py::test_appended_messages_are_recorded_alone_under_the_same_identity; tests/test_usage_ingest.py::test_initial_resumed_and_repeated_ingests_give_two_contributions_summing_to_the_whole; tests/test_usage_ingest.py::test_an_open_message_is_recorded_once_final_and_the_contributions_equal_the_completed_transcript; tests/test_usage_ingest.py::test_two_contributions_whose_last_messages_share_a_second_both_survive; tests/test_usage_ingest.py::test_a_run_killed_after_some_logs_then_rerun_records_each_invocation_once; tests/test_usage_ingest.py::test_a_torn_earlier_log_refuses_that_invocation_naming_it; tests/test_usage_ingest.py::test_a_cursor_missing_from_the_transcript_refuses; tests/test_usage_ingest_git.py::test_a_log_in_another_worktree_counts_toward_exactly_once; tests/test_usage_ingest_git.py::test_from_the_primary_checkout_the_logs_spool_and_nothing_is_committed\"\n+status = \"Drafted\"\n+phase = 6\n+\n+[test.TC-390]\n+verifies = [\"SR-244\", \"LLR-351\", \"IF-246\"]\n+level = \"Integration\"\n+method = \"Ingest a session with service records under both declared result-coverage states.\"\n+tier = \"Smoke\"\n+expected = \"A service-recorded main transcript is skipped, while sub-agents are skipped only when the service result covers them.\"\n+automated = \"Yes\"\n+evidence = \"tests/test_usage_ingest.py::test_a_service_recorded_session_skips_its_main_transcript\"\n+status = \"Drafted\"\n+phase = 6\n+\n+[test.TC-391]\n+verifies = [\"SR-244\", \"LLR-352\", \"LLR-353\", \"LLR-355\", \"IF-245\", \"IF-305\"]\n+level = \"Integration\"\n+method = \"Exercise malformed transcript and meta shapes, arbitrary nesting, unresolved parents, duplicate transcript locations, and absent or unspecified sessions through the reader and command.\"\n+tier = \"Smoke\"\n+expected = \"Unknown shapes and session-selection failures are named and refused, while valid arbitrary nesting and unresolved parents remain observable.\"\n+automated = \"Yes\"\n+evidence = \"tests/test_claude_transcripts.py::test_an_unknown_shape_is_refused_naming_file_and_field; tests/test_claude_transcripts.py::test_a_depth_two_agent_whose_parent_is_absent_is_kept_and_named_unresolved; tests/test_claude_transcripts.py::test_any_spawn_depth_is_accepted_and_recorded; tests/test_claude_transcripts.py::test_a_session_held_in_two_project_directories_is_refused_naming_both; tests/test_usage_ingest.py::test_an_unknown_shape_exits_nonzero_and_records_nothing_for_that_transcript; tests/test_usage_ingest.py::test_no_session_is_a_usage_error; tests/test_usage_ingest.py::test_an_absent_transcript_is_named\"\n+status = \"Drafted\"\n+phase = 6\n+\n+[test.TC-392]\n+verifies = [\"SR-244\", \"LLR-354\", \"IF-246\"]\n+level = \"Integration\"\n+method = \"Plant transcript text in every supported transcript text location and inspect every written ingest log.\"\n+tier = \"Smoke\"\n+expected = \"No transcript text appears in a written ingest record.\"\n+automated = \"Yes\"\n+evidence = \"tests/test_usage_ingest.py::test_no_transcript_text_reaches_any_written_log\"\n+status = \"Drafted\"\n+phase = 6\n+\n+[test.TC-393]\n+verifies = [\"SR-244\", \"LLR-354\", \"IF-246\"]\n+level = \"Integration\"\n+method = \"Place an ingested log in lane records and exercise round, build-family, draw and resume-carrier readers.\"\n+tier = \"Full\"\n+expected = \"An ingested record is not interpreted as a round, build, draw, or resume carrier.\"\n+automated = \"Yes\"\n+evidence = \"tests/test_usage_ingest_git.py::test_an_ingested_log_in_a_lane_is_no_round_no_build_and_no_draw\"\n+status = \"Drafted\"\n+phase = 6\n+\n+[test.TC-394]\n+verifies = [\"SR-244\", \"LLR-353\", \"LLR-355\", \"IF-305\"]\n+level = \"Integration\"\n+method = \"Invoke the command with no selected session and with an absent selected transcript.\"\n+tier = \"Smoke\"\n+expected = \"No selected session exits 2; an absent transcript is named and exits 1.\"\n+automated = \"Yes\"\n+evidence = \"tests/test_usage_ingest.py::test_no_session_is_a_usage_error; tests/test_usage_ingest.py::test_an_absent_transcript_is_named\"\n+status = \"Drafted\"\n+phase = 6\n+\n+[test.TC-395]\n+verifies = [\"SR-244\", \"LLR-356\"]\n+level = \"Unit\"\n+method = \"Read the synchronized completion guidance and assert the current-session and replaced-handoff session ingest commands.\"\n+tier = \"Smoke\"\n+expected = \"Close-out and headless completion ingest the current session and, when named, the prior session tail.\"\n+automated = \"Yes\"\n+evidence = \"tests/test_prompts.py::test_the_close_out_and_headless_leg_run_the_usage_ingest\"\n+status = \"Drafted\"\n+phase = 6\n","exit_code":0,"status":"completed"}}
