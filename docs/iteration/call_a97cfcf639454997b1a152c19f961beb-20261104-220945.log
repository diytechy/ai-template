{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"\"C:\\\\Program Files\\\\PowerShell\\\\7\\\\pwsh.exe\" -Command \"@'\nimport copy\nimport json\nimport tomllib\n\nfiles = {\n    'docs/requirements/low-level-requirements.toml': ('design', 'LLR-360', {'detail'}),\n    'docs/test/test-cases.toml': ('test', 'TC-399', {'method', 'expected'}),\n}\n\ndef read(path):\n    with open(path, 'r', encoding='utf-8', newline='') as f:\n        text = f.read()\n    assert '\\\\r' not in text, f'{path}: expected LF-only text'\n    return text\n\ndef literal(value):\n    return json.dumps(value, ensure_ascii=False, separators=(', ', ': '))\n\ndef block(text, section, ident):\n    marker = f'[{section}.{ident}]\\\\n'\n    assert text.count(marker) == 1, f'{section}.{ident}: missing or duplicate table'\n    start = text.index(marker)\n    end = text.find('\\\\n[[', start + len(marker))\n    return text[start:] if end == -1 else text[start:end]\n\nbefore, texts = {}, {}\nfor path in files:\n    texts[path] = read(path)\n    before[path] = copy.deepcopy(tomllib.loads(texts[path]))\n\nllr_anchor = 'The applicable set combines each amended need with each need named by a system requirement the sitting judges, including an amended system requirement, widens each need by the authoring work item\\\\'s declared tags, and evaluates each need alone.'\nllr_addition = ' A row the merge mints records the declared tags of the work items a route names as its authors, and those tags stand in place of the row\\\\'s own classification; a route naming no authoring work item records none, and the row widens by its own tags. A row minted from a minted row passes that record on, so the minted and in-lane sittings for one system requirement reach one perspective set wherever the authoring work item is named.'\nmethod_anchor = 'work-item tags widen one need without merging siblings;'\nmethod_addition = ' a minted row\\\\'s recorded authoring tags stand in place of its own, and a row minted from a minted row passes them on; the minted and in-lane rows for one system requirement compose one hat set; a route naming no authoring work item leaves the row widening by its own tags;'\nexpected_anchor = 'while another sitting has no perspective question;'\nexpected_addition = ' the minted and in-lane routes reach one perspective set for one system requirement wherever the authoring work item is named;'\n\nchanges = [\n    ('docs/requirements/low-level-requirements.toml', 'design', 'LLR-360', 'detail', llr_anchor, llr_addition),\n    ('docs/test/test-cases.toml', 'test', 'TC-399', 'method', method_anchor, method_addition),\n    ('docs/test/test-cases.toml', 'test', 'TC-399', 'expected', expected_anchor, expected_addition),\n]\nnew_values = {}\nfor path, section, ident, cell, anchor, addition in changes:\n    old_value = before[path][section][ident][cell]\n    own_block = block(texts[path], section, ident)\n    assert old_value.count(anchor) == 1, f'{ident}.{cell}: anchor not unique in old cell'\n    assert own_block.count(anchor) == 1, f'{ident}.{cell}: anchor not unique in its table block'\n    old_line = f'{cell} = {literal(old_value)}'\n    assert own_block.count(old_line) == 1, f'{ident}.{cell}: old value not unique in its table block'\n    new_value = old_value.replace(anchor, anchor + addition, 1)\n    new_values[(path, section, ident, cell)] = new_value\n    texts[path] = texts[path].replace(old_line, f'{cell} = {literal(new_value)}', 1)\n\nfor path, text in texts.items():\n    assert '\\\\r' not in text, f'{path}: edit introduced CR'\n    with open(path, 'w', encoding='utf-8', newline='') as f:\n        f.write(text)\n\nfor path, (section, ident, allowed) in files.items():\n    after_text = read(path)\n    after = tomllib.loads(after_text)\n    assert set(after) == set(before[path]), f'{path}: top-level sections changed'\n    for top in after:\n        if top \"'!= section:\n            assert after[top] == before[path][top], f'\"'{path}: unrelated section moved: {top}'\n    assert set(after[section]) == set(before[path][section]), f'{path}: row set changed'\n    for row_id, row in after[section].items():\n        if row_id \"'!= ident:\n            assert row == before[path][section][row_id], f'\"'{path}: unrelated row moved: {row_id}'\n    assert set(after[section][ident]) == set(before[path][section][ident]), f'{path}: cell set changed'\n    for cell, old_value in before[path][section][ident].items():\n        expected = new_values.get((path, section, ident, cell), old_value)\n        assert after[section][ident][cell] == expected, f'{path}: unexpected movement in {ident}.{cell}'\n\nprint('guarded UTF-8/LF edit passed: three cells changed; TOML parsed; no other cell moved')\n'@ | & 'C:/Projects/ai-template/.venv/Scripts/python.exe' -\ngit diff --check\ngit diff -- docs/requirements/low-level-requirements.toml docs/test/test-cases.toml\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
