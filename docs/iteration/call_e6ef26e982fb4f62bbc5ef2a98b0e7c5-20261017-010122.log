ed it out and the kit's own launch points still refuse. If it should be closed properly, the by-construction alternative of refusing at the launch point is recorded as deliberately not built (D-016).\n\nThe untracked `003-ADJUDICATE-bcb892f.md.requested` is the coordinator's, and I didn't touch it.","ttft_ms":25952,"type":"result","duration_ms":173135,"uuid":"b633b4cb-bf55-4ff3-8442-7ac68b32c993","ttft_stream_ms":23778,"time_to_request_ms":331,"time_to_request_phases_ms":{"other":24,"system_prompt":41,"resume_other":0,"process_user_input":3,"input_attachments":183,"input_hooks":2,"transcript_persist":1,"tool_pool_refresh":2,"init_message":9,"engine_pickup":2,"message_prep":1,"model_config_wait":3,"autocompact":2,"query_setup":0,"model_gates":1,"tool_schema_build":9,"message_normalization":22,"client_creation":7,"request_build":19},"turn_start_resume_kind":"none","process_turn_index":0,"time_to_request_loop_lag_ms":58,"time_to_request_cpu_ms":406,"time_to_request_major_faults":35109,"input_attachments_detail":{"slowest_producer":"changed_files","slowest_producer_ms":173,"cpu_ms":266,"major_faults":31251,"changed_files_reread":10},"first_content_frame_ms":23778,"queued_turn_count":0,"result_index":0}]
