/test_review_brief.py::test_the_scope_critique_names_the_registries_beside_the_spec;tests/test_review_brief.py::test_a_convergence_round_renders_the_one_fixed_stance_line;tests/test_review_brief.py::test_an_absent_stance_renders_the_ordinary_round;tests/test_review_brief.py::test_a_narrow_round_refuses_the_convergence_stance;tests/test_review_brief.py::test_a_convergence_brief_carries_the_stance_and_its_marking;tests/test_review_brief.py::test_a_convergence_tagged_finding_files_with_its_count_unchanged;tests/test_review_brief.py::test_the_scope_rubric_names_every_registry_the_critique_brief_renders;tests/test_plan_filing.py::test_at_the_cap_a_successor_ruling_never_passes;tests/test_review_brief_git.py::test_the_reading_scope_never_shows_a_record_of_earlier_findings;tests/test_review_brief.py::test_only_a_convergence_brief_leaves_the_decisions_record_and_critiques_out_of_its_reading_scope;tests/test_review_brief_git.py::test_an_ordinary_review_reads_the_decisions_record;tests/test_plan_filing.py::test_the_plan_critique_brief_ties_severity_to_reachability\"\nstatus = \"Approved\"\nphase = 6\n\n\r\n[test.TC-410]\nverifies = [\"SR-157\", \"LLR-366\", \"IF-263\"]\nlevel = \"Integration\"\nmethod = \"Exercise evidence that lacks a declaration and a declaration that lacks evidence in plain and strict modes; exercise a Drafted test case; and run the equality check in a bootstrapped scaffold below and at the implementation rung.\"\ntier = \"Full\"\nexpected = \"Each difference names the test case and node, warns in plain mode and errors under strict checking; a Drafted case is judged; and a newly created project warns below the implementation rung while the same difference fails at that rung.\"\nautomated = \"Yes\"\nevidence = \"tests/test_trajectory_arch.py::test_evidence_without_a_tag_is_named; tests/test_trajectory_arch.py::test_a_tag_without_evidence_is_named; tests/test_trajectory_arch.py::test_a_draft_tc_is_judged; tests/test_trajectory_arch.py::test_the_equality_check_on_a_bootstrapped_scaffold\"\nstatus = \"Drafted\"\nphase = 6\n\n\r\n[test.TC-411]\nverifies = [\"SR-157\", \"LLR-366\"]\nlevel = \"Integration\"\nmethod = \"Exercise parametrized, file-only, class-method, whitespace-separated, and non-Python evidence parts against matching and nonmatching declarations; and exercise a test repeating its module declaration.\"\ntier = \"Full\"\nexpected = \"A parametrized case matches its test declaration after case reduction; a file part matches only a file-level declaration; a class method remains whole; whitespace-separated items are read separately; a non-Python node part receives both differences unless its file-only form matches; and a test repeating its module declaration reads tag without evidence with a file-only cell and is clean when both parts are named.\"\nautomated = \"Yes\"\nevidence = \"tests/test_trajectory_arch.py::test_a_parametrized_part_matches_its_tests_tag; tests/test_trajectory_arch.py::test_a_file_only_part_matches_a_module_tag_and_not_a_tests_tag; tests/test_trajectory_arch.py::test_a_class_method_part_matches_its_tag; tests/test_trajectory_arch.py::test_a_whitespace_separated_cell_reads_as_its_items; tests/test_trajectory_arch.py::test_a_non_python_node_part_reads_both_findings; tests/test_trajectory_arch.py::test_a_test_repeating_its_modules_case_needs_its_own_part\"\nstatus = \"Drafted\"\nphase = 6\n\n\r\n[test.TC-412]\nverifies = [\"SR-157\", \"LLR-366\"]\nlevel = \"Integration\"\nmethod = \"Exercise parts outside the tests root, a tests root of `.`, absent tests-root and registry inputs, an unreadable file beside a readable file, and an Evidence cell holding only a parenthetical note.\"\ntier = \"Full\"\nexpected = \"Outside parts are ignored; a tests root of `.` holds every part in the repository; absent inputs are vacuous; an unreadable file adds no equality finding while a readable unmatched part still does; and a note-only cell supplies no part so a declaration for it is tag without evidence.\"\nautomated = \"Yes\"\nevidence = \"tests/test_trajectory_arch.py::test_a_part_outside_the_tests_root_is_ignored; tests/test_trajectory_arch.py::test_the_equality_check_is_vacuous_with_no_tests_root_or_no_registry; tests/test_trajectory_arch.py::test_an_unreadable_file_adds_no_equality_finding; tests/test_trajectory_arch.py::test_a_note_only_cell_has_no_part_and_a_tag_on_it_is_a_finding\"\nstatus = \"Drafted\"\nphase = 6\n\n\r\n[design.LLR-365]\nsr_refs = [\"SR-157\"]\ntitle = \"Test-file declarations of their test cases\"\nmodule = \"project-trajectory/scripts/gen_arch_map.py;project-trajectory/scripts/trajectory_arch.py\"\ncode_symbol = \"read_test_tags/tc_tag_findings\"\ndetail = \"A test-file back-link declaration names test cases, and each named id must be a live test case. In a Python test file, declarations in the module docstring and in a test's docstring are read; in another supported test-file type, declarations are read at file level. A byte-order mark at the start of a file does not change its reading. The two Python levels union. A test repeating its module's test case is no finding. That reading judges the declarations alone: their equality with the Evidence cell is a separate rule. A non-docstring string literal, a backtick-quoted token and an unsupported test-file type make no declaration. A declaration outside a read position, including a pytest-fixture docstring, is refused as misplaced. The following are refused as malformed: a declaration whose list is not test-case ids only; a read-position line whose token follows prose and names a test case; and a next line that continues a valid list. The after-prose refusal directs the declaration to the start of its own line. An id absent from the live test-case registry, including an example or retired id, is refused as unknown; a Drafted test case is live. A test file that cannot be decoded or parsed is refused as unreadable. Every live id in a valid declaration maps to its test node. Each refusal names the repository-relative file, line and shape. Reading test files does not change source-file declaration reading. An absent tests root, or an absent test-case registry, makes the check vacuous. Findings warn without strict checking and error under strict checking; they gate from DevStg-Impl and remain warnings below that rung, including in a newly created project. The contract covers test files, test-case registries and declared tests roots produced by supported workflows; non-Python fixture text, non-default test-collection patterns, hand-chosen test-case aliases and tests roots reached through a symlink are outside it.\"\nrationale = \"A tag that is silently misplaced, malformed, dangling or unreadable can make a test case appear absent without an attributable finding. Keeping the declaration grammar separate from source-file reading prevents this added input from changing established source analysis.\"\ntest_refs = \"TC-404; TC-405; TC-406; TC-407; TC-408; TC-409\"\nstatus = \"Approved\"\ncomponent = \"CMP-006\"\nphase = 6\n\n\r\n[requirement.SR-112]\ntitle = \"Checked per-agent skill fan-out\"\nsn_refs = [\"SN-005\"]\nboundary_refs = [\"B-05\"]\nhat_refs = [\"MAINTAINER\"]\nrequirement = \"\"\"The per-agent skill copies shall be a checked, generated fan-out of the one neutral skill source.\"\"\"\nrationale = \"\"\"Realizes the dissolved edge expectation that a generated artifact drifting from its source fails its --check — one skill maintained in three agent-specific copies rots into three different skills, and the copy an agent actually loads is the one nobody edited. Maintaining a single shared directory was rejected because each agent harness looks in its own path; the fan-out is forced, so the copies are generated and drift is a finding. Generated marking is what stops a maintainer editing a disposable copy.\"\"\"\nacceptance_criteria = \"\"\"A per-agent copy that diverges byte-for-byte from source is detectable and refreshed by one command.\"\"\"\npriority = \"C\"\nverification = \"Test\"\nstatus = \"Approved\"\nphase = 1\ncoincident = \"\"\"The need asks that AI agents and humans work from the same playbook. The skills are part of that playbook, and each agent harness loads them from its own copy; each copy generated from the one neutral skill source, with a copy diverging from it byte for byte detected and refreshed by one command, is that sameness for the skills: every agent loads the text the source holds, and no agent's copy can quietly become a different skill. The generator and its check deliver it with no party between; the need's agent-neutral enforcement clause is other rows'.\"\"\"\n\n\r\n","exit_code":0,"status":"completed"}}
