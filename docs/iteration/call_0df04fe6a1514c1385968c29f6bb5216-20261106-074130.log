que_it_cites; tests/test_plan_filing.py::test_the_pass_form_reads_a_committed_critique_through_line_ending_conversion; tests/test_plan_filing.py::test_a_plan_the_coverage_gate_fails_never_passes; tests/test_plan_filing.py::test_a_minor_only_change_request_passes; tests/test_plan_filing.py::test_a_first_change_request_allows_one_revision_and_never_passes; tests/test_plan_filing.py::test_at_the_cap_an_accepted_dismissal_of_every_blocking_finding_passes; tests/test_plan_filing.py::test_at_the_cap_anything_but_an_accepted_dismissal_is_refused; tests/test_plan_filing.py::test_the_plan_critique_renders_over_the_committed_plan_and_its_coverage; tests/test_plan_filing.py::test_the_second_plan_critique_is_in_convergence_and_never_sees_the_first; tests/test_plan_filing.py::test_at_the_cap_a_major_after_a_minor_is_disputed_under_its_own_number; tests/test_plan_filing.py::test_at_the_cap_two_blocking_findings_with_one_dismissed_are_refused; tests/test_plan_filing.py::test_the_dispute_findings_file_refuses_ids_other_than_the_blocking_ones; tests/test_plan_filing.py::test_the_second_critique_refuses_a_revision_that_misses_a_first_finding; tests/test_plan_filing.py::test_a_filed_critique_exits_zero_and_writes_only_its_record; tests/test_plan_filing.py::test_at_the_cap_an_uncommitted_dispute_verdict_is_refused; tests/test_plan_filing.py::test_the_plan_critique_refuses_a_missing_input_and_writes_nothing; tests/test_plan_pass.py::test_the_planner_template_is_in_the_generated_catalogue; tests/test_plan_pass.py::test_the_shipped_planner_template_names_the_architecture_skill_by_its_agent_paths_and_no_row_of_this_repo;tests/test_plan_pass.py::test_the_planner_brief_names_each_input_by_its_registry;tests/test_review_brief.py::test_the_scope_critique_names_the_registries_beside_the_spec;tests/test_review_brief.py::test_a_convergence_round_renders_the_one_fixed_stance_line;tests/test_review_brief.py::test_an_absent_stance_renders_the_ordinary_round;tests/test_review_brief.py::test_a_narrow_