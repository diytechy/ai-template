+# --- keep-warm (plan §3.5; OI-69 (c2)) ----------------------------------------
+def _warm_cfg(minutes):
+    return ac.AdjudicatorConfig(
+        enabled=minutes > 0,
+        context_reset_pct=55,
+        retain_for=(),
+        keepwarm_minutes=minutes,
+        reset_on_same_artifact=False,
+    )
