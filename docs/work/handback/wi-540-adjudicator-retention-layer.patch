+
+def _dig(mapping, *keys):
+    """Walk a nested mapping by `keys`, returning None on any miss/non-dict —
+    the tolerant reader a best-effort telemetry parse needs."""
+    node = mapping
+    for key in keys:
+        if not isinstance(node, dict):
+            return None
+        node = node.get(key)
