#!/bin/sh
# Pre-commit floor for THIS repo (the ai-template meta-repo) — a thin WRAPPER, not
# a copy. The kit's harness lives under project-trajectory/scripts/ (this repo's
# scripts/ holds only dev-setup), so point the shipped floor there via
# KIT_SCRIPTS_DIR and delegate to it. The floor logic AND the venv-preference now
# live once in project-trajectory/hooks/pre-commit, so there is nothing here to
# drift from the shipped hook (IMPROVEMENT_PLAN.md WI-1.42; was a hand copy).
#
# Enable:  git config core.hooksPath .githooks
# Disable: git config --unset core.hooksPath
KIT_SCRIPTS_DIR=project-trajectory/scripts
export KIT_SCRIPTS_DIR
ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || ROOT=$(cd "$(dirname "$0")/.." && pwd)
# WI-254: sweep gitignored pytest-cov residue (.coverage + -n auto shards) from
# the root — regenerated by every coverage run, consumed by nothing between
# runs, and thousands accumulate. Exact top-level names only; meta-repo wrapper
# only (the shipped kit hook is untouched — no downstream behavior change).
# Age-guarded (>60 min): an unconditional sweep can race a LIVE parallel
# coverage run and delete a shard mid-write — the same in-use-file class
# (WinError 32) WI-104 closed — so only stale residue is swept; a concurrent
# run's fresh shards are left alone (L-15).
find "$ROOT" -maxdepth 1 \( -name '.coverage' -o -name '.coverage.*' \) -mmin +60 -exec rm -f {} + 2>/dev/null
exec sh "$ROOT/project-trajectory/hooks/pre-commit" "$@"
